  m_text: "\uB450 \uB9C8\uB9AC\uC758 \uACF0 \uC0AC\uC774\uB97C \uAD50\uBB18\uD558\uAC8C
    \uD30C\uACE0\uB4E4\uC5B4 \uBC24\uD558\uB298\uC744 \uC870\uAC01\uB0B8 \uD30C\uC218\uAFBC.
