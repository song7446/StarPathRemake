  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  targetText: {fileID: 755347923}
  textKr: "\uC0AC\uAC74\uC774 \uC77C\uC5B4\uB09C \uC21C\uC11C\uB300\uB85C \uC7A5\uBA74\uC744
    \uC774\uC5B4\uBCF4\uC138\uC694."
  textEn: Connect the scene stars in chronological order.
  textZhHans: "\u6309\u4E8B\u4EF6\u53D1\u751F\u7684\u987A\u5E8F\u8FDE\u63A5\u573A\u666F\u4E4B\u661F\u3002"
  textJa: "\u51FA\u6765\u4E8B\u306E\u9806\u306B\u30B7\u30FC\u30F3\u306E\u661F\u3092\u3064\u306A\u304E\u307E\u3057\u3087\u3046\u3002"
  textEs: "Une las estrellas de las escenas en orden cronol\xF3gico."
  textPt: "Ligue as estrelas das cenas em ordem cronol\xF3gica."
  textRu: "\u0421\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435 \u0437\u0432\u0451\u0437\u0434\u044B
    \u0441\u0446\u0435\u043D \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u0441\u043E\u0431\u044B\u0442\u0438\u0439."
