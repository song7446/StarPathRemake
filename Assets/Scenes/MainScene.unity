  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  targetText: {fileID: 137727211}
  textKr: "\uBCC4\uC744 \uD074\uB9AD\uD574 \uC5F0\uACB0\uD574\uBCF4\uC138\uC694."
  textEn: Click the stars to connect them.
  textZhHans: "\u70B9\u51FB\u661F\u661F\uFF0C\u5C06\u5B83\u4EEC\u8FDE\u8D77\u6765\u3002"
  textJa: "\u661F\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u3064\u306A\u3052\u307E\u3057\u3087\u3046\u3002"
  textEs: Haz clic en las estrellas para unirlas.
  textPt: "Clique nas estrelas para conect\xE1-las."
  textRu: "\u041D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435 \u043D\u0430 \u0437\u0432\u0451\u0437\u0434\u044B,
    \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C
    \u0438\u0445."
