  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b11a23b6ed4b0e74dbdaf843d1411398, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  targetText: {fileID: 1590438623}
  textKr: "\uC218\uCCA9\uC5D0\uC11C \uD604\uC7AC \uCC55\uD130\uC758 \uBCC4\uC790\uB9AC
    \uC0AC\uC9C4\uC744 \uAEBC\uB0B4 \uCC38\uACE0\uD558\uC138\uC694."
  textEn: "Take out this chapter\u2019s constellation photo from the notebook as
    a guide."
  textZhHans: "\u4ECE\u7B14\u8BB0\u672C\u4E2D\u53D6\u51FA\u672C\u7AE0\u7684\u661F\u5EA7\u7167\u7247\u4F5C\u4E3A\u53C2\u8003\u3002"
  textJa: "\u30CE\u30FC\u30C8\u304B\u3089\u4ECA\u306E\u7AE0\u306E\u661F\u5EA7\u5199\u771F\u3092\u53D6\u308A\u51FA\u3057\u3066\u53C2\u8003\u306B\u3057\u307E\u3057\u3087\u3046\u3002"
  textEs: "Saca del cuaderno la foto de la constelaci\xF3n de este cap\xEDtulo como
    gu\xEDa."
  textPt: "Tire do caderno a foto da constela\xE7\xE3o deste cap\xEDtulo para usar
    como guia."
  textRu: "\u0414\u043E\u0441\u0442\u0430\u043D\u044C\u0442\u0435 \u0438\u0437 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430
    \u0444\u043E\u0442\u043E \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F
    \u044D\u0442\u043E\u0439 \u0433\u043B\u0430\u0432\u044B \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
    \u043A\u0430\u043A \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443."
