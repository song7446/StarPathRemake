  m_Script: {fileID: 11500000, guid: b11a23b6ed4b0e74dbdaf843d1411398, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  targetText: {fileID: 912506185}
  textKr: "\uC6B0\uD074\uB9AD\uC73C\uB85C \uC5F0\uACB0\uC744 \uCDE8\uC18C\uD558\uAC70\uB098
    \uB9C8\uC9C0\uB9C9 \uC120\uC744 \uC9C0\uC6B0\uC138\uC694."
  textEn: Right-click to cancel drawing or remove the last line.
  textZhHans: "\u53F3\u952E\u53D6\u6D88\u8FDE\u7EBF\uFF0C\u6216\u5220\u9664\u4E0A\u4E00\u6761\u7EBF\u3002"
  textJa: "\u53F3\u30AF\u30EA\u30C3\u30AF\u3067\u63A5\u7D9A\u3092\u4E2D\u6B62\u3001\u307E\u305F\u306F\u76F4\u524D\u306E\u7DDA\u3092\u524A\u9664\u3002"
  textEs: "Clic derecho para cancelar o borrar la \xFAltima l\xEDnea."
  textPt: "Clique direito para cancelar ou apagar a \xFAltima linha."
  textRu: "\u041F\u0440\u0430\u0432\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0430
    \u043C\u044B\u0448\u0438 \u2014 \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0438\u043B\u0438
    \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
    \u043B\u0438\u043D\u0438\u044E."
