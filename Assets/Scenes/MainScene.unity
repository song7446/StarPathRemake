  m_text: "\uBAA8\uB4E0 \uACFC\uC5C5\uC744 \uB05D\uB9C8\uCE58\uACE0 \uBC24\uD558\uB298\uC758
    \uAC00\uC7A5 \uB192\uC740 \uACF3\uC5D0 \uBC88\uB729\uC774\uB294 \uC601\uC6C5\uC758
    \uCD08\uC0C1. \uB4A4\uD2C0\uB9B0 \uD558\uB298 \uC544\uB798 \uAC70\uAFB8\uB85C
    \uB4A4\uC9D1\uD78C \uCC44 \uC601\uC6D0\uD788 \uB05D\uB098\uC9C0 \uC54A\uC744
