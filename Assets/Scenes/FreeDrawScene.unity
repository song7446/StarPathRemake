  m_Script: {fileID: 11500000, guid: b11a23b6ed4b0e74dbdaf843d1411398, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  targetText: {fileID: 1256205109}
  textKr: "\uB9CC\uB4E0 \uBCC4\uC790\uB9AC\uAC00 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.
    \n\uADF8\uB798\uB3C4 \uB098\uAC00\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  textEn: "Your constellation will be lost. \nLeave anyway?"
  textZhHans: "\u4F60\u521B\u5EFA\u7684\u661F\u5EA7\u5C06\u4E22\u5931\u3002\n\u4ECD\u8981\u79BB\u5F00\u5417\uFF1F"
  textJa: "\u4F5C\u3063\u305F\u661F\u5EA7\u304C\u5931\u308F\u308C\u307E\u3059\u3002\n\u305D\u308C\u3067\u3082\u9000\u51FA\u3057\u307E\u3059\u304B\uFF1F"
  textEs: "Se perder\xE1 tu constelaci\xF3n. \n\xBFSalir de todos modos?"
  textPt: "Sua constela\xE7\xE3o ser\xE1 perdida. \nDeseja sair mesmo assim?"
  textRu: "\u0412\u0430\u0448\u0435 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u0435
    \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E.
    \n\u0412\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0432\u044B\u0439\u0442\u0438?"
