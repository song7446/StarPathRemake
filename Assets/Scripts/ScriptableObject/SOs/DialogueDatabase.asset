%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9f347f15addfe4d4bbceb7b49c48e17c, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  dialogues:
  - ID: Chapter_1_Front_1
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uD6CC\uCA4D \uD6CC\uCA4D..."
    Text_En: null
  - ID: Chapter_1_Front_2
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uD6CC\uCA4D..."
    Text_En: null
  - ID: Chapter_1_Front_3
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60..."
    Text_En: null
  - ID: Chapter_1_Front_4
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uC5C4\uB9C8\uB294 \uC5B4\uB514\uAC04\uAC70\uC57C...?"
    Text_En: null
  - ID: Chapter_1_Front_5
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: ...
    Text_En: null
  - ID: Chapter_1_Front_6
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC5C4\uB9C8\uB294 \uC800\uAE30 \uBCC4\uB098\uB77C\uB85C \uAC14\uC5B4"
    Text_En: null
  - ID: Chapter_1_Front_7
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uBCC4\uB098\uB77C?"
    Text_En: null
  - ID: Chapter_1_Front_8
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB798 \uD558\uB298\uC744 \uBD10"
    Text_En: null
  - ID: Chapter_1_Front_9
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC800 \uB9CE\uC740 \uBCC4\uB4E4 \uBCF4\uC774\uC9C0?"
    Text_En: null
  - ID: Chapter_1_Front_10
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC5C4\uB9C8\uB294 \uC800 \uBA40\uB9AC \uB5A0\uB0AC\uC5B4"
    Text_En: null
  - ID: Chapter_1_Front_11
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uB124\uAC00 \uBCF4\uACE0 \uC2F6\uC744 \uB54C\uB9C8\uB2E4 \uC5B8\uC81C\uB4E0
      \uBCFC \uC218 \uC788\uAC8C, \uAC00\uC7A5 \uB192\uC740 \uACF3\uC73C\uB85C."
    Text_En: null
  - ID: Chapter_1_Front_12
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC800\uAE30 \uBC18\uC9DD\uC774\uB294 \uB9CE\uC740 \uBCC4\uB4E4 \uBCF4\uC774\uC9C0?"
    Text_En: null
  - ID: Chapter_1_Front_13
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC5C4\uB9C8\uB294 \uC800 \uBA40\uB9AC\uC11C \uB0B4\uB824\uB2E4\uBCF4\uACE0
      \uC788\uC744\uAC70\uC57C."
    Text_En: null
  - ID: Chapter_1_Front_14
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uC9C4\uC9DC? \uC5C4\uB9C8\uAC00 \uC9C4\uC9DC\uB85C \uB2E4 \uBCF4\uACE0
      \uC788\uC5B4?"
    Text_En: null
  - ID: Chapter_1_Front_15
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB7FC. \uD55C\uBC88 \uCC3E\uC544\uBCFC\uB798?"
    Text_En: null
  - ID: Chapter_1_Front_16
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC544\uBE60\uAC00 \uB3C4\uC640\uC904\uAC8C. \uC800\uAE30 \uC800 \uBCC4\uBD80\uD130
      \uCC9C\uCC9C\uD788 \uB208\uC73C\uB85C \uC120\uC744 \uB530\uB77C\uAC00 \uBCF4\uB294
      \uAC70\uC57C. "
    Text_En: null
  - ID: Chapter_1_Back_1
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uB54C \uC2A4\uCCD0 \uC9C0\uB098\uAC04 \uBC24\uBC14\uB78C\uC740
      \uCC38 \uB530\uB73B\uD588\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_1_Back_2
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC9C0\uAE08, \uB0B4 \uACC1\uC5D0 \uB0A8\uC544\uC788\uB294 \uC628\uAE30\uB294
      \uC544\uBB34\uAC83\uB3C4 \uC5C6\uB2E4."
    Text_En: null
  - ID: Chapter_1_Back_3
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uB0B4 \uC190\uC5D0 \uB369\uADF8\uB7EC\uB2C8 \uB0A8\uACA8\uC9C4 \uC774
      \uB0A1\uC740 \uC218\uCCA9\uACFC, \uC5B4\uB460 \uC18D\uC5D0\uC11C \uC870\uC6A9\uD788
      \uAE38\uC744 \uBE44\uCD94\uB294 \uBCC4\uC790\uB9AC\uB4E4."
    Text_En: null
  - ID: Chapter_1_Back_4
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC774 \uC218\uCCA9\uC5D0 \uB2F4\uAE34 \uBCC4\uB4E4\uC758 \uC120\uC744
      \uD558\uB098\uC529 \uC787\uB2E4 \uBCF4\uBA74"
    Text_En: null
  - ID: Chapter_1_Back_5
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uB0B4\uAC00 \uAC00\uC57C \uD560 \uAE38\uC758 \uB05D\uC5D0 \uB2FF\uC744
      \uC218 \uC788\uC744 \uAC83\uC774\uB77C\uACE0 \uC0DD\uAC01\uD588\uB2E4."
    Text_En: null
  - ID: Chapter_2_Front_1
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uB179\uC774 \uAC00\uB4DD \uC2AC\uC5B4 \uC090\uAC71\uAC70\uB9AC\uB294
      \uD3B8\uC9C0\uD568 \uC55E\uC5D0 \uC130\uB2E4."
    Text_En: null
  - ID: Chapter_2_Front_2
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC190\uC5D0 \uC954 \uC544\uBC84\uC9C0\uC758 \uB0A1\uC740 \uAC00\uC8FD
      \uC218\uCCA9\uC774 \uC720\uB09C\uD788 \uBB34\uAC81\uAC8C \uB290\uAEF4\uC84C\uB2E4."
    Text_En: null
  - ID: Chapter_2_Front_3
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC218\uCCA9 \uC0AC\uC774\uC5D0 \uB07C\uC6CC\uB454, \uBE44\uB6A4\uBE44\uB6A4\uD55C
      \uAE00\uC528\uB85C \uAFB9\uAFB9 \uB20C\uB7EC\uC4F4 \uD3B8\uC9C0\uB97C \uB2E4\uC2DC
      \uD55C\uBC88 \uB9E4\uB9CC\uC84C\uB2E4."
    Text_En: null
  - ID: Chapter_2_Front_4
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC774 \uC218\uCCA9\uC5D0 \uADF8\uB824\uC9C4 \uBCC4\uC790\uB9AC\uC5D0
      \uC544\uBC84\uC9C0\uAC00 \uB0A8\uACA8\uB450\uACE0 \uC628 \uAC83\uB4E4\uC774
      \uC788\uC5B4\uC694."
    Text_En: null
  - ID: Chapter_2_Front_5
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC81C\uBC1C \uC544\uBC84\uC9C0\uAC00 \uBA48\uCDB0 \uC130\uB358 \uADF8
      \uC5B4\uB450\uC6B4 \uACF3\uB4E4\uC744 \uCC3E\uC544\uC8FC\uC138\uC694."
    Text_En: null
  - ID: Chapter_2_Front_6
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uB0B4\uAC00 \uC800\uC9C0\uB978 \uB3CC\uC774\uD0AC \uC218 \uC5C6\uB294
      \uC798\uBABB\uC744 \uBC14\uB85C\uC7A1\uC744 \uC218 \uC788\uB294 \uBC29\uBC95\uC740
      \uC774\uC81C \uC774\uAC83\uBFD0\uC774\uB2E4."
    Text_En: null
  - ID: Chapter_2_Front_7
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uCC28\uAC00\uC6B4 \uCCA0\uBB38\uC774 \uC5F4\uB9AC\uB294 \uC18C\uB9AC\uC640
      \uD568\uAED8, \uC218\uCCA9\uACFC \uD3B8\uC9C0\uB97C \uD3B8\uC9C0\uD568 \uAE4A\uC219\uD55C
      \uACF3\uC73C\uB85C \uBC00\uC5B4 \uB123\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_2_Front_8
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uB204\uAD6C\uB77C\uB3C4 \uC88B\uC73C\uB2C8 \uC81C\uBC1C \uC774 \uD3B8\uC9C0\uB97C
      \uC77D\uACE0 \uADF8 \uD754\uC801\uB4E4\uC744 \uCC3E\uC544\uB0B4 \uC8FC\uAE30\uB97C."
    Text_En: null
  - ID: Chapter_2_Front_9
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC5B4\uB460 \uC18D\uC5D0\uC11C, \uB098\uB294 \uB9C8\uC9C0\uB9C9 \uD76C\uB9DD\uC744
      \uD3B8\uC9C0\uD568\uC5D0 \uBB3B\uC5B4\uB454 \uCC44 \uB3CC\uC544\uC130\uB2E4."
    Text_En: null
  - ID: Chapter_2_Front_10
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uACE0\uAC1C\uB97C \uB4E4\uC5B4 \uBC14\uB77C\uBCF8 \uBC24\uD558\uB298\uC5D0\uB294,
      \uCC28\uAC00\uC6B4 \uB208\uBB3C\uCC98\uB7FC \uC5BC\uC5B4\uBD99\uC740 \uBCC4\uB4E4\uC774
      \uB098\uB97C \uB0B4\uB824\uB2E4\uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_2_Back_1
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uC7A1\uCD08\uAC00 \uBB34\uC131\uD558\uAC8C \uC790\uB780 \uD5C8\uB984\uD55C
      \uC9D1 \uB9C8\uB2F9."
    Text_En: null
  - ID: Chapter_2_Back_2
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uC624\uB7AB\uB3D9\uC548 \uBC29\uCE58\uB41C \uB4EF \uBD89\uC740 \uB179\uC73C\uB85C
      \uB4A4\uB36E\uC778 \uD3B8\uC9C0\uD568 \uC55E\uC5D0 \uC130\uB2E4."
    Text_En: null
  - ID: Chapter_2_Back_3
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uAE30\uBD84 \uB098\uC05C \uAE08\uC18D \uB9C8\uCC30\uC74C\uC744 \uB0B4\uBA70
      \uC090\uAC71\uAC70\uB9AC\uB294 \uD3B8\uC9C0\uD568 \uBB38\uC744 \uC5F4\uC790"
    Text_En: null
  - ID: Chapter_2_Back_4
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uD034\uD034\uD55C \uBA3C\uC9C0 \uB0C4\uC0C8\uC640 \uD568\uAED8 \uBC14\uB2E5\uC5D0
      \uB369\uADF8\uB7EC\uB2C8 \uB193\uC778 \uAC00\uC8FD \uC218\uCCA9 \uD558\uB098\uAC00
      \uBCF4\uC600\uB2E4."
    Text_En: null
  - ID: Chapter_2_Back_5
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uC218\uCCA9\uC744 \uAEBC\uB0B4 \uB4E4\uC790, \uBE5B\uBC14\uB79C \uC885\uC774
      \uC0AC\uC774\uC5D0\uC11C \uBE44\uB6A4\uBE44\uB6A4\uD55C \uAE00\uC528\uB85C
      \uC801\uD78C \uD3B8\uC9C0 \uD55C \uC7A5\uC774 \uD22D \uB5A8\uC5B4\uC84C\uB2E4."
    Text_En: null
  - ID: Chapter_2_Back_6
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uC774 \uC218\uCCA9\uC5D0 \uADF8\uB824\uC9C4 \uBCC4\uC790\uB9AC \uC120
      \uB05D\uC5D0\uB294, \uC544\uBC84\uC9C0\uAC00 \uB0A8\uACA8\uB450\uACE0 \uC628
      \uAC83\uB4E4\uC774 \uC788\uC5B4\uC694..."
    Text_En: null
  - ID: Chapter_2_Back_7
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uC2E0\uACE0\uB97C \uBC1B\uACE0 \uCD9C\uB3D9\uD55C \uC774 \uAE30\uBB18\uD55C
      \uD604\uC7A5\uC5D0\uC11C"
    Text_En: null
  - ID: Chapter_2_Back_8
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uC6B0\uB9AC\uAC00 \uC190\uC5D0 \uC954 \uC720\uC77C\uD55C \uB2E8\uC11C\uB294
      \uACE0\uC791 \uBBF8\uCE5C \uC790\uC758 \uB099\uC11C \uAC19\uC740 \uBCC4\uC790\uB9AC
      \uC218\uCCA9\uBFD0\uC774\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_2_Back_9
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uBC18\uC7A5\uB2D8, \uC124\uB9C8 \uC9C4\uC9DC\uB85C \uC774 \uD669\uB2F9\uD55C
      \uD3B8\uC9C0 \uB0B4\uC6A9\uC744 \uBBFF\uACE0 \uC218\uC0AC\uB97C \uC2DC\uC791\uD558\uC2DC\uB824\uB294
      \uAC74 \uC544\uB2C8\uC8E0?"
    Text_En: null
  - ID: Chapter_2_Back_10
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uB4A4\uC5D0\uC11C \uB4E4\uB824\uC624\uB294 \uD6C4\uC784\uC758 \uD68C\uC758\uC801\uC778
      \uBAA9\uC18C\uB9AC\uB97C \uB4A4\uB85C \uD55C \uCC44, \uB098\uB294 \uC218\uCCA9\uC758
      \uB0A1\uC740 \uD45C\uC9C0\uB97C \uCC9C\uCC9C\uD788 \uC4F8\uC5B4\uB0B4\uB838\uB2E4."
    Text_En: null
  - ID: Chapter_2_Back_11
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uB3D9\uB8CC\uB4E4\uC758 \uB9D0\uB300\uB85C \uC774\uC131\uC801\uC73C\uB85C\uB294
      \uB3C4\uC800\uD788 \uB9D0\uC774 \uC548 \uB418\uB294 \uD5C8\uBB34\uB9F9\uB791\uD55C
      \uC18C\uB9AC\uB2E4."
    Text_En: null
  - ID: Chapter_2_Back_12
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uD558\uC9C0\uB9CC \uAE30\uBB18\uD558\uB9AC\uB9CC\uCE58 \uCC28\uAC11\uAC8C
      \uB0B4\uB824\uC549\uC740 \uC8FC\uBCC0\uC758 \uACF5\uAE30\uC640,"
    Text_En: null
  - ID: Chapter_2_Back_13
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uB0B4 \uC190\uB05D\uBC14\uB2E5\uC5D0 \uB2FF\uB294 \uC218\uCCA9\uC758
      \uBB35\uC9C1\uD55C \uCD09\uAC10\uC740 \uC790\uAFB8\uB9CC \uBD88\uAE38\uD55C
      \uD655\uC2E0\uC744 \uCDA9\uB3D9\uC9C8\uD558\uACE0 \uC788\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_2_Back_14
    Chapter_Id: 2_Back
    Speaker: Player
    Text_Kr: "\uADF8\uB807\uAC8C \uC6B0\uB9AC\uB294, \uD558\uB298\uC758 \uBCC4\uC790\uB9AC\uB97C
      \uB098\uCE68\uBC18 \uC0BC\uC544 \uD754\uC801\uC744 \uCAD3\uB294 \uC774 \uAE30\uBB18\uD55C
      \uC218\uC0AC\uC5D0 \uCCAB\uBC1C\uC744 \uB0B4\uB514\uB3A0\uB2E4."
    Text_En: null
  - ID: Chapter_3_Front_1
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB294 \uBC24\uB9C8\uB2E4 \uB098\uB97C \uCC28\uC5D0 \uD0DC\uC6B0\uACE0
      \uBCC4\uC744 \uBCF4\uB7EC \uB098\uC130\uB2E4."
    Text_En: null
  - ID: Chapter_3_Front_2
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC5B4\uB460\uC774 \uAE54\uB9B0 \uC870\uC218\uC11D \uCC3D\uAC00\uC5D0
      \uC774\uB9C8\uB97C \uAE30\uB304 \uCC44"
    Text_En: null
  - ID: Chapter_3_Front_3
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC18C\uB9AC \uC5C6\uC774 \uD750\uB974\uB294 \uCC3D\uBC16\uC758 \uD48D\uACBD\uC744
      \uC751\uC2DC\uD588\uB2E4."
    Text_En: null
  - ID: Chapter_3_Front_4
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC5B4\uB460 \uC18D\uC5D0\uC11C, \uBCC4\uB4E4\uC740 \uC6B0\uB9AC\uC640
      \uB098\uB780\uD788 \uB2EC\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_3_Front_5
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60, \uC800\uAE30 \uC880 \uBD10. \uC624\uB298\uB3C4 \uBCC4\uB4E4\uC774
      \uC6B0\uB9AC\uB97C \uB530\uB77C\uC624\uACE0 \uC788\uC5B4."
    Text_En: null
  - ID: Chapter_3_Front_6
    Chapter_Id: 3_Front
    Speaker: Father
    Text_Kr: "\uC544\uB2C8\uB780\uB2E4. \uC800 \uBCC4\uB4E4\uC740 \uC6B0\uB9AC\uB97C
      \uB530\uB77C\uC624\uACE0 \uC788\uB294 \uAC8C \uC544\uB2C8\uC57C."
    Text_En: null
  - ID: Chapter_3_Front_7
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC5B4? \uC9C4\uC9DC\uB85C \uAC19\uC774 \uB2EC\uB9AC\uACE0 \uC788\uC796\uC544."
    Text_En: null
  - ID: Chapter_3_Front_8
    Chapter_Id: 3_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB0E5 \uADF8\uB807\uAC8C \uBCF4\uC774\uB294 \uAC83 \uBFD0\uC774\uC57C."
    Text_En: null
  - ID: Chapter_3_Front_9
    Chapter_Id: 3_Front
    Speaker: Father
    Text_Kr: "\uC800 \uBCC4\uB4E4\uC740 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294\uB2E8\uB2E4.
      \uADF8\uB0E5 \uC800 \uC790\uB9AC\uC5D0 \uAC00\uB9CC\uD788 \uC11C \uC788\uB294
      \uAC70\uC57C."
    Text_En: null
  - ID: Chapter_3_Front_10
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294\uB2E4\uACE0? \uC65C?"
    Text_En: null
  - ID: Chapter_3_Front_11
    Chapter_Id: 3_Front
    Speaker: Father
    Text_Kr: "\uBC24\uAE38\uC744 \uAC77\uB294 \uC0AC\uB78C\uB4E4\uC774 \uAE38\uC744
      \uC783\uC9C0 \uC54A\uB3C4\uB85D \uC5B8\uC81C\uB098 \uAC19\uC740 \uC790\uB9AC\uC5D0\uC11C
      \uAE30\uB2E4\uB824\uC8FC\uB294 \uAC70\uC9C0."
    Text_En: null
  - ID: Chapter_3_Front_12
    Chapter_Id: 3_Front
    Speaker: Father
    Text_Kr: "\uC544\uBB34\uB9AC \uC5B4\uB450\uC6CC\uB3C4 \uBCC4\uC744 \uB530\uB77C\uAC00\uBA74
      \uACB0\uAD6D \uBAA9\uC801\uC9C0\uC5D0 \uB2FF\uC744 \uC218 \uC788\uAC8C"
    Text_En: null
  - ID: Chapter_3_Front_13
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB294 \uB0B4\uAC00 \uBCC4\uB4E4\uC744 \uB354 \uC790\uC138\uD788
      \uBCFC \uC218 \uC788\uB3C4\uB85D \uCC28\uB97C \uC644\uC804\uD788 \uAE38\uAC00\uC5D0
      \uBD99\uC5EC \uC138\uC6CC\uC8FC\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_3_Front_14
    Chapter_Id: 3_Front
    Speaker: Father
    Text_Kr: "\uC800\uAE30 \uD558\uB298\uC744 \uBCF4\uB834. \uAD6D\uC790 \uBAA8\uC591\uCC98\uB7FC
      \uC0DD\uAE34 \uC791\uC740\uACF0\uC790\uB9AC\uAC00 \uBCF4\uC774\uC9C0?"
    Text_En: null
  - ID: Chapter_3_Front_15
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC5B4, \uC800\uAE30 \uC870\uADF8\uB9E3\uAC8C \uBAA8\uC5EC\uC788\uB294
      \uBCC4\uB4E4?"
    Text_En: null
  - ID: Chapter_3_Front_16
    Chapter_Id: 3_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB798."
    Text_En: null
  - ID: Chapter_3_Front_17
    Chapter_Id: 3_Front
    Speaker: Father
    Text_Kr: "\uC61B\uB0A0 \uC0AC\uB78C\uB4E4\uC740 \uAE38\uC744 \uC783\uC5C8\uC744
      \uB54C \uC800 \uC791\uC740\uACF0\uC790\uB9AC\uC758 \uAC00\uC7A5 \uB05D\uC5D0
      \uC788\uB294 \uBCC4\uC744 \uBCF4\uACE0 \uBC29\uD5A5\uC744 \uCC3E\uC558\uB2E8\uB2E4."
    Text_En: null
  - ID: Chapter_3_Front_18
    Chapter_Id: 3_Front
    Speaker: Father
    Text_Kr: "\uC800\uAE30 \uC870\uC6A9\uD788 \uC790\uB9AC\uB97C \uC9C0\uD0A4\uACE0
      \uC788\uB294 \uC791\uC740\uACF0\uC790\uB9AC\uB97C \uB208\uC73C\uB85C \uD55C
      \uBC88 \uC774\uC5B4\uBCFC\uB798?"
    Text_En: null
  - ID: Chapter_3_Back_1
    Chapter_Id: 3_Back
    Speaker: Player
    Text_Kr: "\uBD89\uACE0 \uD478\uB978 \uACBD\uAD11\uB4F1 \uBD88\uBE5B\uC774 \uBC24\uAE38\uC744
      \uAC70\uCE60\uAC8C \uC9D1\uC5B4\uC0BC\uD0A4\uBA70, \uACBD\uCC30\uCC28\uB294
      \uC5B4\uB460 \uC18D\uC73C\uB85C \uBBF8\uB044\uB7EC\uC838 \uB4E4\uC5B4\uAC14\uB2E4."
    Text_En: null
  - ID: Chapter_3_Back_2
    Chapter_Id: 3_Back
    Speaker: Player
    Text_Kr: "\uB2EC\uB9AC\uB294 \uCC28 \uC548\uC5D0\uC11C, \uB098\uB294 \uC870\uC218\uC11D\uC5D0
      \uB193\uC778 \uB0A1\uC740 \uC218\uCCA9\uC744 \uB2E4\uC2DC \uD55C\uBC88 \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
    Text_En: null
  - ID: Chapter_3_Back_3
    Chapter_Id: 3_Back
    Speaker: Player
    Text_Kr: "\uC0AC\uAC74\uC758 \uC720\uC77C\uD55C \uB2E8\uC11C\uAC00 \uACE0\uC791
      \uC774\uB7F0 \uC218\uCCA9\uC774\uB77C\uB2C8."
    Text_En: null
  - ID: Chapter_3_Back_4
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uBC18\uC7A5\uB2D8, \uC9C4\uC9DC\uB85C \uC774 \uC218\uCCA9\uC5D0 \uADF8\uB824\uC9C4
      \uBCC4\uC790\uB9AC \uB530\uB77C\uAC00\uBA74 \uBB50\uAC00 \uB098\uC628\uB2F5\uB2C8\uAE4C?
      \uC194\uC9C1\uD788 \uB9D0\uB3C4 \uC548 \uB418\uC796\uC544\uC694."
    Text_En: null
  - ID: Chapter_3_Back_5
    Chapter_Id: 3_Back
    Speaker: Player
    Text_Kr: "\uC6B4\uC804\uB300\uB97C \uC7A1\uC740 \uD6C4\uC784\uC758 \uD22C\uB35C\uAC70\uB9BC\uC5D0
      \uB098\uB294 \uB300\uB2F5 \uB300\uC2E0 \uCC3D\uBC16\uC758 \uC5B4\uB460\uC744
      \uC751\uC2DC\uD588\uB2E4."
    Text_En: null
  - ID: Chapter_3_Back_6
    Chapter_Id: 3_Back
    Speaker: Player
    Text_Kr: "\uB3D9\uB8CC\uB4E4\uC758 \uB9D0\uB300\uB85C \uD5C8\uBB34\uB9F9\uB791\uD55C
      \uC18C\uB9AC\uB2E4. \uBBF8\uCE5C \uC790\uC758 \uD5DB\uC18C\uB9AC\uAC70\uB098,
      \uC9C0\uB3C5\uD55C \uC7A5\uB09C\uC9C8\uC774 \uBD84\uBA85\uD588\uB2E4."
    Text_En: null
  - ID: Chapter_3_Back_7
    Chapter_Id: 3_Back
    Speaker: Player
    Text_Kr: "\uACFC\uD559\uC801\uC778 \uC99D\uAC70\uB3C4, \uD655\uC2E4\uD55C \uBAA9\uACA9\uC790\uB3C4
      \uC5C6\uC774 \uADF8\uC800 \uD558\uB298\uC758 \uBCC4\uC790\uB9AC\uB97C \uB098\uCE68\uBC18
      \uC0BC\uC544 \uD558\uAC8C \uB41C \uC218\uC0AC."
    Text_En: null
  - ID: Chapter_3_Back_8
    Chapter_Id: 3_Back
    Speaker: Player
    Text_Kr: "\uC9C4\uC9DC \uC800 \uC5B4\uB460 \uC18D\uC5D0 \uBB34\uC5B8\uAC00 \uBB3B\uD600
      \uC788\uAE30\uB294 \uD55C \uAC78\uAE4C\uB77C\uACE0 \uC0DD\uAC01\uD55C \uC21C\uAC04
      \uB2E4\uB978 \uACF3\uC73C\uB85C \uAC04 \uD300\uC758 \uBB34\uC804\uC774 \uB4E4\uB824\uC654\uB2E4."
    Text_En: null
  - ID: Chapter_3_Back_9
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC9C0\uC9C0\uC9C1\u2014  \uC5EC\uAE30\uB294 \uC218\uC0C9 2\uD300,
      \uCCAB \uBC88\uC9F8 \uC88C\uD45C \uB3C4\uB2EC \uD604\uC7A5 \uD655\uBCF4\uD588\uC2B5\uB2C8\uB2E4.
      \uD3B8\uC9C0\uC758 \uB0B4\uC6A9\uB300\uB85C \uC2DC\uCCB4\uB97C \uCC3E\uC558\uC2B5\uB2C8\uB2E4."
    Text_En: null
  - ID: Chapter_4_Front_1
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uCE60\uD751 \uAC19\uC740 \uC5B4\uB460\uC774 \uAE54\uB9B0 \uC232\uC18D,
      \uB098\uBB47\uAC00\uC9C0\uC5D0 \uAE01\uD788\uBA70 \uC544\uBC84\uC9C0\uB97C
      \uBAB0\uB798 \uB4A4\uCAD3\uC558\uB2E4."
    Text_En: null
  - ID: Chapter_4_Front_2
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uC228\uC774 \uD131 \uB05D\uAE4C\uC9C0 \uCC28\uC62C\uB790\uC744 \uB54C,
      \uC544\uBC84\uC9C0\uB294 \uBC24\uD558\uB298\uC758 \uBCC4\uB4E4\uC744 \uC62C\uB824\uB2E4\uBCF4\uBA70
      \uB9C8\uCE68\uB0B4 \uAC78\uC74C\uC744 \uBA48\uCDC4\uB2E4."
    Text_En: null
  - ID: Chapter_4_Front_3
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uADF8\uB9AC\uACE0 \uC190\uC5D0 \uC954 \uBB34\uAC70\uC6B4 \uC0BD\uC744
      \uB4E4\uC5B4 \uAD73\uC740 \uB545\uC744 \uAC70\uCE60\uAC8C \uD30C\uD5E4\uCE58\uAE30
      \uC2DC\uC791\uD588\uB2E4."
    Text_En: null
  - ID: Chapter_4_Front_4
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uC870\uC6A9\uD55C \uC0B0\uC18D\uC5D0 \uC6B8\uB824 \uD37C\uC9C0\uB294
      \uC12C\uB729\uD55C \uC0BD\uC9C8 \uC18C\uB9AC."
    Text_En: null
  - ID: Chapter_4_Front_5
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uC5B8\uC820\uAC00\uBD80\uD130 \uC544\uBC84\uC9C0\uB294 \uB298 \uC815\uCCB4
      \uBAA8\uB97C \uD759\uBA3C\uC9C0\uB97C \uB4A4\uC9D1\uC5B4\uC4F4 \uCC44 \uBC24\uB2A6\uAC8C
      \uB3CC\uC544\uC624\uACE4 \uD588\uB2E4."
    Text_En: null
  - ID: Chapter_4_Front_6
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uD558\uB298\uC758 \uBCC4\uC790\uB9AC\uB97C \uB098\uCE68\uBC18 \uC0BC\uC544
      \uCC3E\uC544\uC628 \uC774 \uC5B4\uB450\uC6B4 \uB545 \uBC11\uC5D0,"
    Text_En: null
  - ID: Chapter_4_Front_7
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBC84\uC9C0\uAC00 \uD56D\uC0C1 \uBB3B\uC5B4\uB450\uB358 \uCC28\uAC00\uC6B4
      \uBE44\uBC00\uC774 \uBB34\uC5C7\uC778\uC9C0 \uC774\uC81C\uB294 \uB611\uB611\uD788
      \uC54C \uAC83 \uAC19\uC558\uB2E4."
    Text_En: null
  - ID: Chapter_4_Front_8
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uC5C4\uB9C8\uC640 \uB098\uB97C \uC601\uC6D0\uD788 \uAC08\uB77C\uB193\uC740
      \uAD34\uBB3C."
    Text_En: null
  - ID: Chapter_4_Front_9
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBC84\uC9C0\uB294 \uC774\uC81C \uB354\uC774\uC0C1 \uB0B4\uAC00
      \uC54C\uB358 \uB2E4\uC815\uD55C \uC0AC\uB78C\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_4_Front_10
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uACE0\uAC1C\uB97C \uB4E4\uC5B4 \uC544\uBC84\uC9C0\uAC00 \uBC14\uB77C\uBCF4\uB358
      \uBC24\uD558\uB298\uC744 \uC62C\uB824\uB2E4\uBCF4\uC558\uB2E4."
    Text_En: null
  - ID: Chapter_4_Front_11
    Chapter_Id: 4_Front
    Speaker: Daughter
    Text_Kr: "\uADF8\uACF3\uC5D0\uB294 \uB9C8\uCE58 \uB450 \uC0AC\uB78C \uC0AC\uC774\uB97C
      \uC794\uC778\uD558\uAC8C \uAC00\uB85C\uB9C9\uACE0 \uC120 \uAC70\uB300\uD55C
      \uBC40\uCC98\uB7FC, \uCC28\uAC00\uC6B4 \uBCC4\uB4E4\uC774 \uB465\uAE00\uAC8C
      \uB3C4\uC0AC\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_4_Back_1
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC815\uC2E0\uC744 \uCC28\uB838\uC744 \uB54C, \uB0B4 \uC190\uC5D0 \uC950\uC5EC\uC838
      \uC788\uB358 \uAC83\uC740 \uC544\uBC84\uC9C0\uAC00 \uB4E4\uACE0 \uC788\uB358
      \uBB34\uAC70\uC6B4 \uC0BD\uC774\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_4_Back_2
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uBC1C\uBC11\uC5D0 \uC4F0\uB7EC\uC9C4 \uC544\uBC84\uC9C0\uB294 \uB354
      \uC774\uC0C1 \uC544\uBB34\uB7F0 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_4_Back_3
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC5B8\uC81C\uB098 \uB098\uB97C \uB2E4\uC815\uD558\uAC8C \uBD88\uB7EC\uC8FC\uB358
      \uC544\uBE60\uC758 \uBAA9\uC18C\uB9AC\uB3C4, \uBC24\uC0C8 \uC232\uC744 \uD5E4\uC9D1\uB358
      \uADF8 \uC12C\uB729\uD55C \uC0BD\uC9C8 \uC18C\uB9AC\uB3C4, \uD55C\uC21C\uAC04\uC5D0
      \uBA48\uCDB0\uBC84\uB838\uB2E4."
    Text_En: null
  - ID: Chapter_4_Back_4
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC190\uBC14\uB2E5\uC744 \uD0C0\uACE0 \uD758\uB7EC\uB0B4\uB9AC\uB294
      \uCD95\uCD95\uD558\uACE0 \uB728\uAC70\uC6B4 \uC561\uCCB4\uAC00 \uC0DD\uC0DD\uD55C
      \uD604\uC2E4\uC744 \uC77C\uAE68\uC6E0\uB2E4."
    Text_En: null
  - ID: Chapter_4_Back_5
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB0B4\uAC00 \uAD34\uBB3C\uC744 \uC8FD\uC778 \uAC78\uAE4C, \uC544\uB2C8\uBA74
      \uB0B4\uAC00 \uC9C4\uC9DC \uAD34\uBB3C\uC774 \uB418\uC5B4\uBC84\uB9B0 \uAC78\uAE4C."
    Text_En: null
  - ID: Chapter_4_Back_6
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB3CC\uC774\uD0AC \uC218 \uC5C6\uB294 \uC798\uBABB\uC744 \uC800\uC9C8\uB800\uB2E4\uB294
      \uACF5\uD3EC\uAC00 \uC628\uBAB8\uC744 \uC9D3\uB20C\uB800\uC9C0\uB9CC, \uC2DC\uAC04\uC740
      \uB098\uB97C \uAE30\uB2E4\uB824\uC8FC\uC9C0 \uC54A\uC558\uB2E4."
    Text_En: null
  - ID: Chapter_4_Back_7
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uB5A8\uB9AC\uB294 \uC190\uC73C\uB85C \uC544\uBC84\uC9C0\uAC00
      \uAC00\uC9C0\uACE0 \uC788\uB358 \uB0A1\uC740 \uC218\uCCA9\uC744 \uD488\uC5D0
      \uC464\uC154 \uB123\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_4_Back_8
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uB9AC\uACE0 \uC544\uBC84\uC9C0\uAC00 \uC4F0\uB7EC\uC9C4 \uADF8
      \uC790\uB9AC"
    Text_En: null
  - ID: Chapter_4_Back_9
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC6A9\uC758 \uBCC4\uC790\uB9AC\uAC00 \uCC28\uAC11\uAC8C \uB0B4\uB824\uB2E4\uBCF4\uB294
      \uC774 \uC5B4\uB450\uC6B4 \uB545 \uBC11\uC5D0,"
    Text_En: null
  - ID: Chapter_4_Back_10
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC774\uBC88\uC5D0\uB294 \uB0B4\uAC00 \uC9C1\uC811 \uCC28\uAC00\uC6B4
      \uBE44\uC744 \uBB3B\uC5B4\uC57C\uB9CC \uD588\uB2E4."
    Text_En: null
  - ID: Chapter_4_Back_11
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBC84\uC9C0\uAC00 \uADF8\uB7AC\uB358 \uAC83\uCC98\uB7FC, \uC774
      \uBB34\uAC70\uC6B4 \uC0BD\uC744 \uB4E4\uACE0\uC11C."
    Text_En: null
  - ID: Chapter_5_Front_1
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB0B4\uAC8C\uB3C4 \uBC24\uD558\uB298\uC758 \uBCC4\uB4E4\uC744 \uB9DD\uC6D0\uACBD\uC5D0
      \uB2F4\uC73C\uBA70, \uC6B0\uC8FC\uC758 \uBE44\uBC00\uC744 \uBC1D\uD788\uACA0\uB2E4\uB358
      \uCC2C\uB780\uD55C \uAFC8\uC774 \uC788\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_5_Front_2
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uBCC4\uB4E4\uC758 \uADA4\uC801\uC744 \uCAD3\uC544 \uC88C\uD45C\uB97C
      \uADF8\uB9AC\uB358 \uADF8 \uC2DC\uC808\uC740 \uB0B4 \uC0DD\uC560 \uAC00\uC7A5
      \uC21C\uC218\uD558\uAC8C \uBE5B\uB098\uB358 \uC21C\uAC04\uC774\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_5_Front_3
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uD558\uC9C0\uB9CC \uAC00\uB09C\uC740 \uC794\uC778\uD588\uACE0"
    Text_En: null
  - ID: Chapter_5_Front_4
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB0B4\uAC00 \uC9C0\uCF1C\uC57C \uD560 \uAC00\uC871\uC758 \uBB34\uAC8C\uB294
      \uBC24\uD558\uB298\uC758 \uADF8 \uC5B4\uB5A4 \uBCC4\uBCF4\uB2E4 \uBB34\uAC70\uC6E0\uB2E4"
    Text_En: null
  - ID: Chapter_5_Front_5
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uACB0\uAD6D \uB098\uB294 \uB9DD\uC6D0\uACBD\uC744 \uC811\uACE0, \uC138\uC0C1\uC5D0\uC11C
      \uAC00\uC7A5 \uC5B4\uB450\uC6B4 \uBC14\uB2E5\uC744 \uC120\uD0DD\uD588\uB2E4."
    Text_En: null
  - ID: Chapter_5_Front_6
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC544\uBB34\uB3C4 \uCC3E\uC9C0 \uBABB\uD558\uB294 \uAE4A\uC740 \uC0B0\uC18D"
    Text_En: null
  - ID: Chapter_5_Front_7
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "GPS\uC870\uCC28 \uD130\uC9C0\uC9C0 \uC54A\uB294 \uCE60\uD751 \uAC19\uC740
      \uC5B4\uB460 \uC18D\uC5D0\uC11C \uC644\uBCBD\uD558\uAC8C \uC2DC\uCCB4\uB97C
      \uBB3B\uC5B4\uC8FC\uB294 \uC77C"
    Text_En: null
  - ID: Chapter_5_Front_8
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB0A8\uB4E4\uC740 \uAE38\uC744 \uC783\uACE0 \uD5E4\uB9E4\uB294 \uADF8
      \uACF5\uD3EC\uC758 \uC232\uC18D\uC5D0\uC11C"
    Text_En: null
  - ID: Chapter_5_Front_9
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC5ED\uC124\uC801\uC774\uAC8C\uB3C4 \uB098\uC758 \uCC9C\uBB38\uD559\uC801
      \uC9C0\uC2DD\uC740 \uBE5B\uC744 \uBC1C\uD588\uB2E4."
    Text_En: null
  - ID: Chapter_5_Front_10
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uBC24\uD558\uB298\uC758 \uBCC4\uC790\uB9AC\uB97C \uB098\uCE68\uBC18
      \uC0BC\uC544 \uB545\uC758 \uC815\uD655\uD55C \uC88C\uD45C\uB97C \uCC3E\uC544\uB0B4\uACE0"
    Text_En: null
  - ID: Chapter_5_Front_11
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uD754\uC801\uB3C4 \uC5C6\uC774 \uC2DC\uCCB4\uB97C \uC740\uBC00\uD558\uAC8C
      \uCE58\uC6CC\uC8FC\uB294 \uAC83"
    Text_En: null
  - ID: Chapter_5_Front_12
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uADF8\uAC83\uC774 \uB0B4\uAC00 \uC624\uB79C\uC2DC\uAC04 \uACF5\uBD80\uD55C
      \uACB0\uC2E4\uC774\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_5_Front_13
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB0B4\uAC00 \uADF8\uB9B0 \uBCC4\uC790\uB9AC\uC758 \uC120 \uB05D\uC774
      \uD5A5\uD558\uB294 \uACF3\uC740"
    Text_En: null
  - ID: Chapter_5_Front_14
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC774\uC81C \uC6B0\uC8FC\uC758 \uC2E0\uBE44\uAC00 \uC544\uB2C8\uB77C
      \uCC28\uAC00\uC6B4 \uC2DC\uCCB4\uB4E4\uC774 \uBB3B\uD790 \uBB34\uB364\uC758
      \uC88C\uD45C\uC600\uB2E4."
    Text_En: null
  - ID: Chapter_5_Back_1
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC544\uB0B4\uC758 \uC9C0\uB3C5\uD55C \uBCD1\uB9C8\uB97C \uACE0\uCE58\uB2E4\uBCF4\uB2C8
      \uAC10\uB2F9\uD560 \uC218 \uC5C6\uC744 \uB9CC\uD07C\uC758 \uBE5A\uC774 \uC313\uC5EC\uAC14\uB2E4"
    Text_En: null
  - ID: Chapter_5_Back_2
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC544\uBB34\uB9AC \uBC24\uD558\uB298\uC744 \uBCF4\uBA70 \uBB34\uB364\uC758
      \uC88C\uD45C\uB97C \uCC0D\uACE0 \uC2DC\uCCB4\uB97C \uCE58\uC6CC\uB3C4 \uBE5A\uC740
      \uC904\uC5B4\uB4E4\uC9C0 \uC54A\uC558\uC9C0\uB9CC"
    Text_En: null
  - ID: Chapter_5_Back_3
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC5B4\uB5BB\uAC8C\uB4E0 \uB098\uC544\uC9C8 \uAC83\uC774\uB77C\uB294
      \uD76C\uB9DD\uC744 \uC548\uACE0 \uD558\uB8E8\uD558\uB8E8 \uBC84\uD168\uB098\uAC14\uC5C8\uB2E4. "
    Text_En: null
  - ID: Chapter_5_Back_4
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uD558\uC9C0\uB9CC \uC544\uB0B4\uAC00 \uACB0\uAD6D \uBC84\uD2F0\uC9C0
      \uBABB\uD558\uACE0 \uCC28\uAC11\uAC8C \uC8FD\uC5B4\uBC84\uB9B0 \uADF8\uB0A0"
    Text_En: null
  - ID: Chapter_5_Back_5
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB0B4 \uC548\uC744 \uACA8\uC6B0 \uC9C0\uD0F1\uD558\uB358 \uB9C8\uC9C0\uB9C9
      \uC774\uC131\uC758 \uBB38\uC774 \uCC98\uCC38\uD558\uAC8C \uBD80\uC11C\uC838
      \uB0B4\uB838\uB2E4"
    Text_En: null
  - ID: Chapter_5_Back_6
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB0A8\uC740 \uAC83\uC740 \uC544\uB0B4\uB97C \uC9C0\uD0A4\uC9C0 \uBABB\uD588\uB2E4\uB294
      \uC9C0\uB3C5\uD55C \uBB34\uB825\uAC10"
    Text_En: null
  - ID: Chapter_5_Back_7
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uADF8\uB9AC\uACE0 \uC138\uC0C1\uC5D0 \uD640\uB85C \uB0A8\uACA8\uC9C4
      \uB0B4 \uB538\uBFD0\uC774\uC5C8\uB2E4"
    Text_En: null
  - ID: Chapter_5_Back_8
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB354\uB294 \uC120\uC744 \uC9C0\uD0A4\uB294 \uC2AC\uD514 \uB530\uC704\uC5D0
      \uC8FC\uC800\uD560 \uC2DC\uAC04\uC774 \uC5C6\uC5C8\uB2E4"
    Text_En: null
  - ID: Chapter_5_Back_9
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC5B4\uB5BB\uAC8C\uB4E0 \uC774 \uB054\uCC0D\uD55C \uBE5A\uB354\uBBF8\uB97C
      \uCCAD\uC0B0\uD558\uACE0"
    Text_En: null
  - ID: Chapter_5_Back_10
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uD558\uB098 \uB0A8\uC740 \uB0B4 \uB538\uB9CC\uD07C\uC740 \uB0A8\uBD80\uB7FD\uC9C0
      \uC54A\uAC8C \uBC88\uB4EF\uD558\uAC8C \uD0A4\uC6CC\uB0B4\uC57C\uB9CC \uD588\uB2E4"
    Text_En: null
  - ID: Chapter_5_Back_11
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uADF8\uAC83\uC774 \uB0B4\uAC8C \uB0A8\uC740 \uC720\uC77C\uD55C \uBCC4\uC774\uC5C8\uB2E4"
    Text_En: null
  - ID: Chapter_5_Back_12
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uB354 \uB9CE\uC740 \uB3C8\uC744 \uBC8C\uAE30 \uC704\uD574"
    Text_En: null
  - ID: Chapter_5_Back_13
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC2A4\uC2A4\uB85C \uBC24\uD558\uB298\uC758 \uC2E0\uC774 \uB418\uC5B4
      \uC9C1\uC811 \uBCC4\uC790\uB9AC\uB97C \uB9CC\uB4E4\uAE30\uB85C \uD588\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_1
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uAC00 \uC5C4\uB9C8\uC758 \uC8FD\uC74C\uC744 \uC774\uC57C\uAE30
      \uD574\uC900 \uB0A0 \uB098\uB294 \uC8FD\uC74C\uC774 \uBB34\uC5C7\uC778\uC9C0
      \uC870\uCC28 \uC54C\uC9C0 \uBABB\uD588\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_2
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uB9DD\uC6D0\uACBD \uB108\uBA38\uB85C \uBCC4\uC744 \uBCF4\uB358 \uC544\uBC84\uC9C0\uB294
      \uC5C4\uB9C8\uAC00 \uD558\uB298\uC758 \uAC00\uC7A5 \uBE5B\uB098\uB294 \uBCC4\uC774
      \uB418\uC5C8\uB2E4\uACE0 \uD588\uACE0"
    Text_En: null
  - ID: Chapter_6_Front_3
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uADF8 \uB9D0\uC744 \uC21C\uC9C4\uD558\uAC8C \uBBFF\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_4
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uC800 \uB192\uC740 \uBC24\uD558\uB298\uB85C \uC62C\uB77C\uAC00 \uC5C4\uB9C8\uB97C
      \uB2E4\uC2DC \uB9CC\uB098\uB294 \uAC83"
    Text_En: null
  - ID: Chapter_6_Front_5
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uADF8 \uB2E4\uC815\uD55C \uBAA9\uC18C\uB9AC\uB97C \uD55C \uBC88\uB9CC\uC774\uB77C\uB3C4
      \uB2E4\uC2DC \uB4E3\uB294 \uAC83"
    Text_En: null
  - ID: Chapter_6_Front_6
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uADF8\uAC83\uC774 \uB0B4 \uC5B4\uB9B0 \uC0B6\uC758 \uC720\uC77C\uD55C
      \uC774\uC815\uD45C\uC600\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_7
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uC870\uAE08 \uB354 \uC790\uB77C \uC138\uC0C1\uC758 \uC794\uC778\uD568\uC744
      \uC54C\uAC8C \uB418\uC5C8\uC744 \uB54C"
    Text_En: null
  - ID: Chapter_6_Front_8
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uB0B4 \uBCC4\uC790\uB9AC\uB294 \uAEBC\uC84C\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_9
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uC5B4\uB838\uC744 \uB54C \uB098\uC5D0\uAC8C \uC544\uBE60\uB294 \uBC24\uD558\uB298\uC758
      \uC2E0\uC774\uC5C8\uC9C0\uB9CC "
    Text_En: null
  - ID: Chapter_6_Front_10
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uC54C\uACE0\uBCF4\uB2C8 \uBCC4\uC790\uB9AC \uBC11\uC5D0 \uC0AC\uB78C\uB4E4\uC744
      \uD55C\uBA85\uC529 \uBB3B\uC5B4\uBC84\uB9AC\uB294 \uAD34\uBB3C\uC774\uC5C8\uB2E4"
    Text_En: null
  - ID: Chapter_6_Front_11
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uB0B4\uAC00 \uD560 \uC218 \uC788\uB294 \uC77C\uC740 \uC774\uC81C \uB05D\uB0AC\uB2E4. "
    Text_En: null
  - ID: Chapter_6_Front_12
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uAD34\uBB3C\uC744 \uBA48\uCDB0\uC138\uC6E0\uACE0 \uC5B4\uB460 \uC18D\uC5D0
      \uAC07\uD600\uC788\uB358 \uC9C4\uC2E4\uC744 \uC138\uC0C1\uC5D0 \uB358\uC84C\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_13
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uC774\uC81C\uB294 \uC2E0\uD654\uB97C \uB530\uB77C\uC11C \uC794\uD639\uD55C
      \uADA4\uC801\uC744 \uB530\uB77C\uAC00\uC57C\uD560 \uC2DC\uAC04\uC774\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_14
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC544\uBC84\uC9C0\uAC00 \uB0A8\uAE34 \uC218\uCCA9\uC758
      \uACC4\uC0B0\uBC95\uC744 \uAC00\uB9CC\uD788 \uC74A\uC870\uB9AC\uBA70"
    Text_En: null
  - ID: Chapter_6_Front_15
    Chapter_Id: 6_Front
    Speaker: Daughter
    Text_Kr: "\uC5C4\uB9C8\uAC00 \uB204\uC6CC\uC788\uB294 \uADF8 \uC7A5\uC18C\uC640
      \uC644\uBCBD\uD558\uAC8C \uC9DD\uC744 \uC774\uB8E8\uB294 \uC5B4\uB460 \uC18D\uC73C\uB85C
      \uAC78\uC5B4 \uB4E4\uC5B4\uAC14\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_16
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC9C0\uC9C0\uC9C1\u2014  \uC5EC\uAE30\uB294 \uC218\uC0C9 5\uD300,
      \uC6A9\uC790\uB9AC\uC758 \uC88C\uD45C\uAC00 \uAC00\uB9AC\uD0A4\uB358 \uC9C0\uC810\uC5D0\uC11C
      \uC6A9\uC758\uC790\uB85C \uCD94\uC815\uB418\uB294 \uC2DC\uC2E0\uC744 \uD655\uBCF4\uD588\uC2B5\uB2C8\uB2E4"
    Text_En: null
  - ID: Chapter_6_Front_17
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uACB0\uAD6D \uD3B8\uC9C0 \uB0B4\uC6A9\uB300\uB85C\uAD70."
    Text_En: null
  - ID: Chapter_6_Front_18
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uC544\uBE44\uB294 \uBA48\uCDB0 \uC138\uC6E0\uB2E4 \uCCD0\uB3C4, \uC6B0\uB9B4
      \uC5EC\uAE30\uB85C \uBD88\uB7EC\uB0B8 \uB538\uC758 \uD589\uBC29\uC740? \uD604\uC7A5
      \uC8FC\uBCC0\uC5D0 \uD754\uC801\uC774 \uC788\uB098?"
    Text_En: null
  - ID: Chapter_6_Front_19
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC544\uB2D9\uB2C8\uB2E4, \uC6A9\uC758\uC790\uC758 \uC2DC\uC2E0 \uADFC\uCC98\uC5D0\uB294
      \uB538\uC758 \uD754\uC801\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_20
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uADF8\uB7FC \uB178\uD2B8 \uB9E8 \uB4B7\uC7A5\uC5D0 \uB538\uC774 \uB367\uBD99\uC5EC
      \uC801\uC5B4\uB454 \uAE00\uADC0\uBFD0\uC778\uAC00"
    Text_En: null
  - ID: Chapter_6_Front_21
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\u300E\uC2AC\uD508 \uC544\uC774\uAC00 \uACB0\uAD6D \uC5B4\uBBF8\uC758
      \uADA4\uB3C4\uB97C \uC601\uC6D0\uD788 \uB9F4\uB3CC\uC558\uB4EF\uC774, \uB098
      \uC5ED\uC2DC \uADF8 \uC774\uC815\uD45C\uB97C \uB530\uB77C\uAC00\uACA0\uB2E4.\u300F"
    Text_En: null
  - ID: Chapter_6_Front_22
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: ...
    Text_En: null
  - ID: Chapter_6_Front_23
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uADF8\uB798 \uADF8\uB7F0\uAC70\uC600\uAD70"
    Text_En: null
  - ID: Chapter_6_Front_24
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uC5B4\uBA38\uB2C8\uB294 \uC5B4\uB514\uC5D0 \uC788\uB098 \uD588\uB294\uB370..."
    Text_En: null
  - ID: Chapter_6_Front_25
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uC774\uC81C\uC57C \uC55E\uB4A4\uAC00 \uB9DE\uC544 "
    Text_En: null
  - ID: Chapter_6_Front_26
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uB538\uC740 \uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uC558\uC5B4 \uC2E0\uD654\uCC98\uB7FC
      \uC870\uAC01\uB09C \uAFC8\uC744 \uC887\uAE30\uC704\uD574 \uAC04\uAC70\uC57C."
    Text_En: null
  - ID: Chapter_6_Front_27
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uC804\uC5D0 \uC6B0\uB9AC\uAC00 \uCC3E\uC544\uB0C8\uB358 \uADF8 \uBB34\uB364"
    Text_En: null
  - ID: Chapter_6_Front_28
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uADF8 \uC88C\uD45C\uC640 \uC30D\uC744 \uC774\uB8E8\uB294 \uAC00\uC7A5
      \uCC28\uAC00\uC6B4 \uB300\uCE6D\uC810\uC73C\uB85C \uC81C \uBC1C\uB85C \uAC78\uC5B4
      \uB4E4\uC5B4\uAC14\uC744\uAC70\uB2E4."
    Text_En: null
  - ID: Chapter_6_Front_29
    Chapter_Id: 6_Front
    Speaker: Player
    Text_Kr: "\uADF8\uACF3\uC744 \uCC3E\uC544\uBD10 \uAC70\uAE30\uC11C \uB610 \uB2E4\uB978
      \uC2DC\uCCB4\uAC00 \uB098\uC62C \uAC83\uC774\uC57C..."
    Text_En: null
  - ID: Chapter_6_Back_1
    Chapter_Id: 6_Back
    Speaker: Police
    Text_Kr: "\uBC18\uC7A5\uB2D8! \uC774\uCABD\uC785\uB2C8\uB2E4! \uC218\uD480 \uC544\uB798\uC5D0\u2026\u2026!"
    Text_En: null
  - ID: Chapter_6_Back_2
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uB300\uC6D0\uB4E4\uC774 \uD669\uAE09\uD788 \uB2EC\uB824\uAC00 \uBE5B\uC744
      \uBAA8\uC558\uB2E4."
    Text_En: null
  - ID: Chapter_6_Back_3
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uC190\uC804\uB4F1 \uBD88\uBE5B\uC774 \uAC00\uB9AC\uD0A8 \uCD95\uCD95\uD55C
      \uD759\uBC14\uB2E5 \uC704\uC5D0\uB294, \uC9C0\uB3C5\uD55C \uC815\uC801\uB9CC\uC774
      \uD750\uB974\uACE0 \uC788\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_6_Back_4
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uADF8\uACF3\uC5D0\uB294 \uC720\uC77C\uD558\uAC8C \uB450 \uAC1C\uC758
      \uBCC4\uC790\uB9AC\uAC00 \uC788\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_6_Back_5
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uD558\uB098\uB294 \uC624\uB798\uC804 \uC544\uBC84\uC9C0\uAC00 \uBB3B\uC5B4\uB450\uC5B4
      \uD615\uCCB4\uB9CC \uAC04\uC2E0\uD788 \uB0A8\uC740 \uB610 \uB2E4\uB978 \uD53C\uD574\uC790\uC758
      \uCC28\uAC00\uC6B4 \uBC31\uACE8."
    Text_En: null
  - ID: Chapter_6_Back_6
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uADF8\uB9AC\uACE0 \uB9C8\uCE58 \uC7A0\uB4E0 \uAC83\uCC98\uB7FC \uB208\uC744
      \uAC10\uACE0 \uC788\uB294 \uB538\uC758 \uC2DC\uC2E0\uC774\uC5C8\uB2E4."
    Text_En: null
  - ID: Chapter_6_Back_7
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\u2026\u2026 \uC5ED\uC2DC \uB2A6\uC5C8\uAD70."
    Text_En: null
  - ID: Chapter_6_Back_8
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uB538\uC758 \uC548\uC0C9\uC740 \uC774\uBBF8 \uBBF8\uB3D9\uB3C4 \uC5C6\uC774
      \uD558\uC597\uAC8C \uC9C8\uB824 \uC788\uC5C8\uACE0"
    Text_En: null
  - ID: Chapter_6_Back_9
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uADF8 \uACC1\uC758 \uD759\uBC14\uB2E5\uC740 \uBB34\uB364\uC744 \uD655\uC778\uD558\uB824
      \uD588\uB358 \uB4EF \uC870\uAE08 \uD30C\uD5E4\uCCD0\uC838 \uC788\uC744 \uBFD0\uC774\uC5C8\uB2E4"
    Text_En: null
  - ID: Chapter_6_Back_10
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uACBD\uCC30\uB4E4\uC744 \uC774\uACF3\uC73C\uB85C \uC644\uBCBD\uD558\uAC8C
      \uC778\uB3C4\uD55C \uB538\uC740"
    Text_En: null
  - ID: Chapter_6_Back_11
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uC790\uC2E0\uC774 \uBCF4\uB0B8 \uD3B8\uC9C0\uB300\uB85C \uC544\uBC84\uC9C0\uAC00
      \uC0C8\uACA8\uB193\uC740 \uC794\uD639\uD55C \uADA4\uC801\uC758 \uB9C8\uC9C0\uB9C9
      \uC885\uCC29\uC9C0\uC5D0\uC11C \uC2A4\uC2A4\uB85C \uBA48\uCDB0 \uC120 \uAC83\uC774\uB2E4."
    Text_En: null
  - ID: Chapter_6_Back_12
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uACB0\uAD6D\u2026\u2026 \uC2E0\uD654\uC758 \uC794\uD639\uD55C \uADA4\uC801\uC774
      \uC5EC\uAE30\uC11C \uB05D\uC774 \uB0AC\uAD70."
    Text_En: null
  - ID: Chapter_6_Back_13
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uACFC\uAC70 \uC544\uBC84\uC9C0\uAC00 \uC9C0\uC5B4\uB0B8 \uAC70\uC9D3\uB9D0\uC744
      \uBBFF\uC5C8\uB358 \uC544\uC774\uB294,"
    Text_En: null
  - ID: Chapter_6_Back_14
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uC790\uC2E0\uC744 \uC704\uD574 \uAD34\uBB3C\uC774 \uB41C \uC544\uBC84\uC9C0\uC758
      \uC9C4\uC2E4\uC740 \uB05D\uB0B4 \uC54C\uC9C0 \uBABB\uD588\uC9C0\uB9CC"
    Text_En: null
  - ID: Chapter_6_Back_15
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uC138\uC0C1\uC758 \uC120\uC744 \uC81C \uC190\uC73C\uB85C \uBAA8\uB450
      \uB04A\uC5B4\uB0B4\uACE0 \uB098\uC11C\uC57C"
    Text_En: null
  - ID: Chapter_6_Back_16
    Chapter_Id: 6_Back
    Speaker: Player
    Text_Kr: "\uBE44\uB85C\uC18C \uADF8\uD1A0\uB85D \uCC3E\uC544 \uD5E4\uB9E4\uB358
      \uC790\uC2E0\uB9CC\uC758 \uAFC8\uC744 \uCC3E\uC73C\uB7EC \uAC00\uAC8C \uB418\uC5C8\uB2E4."
    Text_En: null
