%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9f347f15addfe4d4bbceb7b49c48e17c, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  dialogues:
  - ID: Chapter_1_Front_1
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uD6CC\uCA4D\u2026\u2026."
    Text_En: Sniff...
    Text_ZhHans: "\u545C\u2026\u2026"
    Text_Ja: "\u3050\u3059\u3063\u2026\u2026"
    Text_Es: Snif...
    Text_Pt: Snif...
    Text_Ru: "\u0412\u0441\u0445\u043B\u0438\u043F..."
  - ID: Chapter_1_Front_2
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uD6CC\uCA4D\u2026\u2026."
    Text_En: Sniff...
    Text_ZhHans: "\u545C\u2026\u2026"
    Text_Ja: "\u3050\u3059\u3063\u2026\u2026"
    Text_Es: Snif...
    Text_Pt: Snif...
    Text_Ru: "\u0412\u0441\u0445\u043B\u0438\u043F..."
  - ID: Chapter_1_Front_3
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\u2026\u2026."
    Text_En: Dad...
    Text_ZhHans: "\u7238\u7238\u2026\u2026"
    Text_Ja: "\u304A\u7236\u3055\u3093\u2026\u2026"
    Text_Es: "Pap\xE1..."
    Text_Pt: Papai...
    Text_Ru: "\u041F\u0430\u043F\u0430..."
  - ID: Chapter_1_Front_4
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC751."
    Text_En: Yes?
    Text_ZhHans: "\u55EF\u3002"
    Text_Ja: "\u3046\u3093\u3002"
    Text_Es: "S\xED."
    Text_Pt: Sim.
    Text_Ru: "\u0414\u0430."
  - ID: Chapter_1_Front_5
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uC5C4\uB9C8\uB294 \uC5B4\uB514 \uAC04 \uAC70\uC57C\u2026\u2026?"
    Text_En: Where did Mom go...?
    Text_ZhHans: "\u5988\u5988\u53BB\u54EA\u513F\u4E86\u2026\u2026\uFF1F"
    Text_Ja: "\u304A\u6BCD\u3055\u3093\u3001\u3069\u3053\u306B\u884C\u3063\u305F\u306E\u2026\u2026\uFF1F"
    Text_Es: "\xBFAd\xF3nde se fue mam\xE1...?"
    Text_Pt: "Para onde a mam\xE3e foi...?"
    Text_Ru: "\u041A\u0443\u0434\u0430 \u0443\u0448\u043B\u0430 \u043C\u0430\u043C\u0430...?"
  - ID: Chapter_1_Front_6
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\u2026\u2026."
    Text_En: ...
    Text_ZhHans: "\u2026\u2026"
    Text_Ja: "\u2026\u2026"
    Text_Es: ...
    Text_Pt: ...
    Text_Ru: ...
  - ID: Chapter_1_Front_7
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC5C4\uB9C8\uB294 \uC800\uAE30 \uBCC4\uB098\uB77C\uB85C \uAC14\uC5B4."
    Text_En: Mom went to live among the stars.
    Text_ZhHans: "\u5988\u5988\u53BB\u4E86\u661F\u661F\u7684\u56FD\u5EA6\u3002"
    Text_Ja: "\u304A\u6BCD\u3055\u3093\u306F\u661F\u306E\u56FD\u306B\u884C\u3063\u305F\u3093\u3060\u3002"
    Text_Es: "Mam\xE1 se fue al pa\xEDs de las estrellas."
    Text_Pt: "A mam\xE3e foi morar entre as estrelas."
    Text_Ru: "\u041C\u0430\u043C\u0430 \u0443\u0448\u043B\u0430 \u0432 \u0441\u0442\u0440\u0430\u043D\u0443
      \u0437\u0432\u0451\u0437\u0434."
  - ID: Chapter_1_Front_8
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uBCC4\uB098\uB77C?"
    Text_En: The stars?
    Text_ZhHans: "\u661F\u661F\u7684\u56FD\u5EA6\uFF1F"
    Text_Ja: "\u661F\u306E\u56FD\uFF1F"
    Text_Es: "\xBFDe las estrellas?"
    Text_Pt: Entre as estrelas?
    Text_Ru: "\u0412 \u0441\u0442\u0440\u0430\u043D\u0443 \u0437\u0432\u0451\u0437\u0434?"
  - ID: Chapter_1_Front_9
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB798. \uACE0\uAC1C \uB4E4\uC5B4\uC11C \uD558\uB298\uC744 \uBD10."
    Text_En: Yes. Look up at the sky.
    Text_ZhHans: "\u55EF\uFF0C\u62AC\u5934\u770B\u770B\u5929\u7A7A\u3002"
    Text_Ja: "\u305D\u3046\u3002\u7A7A\u3092\u898B\u4E0A\u3052\u3066\u3054\u3089\u3093\u3002"
    Text_Es: "S\xED. Levanta la vista."
    Text_Pt: "Sim. Olhe para o c\xE9u."
    Text_Ru: "\u0414\u0430. \u041F\u043E\u0434\u043D\u0438\u043C\u0438 \u0433\u043E\u043B\u043E\u0432\u0443,
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u043D\u0435\u0431\u043E."
  - ID: Chapter_1_Front_10
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uBC18\uC9DD\uC774\uB294 \uBCC4\uB4E4 \uBCF4\uC774\uC9C0?"
    Text_En: See those twinkling stars?
    Text_ZhHans: "\u770B\u89C1\u90A3\u4E9B\u95EA\u95EA\u7684\u661F\u661F\u4E86\u5417\uFF1F"
    Text_Ja: "\u304D\u3089\u304D\u3089\u5149\u308B\u661F\u304C\u898B\u3048\u308B\u304B\u3044\uFF1F"
    Text_Es: "\xBFVes c\xF3mo brillan?"
    Text_Pt: "Est\xE1 vendo as estrelas brilhando?"
    Text_Ru: "\u0412\u0438\u0434\u0438\u0448\u044C, \u043A\u0430\u043A \u043C\u0435\u0440\u0446\u0430\u044E\u0442
      \u0437\u0432\u0451\u0437\u0434\u044B?"
  - ID: Chapter_1_Front_11
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\u2026\u2026\uC751."
    Text_En: ...Yeah.
    Text_ZhHans: "\u2026\u2026\u55EF\u3002"
    Text_Ja: "\u2026\u2026\u3046\u3093\u3002"
    Text_Es: "...S\xED."
    Text_Pt: ...Sim.
    Text_Ru: "...\u0414\u0430."
  - ID: Chapter_1_Front_12
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC5C4\uB9C8\uB294 \uC800 \uBA40\uB9AC\uC11C \uC6B0\uB9AC\uB97C \uBCF4\uACE0
      \uC788\uC744 \uAC70\uC57C."
    Text_En: Mom must be watching us from there.
    Text_ZhHans: "\u5988\u5988\u4E00\u5B9A\u5728\u8FDC\u5904\u770B\u7740\u6211\u4EEC\u3002"
    Text_Ja: "\u304A\u6BCD\u3055\u3093\u306F\u9060\u304F\u304B\u3089\u898B\u3066\u3044\u308B\u3088\u3002"
    Text_Es: "Seguro que mam\xE1 nos mira desde all\xED."
    Text_Pt: "Ela deve estar olhando para n\xF3s l\xE1 de longe."
    Text_Ru: "\u041C\u0430\u043C\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u043D\u0430\u0441 \u043E\u0442\u0442\u0443\u0434\u0430."
  - ID: Chapter_1_Front_13
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uB0B4\uAC00 \uC5EC\uAE30 \uC788\uB294 \uAC83\uB3C4 \uC54C\uC544?"
    Text_En: Does she know I'm here?
    Text_ZhHans: "\u5979\u77E5\u9053\u6211\u5728\u8FD9\u91CC\u5417\uFF1F"
    Text_Ja: "\u79C1\u304C\u3053\u3053\u306B\u3044\u308B\u306E\u3082\u5206\u304B\u308B\uFF1F"
    Text_Es: "\xBFSabe que estoy aqu\xED?"
    Text_Pt: Ela sabe que estou aqui?
    Text_Ru: "\u041E\u043D\u0430 \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E
      \u044F \u0437\u0434\u0435\u0441\u044C?"
  - ID: Chapter_1_Front_14
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB7FC. \uC544\uBE60\uB791 \uAC19\uC774 \uC549\uC544 \uC788\uB294
      \uAC83\uB3C4 \uB2E4 \uBCF4\uC77C\uAC78."
    Text_En: Of course. She can see us together.
    Text_ZhHans: "\u5F53\u7136\uFF0C\u4E5F\u80FD\u770B\u89C1\u4F60\u548C\u7238\u7238\u5750\u5728\u4E00\u8D77\u3002"
    Text_Ja: "\u3082\u3061\u308D\u3093\u3002\u4E8C\u4EBA\u3067\u3044\u308B\u306E\u3082\u898B\u3048\u308B\u3055\u3002"
    Text_Es: Claro. Puede vernos sentados juntos.
    Text_Pt: "Claro. Pode ver n\xF3s dois aqui juntos."
    Text_Ru: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E. \u0412\u0438\u0434\u0438\u0442,
      \u043A\u0430\u043A \u043C\u044B \u0441\u0438\u0434\u0438\u043C \u0432\u043C\u0435\u0441\u0442\u0435."
  - ID: Chapter_1_Front_15
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uADF8\uB7F0\uB370 \uB098\uB294 \uC5C4\uB9C8\uAC00 \uC548 \uBCF4\uC5EC."
    Text_En: But I can't see her.
    Text_ZhHans: "\u53EF\u6211\u770B\u4E0D\u89C1\u5988\u5988\u3002"
    Text_Ja: "\u3067\u3082\u3001\u79C1\u306B\u306F\u304A\u6BCD\u3055\u3093\u304C\u898B\u3048\u306A\u3044\u3002"
    Text_Es: Pero yo no puedo verla.
    Text_Pt: "Mas eu n\xE3o consigo ver a mam\xE3e."
    Text_Ru: "\u0410 \u044F \u043C\u0430\u043C\u0443 \u043D\u0435 \u0432\u0438\u0436\u0443."
  - ID: Chapter_1_Front_16
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\u2026\u2026\uBCC4\uC774 \uB108\uBB34 \uB9CE\uC544\uC11C \uADF8\uB7F0\uAC00
      \uBCF4\uB2E4."
    Text_En: ...Maybe there are too many stars.
    Text_ZhHans: "\u2026\u2026\u4E5F\u8BB8\u662F\u661F\u661F\u592A\u591A\u4E86\u3002"
    Text_Ja: "\u2026\u2026\u661F\u304C\u591A\u3059\u304E\u308B\u306E\u304B\u306A\u3002"
    Text_Es: "...Quiz\xE1 haya demasiadas estrellas."
    Text_Pt: ...Talvez haja estrelas demais.
    Text_Ru: "...\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0437\u0432\u0451\u0437\u0434
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E."
  - ID: Chapter_1_Front_17
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB294 \uC5B4\uB514 \uC788\uB294\uC9C0 \uC54C\uC544?"
    Text_En: Do you know where she is?
    Text_ZhHans: "\u7238\u7238\u77E5\u9053\u5979\u5728\u54EA\u513F\u5417\uFF1F"
    Text_Ja: "\u304A\u7236\u3055\u3093\u306F\u3069\u3053\u306B\u3044\u308B\u304B\u5206\u304B\u308B\uFF1F"
    Text_Es: "\xBFT\xFA sabes d\xF3nde est\xE1?"
    Text_Pt: "Voc\xEA sabe onde ela est\xE1?"
    Text_Ru: "\u0410 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0433\u0434\u0435
      \u043E\u043D\u0430?"
  - ID: Chapter_1_Front_18
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uAC19\uC774 \uCC3E\uC544\uBCFC\uAE4C?"
    Text_En: Shall we look together?
    Text_ZhHans: "\u6211\u4EEC\u4E00\u8D77\u627E\u627E\u5427\uFF1F"
    Text_Ja: "\u4E00\u7DD2\u306B\u63A2\u3057\u3066\u307F\u3088\u3046\u304B\u3002"
    Text_Es: "\xBFLa buscamos juntos?"
    Text_Pt: Vamos procurar juntos?
    Text_Ru: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0438\u0449\u0435\u043C
      \u0432\u043C\u0435\u0441\u0442\u0435?"
  - ID: Chapter_1_Front_19
    Chapter_Id: 1_Front
    Speaker: Daughter
    Text_Kr: "\uCC3E\uC73C\uBA74 \uB098\uD55C\uD14C\uB3C4 \uC54C\uB824\uC918."
    Text_En: Tell me when you find her.
    Text_ZhHans: "\u627E\u5230\u4E86\u4E5F\u8981\u544A\u8BC9\u6211\u3002"
    Text_Ja: "\u898B\u3064\u3051\u305F\u3089\u3001\u79C1\u306B\u3082\u6559\u3048\u3066\u306D\u3002"
    Text_Es: "Av\xEDsame cuando la encuentres."
    Text_Pt: Quando achar, me conta.
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0451\u0448\u044C,
      \u0441\u043A\u0430\u0436\u0438 \u043C\u043D\u0435."
  - ID: Chapter_1_Front_20
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB798. \uC544\uBE60\uAC00 \uB3C4\uC640\uC904\uAC8C."
    Text_En: I will. Let me help.
    Text_ZhHans: "\u597D\uFF0C\u7238\u7238\u5E2E\u4F60\u3002"
    Text_Ja: "\u3042\u3042\u3002\u304A\u7236\u3055\u3093\u304C\u624B\u4F1D\u3046\u3088\u3002"
    Text_Es: "Claro. Yo te ayudar\xE9."
    Text_Pt: Claro. Eu vou ajudar.
    Text_Ru: "\u0425\u043E\u0440\u043E\u0448\u043E. \u042F \u0442\u0435\u0431\u0435
      \u043F\u043E\u043C\u043E\u0433\u0443."
  - ID: Chapter_1_Front_21
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uC800\uAE30 \uC800 \uBCC4\uBD80\uD130,"
    Text_En: Start with that star.
    Text_ZhHans: "\u5148\u4ECE\u90A3\u9897\u661F\u661F\u5F00\u59CB\uFF0C"
    Text_Ja: "\u3042\u306E\u661F\u304B\u3089\u3001"
    Text_Es: Empieza por aquella estrella.
    Text_Pt: Comece por aquela estrela.
    Text_Ru: "\u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u0442\u043E\u0439 \u0437\u0432\u0435\u0437\u0434\u044B."
  - ID: Chapter_1_Front_22
    Chapter_Id: 1_Front
    Speaker: Father
    Text_Kr: "\uCC9C\uCC9C\uD788 \uC120\uC744 \uC774\uC5B4\uBCF4\uB294 \uAC70\uC57C."
    Text_En: Then slowly connect the dots.
    Text_ZhHans: "\u6162\u6162\u628A\u5B83\u4EEC\u8FDE\u8D77\u6765\u3002"
    Text_Ja: "\u3086\u3063\u304F\u308A\u7DDA\u3092\u3064\u306A\u3044\u3067\u3044\u304F\u3093\u3060\u3002"
    Text_Es: "Y ve uni\xE9ndolas despacio."
    Text_Pt: "E v\xE1 ligando uma \xE0 outra, devagar."
    Text_Ru: "\u0411\u0443\u0434\u0435\u043C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C \u0438\u0445 \u043B\u0438\u043D\u0438\u044F\u043C\u0438."
  - ID: Chapter_1_Back_1
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uB0A0\uB3C4 \uB098\uB294 \uC774\uCABD\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4."
    Text_En: I sat on this side that day, too.
    Text_ZhHans: "\u90A3\u5929\uFF0C\u6211\u4E5F\u5750\u5728\u8FD9\u4E00\u8FB9\u3002"
    Text_Ja: "\u3042\u306E\u65E5\u3082\u3001\u79C1\u306F\u3053\u3061\u3089\u306B\u5EA7\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "Aquel d\xEDa tambi\xE9n me sent\xE9 aqu\xED."
    Text_Pt: "Naquele dia, eu tamb\xE9m sentei deste lado."
    Text_Ru: "\u0412 \u0442\u043E\u0442 \u0434\u0435\u043D\u044C \u044F \u0442\u043E\u0436\u0435
      \u0441\u0438\u0434\u0435\u043B\u0430 \u0441 \u044D\u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B."
  - ID: Chapter_1_Back_2
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uBCC4\uC744 \uAC00\uB9AC\uD0A4\uB294 \uC544\uBE60\uC758 \uC190\uC744
      \uB193\uCE60\uAE4C \uBD10,"
    Text_En: Watching where Dad pointed,
    Text_ZhHans: "\u6015\u770B\u6F0F\u7238\u7238\u6307\u7684\u661F\u661F\uFF0C"
    Text_Ja: "\u304A\u7236\u3055\u3093\u306E\u6307\u3059\u661F\u3092\u898B\u5931\u308F\u306A\u3044\u3088\u3046\u3001"
    Text_Es: "Para no perder de vista d\xF3nde se\xF1alaba,"
    Text_Pt: Com medo de perder o que ele apontava,
    Text_Ru: "\u0427\u0442\u043E\u0431\u044B \u043D\u0435 \u0443\u043F\u0443\u0441\u0442\u0438\u0442\u044C,
      \u043A\u0443\u0434\u0430 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u043F\u0430\u043F\u0430,"
  - ID: Chapter_1_Back_3
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC637\uC18C\uB9E4\uB97C \uAF2D \uC7A1\uACE0\uC11C."
    Text_En: I held tight to his sleeve.
    Text_ZhHans: "\u6211\u7D27\u7D27\u6525\u7740\u4ED6\u7684\u8863\u8896\u3002"
    Text_Ja: "\u8896\u3092\u304E\u3085\u3063\u3068\u63E1\u3063\u3066\u3002"
    Text_Es: "me aferr\xE9 a la manga de pap\xE1."
    Text_Pt: segurei firme na manga dele.
    Text_Ru: "\u044F \u043A\u0440\u0435\u043F\u043A\u043E \u0434\u0435\u0440\u0436\u0430\u043B\u0430\u0441\u044C
      \u0437\u0430 \u0435\u0433\u043E \u0440\u0443\u043A\u0430\u0432."
  - ID: Chapter_1_Back_4
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC774\uC81C \uC606\uC790\uB9AC\uB294 \uBE44\uC5B4 \uC788\uB2E4."
    Text_En: Now the seat beside me was empty.
    Text_ZhHans: "\u5982\u4ECA\uFF0C\u8EAB\u65C1\u7684\u5EA7\u4F4D\u7A7A\u7740\u3002"
    Text_Ja: "\u4ECA\u3001\u96A3\u306E\u5E2D\u306F\u7A7A\u3044\u3066\u3044\u308B\u3002"
    Text_Es: "Ahora, el asiento de al lado estaba vac\xEDo."
    Text_Pt: Agora, o lugar ao meu lado estava vazio.
    Text_Ru: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u0435\u0441\u0442\u043E
      \u0440\u044F\u0434\u043E\u043C \u043F\u0443\u0441\u0442\u043E\u0432\u0430\u043B\u043E."
  - ID: Chapter_1_Back_5
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uBB34\uB98E \uC704\uC5D0 \uBE48\uC190\uC744 \uC62C\uB824\uB193\uC558\uB2E4."
    Text_En: I rested my empty hands in my lap.
    Text_ZhHans: "\u6211\u628A\u7A7A\u7A7A\u7684\u53CC\u624B\u653E\u5728\u819D\u4E0A\u3002"
    Text_Ja: "\u79C1\u306F\u4F55\u3082\u6301\u305F\u306A\u3044\u624B\u3092\u819D\u306B\u7F6E\u3044\u305F\u3002"
    Text_Es: "Dej\xE9 las manos vac\xEDas sobre las rodillas."
    Text_Pt: "Pousei as m\xE3os vazias no colo."
    Text_Ru: "\u042F \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430 \u043F\u0443\u0441\u0442\u044B\u0435
      \u043B\u0430\u0434\u043E\u043D\u0438 \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438."
  - ID: Chapter_1_Back_6
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC190\uD1B1 \uBC11\uC5D0\uB294 \uC544\uC9C1 \uD759\uC774 \uB0A8\uC544
      \uC788\uC5C8\uB2E4."
    Text_En: Dirt still clung beneath my nails.
    Text_ZhHans: "\u6307\u7532\u7F1D\u91CC\u8FD8\u7559\u7740\u6CE5\u571F\u3002"
    Text_Ja: "\u722A\u306E\u9593\u306B\u306F\u3001\u307E\u3060\u571F\u304C\u6B8B\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "A\xFAn ten\xEDa tierra bajo las u\xF1as."
    Text_Pt: Ainda havia terra sob minhas unhas.
    Text_Ru: "\u041F\u043E\u0434 \u043D\u043E\u0433\u0442\u044F\u043C\u0438 \u0435\u0449\u0451
      \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0430\u0441\u044C \u0437\u0435\u043C\u043B\u044F."
  - ID: Chapter_1_Back_7
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uADF8 \uD45C\uC2DC\uAC00 \uC788\uB294 \uACF3\uC740 \uC804\uBD80 \uAC00\uBCF4\uC558\uB2E4."
    Text_En: I'd been to every marked place.
    Text_ZhHans: "\u6240\u6709\u6807\u8BB0\u8FC7\u7684\u5730\u65B9\uFF0C\u6211\u90FD\u53BB\u8FC7\u4E86\u3002"
    Text_Ja: "\u5370\u306E\u3042\u308B\u5834\u6240\u306F\u5168\u90E8\u56DE\u3063\u305F\u3002"
    Text_Es: "Hab\xEDa ido a todos los lugares marcados."
    Text_Pt: Eu tinha ido a todos os lugares marcados.
    Text_Ru: "\u042F \u043F\u043E\u0431\u044B\u0432\u0430\u043B\u0430 \u0432\u043E
      \u0432\u0441\u0435\u0445 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0445
      \u043C\u0435\u0441\u0442\u0430\u0445."
  - ID: Chapter_1_Back_8
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uAE38\uC744 \uC798\uBABB \uB4E4\uC5C8\uC744\uAE4C \uBD10"
    Text_En: Afraid I'd taken a wrong turn,
    Text_ZhHans: "\u6015\u81EA\u5DF1\u8D70\u9519\u8DEF\uFF0C"
    Text_Ja: "\u9053\u3092\u9593\u9055\u3048\u305F\u306E\u3067\u306F\u3068\u3001"
    Text_Es: Por miedo a equivocarme de camino,
    Text_Pt: Com medo de ter errado o caminho,
    Text_Ru: "\u0411\u043E\u044F\u0441\u044C, \u0447\u0442\u043E \u0441\u0432\u0435\u0440\u043D\u0443\u043B\u0430
      \u043D\u0435 \u0442\u0443\u0434\u0430,"
  - ID: Chapter_1_Back_9
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uBA87 \uBC88\uC529 \uB3CC\uC544\uAC00 \uD655\uC778\uD55C \uACF3\uB3C4
      \uC788\uC5C8\uB2E4."
    Text_En: I'd checked some more than once.
    Text_ZhHans: "\u6709\u4E9B\u5730\u65B9\u8FD8\u56DE\u53BB\u786E\u8BA4\u4E86\u597D\u51E0\u904D\u3002"
    Text_Ja: "\u4F55\u5EA6\u3082\u623B\u3063\u3066\u78BA\u304B\u3081\u305F\u5834\u6240\u3082\u3042\u308B\u3002"
    Text_Es: "hab\xEDa vuelto a comprobar algunos."
    Text_Pt: "voltei a alguns deles v\xE1rias vezes."
    Text_Ru: "\u0432 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0430\u0441\u044C
      \u043D\u0435 \u0440\u0430\u0437."
  - ID: Chapter_1_Back_10
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uD558\uC9C0\uB9CC \uC5B4\uB514\uC5D0\uB3C4 \uC544\uBE60\uB294 \uC5C6\uC5C8\uB2E4."
    Text_En: But Dad was nowhere to be found.
    Text_ZhHans: "\u53EF\u54EA\u91CC\u90FD\u6CA1\u6709\u7238\u7238\u3002"
    Text_Ja: "\u305D\u308C\u3067\u3082\u3001\u304A\u7236\u3055\u3093\u306F\u3069\u3053\u306B\u3082\u3044\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Pero pap\xE1 no estaba en ninguna parte."
    Text_Pt: "Mas papai n\xE3o estava em lugar nenhum."
    Text_Ru: "\u041D\u043E \u043F\u0430\u043F\u044B \u043D\u0438\u0433\u0434\u0435
      \u043D\u0435 \u0431\u044B\u043B\u043E."
  - ID: Chapter_1_Back_11
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uB354 \uCC3E\uC544\uBCFC \uAE30\uB85D\uC740 \uB0A8\uC544 \uC788\uC9C0
      \uC54A\uC558\uB2E4."
    Text_En: There were no more leads to follow.
    Text_ZhHans: "\u5DF2\u7ECF\u6CA1\u6709\u80FD\u7EE7\u7EED\u8FFD\u67E5\u7684\u8BB0\u5F55\u4E86\u3002"
    Text_Ja: "\u3082\u3046\u3001\u305F\u3069\u308C\u308B\u8A18\u9332\u306F\u6B8B\u3063\u3066\u3044\u306A\u3044\u3002"
    Text_Es: "Ya no quedaban m\xE1s pistas que seguir."
    Text_Pt: "N\xE3o havia mais pistas para seguir."
    Text_Ru: "\u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u0437\u0430\u043F\u0438\u0441\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u043C\u043E\u0436\u043D\u043E \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C."
  - ID: Chapter_1_Back_12
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC218\uCCA9\uC740 \uC9D1\uC5D0 \uB450\uACE0 \uC654\uB2E4."
    Text_En: I'd left the notebook at home.
    Text_ZhHans: "\u6211\u628A\u7B14\u8BB0\u672C\u7559\u5728\u4E86\u5BB6\u91CC\u3002"
    Text_Ja: "\u624B\u5E33\u306F\u5BB6\u306B\u7F6E\u3044\u3066\u304D\u305F\u3002"
    Text_Es: "Hab\xEDa dejado el cuaderno en casa."
    Text_Pt: Deixei o caderno em casa.
    Text_Ru: "\u0411\u043B\u043E\u043A\u043D\u043E\u0442 \u044F \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u0434\u043E\u043C\u0430."
  - ID: Chapter_1_Back_13
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uC758 \uCC45\uC0C1 \uC704, \uCC98\uC74C \uBC1C\uACAC\uD588\uB358
      \uC790\uB9AC\uC5D0."
    Text_En: On Dad's desk, where I'd found it.
    Text_ZhHans: "\u653E\u5728\u7238\u7238\u7684\u4E66\u684C\u4E0A\uFF0C\u6700\u521D\u53D1\u73B0\u5B83\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u306E\u673A\u306E\u4E0A\u3002\u6700\u521D\u306B\u898B\u3064\u3051\u305F\u5834\u6240\u306B\u3002"
    Text_Es: "En su escritorio, donde lo encontr\xE9."
    Text_Pt: Na mesa dele, onde o encontrei.
    Text_Ru: "\u041D\u0430 \u043F\u0430\u043F\u0438\u043D\u043E\u043C \u0441\u0442\u043E\u043B\u0435,
      \u0433\u0434\u0435 \u0435\u0433\u043E \u0438 \u043D\u0430\u0448\u043B\u0430."
  - ID: Chapter_1_Back_14
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uB9C8\uC9C0\uB9C9 \uC7A5\uC5D0\uB294 \uC9E7\uC740 \uB9D0\uC744 \uB0A8\uACBC\uB2E4."
    Text_En: I'd left a note on the last page.
    Text_ZhHans: "\u6211\u5728\u6700\u540E\u4E00\u9875\u7559\u4E86\u51E0\u53E5\u8BDD\u3002"
    Text_Ja: "\u6700\u5F8C\u306E\u30DA\u30FC\u30B8\u306B\u3001\u77ED\u3044\u8A00\u8449\u3092\u6B8B\u3057\u305F\u3002"
    Text_Es: "En la \xFAltima p\xE1gina dej\xE9 una nota."
    Text_Pt: "Na \xFAltima p\xE1gina, deixei um bilhete."
    Text_Ru: "\u041D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u0437\u0430\u043F\u0438\u0441\u043A\u0443."
  - ID: Chapter_1_Back_15
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uC640 \uBCC4\uC744 \uC787\uB294 \uBC95\uC744 \uBC30\uC6E0\uB358
      \uACF3\uC5D0 \uAC08\uAC8C."
    Text_En: I'll go where you taught me the stars.
    Text_ZhHans: "\u6211\u53BB\u7238\u7238\u6559\u6211\u8FDE\u661F\u661F\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u3068\u661F\u3092\u3064\u306A\u3050\u7DF4\u7FD2\u3092\u3057\u305F\u5834\u6240\u306B\u884C\u304F\u306D\u3002"
    Text_Es: "Ir\xE9 donde me ense\xF1aste a unir estrellas."
    Text_Pt: "Vou onde voc\xEA me ensinou a ligar estrelas."
    Text_Ru: "\u041F\u043E\u0439\u0434\u0443 \u0442\u0443\u0434\u0430, \u0433\u0434\u0435
      \u0442\u044B \u0443\u0447\u0438\u043B \u043C\u0435\u043D\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: Chapter_1_Back_16
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uAC70\uAE30\uC11C \uAE30\uB2E4\uB9B4\uAC8C."
    Text_En: I'll wait there.
    Text_ZhHans: "\u6211\u4F1A\u5728\u90A3\u91CC\u7B49\u4F60\u3002"
    Text_Ja: "\u305D\u3053\u3067\u5F85\u3063\u3066\u308B\u3002"
    Text_Es: "Te esperar\xE9 all\xED."
    Text_Pt: "Vou esperar l\xE1."
    Text_Ru: "\u0411\u0443\u0434\u0443 \u0436\u0434\u0430\u0442\u044C \u0442\u0430\u043C."
  - ID: Chapter_1_Back_17
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uD639\uC2DC \uB0B4\uAC00 \uC5C6\uB294 \uC0AC\uC774 \uB3CC\uC544\uC628\uB2E4\uBA74,"
    Text_En: If he came home while I was out,
    Text_ZhHans: "\u8FD9\u6837\uFF0C\u4E07\u4E00\u4ED6\u8D81\u6211\u4E0D\u5728\u65F6\u56DE\u6765\uFF0C"
    Text_Ja: "\u79C1\u304C\u3044\u306A\u3044\u9593\u306B\u5E30\u3063\u3066\u304D\u3066\u3082\u3001"
    Text_Es: "Si volv\xEDa mientras yo estaba fuera,"
    Text_Pt: Se ele voltasse enquanto eu estivesse fora,
    Text_Ru: "\u0415\u0441\u043B\u0438 \u043E\u043D \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F,
      \u043F\u043E\u043A\u0430 \u043C\u0435\u043D\u044F \u043D\u0435\u0442,"
  - ID: Chapter_1_Back_18
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC5B4\uB514\uB85C \uAC14\uB294\uC9C0 \uC54C \uC218 \uC788\uB3C4\uB85D."
    Text_En: he would know where to find me.
    Text_ZhHans: "\u5C31\u80FD\u77E5\u9053\u6211\u53BB\u4E86\u54EA\u91CC\u3002"
    Text_Ja: "\u884C\u304D\u5148\u304C\u5206\u304B\u308B\u3088\u3046\u306B\u3002"
    Text_Es: "sabr\xEDa d\xF3nde encontrarme."
    Text_Pt: saberia onde me encontrar.
    Text_Ru: "\u0442\u043E \u0443\u0437\u043D\u0430\u0435\u0442, \u043A\u0443\u0434\u0430
      \u044F \u0443\u0448\u043B\u0430."
  - ID: Chapter_1_Back_19
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uACE0\uAC1C\uB97C \uB4E4\uC790 \uBCC4\uB4E4\uC774 \uBCF4\uC600\uB2E4."
    Text_En: I looked up at the stars.
    Text_ZhHans: "\u62AC\u8D77\u5934\uFF0C\u661F\u661F\u6620\u5165\u773C\u5E18\u3002"
    Text_Ja: "\u9854\u3092\u4E0A\u3052\u308B\u3068\u3001\u661F\u304C\u898B\u3048\u305F\u3002"
    Text_Es: "Alc\xE9 la vista y vi las estrellas."
    Text_Pt: Ergui os olhos e vi as estrelas.
    Text_Ru: "\u042F \u043F\u043E\u0434\u043D\u044F\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0438 \u0443\u0432\u0438\u0434\u0435\u043B\u0430 \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: Chapter_1_Back_20
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB294 \uB0B4\uAC8C \uBCC4\uC744 \uC787\uB294 \uBC95\uC744
      \uC54C\uB824\uC92C\uC9C0\uB9CC,"
    Text_En: Dad had taught me to connect them,
    Text_ZhHans: "\u7238\u7238\u6559\u4F1A\u4E86\u6211\u8FDE\u63A5\u661F\u661F\uFF0C"
    Text_Ja: "\u304A\u7236\u3055\u3093\u306F\u661F\u306E\u3064\u306A\u304E\u65B9\u3092\u6559\u3048\u3066\u304F\u308C\u305F\u3002"
    Text_Es: "Pap\xE1 me hab\xEDa ense\xF1ado a unirlas,"
    Text_Pt: "Papai me ensinou a lig\xE1-las,"
    Text_Ru: "\u041F\u0430\u043F\u0430 \u043D\u0430\u0443\u0447\u0438\u043B \u043C\u0435\u043D\u044F
      \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C \u0438\u0445,"
  - ID: Chapter_1_Back_21
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC544\uC9C1 \uC544\uBE60\uB77C\uB294 \uBCC4\uC744 \uCC3E\uC9C0
      \uBABB\uD588\uB2E4."
    Text_En: but I still couldn't find his.
    Text_ZhHans: "\u53EF\u6211\u8FD8\u6CA1\u627E\u5230\u540D\u4E3A\u7238\u7238\u7684\u90A3\u9897\u661F\u3002"
    Text_Ja: "\u3067\u3082\u3001\u304A\u7236\u3055\u3093\u3068\u3044\u3046\u661F\u306F\u307E\u3060\u898B\u3064\u304B\u3089\u306A\u3044\u3002"
    Text_Es: "pero a\xFAn no encontraba la suya."
    Text_Pt: "mas eu ainda n\xE3o encontrava a dele."
    Text_Ru: "\u043D\u043E \u0437\u0432\u0435\u0437\u0434\u0443 \u043F\u043E \u0438\u043C\u0435\u043D\u0438
      \xAB\u043F\u0430\u043F\u0430\xBB \u044F \u0442\u0430\u043A \u0438 \u043D\u0435
      \u043D\u0430\u0448\u043B\u0430."
  - ID: Chapter_1_Back_22
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9AC\uBA74 \uC544\uBE60\uAC00 \uC62C\uAE4C."
    Text_En: Would he come if I waited here?
    Text_ZhHans: "\u5728\u8FD9\u91CC\u7B49\uFF0C\u7238\u7238\u4F1A\u6765\u5417\uFF1F"
    Text_Ja: "\u3053\u3053\u3067\u5F85\u3063\u3066\u3044\u308C\u3070\u3001\u6765\u3066\u304F\u308C\u308B\u3060\u308D\u3046\u304B\u3002"
    Text_Es: "\xBFVendr\xEDa si lo esperaba aqu\xED?"
    Text_Pt: "Ser\xE1 que ele viria se eu esperasse aqui?"
    Text_Ru: "\u041F\u0440\u0438\u0434\u0451\u0442 \u043B\u0438 \u043E\u043D, \u0435\u0441\u043B\u0438
      \u044F \u043F\u043E\u0434\u043E\u0436\u0434\u0443 \u0437\u0434\u0435\u0441\u044C?"
  - ID: Chapter_1_Back_23
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uB3CC\uC544\uC62C \uAC70\uB77C\uB294 \uBCF4\uC7A5\uC740 \uC5C6\uC5C8\uB2E4."
    Text_En: There was no promise he'd return.
    Text_ZhHans: "\u6CA1\u6709\u4EBA\u80FD\u4FDD\u8BC1\u4ED6\u4F1A\u56DE\u6765\u3002"
    Text_Ja: "\u5E30\u3063\u3066\u304F\u308B\u4FDD\u8A3C\u306F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: Nada aseguraba que fuera a volver.
    Text_Pt: Nada garantia que ele voltaria.
    Text_Ru: "\u041D\u0438\u0447\u0442\u043E \u043D\u0435 \u043E\u0431\u0435\u0449\u0430\u043B\u043E,
      \u0447\u0442\u043E \u043E\u043D \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F."
  - ID: Chapter_1_Back_24
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uB798\uB3C4 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD55C \uBC88\uB9CC."
    Text_En: Still, just one last time,
    Text_ZhHans: "\u53EF\u6211\u8FD8\u662F\u60F3\uFF0C\u6700\u540E\u518D\u7B49\u4E00\u6B21\u3002"
    Text_Ja: "\u305D\u308C\u3067\u3082\u3001\u6700\u5F8C\u306B\u3082\u3046\u4E00\u5EA6\u3060\u3051\u3002"
    Text_Es: "Aun as\xED, una \xFAltima vez,"
    Text_Pt: "Mesmo assim, s\xF3 mais uma vez,"
    Text_Ru: "\u0418 \u0432\u0441\u0451 \u0436\u0435, \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437,"
  - ID: Chapter_1_Back_25
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uC640 \uD568\uAED8 \uBCF4\uB358 \uD558\uB298 \uC544\uB798\uC5D0\uC11C,"
    Text_En: beneath the sky we'd shared,
    Text_ZhHans: "\u5728\u66FE\u548C\u7238\u7238\u4E00\u8D77\u4EF0\u671B\u7684\u5929\u7A7A\u4E0B\uFF0C"
    Text_Ja: "\u4E00\u7DD2\u306B\u898B\u305F\u7A7A\u306E\u4E0B\u3067\u3001"
    Text_Es: "bajo el cielo que hab\xEDamos compartido,"
    Text_Pt: "sob o c\xE9u que vimos juntos,"
    Text_Ru: "\u043F\u043E\u0434 \u043D\u0435\u0431\u043E\u043C, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043C\u044B \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435,"
  - ID: Chapter_1_Back_26
    Chapter_Id: 1_Back
    Speaker: Daughter
    Text_Kr: "\uAE30\uB2E4\uB9AC\uACE0 \uC2F6\uC5C8\uB2E4."
    Text_En: I wanted to wait.
    Text_ZhHans: "\u518D\u7B49\u4E00\u7B49\u3002"
    Text_Ja: "\u5F85\u3063\u3066\u3044\u305F\u304B\u3063\u305F\u3002"
    Text_Es: "quer\xEDa esperarlo."
    Text_Pt: eu queria esperar.
    Text_Ru: "\u043C\u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
      \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C."
  - ID: Chapter_2_Front_1
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uC640 \uBCC4\uC744 \uBCF4\uB7EC \uAC00\uB294 \uB0A0\uC774\uBA74,"
    Text_En: Whenever Dad took me stargazing,
    Text_ZhHans: "\u6BCF\u6B21\u548C\u7238\u7238\u53BB\u770B\u661F\u661F\uFF0C"
    Text_Ja: "\u304A\u7236\u3055\u3093\u3068\u661F\u3092\u898B\u306B\u884C\u304F\u65E5\u306F\u3001"
    Text_Es: "Cuando \xEDbamos a ver las estrellas,"
    Text_Pt: "Quando \xEDamos ver as estrelas,"
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u0441 \u043F\u0430\u043F\u043E\u0439
      \u0435\u0445\u0430\u043B\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434\u044B,"
  - ID: Chapter_2_Front_2
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uB298 \uCC3D\uBB38 \uCABD\uC5D0 \uBD99\uC5B4 \uC549\uC558\uB2E4."
    Text_En: I always sat close to the window.
    Text_ZhHans: "\u6211\u603B\u662F\u7D27\u8D34\u7740\u8F66\u7A97\u5750\u3002"
    Text_Ja: "\u3044\u3064\u3082\u7A93\u306B\u5BC4\u308A\u6DFB\u3046\u3088\u3046\u306B\u5EA7\u3063\u3066\u3044\u305F\u3002"
    Text_Es: siempre me pegaba a la ventanilla.
    Text_Pt: "eu sempre me sentava junto \xE0 janela."
    Text_Ru: "\u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0430\u0434\u0438\u043B\u0430\u0441\u044C
      \u043F\u043E\u0431\u043B\u0438\u0436\u0435 \u043A \u043E\u043A\u043D\u0443."
  - ID: Chapter_2_Front_3
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC9C0\uB09C\uBC88 \uBCA4\uCE58\uC5D0\uC11C \uBCF4\uC558\uB358 \uBCC4\uC744"
    Text_En: I wanted to find the stars
    Text_ZhHans: "\u4E0A\u6B21\u5728\u957F\u6905\u4E0A\u770B\u5230\u7684\u661F\u661F\uFF0C"
    Text_Ja: "\u3053\u306E\u524D\u3001\u30D9\u30F3\u30C1\u304B\u3089\u898B\u305F\u661F\u3092\u3001"
    Text_Es: "Quer\xEDa encontrar aquellas estrellas"
    Text_Pt: Queria encontrar aquelas estrelas
    Text_Ru: "\u0417\u0432\u0451\u0437\u0434\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043C\u044B \u0432\u0438\u0434\u0435\u043B\u0438 \u0441\u043E \u0441\u043A\u0430\u043C\u0435\u0439\u043A\u0438,"
  - ID: Chapter_2_Front_4
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uB2EC\uB9AC\uB294 \uCC28 \uC548\uC5D0\uC11C\uB3C4 \uCC3E\uACE0 \uC2F6\uC5C8\uB2E4."
    Text_En: we'd seen from the bench.
    Text_ZhHans: "\u6211\u4E5F\u60F3\u5728\u884C\u9A76\u7684\u8F66\u91CC\u627E\u5230\u3002"
    Text_Ja: "\u8D70\u308B\u8ECA\u306E\u4E2D\u3067\u3082\u898B\u3064\u3051\u305F\u304B\u3063\u305F\u3002"
    Text_Es: "que hab\xEDamos visto desde el banco."
    Text_Pt: "que t\xEDnhamos visto do banco."
    Text_Ru: "\u043C\u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
      \u043D\u0430\u0439\u0442\u0438 \u0438 \u0438\u0437 \u043C\u0430\u0448\u0438\u043D\u044B."
  - ID: Chapter_2_Front_5
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60, \uC800\uAE30 \uBD10."
    Text_En: Dad, look.
    Text_ZhHans: "\u7238\u7238\uFF0C\u770B\u90A3\u8FB9\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u3001\u898B\u3066\u3002"
    Text_Es: "Pap\xE1, mira."
    Text_Pt: Papai, olha.
    Text_Ru: "\u041F\u0430\u043F\u0430, \u0441\u043C\u043E\u0442\u0440\u0438."
  - ID: Chapter_2_Front_6
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uBCC4\uB4E4\uC774 \uC6B0\uB9AC\uB97C \uB530\uB77C\uC624\uACE0 \uC788\uC5B4."
    Text_En: The stars are following us.
    Text_ZhHans: "\u661F\u661F\u5728\u8DDF\u7740\u6211\u4EEC\u8D70\u3002"
    Text_Ja: "\u661F\u304C\u3064\u3044\u3066\u304F\u308B\u3088\u3002"
    Text_Es: Las estrellas nos siguen.
    Text_Pt: "As estrelas est\xE3o seguindo a gente."
    Text_Ru: "\u0417\u0432\u0451\u0437\u0434\u044B \u0435\u0434\u0443\u0442 \u0437\u0430
      \u043D\u0430\u043C\u0438."
  - ID: Chapter_2_Front_7
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC6B0\uB9AC\uAC00 \uC6C0\uC9C1\uC774\uB2C8\uAE4C \uADF8\uB807\uAC8C
      \uBCF4\uC774\uB294 \uAC70\uC57C."
    Text_En: They look that way because we move.
    Text_ZhHans: "\u90A3\u662F\u56E0\u4E3A\u6211\u4EEC\u5728\u52A8\u3002"
    Text_Ja: "\u3053\u3063\u3061\u304C\u52D5\u304F\u304B\u3089\u3001\u305D\u3046\u898B\u3048\u308B\u3093\u3060\u3002"
    Text_Es: Lo parece porque nos movemos.
    Text_Pt: Parece, porque estamos nos movendo.
    Text_Ru: "\u0422\u0430\u043A \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u043C\u044B \u0434\u0432\u0438\u0436\u0435\u043C\u0441\u044F."
  - ID: Chapter_2_Front_8
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uADF8\uB7FC \uBCC4\uB4E4\uC740 \uC5B4\uB514\uB85C \uAC00\uB294 \uAC74\uB370?"
    Text_En: Then where are the stars going?
    Text_ZhHans: "\u90A3\u661F\u661F\u8981\u53BB\u54EA\u513F\u5462\uFF1F"
    Text_Ja: "\u3058\u3083\u3042\u3001\u661F\u306F\u3069\u3053\u306B\u884C\u304F\u306E\uFF1F"
    Text_Es: "Entonces, \xBFad\xF3nde van ellas?"
    Text_Pt: "Ent\xE3o para onde elas est\xE3o indo?"
    Text_Ru: "\u0410 \u043A\u0443\u0434\u0430 \u0435\u0434\u0443\u0442 \u0441\u0430\u043C\u0438
      \u0437\u0432\u0451\u0437\u0434\u044B?"
  - ID: Chapter_2_Front_9
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC800 \uBA40\uB9AC \uADF8\uB300\uB85C \uC788\uB294 \uAC70\uC9C0."
    Text_En: They're staying far away.
    Text_ZhHans: "\u5B83\u4EEC\u4E00\u76F4\u5F85\u5728\u5F88\u8FDC\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u305A\u3063\u3068\u9060\u304F\u306B\u3044\u308B\u3093\u3060\u3088\u3002"
    Text_Es: "Se quedan all\xED, muy lejos."
    Text_Pt: "Elas ficam l\xE1 longe, no mesmo lugar."
    Text_Ru: "\u041E\u043D\u0438 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u0442\u0430\u043C, \u0434\u0430\u043B\u0435\u043A\u043E."
  - ID: Chapter_2_Front_10
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC6B0\uB9AC\uB9CC \uC9C0\uB098\uAC00\uB294 \uAC70\uC57C."
    Text_En: We're the ones passing by.
    Text_ZhHans: "\u53EA\u662F\u6211\u4EEC\u5728\u7ECF\u8FC7\u3002"
    Text_Ja: "\u901A\u308A\u904E\u304E\u308B\u306E\u306F\u3001\u79C1\u305F\u3061\u3060\u3051\u3055\u3002"
    Text_Es: Solo nosotros pasamos.
    Text_Pt: "S\xF3 n\xF3s estamos passando."
    Text_Ru: "\u042D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u044B
      \u043F\u0440\u043E\u0435\u0437\u0436\u0430\u0435\u043C \u043C\u0438\u043C\u043E."
  - ID: Chapter_2_Front_11
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uADF8\uB7F0\uB370 \uC5B4\uB5BB\uAC8C \uACC4\uC18D \uBCF4\uC5EC?"
    Text_En: But why can we still see them?
    Text_ZhHans: "\u53EF\u4E3A\u4EC0\u4E48\u8FD8\u80FD\u4E00\u76F4\u770B\u89C1\uFF1F"
    Text_Ja: "\u3067\u3082\u3001\u3069\u3046\u3057\u3066\u305A\u3063\u3068\u898B\u3048\u308B\u306E\uFF1F"
    Text_Es: "\xBFY por qu\xE9 a\xFAn podemos verlas?"
    Text_Pt: "Mas por que ainda d\xE1 para ver?"
    Text_Ru: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0447\u0435\u043C\u0443
      \u0438\u0445 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0432\u0438\u0434\u043D\u043E?"
  - ID: Chapter_2_Front_12
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC9D1\uB3C4 \uB098\uBB34\uB3C4 \uB2E4 \uC9C0\uB098\uAC14\uB294\uB370."
    Text_En: The houses and trees are all gone.
    Text_ZhHans: "\u623F\u5B50\u548C\u6811\u90FD\u8FC7\u53BB\u4E86\u3002"
    Text_Ja: "\u5BB6\u3082\u6728\u3082\u3001\u3082\u3046\u901A\u308A\u904E\u304E\u305F\u306E\u306B\u3002"
    Text_Es: "Las casas y los \xE1rboles ya quedaron atr\xE1s."
    Text_Pt: "As casas e as \xE1rvores j\xE1 ficaram para tr\xE1s."
    Text_Ru: "\u0414\u043E\u043C\u0430 \u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F
      \u0443\u0436\u0435 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043F\u043E\u0437\u0430\u0434\u0438."
  - ID: Chapter_2_Front_13
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uBCC4\uC740 \uADF8\uAC83\uBCF4\uB2E4 \uD6E8\uC52C \uBA40\uB9AC \uC788\uAC70\uB4E0."
    Text_En: The stars are much farther away.
    Text_ZhHans: "\u56E0\u4E3A\u661F\u661F\u6BD4\u5B83\u4EEC\u8FDC\u5F97\u591A\u3002"
    Text_Ja: "\u661F\u306F\u3001\u305D\u308C\u3088\u308A\u305A\u3063\u3068\u9060\u3044\u304B\u3089\u306D\u3002"
    Text_Es: "Porque las estrellas est\xE1n mucho m\xE1s lejos."
    Text_Pt: "As estrelas est\xE3o muito mais longe."
    Text_Ru: "\u0417\u0432\u0451\u0437\u0434\u044B \u0433\u043E\u0440\u0430\u0437\u0434\u043E
      \u0434\u0430\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043E\u043D\u0438."
  - ID: Chapter_2_Front_14
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB294 \uAE38\uAC00\uC5D0 \uCC28\uB97C \uC138\uC6E0\uB2E4."
    Text_En: Dad pulled over.
    Text_ZhHans: "\u7238\u7238\u628A\u8F66\u505C\u5728\u8DEF\u8FB9\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u306F\u9053\u7AEF\u306B\u8ECA\u3092\u6B62\u3081\u305F\u3002"
    Text_Es: "Pap\xE1 detuvo el coche junto al camino."
    Text_Pt: "Papai parou o carro \xE0 beira da estrada."
    Text_Ru: "\u041F\u0430\u043F\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B
      \u043C\u0430\u0448\u0438\u043D\u0443 \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B."
  - ID: Chapter_2_Front_15
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uCC28\uAC00 \uBA48\uCDC4\uB294\uB370\uB3C4,"
    Text_En: Even after the car stopped,
    Text_ZhHans: "\u8F66\u505C\u4E0B\u4E86\uFF0C"
    Text_Ja: "\u8ECA\u304C\u6B62\u307E\u3063\u3066\u3082\u3001"
    Text_Es: "Aunque el coche se hab\xEDa parado,"
    Text_Pt: Mesmo com o carro parado,
    Text_Ru: "\u041C\u0430\u0448\u0438\u043D\u0430 \u0441\u0442\u043E\u044F\u043B\u0430,"
  - ID: Chapter_2_Front_16
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uBCC4\uB4E4\uC740 \uC5EC\uC804\uD788 \uCC3D\uBC16\uC5D0 \uC788\uC5C8\uB2E4."
    Text_En: the stars stayed outside my window.
    Text_ZhHans: "\u661F\u661F\u5374\u4F9D\u7136\u5728\u7A97\u5916\u3002"
    Text_Ja: "\u661F\u306F\u307E\u3060\u7A93\u306E\u5916\u306B\u3042\u3063\u305F\u3002"
    Text_Es: "las estrellas segu\xEDan al otro lado."
    Text_Pt: as estrelas continuavam na janela.
    Text_Ru: "\u0430 \u0437\u0432\u0451\u0437\u0434\u044B \u0432\u0441\u0451 \u0435\u0449\u0451
      \u0431\u044B\u043B\u0438 \u0437\u0430 \u043E\u043A\u043D\u043E\u043C."
  - ID: Chapter_2_Front_17
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC5C4\uB9C8\uAC00 \uC788\uB294 \uBCC4\uB3C4 \uBCF4\uC5EC?"
    Text_En: Can you see Mom's star?
    Text_ZhHans: "\u80FD\u770B\u89C1\u5988\u5988\u5728\u7684\u90A3\u9897\u661F\u5417\uFF1F"
    Text_Ja: "\u304A\u6BCD\u3055\u3093\u306E\u661F\u3082\u898B\u3048\u308B\uFF1F"
    Text_Es: "\xBFVes la estrella donde est\xE1 mam\xE1?"
    Text_Pt: "D\xE1 para ver a estrela da mam\xE3e?"
    Text_Ru: "\u0410 \u043C\u0430\u043C\u0438\u043D\u0443 \u0437\u0432\u0435\u0437\u0434\u0443
      \u0432\u0438\u0434\u043D\u043E?"
  - ID: Chapter_2_Front_18
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC751. \uC800\uBC88\uC5D0 \uAC19\uC774 \uCC3E\uC558\uB358 \uD070\uACF0\uC790\uB9AC."
    Text_En: Yes. The Great Bear we found.
    Text_ZhHans: "\u55EF\uFF0C\u5C31\u662F\u4E0A\u6B21\u4E00\u8D77\u627E\u7684\u5927\u718A\u5EA7\u3002"
    Text_Ja: "\u3042\u3042\u3002\u3053\u306E\u524D\u4E00\u7DD2\u306B\u63A2\u3057\u305F\u3001\u304A\u304A\u3050\u307E\u5EA7\u3060\u3002"
    Text_Es: "S\xED. La Osa Mayor que encontramos."
    Text_Pt: Sim. A Ursa Maior que encontramos.
    Text_Ru: "\u0414\u0430. \u041F\u043E\u043C\u043D\u0438\u0448\u044C \u0411\u043E\u043B\u044C\u0448\u0443\u044E
      \u041C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u0443?"
  - ID: Chapter_2_Front_19
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uAE30\uC5B5\uB098?"
    Text_En: Remember?
    Text_ZhHans: "\u8FD8\u8BB0\u5F97\u5417\uFF1F"
    Text_Ja: "\u899A\u3048\u3066\u308B\u304B\u3044\uFF1F"
    Text_Es: "\xBFTe acuerdas?"
    Text_Pt: Lembra?
    Text_Ru: "\u041C\u044B \u043D\u0430\u0448\u043B\u0438 \u0435\u0451 \u0432 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
      \u0440\u0430\u0437."
  - ID: Chapter_2_Front_20
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC751. \uD070 \uACF0."
    Text_En: Yeah. The big bear.
    Text_ZhHans: "\u8BB0\u5F97\uFF0C\u5927\u718A\u3002"
    Text_Ja: "\u3046\u3093\u3002\u5927\u304D\u306A\u30AF\u30DE\u3002"
    Text_Es: "S\xED. La osa grande."
    Text_Pt: Sim. A ursa grande.
    Text_Ru: "\u0414\u0430. \u0411\u043E\u043B\u044C\u0448\u0443\u044E \u043C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u0443."
  - ID: Chapter_2_Front_21
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uADF8 \uADFC\uCC98\uC5D0\uB294 \uC791\uC740\uACF0\uC790\uB9AC\uB3C4
      \uC788\uC5B4."
    Text_En: There's a Little Bear nearby, too.
    Text_ZhHans: "\u5B83\u9644\u8FD1\u8FD8\u6709\u5C0F\u718A\u5EA7\u3002"
    Text_Ja: "\u305D\u306E\u8FD1\u304F\u306B\u306F\u3001\u3053\u3050\u307E\u5EA7\u3082\u3042\u308B\u3093\u3060\u3002"
    Text_Es: "Cerca tambi\xE9n est\xE1 la Osa Menor."
    Text_Pt: "Perto dela tamb\xE9m fica a Ursa Menor."
    Text_Ru: "\u0410 \u0440\u044F\u0434\u043E\u043C \u0435\u0441\u0442\u044C \u0438
      \u041C\u0430\u043B\u0430\u044F \u041C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u0430."
  - ID: Chapter_2_Front_22
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC791\uC740 \uACF0\uB3C4 \uC788\uC5B4?"
    Text_En: There's a little one?
    Text_ZhHans: "\u8FD8\u6709\u5C0F\u718A\uFF1F"
    Text_Ja: "\u5C0F\u3055\u306A\u30AF\u30DE\u3082\u3044\u308B\u306E\uFF1F"
    Text_Es: "\xBFHay una osa peque\xF1a?"
    Text_Pt: Tem uma ursa pequena?
    Text_Ru: "\u0415\u0449\u0451 \u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F?"
  - ID: Chapter_2_Front_23
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB798. \uC61B\uB0A0 \uC0AC\uB78C\uB4E4\uC740"
    Text_En: Yes. Long ago,
    Text_ZhHans: "\u5BF9\uFF0C\u5F88\u4E45\u4EE5\u524D\u7684\u4EBA\u4EEC\uFF0C"
    Text_Ja: "\u3042\u3042\u3002\u6614\u306E\u4EBA\u305F\u3061\u306F\u3001"
    Text_Es: "S\xED. Hace mucho tiempo,"
    Text_Pt: "Sim. H\xE1 muito tempo,"
    Text_Ru: "\u0414\u0430. \u0414\u0430\u0432\u043D\u044B\u043C-\u0434\u0430\u0432\u043D\u043E
      \u043B\u044E\u0434\u0438"
  - ID: Chapter_2_Front_24
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC791\uC740\uACF0\uC790\uB9AC\uC758 \uB05D\uC5D0 \uC788\uB294 \uBD81\uADF9\uC131\uC774\uB77C\uB294
      \uBCC4\uC744 \uBCF4\uACE0"
    Text_En: people used Polaris at its tail
    Text_ZhHans: "\u4F1A\u770B\u5C0F\u718A\u5EA7\u5C3E\u5DF4\u4E0A\u7684\u5317\u6781\u661F\uFF0C"
    Text_Ja: "\u3053\u3050\u307E\u5EA7\u306E\u3057\u3063\u307D\u306B\u3042\u308B\u5317\u6975\u661F\u3092\u898B\u3066\u3001"
    Text_Es: la gente miraba la Polar, en su cola,
    Text_Pt: as pessoas olhavam a Polar, na cauda dela,
    Text_Ru: "\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043D\u0430 \u041F\u043E\u043B\u044F\u0440\u043D\u0443\u044E
      \u0437\u0432\u0435\u0437\u0434\u0443 \u0432 \u0435\u0451 \u0445\u0432\u043E\u0441\u0442\u0435,"
  - ID: Chapter_2_Front_25
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC5B4\uB290 \uCABD\uC774 \uBD81\uCABD\uC778\uC9C0 \uC54C\uC544\uB0C8\uB2E8\uB2E4."
    Text_En: to find their way north.
    Text_ZhHans: "\u6765\u8FA8\u8BA4\u54EA\u8FB9\u662F\u5317\u65B9\u3002"
    Text_Ja: "\u5317\u304C\u3069\u3061\u3089\u304B\u8ABF\u3079\u305F\u3093\u3060\u3002"
    Text_Es: "para saber d\xF3nde estaba el norte."
    Text_Pt: para saber onde ficava o norte.
    Text_Ru: "\u0447\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C,
      \u0433\u0434\u0435 \u0441\u0435\u0432\u0435\u0440."
  - ID: Chapter_2_Front_26
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uAE38\uC744 \uC783\uC5C8\uC744 \uB54C?"
    Text_En: When they got lost?
    Text_ZhHans: "\u8FF7\u8DEF\u7684\u65F6\u5019\u5417\uFF1F"
    Text_Ja: "\u8FF7\u5B50\u306B\u306A\u3063\u305F\u3068\u304D\uFF1F"
    Text_Es: "\xBFCu\xE1ndo se perd\xEDan?"
    Text_Pt: Quando se perdiam?
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430 \u0442\u0435\u0440\u044F\u043B\u0438\u0441\u044C?"
  - ID: Chapter_2_Front_27
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC751. \uC5B4\uB514\uB85C \uAC00\uC57C \uD560\uC9C0 \uBAA8\uB97C \uB54C"
    Text_En: Yes. When they didn't know the way,
    Text_ZhHans: "\u55EF\uFF0C\u4E0D\u77E5\u9053\u8BE5\u5F80\u54EA\u513F\u8D70\u7684\u65F6\u5019\uFF0C"
    Text_Ja: "\u305D\u3046\u3002\u3069\u3053\u3078\u884C\u3051\u3070\u3044\u3044\u304B\u5206\u304B\u3089\u306A\u3044\u3068\u304D\u3001"
    Text_Es: "S\xED. Cuando no sab\xEDan ad\xF3nde ir,"
    Text_Pt: "Sim. Quando n\xE3o sabiam aonde ir,"
    Text_Ru: "\u0414\u0430. \u041A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0437\u043D\u0430\u043B\u0438,
      \u043A\u0443\u0434\u0430 \u0438\u0434\u0442\u0438,"
  - ID: Chapter_2_Front_28
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC791\uC740\uACF0\uC790\uB9AC\uB294 \uC5B8\uC81C\uB098 \uAE38\uC7A1\uC774\uAC00
      \uB418\uC5B4\uC8FC\uC5C8\uC5B4."
    Text_En: the Little Bear would guide them.
    Text_ZhHans: "\u5C0F\u718A\u5EA7\u603B\u4F1A\u4E3A\u4EBA\u4EEC\u6307\u8DEF\u3002"
    Text_Ja: "\u3053\u3050\u307E\u5EA7\u306F\u3044\u3064\u3082\u9053\u3057\u308B\u3079\u306B\u306A\u3063\u305F\u3002"
    Text_Es: la Osa Menor les mostraba el camino.
    Text_Pt: a Ursa Menor mostrava o caminho.
    Text_Ru: "\u041C\u0430\u043B\u0430\u044F \u041C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u0430
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430 \u0438\u043C \u043F\u0443\u0442\u044C."
  - ID: Chapter_2_Front_29
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uB450 \uBCC4\uC790\uB9AC\uB97C \uBC88\uAC08\uC544 \uBC14\uB77C\uBD24\uB2E4."
    Text_En: I looked from one bear to the other.
    Text_ZhHans: "\u6211\u6765\u56DE\u671B\u7740\u4E24\u4E2A\u661F\u5EA7\u3002"
    Text_Ja: "\u79C1\u306F\u4E8C\u3064\u306E\u661F\u5EA7\u3092\u4EA4\u4E92\u306B\u898B\u305F\u3002"
    Text_Es: "Mir\xE9 las dos constelaciones."
    Text_Pt: "Olhei de uma constela\xE7\xE3o para a outra."
    Text_Ru: "\u042F \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u043B\u0430
      \u0432\u0437\u0433\u043B\u044F\u0434 \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F\u043C\u0438."
  - ID: Chapter_2_Front_30
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uD070 \uACF0\uC740 \uC5C4\uB9C8\uACE0,"
    Text_En: If the big bear is Mom,
    Text_ZhHans: "\u5927\u718A\u662F\u5988\u5988\uFF0C"
    Text_Ja: "\u5927\u304D\u306A\u30AF\u30DE\u304C\u304A\u6BCD\u3055\u3093\u3067\u3001"
    Text_Es: "Si la osa grande es mam\xE1,"
    Text_Pt: "Se a ursa grande \xE9 a mam\xE3e,"
    Text_Ru: "\u0415\u0441\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u0430 \u2014 \u043C\u0430\u043C\u0430,"
  - ID: Chapter_2_Front_31
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC791\uC740 \uACF0\uC740 \uB098\uC778\uAC00?"
    Text_En: am I the little one?
    Text_ZhHans: "\u90A3\u5C0F\u718A\u662F\u6211\u5417\uFF1F"
    Text_Ja: "\u5C0F\u3055\u306A\u30AF\u30DE\u306F\u79C1\uFF1F"
    Text_Es: "\xBFyo soy la peque\xF1a?"
    Text_Pt: eu sou a pequena?
    Text_Ru: "\u0442\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u2014 \u044F?"
  - ID: Chapter_2_Front_32
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB807\uAC8C \uC0DD\uAC01\uD574\uB3C4 \uB418\uACA0\uB124."
    Text_En: You could think of it that way.
    Text_ZhHans: "\u8FD9\u4E48\u60F3\u4E5F\u53EF\u4EE5\u3002"
    Text_Ja: "\u305D\u3046\u8003\u3048\u3066\u3082\u3044\u3044\u306D\u3002"
    Text_Es: "Puedes verlo as\xED."
    Text_Pt: Pode pensar assim.
    Text_Ru: "\u041C\u043E\u0436\u043D\u043E \u0438 \u0442\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C."
  - ID: Chapter_2_Front_33
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uADF8\uB7FC \uC544\uBE60\uB791 \uBCFC \uB54C\uB294 \uC544\uBE60\uAC00
      \uD070 \uACF0\uC774\uC57C."
    Text_En: Then when we're here, you're the big one.
    Text_ZhHans: "\u90A3\u548C\u7238\u7238\u770B\u661F\u661F\u65F6\uFF0C\u7238\u7238\u5C31\u662F\u5927\u718A\u3002"
    Text_Ja: "\u3058\u3083\u3042\u3001\u4E00\u7DD2\u306B\u898B\u308B\u3068\u304D\u306F\u304A\u7236\u3055\u3093\u304C\u5927\u304D\u306A\u30AF\u30DE\u3002"
    Text_Es: "Entonces, contigo, t\xFA eres la grande."
    Text_Pt: "Ent\xE3o, quando estou com voc\xEA, voc\xEA \xE9 a grande."
    Text_Ru: "\u0422\u043E\u0433\u0434\u0430 \u0441 \u0442\u043E\u0431\u043E\u0439
      \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u0430
      \u2014 \u044D\u0442\u043E \u0442\u044B."
  - ID: Chapter_2_Front_34
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC791\uC740 \uACF0\uC774\uACE0."
    Text_En: And I'm the little one.
    Text_ZhHans: "\u6211\u662F\u5C0F\u718A\u3002"
    Text_Ja: "\u79C1\u306F\u5C0F\u3055\u306A\u30AF\u30DE\u306D\u3002"
    Text_Es: "Y yo soy la peque\xF1a."
    Text_Pt: E eu sou a pequena.
    Text_Ru: "\u0410 \u044F \u2014 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F."
  - ID: Chapter_2_Front_35
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB294 \uC6C3\uC73C\uBA70 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    Text_En: Dad smiled and nodded.
    Text_ZhHans: "\u7238\u7238\u7B11\u7740\u70B9\u4E86\u70B9\u5934\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u306F\u7B11\u3063\u3066\u3046\u306A\u305A\u3044\u305F\u3002"
    Text_Es: "Pap\xE1 sonri\xF3 y asinti\xF3."
    Text_Pt: Papai sorriu e concordou.
    Text_Ru: "\u041F\u0430\u043F\u0430 \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B."
  - ID: Chapter_2_Front_36
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB3C4 \uC800 \uBCC4 \uBCF4\uACE0 \uAE38\uC744 \uCC3E\uC544?"
    Text_En: Do you use that star to find your way?
    Text_ZhHans: "\u7238\u7238\u4E5F\u770B\u90A3\u9897\u661F\u627E\u8DEF\u5417\uFF1F"
    Text_Ja: "\u304A\u7236\u3055\u3093\u3082\u3001\u3042\u306E\u661F\u3067\u9053\u3092\u63A2\u3059\u306E\uFF1F"
    Text_Es: "\xBFT\xFA tambi\xE9n te gu\xEDas por esa estrella?"
    Text_Pt: "Voc\xEA tamb\xE9m usa essa estrela para se guiar?"
    Text_Ru: "\u0422\u044B \u0442\u043E\u0436\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C
      \u043F\u0443\u0442\u044C \u043F\u043E \u044D\u0442\u043E\u0439 \u0437\u0432\u0435\u0437\u0434\u0435?"
  - ID: Chapter_2_Front_37
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB7FC. \uC774\uACF3\uC5D0 \uC624\uB294 \uAE38\uB3C4"
    Text_En: Of course. I wrote the way here
    Text_ZhHans: "\u5F53\u7136\uFF0C\u8FDE\u6765\u8FD9\u91CC\u7684\u8DEF\uFF0C"
    Text_Ja: "\u3082\u3061\u308D\u3093\u3002\u3053\u3053\u307E\u3067\u306E\u9053\u3082\u3001"
    Text_Es: Claro. Hasta el camino a este lugar
    Text_Pt: "Claro. At\xE9 o caminho para c\xE1"
    Text_Ru: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E. \u0414\u0430\u0436\u0435
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0441\u044E\u0434\u0430"
  - ID: Chapter_2_Front_38
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC218\uCCA9\uC5D0 \uC800 \uBCC4\uACFC \uD568\uAED8 \uC801\uC5B4\uB480\uB2E8\uB2E4."
    Text_En: in my notebook, beside that star.
    Text_ZhHans: "\u6211\u90FD\u548C\u90A3\u9897\u661F\u4E00\u8D77\u8BB0\u5728\u672C\u5B50\u91CC\u4E86\u3002"
    Text_Ja: "\u3042\u306E\u661F\u3068\u4E00\u7DD2\u306B\u624B\u5E33\u306B\u66F8\u3044\u3066\u3042\u308B\u3088\u3002"
    Text_Es: "lo anot\xE9 en mi cuaderno junto a ella."
    Text_Pt: "est\xE1 no meu caderno, junto dessa estrela."
    Text_Ru: "\u044F \u0437\u0430\u043F\u0438\u0441\u0430\u043B \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0435\u0439."
  - ID: Chapter_2_Front_39
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB3C4 \uC54C\uB824\uC918."
    Text_En: Teach me, too.
    Text_ZhHans: "\u4E5F\u6559\u6559\u6211\u5427\u3002"
    Text_Ja: "\u79C1\u306B\u3082\u6559\u3048\u3066\u3002"
    Text_Es: "Ens\xE9\xF1ame a m\xED tambi\xE9n."
    Text_Pt: "Me ensina tamb\xE9m."
    Text_Ru: "\u041D\u0430\u0443\u0447\u0438 \u0438 \u043C\u0435\u043D\u044F."
  - ID: Chapter_2_Front_40
    Chapter_Id: 2_Front
    Speaker: Daughter
    Text_Kr: "\uD63C\uC790\uC11C\uB3C4 \uCC3E\uC744 \uC218 \uC788\uAC8C."
    Text_En: So I can find it on my own.
    Text_ZhHans: "\u8FD9\u6837\u6211\u81EA\u5DF1\u4E5F\u80FD\u627E\u5230\u3002"
    Text_Ja: "\u4E00\u4EBA\u3067\u3082\u898B\u3064\u3051\u3089\u308C\u308B\u3088\u3046\u306B\u3002"
    Text_Es: Para encontrarlo yo sola.
    Text_Pt: Para eu achar sozinha.
    Text_Ru: "\u0427\u0442\u043E\u0431\u044B \u044F \u043C\u043E\u0433\u043B\u0430
      \u043D\u0430\u0439\u0442\u0438 \u0441\u0430\u043C\u0430."
  - ID: Chapter_2_Front_41
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB798. \uADF8\uB7FC \uC791\uC740\uACF0\uC790\uB9AC\uBD80\uD130
      \uCC3E\uC544\uBCF4\uC790."
    Text_En: All right. Let's find the Little Bear.
    Text_ZhHans: "\u597D\uFF0C\u90A3\u5148\u627E\u627E\u5C0F\u718A\u5EA7\u5427\u3002"
    Text_Ja: "\u3042\u3042\u3002\u3058\u3083\u3042\u3001\u3053\u3050\u307E\u5EA7\u304B\u3089\u63A2\u305D\u3046\u3002"
    Text_Es: Bien. Busquemos primero la Osa Menor.
    Text_Pt: Claro. Vamos achar a Ursa Menor primeiro.
    Text_Ru: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043D\u0430\u0439\u0434\u0451\u043C \u041C\u0430\u043B\u0443\u044E \u041C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u0443."
  - ID: Chapter_2_Front_42
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uC5B4\uB5A4 \uBCC4\uB4E4\uC774 \uC774\uC5B4\uC9C0\uB294\uC9C0"
    Text_En: Take your time
    Text_ZhHans: "\u770B\u770B\u54EA\u4E9B\u661F\u661F\u80FD\u8FDE\u5728\u4E00\u8D77\uFF0C"
    Text_Ja: "\u3069\u306E\u661F\u304C\u3064\u306A\u304C\u308B\u306E\u304B\u3001"
    Text_Es: "Mira qu\xE9 estrellas se unen."
    Text_Pt: Veja quais estrelas se ligam.
    Text_Ru: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u043A\u0430\u043A\u0438\u0435
      \u0437\u0432\u0451\u0437\u0434\u044B \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F."
  - ID: Chapter_2_Front_43
    Chapter_Id: 2_Front
    Speaker: Father
    Text_Kr: "\uCC9C\uCC9C\uD788 \uC0B4\uD3B4\uBCF4\uB834."
    Text_En: and see which stars connect.
    Text_ZhHans: "\u6162\u6162\u627E\u3002"
    Text_Ja: "\u3086\u3063\u304F\u308A\u898B\u3066\u3054\u3089\u3093\u3002"
    Text_Es: "T\xF3mate tu tiempo."
    Text_Pt: Pode olhar com calma.
    Text_Ru: "\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0441\u043F\u0435\u0448\u0438."
  - ID: Chapter_2_Back_1
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uD5E4\uB4DC\uB77C\uC774\uD2B8\uAC00 \uC881\uC740 \uC0B0\uAE38\uC744
      \uBE44\uCDC4\uB2E4."
    Text_En: Our headlights lit the narrow road.
    Text_ZhHans: "\u8F66\u706F\u7167\u4EAE\u4E86\u72ED\u7A84\u7684\u5C71\u8DEF\u3002"
    Text_Ja: "\u30D8\u30C3\u30C9\u30E9\u30A4\u30C8\u304C\u7D30\u3044\u5C71\u9053\u3092\u7167\u3089\u3057\u305F\u3002"
    Text_Es: Los faros alumbraban el estrecho camino.
    Text_Pt: "Os far\xF3is iluminavam a estrada estreita."
    Text_Ru: "\u0424\u0430\u0440\u044B \u043E\u0441\u0432\u0435\u0449\u0430\u043B\u0438
      \u0443\u0437\u043A\u0443\u044E \u0433\u043E\u0440\u043D\u0443\u044E \u0434\u043E\u0440\u043E\u0433\u0443."
  - ID: Chapter_2_Back_2
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uAC00\uB85C\uB4F1\uC740 \uD55C\uCC38 \uC804\uC5D0 \uB04A\uACBC\uACE0,"
    Text_En: The streetlights were far behind us.
    Text_ZhHans: "\u8DEF\u706F\u65E9\u5DF2\u6D88\u5931\u5728\u8EAB\u540E\uFF0C"
    Text_Ja: "\u8857\u706F\u306F\u3001\u305A\u3044\u3076\u3093\u524D\u306B\u9014\u5207\u308C\u3001"
    Text_Es: "Hac\xEDa rato que no hab\xEDa farolas."
    Text_Pt: "Os postes tinham ficado para tr\xE1s."
    Text_Ru: "\u0424\u043E\u043D\u0430\u0440\u0438 \u0434\u0430\u0432\u043D\u043E
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043F\u043E\u0437\u0430\u0434\u0438."
  - ID: Chapter_2_Back_3
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uCC3D\uBC16\uC5D0\uB294 \uB098\uBB34\uB4E4\uB9CC \uC9C0\uB098\uAC14\uB2E4."
    Text_En: Only trees passed outside.
    Text_ZhHans: "\u7A97\u5916\u53EA\u6709\u6811\u6728\u4E0D\u65AD\u63A0\u8FC7\u3002"
    Text_Ja: "\u7A93\u306E\u5916\u3092\u6728\u3005\u3060\u3051\u304C\u6D41\u308C\u3066\u3044\u305F\u3002"
    Text_Es: "Solo pasaban \xE1rboles tras la ventanilla."
    Text_Pt: "S\xF3 \xE1rvores passavam pela janela."
    Text_Ru: "\u0417\u0430 \u043E\u043A\u043D\u043E\u043C \u043C\u0435\u043B\u044C\u043A\u0430\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u0440\u0435\u0432\u044C\u044F."
  - ID: Chapter_2_Back_4
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC774 \uC0AC\uAC74\uC758 \uC2E4\uB9C8\uB9AC\uB97C \uD480 \uC218 \uC788\uB294
      \uAC83\uC740"
    Text_En: Our lead in this case
    Text_ZhHans: "\u80FD\u89E3\u5F00\u8FD9\u8D77\u6848\u4EF6\u7684\u7EBF\u7D22\uFF0C"
    Text_Ja: "\u3053\u306E\u4E8B\u4EF6\u3092\u89E3\u304F\u624B\u304C\u304B\u308A\u306F\u3001"
    Text_Es: La clave para resolver el caso
    Text_Pt: A pista para desvendar o caso
    Text_Ru: "\u0417\u0430\u0446\u0435\u043F\u043A\u043E\u0439 \u0432 \u044D\u0442\u043E\u043C
      \u0434\u0435\u043B\u0435"
  - ID: Chapter_2_Back_5
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB0B4 \uC190\uC5D0 \uB4E0 \uC218\uCCA9 \uAE30\uB85D\uC758 \uC0AC\uBCF8\uC774\uC5C8\uB2E4."
    Text_En: was the notebook copy in my hands.
    Text_ZhHans: "\u5C31\u662F\u6211\u624B\u4E2D\u7684\u7B14\u8BB0\u590D\u5370\u4EF6\u3002"
    Text_Ja: "\u624B\u5143\u306B\u3042\u308B\u624B\u5E33\u306E\u30B3\u30D4\u30FC\u3060\u3063\u305F\u3002"
    Text_Es: era la copia que llevaba en las manos.
    Text_Pt: "era a c\xF3pia do caderno em minhas m\xE3os."
    Text_Ru: "\u0431\u044B\u043B\u0430 \u043A\u043E\u043F\u0438\u044F \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430
      \u0432 \u043C\u043E\u0438\u0445 \u0440\u0443\u043A\u0430\u0445."
  - ID: Chapter_2_Back_6
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uADF8\uC758 \uCC45\uC0C1\uC5D0\uC11C \uD655\uBCF4\uD55C \uC218\uCCA9."
    Text_En: We'd found the original on his desk.
    Text_ZhHans: "\u539F\u672C\u662F\u5728\u4ED6\u7684\u4E66\u684C\u4E0A\u627E\u5230\u7684\u3002"
    Text_Ja: "\u5F7C\u306E\u673A\u304B\u3089\u62BC\u53CE\u3057\u305F\u624B\u5E33\u3002"
    Text_Es: El cuaderno hallado en su escritorio.
    Text_Pt: O original estava na mesa dele.
    Text_Ru: "\u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B \u043D\u0430\u0448\u043B\u0438
      \u043D\u0430 \u0435\u0433\u043E \u0441\u0442\u043E\u043B\u0435."
  - ID: Chapter_2_Back_7
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uADF8 \uC548\uC758 \uACBD\uB85C\uB97C \uB098\uB220 \uB9E1\uC544"
    Text_En: We'd split its routes among the teams.
    Text_ZhHans: "\u6211\u4EEC\u628A\u5176\u4E2D\u7684\u8DEF\u7EBF\u5206\u914D\u4E0B\u53BB\uFF0C"
    Text_Ja: "\u305D\u3053\u306B\u8A18\u3055\u308C\u305F\u9053\u3092\u5206\u62C5\u3057\u3001"
    Text_Es: "Hab\xEDamos repartido sus rutas"
    Text_Pt: Dividimos as rotas entre as equipes,
    Text_Ru: "\u041C\u044B \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u043B\u0438
      \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B,"
  - ID: Chapter_2_Back_8
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uAC01 \uC218\uC0C9\uD300\uC774 \uC6C0\uC9C1\uC774\uACE0 \uC788\uC5C8\uB2E4."
    Text_En: Each team was now searching.
    Text_ZhHans: "\u5404\u641C\u67E5\u7EC4\u6B63\u5206\u5934\u884C\u52A8\u3002"
    Text_Ja: "\u5404\u635C\u7D22\u73ED\u304C\u52D5\u3044\u3066\u3044\u305F\u3002"
    Text_Es: "entre los equipos de b\xFAsqueda."
    Text_Pt: que agora seguiam por elas.
    Text_Ru: "\u0438 \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u044B\u0435 \u0433\u0440\u0443\u043F\u043F\u044B
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C \u043F\u043E
      \u043D\u0438\u043C."
  - ID: Chapter_2_Back_9
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uBC18\uC7A5\uB2D8, \uAC08\uB9BC\uAE38\uC785\uB2C8\uB2E4."
    Text_En: Chief, there's a fork ahead.
    Text_ZhHans: "\u961F\u957F\uFF0C\u524D\u9762\u6709\u5C94\u8DEF\u3002"
    Text_Ja: "\u73ED\u9577\u3001\u5206\u304B\u308C\u9053\u3067\u3059\u3002"
    Text_Es: "Jefe, hay una bifurcaci\xF3n."
    Text_Pt: "Chefe, uma bifurca\xE7\xE3o."
    Text_Ru: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A, \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0430."
  - ID: Chapter_2_Back_10
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC624\uB978\uCABD\uC73C\uB85C \uAC00."
    Text_En: Take the right.
    Text_ZhHans: "\u5F80\u53F3\u3002"
    Text_Ja: "\u53F3\u3060\u3002"
    Text_Es: A la derecha.
    Text_Pt: "\xC0 direita."
    Text_Ru: "\u041D\u0430\u043F\u0440\u0430\u0432\u043E."
  - ID: Chapter_2_Back_11
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC870\uAE08 \uB354 \uAC00\uBA74 \uAE38\uC774 \uB05D\uB0A0 \uAC70\uC57C."
    Text_En: The road should end soon.
    Text_ZhHans: "\u518D\u8D70\u4E00\u6BB5\uFF0C\u8DEF\u5C31\u5230\u5934\u4E86\u3002"
    Text_Ja: "\u3082\u3046\u5C11\u3057\u884C\u304F\u3068\u9053\u304C\u7D42\u308F\u308B\u3002"
    Text_Es: "El camino acabar\xE1 un poco m\xE1s adelante."
    Text_Pt: "A estrada deve acabar logo \xE0 frente."
    Text_Ru: "\u0427\u0443\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F."
  - ID: Chapter_2_Back_12
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC800\uAE30\uC11C\uBD80\uD130\uB294 \uAC78\uC5B4\uAC00\uC57C \uD55C\uB2F5\uB2C8\uAE4C?"
    Text_En: Do we go on foot from there?
    Text_ZhHans: "\u4ECE\u90A3\u91CC\u5F00\u59CB\u8981\u6B65\u884C\u5417\uFF1F"
    Text_Ja: "\u305D\u3053\u304B\u3089\u306F\u5F92\u6B69\u3067\u3059\u304B\uFF1F"
    Text_Es: "\xBFDesde all\xED seguimos a pie?"
    Text_Pt: "Dali seguimos a p\xE9?"
    Text_Ru: "\u041E\u0442\u0442\u0443\u0434\u0430 \u043F\u043E\u0439\u0434\u0451\u043C
      \u043F\u0435\u0448\u043A\u043E\u043C?"
  - ID: Chapter_2_Back_13
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uADF8\uB798. \uBC14\uC704 \uC606\uC73C\uB85C \uC62C\uB77C\uAC00\uB77C\uACE0
      \uC801\uD600 \uC788\uC5B4."
    Text_En: Yes. It says to climb beside a rock.
    Text_ZhHans: "\u5BF9\uFF0C\u4E0A\u9762\u5199\u7740\u4ECE\u5CA9\u77F3\u65C1\u5F80\u4E0A\u8D70\u3002"
    Text_Ja: "\u3042\u3042\u3002\u5CA9\u306E\u6A2A\u3092\u4E0A\u308C\u3068\u66F8\u3044\u3066\u3042\u308B\u3002"
    Text_Es: "S\xED. Dice que subamos junto a una roca."
    Text_Pt: Sim. Diz para subir ao lado de uma rocha.
    Text_Ru: "\u0414\u0430. \u041D\u0430\u043F\u0438\u0441\u0430\u043D\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
      \u0432\u043E\u0437\u043B\u0435 \u0441\u043A\u0430\u043B\u044B."
  - ID: Chapter_2_Back_14
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uD6C4\uC784\uC740 \uC18D\uB3C4\uB97C \uC904\uC774\uBA70 \uC8FC\uC704\uB97C
      \uC0B4\uD3C8\uB2E4."
    Text_En: My partner slowed and looked around.
    Text_ZhHans: "\u5E74\u8F7B\u8B66\u5458\u653E\u6162\u8F66\u901F\uFF0C\u6253\u91CF\u56DB\u5468\u3002"
    Text_Ja: "\u5F8C\u8F29\u306F\u901F\u5EA6\u3092\u843D\u3068\u3057\u3001\u8FBA\u308A\u3092\u898B\u305F\u3002"
    Text_Es: "Mi compa\xF1ero fren\xF3 y mir\xF3 alrededor."
    Text_Pt: Meu colega reduziu e olhou ao redor.
    Text_Ru: "\u041D\u0430\u043F\u0430\u0440\u043D\u0438\u043A \u0441\u0431\u0430\u0432\u0438\u043B
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438 \u043E\u0433\u043B\u044F\u0434\u0435\u043B\u0441\u044F."
  - ID: Chapter_2_Back_15
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uBCC4\uC744 \uBCF4\uB7EC \uC774\uB7F0 \uACF3\uAE4C\uC9C0 \uB2E4\uB154\uAD70\uC694."
    Text_En: He came all this way to see stars?
    Text_ZhHans: "\u4ED6\u770B\u661F\u661F\u8FD8\u8DD1\u5230\u8FD9\u79CD\u5730\u65B9\u6765\u554A\u3002"
    Text_Ja: "\u661F\u3092\u898B\u308B\u305F\u3081\u306B\u3001\u3053\u3093\u306A\u6240\u307E\u3067\u3002"
    Text_Es: "Ven\xEDa hasta aqu\xED para ver estrellas."
    Text_Pt: "Ele vinha at\xE9 aqui para ver estrelas?"
    Text_Ru: "\u041E\u043D \u0437\u0430\u0431\u0438\u0440\u0430\u043B\u0441\u044F
      \u0441\u044E\u0434\u0430 \u0440\u0430\u0434\u0438 \u0437\u0432\u0451\u0437\u0434?"
  - ID: Chapter_2_Back_16
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uAE30\uB85D\uB300\uB85C\uB77C\uBA74 \uD55C\uB450 \uACF3\uC774 \uC544\uB2C8\uC57C."
    Text_En: And not just here, by these records.
    Text_ZhHans: "\u6309\u8BB0\u5F55\u770B\uFF0C\u8FD8\u4E0D\u6B62\u4E00\u4E24\u5904\u3002"
    Text_Ja: "\u8A18\u9332\u3092\u898B\u308B\u9650\u308A\u3001\u4E00\u304B\u6240\u3084\u4E8C\u304B\u6240\u3058\u3083\u306A\u3044\u3002"
    Text_Es: "Y no era el \xFAnico sitio, seg\xFAn esto."
    Text_Pt: "E n\xE3o s\xF3 aqui, pelo que est\xE1 escrito."
    Text_Ru: "\u0421\u0443\u0434\u044F \u043F\u043E \u0437\u0430\u043F\u0438\u0441\u044F\u043C,
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u044E\u0434\u0430."
  - ID: Chapter_2_Back_17
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uB2E4\uC74C \uC7A5\uC744 \uD3BC\uCCE4\uB2E4."
    Text_En: I turned the page.
    Text_ZhHans: "\u6211\u7FFB\u5F00\u4E0B\u4E00\u9875\u3002"
    Text_Ja: "\u79C1\u306F\u6B21\u306E\u30DA\u30FC\u30B8\u3092\u958B\u3044\u305F\u3002"
    Text_Es: "Pas\xE9 a la siguiente p\xE1gina."
    Text_Pt: "Abri a p\xE1gina seguinte."
    Text_Ru: "\u042F \u043E\u0442\u043A\u0440\u044B\u043B \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443."
  - ID: Chapter_2_Back_18
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB2E4\uB978 \uBCC4\uC790\uB9AC \uC544\uB798\uC5D0\uB3C4"
    Text_En: Beneath another constellation
    Text_ZhHans: "\u5176\u4ED6\u661F\u5EA7\u4E0B\u9762\uFF0C"
    Text_Ja: "\u5225\u306E\u661F\u5EA7\u306E\u4E0B\u306B\u3082\u3001"
    Text_Es: Bajo otras constelaciones
    Text_Pt: "Sob outras constela\xE7\xF5es,"
    Text_Ru: "\u041F\u043E\u0434 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F\u043C\u0438"
  - ID: Chapter_2_Back_19
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uBE44\uC2B7\uD55C \uACBD\uB85C\uC640 \uD45C\uC2DC\uAC00 \uC801\uD600
      \uC788\uC5C8\uB2E4."
    Text_En: were similar routes and markings.
    Text_ZhHans: "\u4E5F\u5199\u7740\u7C7B\u4F3C\u7684\u8DEF\u7EBF\u548C\u6807\u8BB0\u3002"
    Text_Ja: "\u4F3C\u305F\u3088\u3046\u306A\u9053\u9806\u3068\u5370\u304C\u3042\u3063\u305F\u3002"
    Text_Es: "hab\xEDa rutas y marcas parecidas."
    Text_Pt: havia rotas e marcas parecidas.
    Text_Ru: "\u0431\u044B\u043B\u0438 \u043F\u043E\u0445\u043E\u0436\u0438\u0435
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u0438 \u043E\u0442\u043C\u0435\u0442\u043A\u0438."
  - ID: Chapter_2_Back_20
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC544\uC9C1 \uADF8 \uD45C\uC2DC\uC758 \uB73B\uC740 \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
    Text_En: We still didn't know what they meant.
    Text_ZhHans: "\u6211\u4EEC\u8FD8\u4E0D\u77E5\u9053\u90A3\u4E9B\u6807\u8BB0\u7684\u542B\u4E49\u3002"
    Text_Ja: "\u307E\u3060\u3001\u5370\u306E\u610F\u5473\u306F\u5206\u304B\u3089\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "A\xFAn no sab\xEDamos qu\xE9 significaban."
    Text_Pt: "Ainda n\xE3o sab\xEDamos o que significavam."
    Text_Ru: "\u0418\u0445 \u0441\u043C\u044B\u0441\u043B \u043F\u043E\u043A\u0430
      \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F \u043D\u0435\u044F\u0441\u0435\u043D."
  - ID: Chapter_2_Back_21
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uADF8\uB54C \uBB34\uC804\uAE30\uC5D0\uC11C \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    Text_En: Then the radio crackled.
    Text_ZhHans: "\u8FD9\u65F6\uFF0C\u5BF9\u8BB2\u673A\u54CD\u4E86\u3002"
    Text_Ja: "\u305D\u306E\u3068\u304D\u3001\u7121\u7DDA\u304C\u9CF4\u3063\u305F\u3002"
    Text_Es: "Entonces son\xF3 la radio."
    Text_Pt: "Ent\xE3o o r\xE1dio chiou."
    Text_Ru: "\u0422\u0443\u0442 \u043E\u0436\u0438\u043B\u0430 \u0440\u0430\u0446\u0438\u044F."
  - ID: Chapter_2_Back_22
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC9C0\uC9C0\uC9C1\u2026\u2026 \uC5EC\uAE30\uB294 \uC218\uC0C9 2\uD300."
    Text_En: Krrsh... Search Team Two here.
    Text_ZhHans: "\u6ECB\u2026\u2026\u8FD9\u91CC\u662F\u641C\u67E5\u4E8C\u7EC4\u3002"
    Text_Ja: "\u30B6\u30B6\u30C3\u2026\u2026\u3053\u3061\u3089\u635C\u7D22\u4E8C\u73ED\u3002"
    Text_Es: "Crrr... Aqu\xED, equipo de b\xFAsqueda dos."
    Text_Pt: "Chhh... Aqui \xE9 a equipe de busca dois."
    Text_Ru: "\u0428-\u0448... \u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0432\u0442\u043E\u0440\u0430\u044F
      \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430."
  - ID: Chapter_2_Back_23
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uAE30\uB85D\uB41C \uC9C0\uC810\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4."
    Text_En: We've reached the marked location.
    Text_ZhHans: "\u5DF2\u5230\u8FBE\u8BB0\u5F55\u4E2D\u7684\u5730\u70B9\u3002"
    Text_Ja: "\u8A18\u9332\u306E\u5730\u70B9\u306B\u5230\u7740\u3057\u307E\u3057\u305F\u3002"
    Text_Es: Hemos llegado al punto indicado.
    Text_Pt: Chegamos ao local indicado.
    Text_Ru: "\u041C\u044B \u043D\u0430 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435."
  - ID: Chapter_2_Back_24
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC2DC\uC2E0 \uD55C \uAD6C\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
    Text_En: We've found a body.
    Text_ZhHans: "\u53D1\u73B0\u4E00\u5177\u5C38\u4F53\u3002"
    Text_Ja: "\u907A\u4F53\u3092\u4E00\u4F53\u767A\u898B\u3002"
    Text_Es: "Encontramos un cad\xE1ver."
    Text_Pt: Encontramos um corpo.
    Text_Ru: "\u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E \u0442\u0435\u043B\u043E."
  - ID: Chapter_2_Back_25
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uB118\uAE30\uB358 \uC885\uC774\uB97C \uBA48\uCDC4\uB2E4."
    Text_En: I stopped turning the page.
    Text_ZhHans: "\u6211\u505C\u4E0B\u4E86\u7FFB\u9875\u7684\u624B\u3002"
    Text_Ja: "\u30DA\u30FC\u30B8\u3092\u3081\u304F\u308B\u624B\u304C\u6B62\u307E\u3063\u305F\u3002"
    Text_Es: "Dej\xE9 de pasar la p\xE1gina."
    Text_Pt: "Parei de virar a p\xE1gina."
    Text_Ru: "\u042F \u0437\u0430\u043C\u0435\u0440, \u043D\u0435 \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u0432
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443."
  - ID: Chapter_2_Back_26
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC2E0\uC6D0\uC740 \uD655\uC778\uB418\uB098?"
    Text_En: Any identification?
    Text_ZhHans: "\u80FD\u786E\u8BA4\u8EAB\u4EFD\u5417\uFF1F"
    Text_Ja: "\u8EAB\u5143\u306F\u5206\u304B\u308B\u304B\uFF1F"
    Text_Es: "\xBFPueden identificarlo?"
    Text_Pt: Conseguem identificar?
    Text_Ru: "\u041B\u0438\u0447\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430?"
  - ID: Chapter_2_Back_27
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC544\uC9C1\uC785\uB2C8\uB2E4. \uAC10\uC2DD\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
    Text_En: Not yet. We'll need forensics.
    Text_ZhHans: "\u8FD8\u4E0D\u80FD\uFF0C\u9700\u8981\u8FDB\u4E00\u6B65\u9274\u5B9A\u3002"
    Text_Ja: "\u307E\u3060\u3067\u3059\u3002\u9451\u5B9A\u304C\u5FC5\u8981\u3067\u3059\u3002"
    Text_Es: "Todav\xEDa no. Hace falta un an\xE1lisis forense."
    Text_Pt: "Ainda n\xE3o. Precisamos da per\xEDcia."
    Text_Ru: "\u041F\u043E\u043A\u0430 \u043D\u0435\u0442. \u041D\u0443\u0436\u043D\u0430
      \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0430."
  - ID: Chapter_2_Back_28
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB2E4\uB9CC \uB204\uAD70\uAC00 \uBA3C\uC800 \uB2E4\uB140\uAC04 \uD754\uC801\uC774
      \uC788\uC2B5\uB2C8\uB2E4."
    Text_En: But someone else has been here.
    Text_ZhHans: "\u4E0D\u8FC7\uFF0C\u6709\u4EBA\u5148\u6765\u8FC7\u8FD9\u91CC\u3002"
    Text_Ja: "\u305F\u3060\u3001\u8AB0\u304B\u304C\u5148\u306B\u6765\u305F\u5F62\u8DE1\u304C\u3042\u308A\u307E\u3059\u3002"
    Text_Es: "Pero alguien estuvo aqu\xED antes."
    Text_Pt: "Mas algu\xE9m esteve aqui antes."
    Text_Ru: "\u041D\u043E \u0434\u043E \u043D\u0430\u0441 \u0437\u0434\u0435\u0441\u044C
      \u043A\u0442\u043E-\u0442\u043E \u043F\u043E\u0431\u044B\u0432\u0430\u043B."
  - ID: Chapter_2_Back_29
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC5B4\uB5A4 \uD754\uC801\uC774\uC9C0?"
    Text_En: What makes you say that?
    Text_ZhHans: "\u4EC0\u4E48\u75D5\u8FF9\uFF1F"
    Text_Ja: "\u3069\u3093\u306A\u5F62\u8DE1\u3060\uFF1F"
    Text_Es: "\xBFQu\xE9 indicios hay?"
    Text_Pt: Que sinais encontraram?
    Text_Ru: "\u0427\u0442\u043E \u0437\u0430 \u0441\u043B\u0435\u0434\u044B?"
  - ID: Chapter_2_Back_30
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB9E4\uC7A5\uB41C \uACF3\uC758 \uD759\uC774 \uD30C\uD5E4\uCCD0\uC838
      \uC788\uC2B5\uB2C8\uB2E4."
    Text_En: The burial site has been dug up.
    Text_ZhHans: "\u57CB\u5C38\u5904\u7684\u6CE5\u571F\u88AB\u6316\u5F00\u4E86\u3002"
    Text_Ja: "\u57CB\u3081\u3089\u308C\u305F\u5834\u6240\u304C\u6398\u308A\u8FD4\u3055\u308C\u3066\u3044\u307E\u3059\u3002"
    Text_Es: Han removido la tierra de la fosa.
    Text_Pt: A terra da cova foi remexida.
    Text_Ru: "\u0417\u0435\u043C\u043B\u044F \u0432 \u043C\u0435\u0441\u0442\u0435
      \u0437\u0430\u0445\u043E\u0440\u043E\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0437\u0440\u044B\u0442\u0430."
  - ID: Chapter_2_Back_31
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC2DC\uC2E0 \uC77C\uBD80\uAC00 \uB4DC\uB7EC\uB09C \uC0C1\uD0DC\uC600\uC2B5\uB2C8\uB2E4."
    Text_En: Part of the body was exposed.
    Text_ZhHans: "\u5C38\u4F53\u7684\u4E00\u90E8\u5206\u9732\u5728\u5916\u9762\u3002"
    Text_Ja: "\u907A\u4F53\u306E\u4E00\u90E8\u304C\u9732\u51FA\u3057\u3066\u3044\u307E\u3057\u305F\u3002"
    Text_Es: Parte del cuerpo estaba al descubierto.
    Text_Pt: Parte do corpo estava exposta.
    Text_Ru: "\u0427\u0430\u0441\u0442\u044C \u0442\u0435\u043B\u0430 \u0431\u044B\u043B\u0430
      \u043E\u0431\u043D\u0430\u0436\u0435\u043D\u0430."
  - ID: Chapter_2_Back_32
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB3D9\uBB3C\uC774 \uAC74\uB4DC\uB9B0 \uAC74\uAC00?"
    Text_En: Could an animal have done it?
    Text_ZhHans: "\u662F\u52A8\u7269\u7FFB\u52A8\u7684\u5417\uFF1F"
    Text_Ja: "\u52D5\u7269\u306E\u4ED5\u696D\u304B\uFF1F"
    Text_Es: "\xBFPudo ser un animal?"
    Text_Pt: Algum animal?
    Text_Ru: "\u041C\u043E\u0436\u0435\u0442, \u0437\u0432\u0435\u0440\u044C?"
  - ID: Chapter_2_Back_33
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC0BD\uC73C\uB85C \uD310 \uB4EF\uD55C \uC790\uAD6D\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    Text_En: There are what look like shovel marks.
    Text_ZhHans: "\u73B0\u573A\u6709\u7591\u4F3C\u94C1\u9539\u6316\u6398\u7684\u75D5\u8FF9\u3002"
    Text_Ja: "\u30B7\u30E3\u30D9\u30EB\u3067\u6398\u3063\u305F\u3088\u3046\u306A\u8DE1\u304C\u3042\u308A\u307E\u3059\u3002"
    Text_Es: Hay lo que parecen marcas de pala.
    Text_Pt: "H\xE1 marcas que parecem ser de uma p\xE1."
    Text_Ru: "\u0415\u0441\u0442\u044C \u0441\u043B\u0435\u0434\u044B, \u043F\u043E\u0445\u043E\u0436\u0438\u0435
      \u043D\u0430 \u0443\u0434\u0430\u0440\u044B \u043B\u043E\u043F\u0430\u0442\u044B."
  - ID: Chapter_2_Back_34
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC8FC\uBCC0\uC758 \uBC1C\uC790\uAD6D\uB3C4 \uD568\uAED8 \uD655\uC778
      \uC911\uC785\uB2C8\uB2E4."
    Text_En: We're checking nearby footprints, too.
    Text_ZhHans: "\u6211\u4EEC\u4E5F\u5728\u68C0\u67E5\u5468\u56F4\u7684\u811A\u5370\u3002"
    Text_Ja: "\u5468\u56F2\u306E\u8DB3\u8DE1\u3082\u78BA\u8A8D\u4E2D\u3067\u3059\u3002"
    Text_Es: "Tambi\xE9n revisamos las huellas cercanas."
    Text_Pt: "Tamb\xE9m estamos examinando as pegadas."
    Text_Ru: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u0438 \u0441\u043B\u0435\u0434\u044B
      \u043D\u043E\u0433 \u043F\u043E\u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438."
  - ID: Chapter_2_Back_35
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC218\uCCA9\uC758 \uC885\uC774 \uC0AC\uC774\uC5D0 \uB07C\uC5B4 \uC788\uB358"
    Text_En: I remembered the dry dirt
    Text_ZhHans: "\u6211\u60F3\u8D77\u4E86\u5939\u5728\u7B14\u8BB0\u672C\u7EB8\u9875\u95F4\u7684\uFF0C"
    Text_Ja: "\u624B\u5E33\u306E\u30DA\u30FC\u30B8\u306B\u631F\u307E\u3063\u3066\u3044\u305F\u3001"
    Text_Es: "Record\xE9 la tierra seca"
    Text_Pt: Lembrei da terra seca
    Text_Ru: "\u042F \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B \u0441\u0443\u0445\u0443\u044E
      \u0437\u0435\u043C\u043B\u044E,"
  - ID: Chapter_2_Back_36
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB9C8\uB978 \uD759\uC774 \uB5A0\uC62C\uB790\uB2E4."
    Text_En: caught between the notebook's pages.
    Text_ZhHans: "\u90A3\u4E9B\u5E72\u6389\u7684\u6CE5\u571F\u3002"
    Text_Ja: "\u4E7E\u3044\u305F\u571F\u3092\u601D\u3044\u51FA\u3057\u305F\u3002"
    Text_Es: "atrapada entre las p\xE1ginas del cuaderno."
    Text_Pt: "presa entre as p\xE1ginas do caderno."
    Text_Ru: "\u0437\u0430\u0441\u0442\u0440\u044F\u0432\u0448\u0443\u044E \u043C\u0435\u0436\u0434\u0443
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u043C\u0438 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430."
  - ID: Chapter_2_Back_37
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uADF8\uAC00 \uB2E4\uC2DC \uCC3E\uC544\uC654\uB358 \uAC78\uAE4C."
    Text_En: Had he come back?
    Text_ZhHans: "\u662F\u4ED6\u56DE\u6765\u8FC7\u5417\uFF1F"
    Text_Ja: "\u5F7C\u304C\u623B\u3063\u3066\u304D\u305F\u306E\u304B\u3002"
    Text_Es: "\xBFHab\xEDa regresado \xE9l?"
    Text_Pt: "Ser\xE1 que ele tinha voltado?"
    Text_Ru: "\u041E\u043D \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0441\u044F
      \u0441\u044E\u0434\u0430?"
  - ID: Chapter_2_Back_38
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC544\uB2C8\uBA74 \uC774 \uAE30\uB85D\uC744 \uBCF8 \uB2E4\uB978 \uB204\uAD70\uAC00\uAC00."
    Text_En: Or someone else who'd read this?
    Text_ZhHans: "\u8FD8\u662F\u5176\u4ED6\u770B\u8FC7\u8FD9\u672C\u7B14\u8BB0\u7684\u4EBA\uFF1F"
    Text_Ja: "\u305D\u308C\u3068\u3082\u3001\u3053\u306E\u8A18\u9332\u3092\u8AAD\u3093\u3060\u5225\u306E\u8AB0\u304B\u304B\u3002"
    Text_Es: "\xBFO alguien m\xE1s que ley\xF3 estas notas?"
    Text_Pt: "Ou algu\xE9m que tamb\xE9m leu estas notas?"
    Text_Ru: "\u0418\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E \u0435\u0449\u0451
      \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B \u044D\u0442\u0438 \u0437\u0430\u043F\u0438\u0441\u0438?"
  - ID: Chapter_2_Back_39
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uD604\uC7A5 \uBCF4\uC874\uD558\uACE0 \uAC10\uC2DD\uD300 \uC694\uCCAD\uD574."
    Text_En: Secure the scene. Get forensics.
    Text_ZhHans: "\u4FDD\u62A4\u73B0\u573A\uFF0C\u901A\u77E5\u9274\u8BC1\u4EBA\u5458\u3002"
    Text_Ja: "\u73FE\u5834\u3092\u4FDD\u5B58\u3057\u3001\u9451\u8B58\u3092\u547C\u3079\u3002"
    Text_Es: Aseguren la zona. Avisen a los forenses.
    Text_Pt: "Isolem o local e chamem a per\xEDcia."
    Text_Ru: "\u041E\u0446\u0435\u043F\u0438\u0442\u0435 \u043C\u0435\u0441\u0442\u043E.
      \u0412\u044B\u0437\u043E\u0432\u0438\u0442\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u043E\u0432."
  - ID: Chapter_2_Back_40
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB098\uBA38\uC9C0 \uD300\uC5D0\uB3C4 \uBC1C\uACAC \uB0B4\uC6A9 \uACF5\uC720\uD558\uACE0."
    Text_En: Update the other teams, too.
    Text_ZhHans: "\u4E5F\u628A\u60C5\u51B5\u544A\u77E5\u5176\u4ED6\u7EC4\u3002"
    Text_Ja: "\u307B\u304B\u306E\u73ED\u306B\u3082\u5171\u6709\u3059\u308B\u3093\u3060\u3002"
    Text_Es: "Informen tambi\xE9n a los otros equipos."
    Text_Pt: "Informem as outras equipes tamb\xE9m."
    Text_Ru: "\u0421\u043E\u043E\u0431\u0449\u0438\u0442\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
      \u0433\u0440\u0443\u043F\u043F\u0430\u043C."
  - ID: Chapter_2_Back_41
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uC0AC\uBCF8\uC758 \uB2E4\uB978 \uD45C\uC2DC\uB4E4\uC744
      \uC0B4\uD3C8\uB2E4."
    Text_En: I studied the other marks on my copy.
    Text_ZhHans: "\u6211\u67E5\u770B\u590D\u5370\u4EF6\u4E0A\u5176\u4ED6\u7684\u6807\u8BB0\u3002"
    Text_Ja: "\u79C1\u306F\u30B3\u30D4\u30FC\u306B\u3042\u308B\u5225\u306E\u5370\u3092\u898B\u305F\u3002"
    Text_Es: "Examin\xE9 las dem\xE1s marcas de la copia."
    Text_Pt: "Examinei as outras marcas na c\xF3pia."
    Text_Ru: "\u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430
      \u0434\u0440\u0443\u0433\u0438\u0435 \u043E\u0442\u043C\u0435\u0442\u043A\u0438
      \u0432 \u043A\u043E\u043F\u0438\u0438."
  - ID: Chapter_2_Back_42
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC774 \uAE30\uB85D\uB4E4\uC774 \uBAA8\uB450 \uAC19\uC740 \uB73B\uC774\uB77C\uBA74,"
    Text_En: If they all meant the same thing,
    Text_ZhHans: "\u5982\u679C\u8FD9\u4E9B\u8BB0\u5F55\u90FD\u610F\u5473\u7740\u540C\u4E00\u4EF6\u4E8B\uFF0C"
    Text_Ja: "\u3053\u306E\u8A18\u9332\u304C\u3059\u3079\u3066\u540C\u3058\u610F\u5473\u306A\u3089\u3001"
    Text_Es: Si todas significaban lo mismo,
    Text_Pt: Se todas significassem a mesma coisa,
    Text_Ru: "\u0415\u0441\u043B\u0438 \u0432\u0441\u0435 \u043E\u043D\u0438 \u043E\u0437\u043D\u0430\u0447\u0430\u043B\u0438
      \u043E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435,"
  - ID: Chapter_2_Back_43
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uC6B0\uB9AC\uAC00 \uD655\uC778\uD574\uC57C \uD560 \uAC83\uC740"
    Text_En: we had more to find
    Text_ZhHans: "\u90A3\u4E48\u6211\u4EEC\u8981\u67E5\u660E\u7684\uFF0C"
    Text_Ja: "\u78BA\u304B\u3081\u308B\u3079\u304D\u3082\u306E\u306F\u3001"
    Text_Es: "lo que deb\xEDamos averiguar"
    Text_Pt: "ter\xEDamos mais a descobrir"
    Text_Ru: "\u043D\u0430\u043C \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u044F\u043B\u043E
      \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C"
  - ID: Chapter_2_Back_44
    Chapter_Id: 2_Back
    Speaker: Police
    Text_Kr: "\uD55C \uC0AC\uB78C\uC758 \uD589\uBC29\uB9CC\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    Text_En: than one missing man.
    Text_ZhHans: "\u5C31\u4E0D\u53EA\u662F\u4E00\u4E2A\u4EBA\u7684\u4E0B\u843D\u4E86\u3002"
    Text_Ja: "\u4E00\u4EBA\u306E\u884C\u65B9\u3060\u3051\u3067\u306F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: no era solo el paradero de un hombre.
    Text_Pt: do que o paradeiro de um homem.
    Text_Ru: "\u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0443\u0434\u044C\u0431\u0443
      \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0435\u0433\u043E \u043C\u0443\u0436\u0447\u0438\u043D\u044B."
  - ID: Chapter_3_Front_1
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB294 \uBA70\uCE60\uC9F8 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uB2E4."
    Text_En: Dad hadn't come home for days.
    Text_ZhHans: "\u7238\u7238\u5DF2\u7ECF\u597D\u51E0\u5929\u6CA1\u56DE\u6765\u4E86\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u306F\u4F55\u65E5\u3082\u5E30\u3063\u3066\u3044\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Pap\xE1 llevaba d\xEDas sin volver."
    Text_Pt: Papai estava fora havia dias.
    Text_Ru: "\u041F\u0430\u043F\u0430 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0441\u044F
      \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439."
  - ID: Chapter_3_Front_2
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uBC24\uB2A6\uAC8C \uB098\uAC00\uB294 \uC77C\uC740 \uC775\uC219\uD588\uC9C0\uB9CC,"
    Text_En: I was used to him going out late,
    Text_ZhHans: "\u6211\u4E60\u60EF\u4E86\u4ED6\u6DF1\u591C\u51FA\u95E8\uFF0C"
    Text_Ja: "\u591C\u9045\u304F\u306B\u51FA\u304B\u3051\u308B\u306E\u306F\u6163\u308C\u3066\u3044\u305F\u3051\u308C\u3069\u3001"
    Text_Es: Era normal que saliera de noche,
    Text_Pt: "Eu estava acostumada com suas sa\xEDdas \xE0 noite,"
    Text_Ru: "\u041A \u0435\u0433\u043E \u043D\u043E\u0447\u043D\u044B\u043C \u043E\u0442\u043B\u0443\u0447\u043A\u0430\u043C
      \u044F \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430,"
  - ID: Chapter_3_Front_3
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC774\uB807\uAC8C \uC624\uB798 \uC9D1\uC744 \uBE44\uC6B4 \uC801\uC740
      \uC5C6\uC5C8\uB2E4."
    Text_En: but never for this long.
    Text_ZhHans: "\u53EF\u4ED6\u4ECE\u6CA1\u79BB\u5BB6\u8FD9\u4E48\u4E45\u3002"
    Text_Ja: "\u3053\u3093\u306A\u306B\u9577\u304F\u7559\u5B88\u306B\u3057\u305F\u3053\u3068\u306F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "pero nunca se hab\xEDa ido tanto tiempo."
    Text_Pt: mas nunca tinha ficado tanto tempo fora.
    Text_Ru: "\u043D\u043E \u0442\u0430\u043A \u043D\u0430\u0434\u043E\u043B\u0433\u043E
      \u043E\u043D \u0435\u0449\u0451 \u043D\u0435 \u0443\u0445\u043E\u0434\u0438\u043B."
  - ID: Chapter_3_Front_4
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC804\uD654\uC5D0\uC11C\uB294 \uAC19\uC740 \uC548\uB0B4\uB9CC \uBC18\uBCF5\uB410\uB2E4."
    Text_En: His phone played the same message.
    Text_ZhHans: "\u7535\u8BDD\u91CC\u53CD\u590D\u54CD\u8D77\u540C\u6837\u7684\u63D0\u793A\u97F3\u3002"
    Text_Ja: "\u96FB\u8A71\u304B\u3089\u306F\u3001\u540C\u3058\u6848\u5185\u304C\u7E70\u308A\u8FD4\u3055\u308C\u305F\u3002"
    Text_Es: "El tel\xE9fono repet\xEDa el mismo mensaje."
    Text_Pt: O telefone repetia a mesma mensagem.
    Text_Ru: "\u0412 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B\u043E\u0441\u044C
      \u043E\u0434\u043D\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435."
  - ID: Chapter_3_Front_5
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC544\uBE60\uC758 \uBC29\uC73C\uB85C \uB4E4\uC5B4\uAC14\uB2E4."
    Text_En: I went into his room.
    Text_ZhHans: "\u6211\u8D70\u8FDB\u7238\u7238\u7684\u623F\u95F4\u3002"
    Text_Ja: "\u79C1\u306F\u304A\u7236\u3055\u3093\u306E\u90E8\u5C4B\u306B\u5165\u3063\u305F\u3002"
    Text_Es: "Entr\xE9 en su habitaci\xF3n."
    Text_Pt: Entrei no quarto dele.
    Text_Ru: "\u042F \u0432\u043E\u0448\u043B\u0430 \u0432 \u043F\u0430\u043F\u0438\u043D\u0443
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443."
  - ID: Chapter_3_Front_6
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uCC45\uC0C1 \uC704\uC5D0\uB294 \uC9C0\uB3C4\uC640 \uC885\uC774\uB4E4\uC774"
    Text_En: Maps and papers lay
    Text_ZhHans: "\u4E66\u684C\u4E0A\uFF0C\u5730\u56FE\u548C\u7EB8\u5F20"
    Text_Ja: "\u673A\u306E\u4E0A\u306B\u306F\u5730\u56F3\u3084\u7D19\u304C\u3001"
    Text_Es: "Sobre el escritorio hab\xEDa mapas y papeles,"
    Text_Pt: "Mapas e pap\xE9is cobriam a mesa,"
    Text_Ru: "\u041A\u0430\u0440\u0442\u044B \u0438 \u0431\u0443\u043C\u0430\u0433\u0438
      \u043B\u0435\u0436\u0430\u043B\u0438 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435"
  - ID: Chapter_3_Front_7
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uACB9\uACB9\uC774 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
    Text_En: in layers across his desk.
    Text_ZhHans: "\u4E00\u5C42\u5C42\u94FA\u53E0\u7740\u3002"
    Text_Ja: "\u4F55\u679A\u3082\u91CD\u306A\u3063\u3066\u5E83\u3052\u3089\u308C\u3066\u3044\u305F\u3002"
    Text_Es: extendidos unos sobre otros.
    Text_Pt: espalhados uns sobre os outros.
    Text_Ru: "\u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0451\u0432."
  - ID: Chapter_3_Front_8
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC5B4\uB514\uC5D0 \uAC14\uB294\uC9C0 \uC801\uC5B4\uB450\uC9C0 \uC54A\uC558\uC744\uAE4C."
    Text_En: Maybe he'd written where he was going.
    Text_ZhHans: "\u4ED6\u4F1A\u4E0D\u4F1A\u5199\u4E0B\u4E86\u53BB\u5411\uFF1F"
    Text_Ja: "\u884C\u304D\u5148\u3092\u66F8\u304D\u6B8B\u3057\u3066\u3044\u306A\u3044\u3060\u308D\u3046\u304B\u3002"
    Text_Es: "\xBFHabr\xEDa anotado ad\xF3nde iba?"
    Text_Pt: "Ser\xE1 que ele anotou aonde ia?"
    Text_Ru: "\u041C\u043E\u0436\u0435\u0442, \u043E\u043D \u0437\u0430\u043F\u0438\u0441\u0430\u043B,
      \u043A\u0443\u0434\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F?"
  - ID: Chapter_3_Front_9
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC5F0\uB77D\uD560 \uC0AC\uB78C\uC774\uB77C\uB3C4 \uCC3E\uC744 \uC218
      \uC788\uB2E4\uBA74."
    Text_En: Or left someone I could call.
    Text_ZhHans: "\u54EA\u6015\u80FD\u627E\u5230\u4E00\u4E2A\u53EF\u4EE5\u8054\u7CFB\u7684\u4EBA\u3002"
    Text_Ja: "\u9023\u7D61\u3067\u304D\u308B\u4EBA\u3060\u3051\u3067\u3082\u5206\u304B\u308C\u3070\u3002"
    Text_Es: "Quiz\xE1 encontrara a alguien a quien llamar."
    Text_Pt: "Talvez houvesse algu\xE9m para quem ligar."
    Text_Ru: "\u0418\u043B\u0438 \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F
      \u0445\u043E\u0442\u044C \u043A\u0442\u043E-\u0442\u043E, \u043A\u043E\u043C\u0443
      \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u0442\u044C."
  - ID: Chapter_3_Front_10
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC885\uC774\uB97C \uB4E4\uCD94\uC790 \uADF8 \uC544\uB798\uC5D0\uC11C"
    Text_En: I lifted the papers
    Text_ZhHans: "\u6211\u7FFB\u52A8\u7EB8\u5F20\uFF0C"
    Text_Ja: "\u7D19\u3092\u3081\u304F\u308B\u3068\u3001\u305D\u306E\u4E0B\u304B\u3089\u3001"
    Text_Es: "Levant\xE9 los papeles"
    Text_Pt: "Levantei os pap\xE9is"
    Text_Ru: "\u042F \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u043B\u0430
      \u0431\u0443\u043C\u0430\u0433\u0438"
  - ID: Chapter_3_Front_11
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uB0A1\uC740 \uAC00\uC8FD \uC218\uCCA9\uC774 \uB098\uC654\uB2E4."
    Text_En: and found an old leather notebook.
    Text_ZhHans: "\u4E0B\u9762\u9732\u51FA\u4E00\u672C\u65E7\u76AE\u9762\u7B14\u8BB0\u672C\u3002"
    Text_Ja: "\u53E4\u3044\u9769\u306E\u624B\u5E33\u304C\u51FA\u3066\u304D\u305F\u3002"
    Text_Es: "y apareci\xF3 un viejo cuaderno de cuero."
    Text_Pt: e encontrei um velho caderno de couro.
    Text_Ru: "\u0438 \u043D\u0430\u0448\u043B\u0430 \u0441\u0442\u0430\u0440\u044B\u0439
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0431\u043B\u043E\u043A\u043D\u043E\u0442."
  - ID: Chapter_3_Front_12
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uAC00 \uB298 \uAC00\uC9C0\uACE0 \uB2E4\uB2C8\uB358 \uAC83\uC774\uC5C8\uB2E4."
    Text_En: The one Dad always carried.
    Text_ZhHans: "\u90A3\u662F\u7238\u7238\u603B\u5E26\u5728\u8EAB\u8FB9\u7684\u4E1C\u897F\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u304C\u3044\u3064\u3082\u6301\u3061\u6B69\u3044\u3066\u3044\u305F\u3082\u306E\u3060\u3002"
    Text_Es: "El que pap\xE1 siempre llevaba consigo."
    Text_Pt: Era o que papai sempre levava consigo.
    Text_Ru: "\u041F\u0430\u043F\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u043E\u0441\u0438\u043B
      \u0435\u0433\u043E \u0441 \u0441\u043E\u0431\u043E\u0439."
  - ID: Chapter_3_Front_13
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC774\uAC74 \uB450\uACE0 \uAC14\uB124\u2026\u2026."
    Text_En: You left this behind...
    Text_ZhHans: "\u8FD9\u6B21\u5374\u7559\u4E0B\u4E86\u2026\u2026"
    Text_Ja: "\u3053\u308C\u306F\u7F6E\u3044\u3066\u3044\u3063\u305F\u3093\u3060\u2026\u2026"
    Text_Es: Este lo dejaste...
    Text_Pt: "Este voc\xEA deixou..."
    Text_Ru: "\u0410 \u0435\u0433\u043E \u0442\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B..."
  - ID: Chapter_3_Front_14
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uD45C\uC9C0\uB97C \uD3BC\uCE58\uB2C8 \uC544\uBE60\uC758 \uAE00\uC528\uAC00
      \uBCF4\uC600\uB2E4."
    Text_En: I opened it and saw his handwriting.
    Text_ZhHans: "\u7FFB\u5F00\u5C01\u9762\uFF0C\u662F\u7238\u7238\u7684\u5B57\u8FF9\u3002"
    Text_Ja: "\u8868\u7D19\u3092\u958B\u304F\u3068\u3001\u304A\u7236\u3055\u3093\u306E\u5B57\u304C\u898B\u3048\u305F\u3002"
    Text_Es: "Lo abr\xED y reconoc\xED su letra."
    Text_Pt: Abri a capa e vi a letra dele.
    Text_Ru: "\u041F\u043E\u0434 \u043E\u0431\u043B\u043E\u0436\u043A\u043E\u0439
      \u0431\u044B\u043B \u043F\u0430\u043F\u0438\u043D \u043F\u043E\u0447\u0435\u0440\u043A."
  - ID: Chapter_3_Front_15
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uBCC4\uC744 \uBCF4\uAE30 \uC88B\uC740 \uACC4\uC808\uACFC \uC2DC\uAC04."
    Text_En: Seasons and times for stargazing.
    Text_ZhHans: "\u9002\u5408\u89C2\u661F\u7684\u5B63\u8282\u548C\u65F6\u95F4\u3002"
    Text_Ja: "\u661F\u3092\u898B\u308B\u306E\u306B\u3044\u3044\u5B63\u7BC0\u3084\u6642\u9593\u3002"
    Text_Es: "\xC9pocas y horas para observar estrellas."
    Text_Pt: "\xC9pocas e hor\xE1rios para observar estrelas."
    Text_Ru: "\u0412\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430 \u0438 \u0447\u0430\u0441\u044B
      \u0434\u043B\u044F \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439."
  - ID: Chapter_3_Front_16
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uCC28\uB97C \uC138\uC6CC\uB458 \uACF3\uACFC \uC0B0\uC73C\uB85C \uB4E4\uC5B4\uAC00\uB294
      \uAE38."
    Text_En: Where to park. Paths into the hills.
    Text_ZhHans: "\u505C\u8F66\u7684\u4F4D\u7F6E\uFF0C\u8FD8\u6709\u8FDB\u5C71\u7684\u8DEF\u3002"
    Text_Ja: "\u8ECA\u3092\u6B62\u3081\u308B\u5834\u6240\u3068\u3001\u5C71\u3078\u5165\u308B\u9053\u3002"
    Text_Es: "D\xF3nde aparcar. C\xF3mo entrar al monte."
    Text_Pt: Onde estacionar. Caminhos pela montanha.
    Text_Ru: "\u0413\u0434\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043C\u0430\u0448\u0438\u043D\u0443. \u041A\u0430\u043A \u043F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F
      \u0432 \u0433\u043E\u0440\u044B."
  - ID: Chapter_3_Front_17
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uBE48\uC790\uB9AC\uC5D0\uB294 \uC791\uC740 \uBCC4\uB4E4\uC774 \uADF8\uB824\uC838
      \uC788\uC5C8\uB2E4."
    Text_En: Little stars filled the empty spaces.
    Text_ZhHans: "\u7A7A\u767D\u5904\u753B\u7740\u5C0F\u5C0F\u7684\u661F\u661F\u3002"
    Text_Ja: "\u4F59\u767D\u306B\u306F\u5C0F\u3055\u306A\u661F\u304C\u63CF\u3044\u3066\u3042\u3063\u305F\u3002"
    Text_Es: "Hab\xEDa estrellitas en los espacios vac\xEDos."
    Text_Pt: "Pequenas estrelas ocupavam os espa\xE7os vazios."
    Text_Ru: "\u041D\u0430 \u043F\u043E\u043B\u044F\u0445 \u0431\u044B\u043B\u0438
      \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u044B \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0438."
  - ID: Chapter_3_Front_18
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uD398\uC774\uC9C0\uB97C \uCC9C\uCC9C\uD788 \uB118\uACBC\uB2E4."
    Text_En: I turned the pages slowly.
    Text_ZhHans: "\u6211\u6162\u6162\u7FFB\u7740\u4E66\u9875\u3002"
    Text_Ja: "\u79C1\u306F\u3086\u3063\u304F\u308A\u30DA\u30FC\u30B8\u3092\u3081\u304F\u3063\u305F\u3002"
    Text_Es: "Fui pasando las p\xE1ginas despacio."
    Text_Pt: "Virei as p\xE1ginas devagar."
    Text_Ru: "\u042F \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043B\u0438\u0441\u0442\u0430\u043B\u0430
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B."
  - ID: Chapter_3_Front_19
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uB4A4\uB85C \uAC08\uC218\uB85D \uC124\uBA85\uC740 \uC9E7\uC544\uC84C\uACE0,"
    Text_En: Further in, the notes grew shorter.
    Text_ZhHans: "\u8D8A\u5F80\u540E\uFF0C\u8BF4\u660E\u8D8A\u7B80\u77ED\uFF0C"
    Text_Ja: "\u5F8C\u308D\u306B\u884C\u304F\u307B\u3069\u8AAC\u660E\u306F\u77ED\u304F\u306A\u308A\u3001"
    Text_Es: "Las explicaciones eran cada vez m\xE1s cortas."
    Text_Pt: "As explica\xE7\xF5es ficavam mais curtas,"
    Text_Ru: "\u041A \u043A\u043E\u043D\u0446\u0443 \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u044F
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C \u043A\u043E\u0440\u043E\u0447\u0435,"
  - ID: Chapter_3_Front_20
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC54C \uC218 \uC5C6\uB294 \uD45C\uC2DC\uB4E4\uC774 \uB298\uC5B4\uB0AC\uB2E4."
    Text_En: Strange markings became more common.
    Text_ZhHans: "\u770B\u4E0D\u61C2\u7684\u6807\u8BB0\u5374\u8D8A\u6765\u8D8A\u591A\u3002"
    Text_Ja: "\u610F\u5473\u306E\u5206\u304B\u3089\u306A\u3044\u5370\u304C\u5897\u3048\u3066\u3044\u3063\u305F\u3002"
    Text_Es: Y aumentaban las marcas desconocidas.
    Text_Pt: e as marcas desconhecidas aumentavam.
    Text_Ru: "\u0430 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0445
      \u043E\u0442\u043C\u0435\u0442\u043E\u043A \u2014 \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435."
  - ID: Chapter_3_Front_21
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC790\uC8FC \uB2E4\uB2C8\uB358 \uACF3\uC774\uB77C"
    Text_En: Did he know these places so well
    Text_ZhHans: "\u56E0\u4E3A\u662F\u5E38\u53BB\u7684\u5730\u65B9\uFF0C"
    Text_Ja: "\u3088\u304F\u901A\u3046\u5834\u6240\u3060\u304B\u3089\u3001"
    Text_Es: "Quiz\xE1 conoc\xEDa tanto aquellos lugares"
    Text_Pt: "Talvez conhecesse t\xE3o bem os lugares"
    Text_Ru: "\u041C\u043E\u0436\u0435\u0442, \u043E\u043D \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E
      \u0437\u043D\u0430\u043B \u044D\u0442\u0438 \u043C\u0435\u0441\u0442\u0430,"
  - ID: Chapter_3_Front_22
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC790\uAE30\uB9CC \uC54C\uC544\uBCF4\uBA74 \uB410\uB358 \uAC78\uAE4C."
    Text_En: that only he needed to understand?
    Text_ZhHans: "\u6240\u4EE5\u53EA\u8981\u81EA\u5DF1\u770B\u5F97\u61C2\u5C31\u591F\u4E86\u5417\uFF1F"
    Text_Ja: "\u81EA\u5206\u306B\u3060\u3051\u5206\u304B\u308C\u3070\u3088\u304B\u3063\u305F\u306E\u3060\u308D\u3046\u304B\u3002"
    Text_Es: "que le bastaba con entenderlas \xE9l."
    Text_Pt: "que s\xF3 ele precisasse entender."
    Text_Ru: "\u0447\u0442\u043E \u043F\u0438\u0441\u0430\u043B \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u043B\u044F \u0441\u0435\u0431\u044F?"
  - ID: Chapter_3_Front_23
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uD55C \uD398\uC774\uC9C0\uC5D0\uC11C \uC190\uC774 \uBA48\uCDC4\uB2E4."
    Text_En: My hand stopped on one page.
    Text_ZhHans: "\u6211\u7684\u624B\u505C\u5728\u5176\u4E2D\u4E00\u9875\u3002"
    Text_Ja: "\u3042\u308B\u30DA\u30FC\u30B8\u3067\u624B\u304C\u6B62\u307E\u3063\u305F\u3002"
    Text_Es: "Me detuve en una p\xE1gina."
    Text_Pt: "Minha m\xE3o parou em uma p\xE1gina."
    Text_Ru: "\u041D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435
      \u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C."
  - ID: Chapter_3_Front_24
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uBCC4 \uADF8\uB9BC \uC544\uB798\uC5D0 \uC9C0\uBA85 \uB300\uC2E0"
    Text_En: Below the stars, instead of a name,
    Text_ZhHans: "\u661F\u661F\u56FE\u6848\u4E0B\u9762\u6CA1\u6709\u5730\u540D\uFF0C"
    Text_Ja: "\u661F\u306E\u7D75\u306E\u4E0B\u306B\u306F\u5730\u540D\u306E\u4EE3\u308F\u308A\u306B\u3001"
    Text_Es: Bajo las estrellas, en vez de un nombre,
    Text_Pt: Sob as estrelas, em vez de um nome,
    Text_Ru: "\u041F\u043E\u0434 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438
      \u0432\u043C\u0435\u0441\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      \u043C\u0435\u0441\u0442\u0430"
  - ID: Chapter_3_Front_25
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC9E7\uC740 \uD654\uC0B4\uD45C \uD558\uB098\uAC00 \uADF8\uB824\uC838
      \uC788\uC5C8\uB2E4."
    Text_En: there was just a short arrow.
    Text_ZhHans: "\u53EA\u753B\u7740\u4E00\u4E2A\u77ED\u77ED\u7684\u7BAD\u5934\u3002"
    Text_Ja: "\u77ED\u3044\u77E2\u5370\u304C\u4E00\u672C\u3042\u3063\u305F\u3002"
    Text_Es: "hab\xEDa una peque\xF1a flecha."
    Text_Pt: havia apenas uma pequena seta.
    Text_Ru: "\u0431\u044B\u043B\u0430 \u043B\u0438\u0448\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0430\u044F
      \u0441\u0442\u0440\u0435\u043B\u043A\u0430."
  - ID: Chapter_3_Front_26
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC774\uAC83\uB9CC \uBCF4\uACE0 \uC5B4\uB5BB\uAC8C \uCC3E\uC544\uAC04
      \uAC70\uC9C0?"
    Text_En: How did he find it with only this?
    Text_ZhHans: "\u5149\u770B\u8FD9\u4E2A\uFF0C\u8981\u600E\u4E48\u627E\u5230\u5730\u65B9\uFF1F"
    Text_Ja: "\u3053\u308C\u3060\u3051\u3067\u3001\u3069\u3046\u3084\u3063\u3066\u884C\u3051\u305F\u3093\u3060\u308D\u3046\u3002"
    Text_Es: "\xBFC\xF3mo encontraba el sitio solo con esto?"
    Text_Pt: "Como ele achava o lugar s\xF3 com isso?"
    Text_Ru: "\u041A\u0430\u043A \u043F\u043E \u044D\u0442\u043E\u043C\u0443 \u0432\u043E\u043E\u0431\u0449\u0435
      \u043D\u0430\u0439\u0442\u0438 \u0434\u043E\u0440\u043E\u0433\u0443?"
  - ID: Chapter_3_Front_27
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC218\uCCA9 \uC55E\uCABD\uC744 \uB2E4\uC2DC \uD3BC\uCCE4\uB2E4."
    Text_En: I went back to the earlier pages.
    Text_ZhHans: "\u6211\u53C8\u7FFB\u56DE\u7B14\u8BB0\u672C\u524D\u9762\u3002"
    Text_Ja: "\u79C1\u306F\u624B\u5E33\u306E\u524D\u306E\u65B9\u3092\u958B\u304D\u76F4\u3057\u305F\u3002"
    Text_Es: "Volv\xED a las primeras p\xE1ginas."
    Text_Pt: "Voltei \xE0s primeiras p\xE1ginas."
    Text_Ru: "\u042F \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C \u043A
      \u043D\u0430\u0447\u0430\u043B\u0443 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430."
  - ID: Chapter_3_Front_28
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC624\uB798\uB41C \uAD00\uCE21 \uAE30\uB85D\uC5D0\uB3C4 \uBCC4 \uADF8\uB9BC\uC774
      \uC788\uC5C8\uB2E4."
    Text_En: The old stargazing notes had stars, too.
    Text_ZhHans: "\u65E9\u671F\u7684\u89C2\u6D4B\u8BB0\u5F55\u91CC\u4E5F\u753B\u7740\u661F\u661F\u3002"
    Text_Ja: "\u53E4\u3044\u89B3\u6E2C\u8A18\u9332\u306B\u3082\u3001\u661F\u306E\u7D75\u304C\u3042\u3063\u305F\u3002"
    Text_Es: "Las notas antiguas tambi\xE9n ten\xEDan estrellas."
    Text_Pt: "As notas antigas tamb\xE9m tinham estrelas."
    Text_Ru: "\u0412 \u0441\u0442\u0430\u0440\u044B\u0445 \u0437\u0430\u043F\u0438\u0441\u044F\u0445
      \u0442\u043E\u0436\u0435 \u0431\u044B\u043B\u0438 \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: Chapter_3_Front_29
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uADF8 \uC606\uC5D0\uB294 \uC0B0\uAE38\uC758 \uAC08\uB9BC\uAE38\uACFC"
    Text_En: Beside them were forks in the trail
    Text_ZhHans: "\u65C1\u8FB9\u8BB0\u7740\u5C71\u8DEF\u7684\u5C94\u53E3\uFF0C"
    Text_Ja: "\u305D\u306E\u6A2A\u306B\u306F\u5C71\u9053\u306E\u5206\u304B\u308C\u9053\u3068\u3001"
    Text_Es: Junto a ellas figuraban los cruces
    Text_Pt: "Ao lado, havia bifurca\xE7\xF5es da trilha"
    Text_Ru: "\u0420\u044F\u0434\u043E\u043C \u2014 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438
      \u0433\u043E\u0440\u043D\u044B\u0445 \u0442\u0440\u043E\u043F"
  - ID: Chapter_3_Front_30
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uD070 \uBC14\uC704\uC758 \uC704\uCE58\uAC00 \uC801\uD600 \uC788\uC5C8\uB2E4."
    Text_En: and the position of a large rock.
    Text_ZhHans: "\u8FD8\u6709\u5927\u5CA9\u77F3\u7684\u4F4D\u7F6E\u3002"
    Text_Ja: "\u5927\u304D\u306A\u5CA9\u306E\u4F4D\u7F6E\u304C\u66F8\u304B\u308C\u3066\u3044\u305F\u3002"
    Text_Es: "y la posici\xF3n de una gran roca."
    Text_Pt: "e a posi\xE7\xE3o de uma grande rocha."
    Text_Ru: "\u0438 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0441\u043A\u0430\u043B\u044B."
  - ID: Chapter_3_Front_31
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uBCC4\uC790\uB9AC\uB9C8\uB2E4 \uC7A5\uC18C\uB97C \uC801\uC5B4\uB454
      \uAC74\uAC00."
    Text_En: A place for each constellation?
    Text_ZhHans: "\u6BCF\u4E2A\u661F\u5EA7\u90FD\u5BF9\u5E94\u4E00\u4E2A\u5730\u65B9\u5417\uFF1F"
    Text_Ja: "\u661F\u5EA7\u3054\u3068\u306B\u5834\u6240\u3092\u8A18\u3057\u305F\u306E\u3060\u308D\u3046\u304B\u3002"
    Text_Es: "\xBFUn lugar para cada constelaci\xF3n?"
    Text_Pt: "Um lugar para cada constela\xE7\xE3o?"
    Text_Ru: "\u0414\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F
      \u2014 \u0441\u0432\u043E\u0451 \u043C\u0435\u0441\u0442\u043E?"
  - ID: Chapter_3_Front_32
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uB450 \uD398\uC774\uC9C0\uB97C \uBC88\uAC08\uC544 \uC0B4\uD3C8\uB2E4."
    Text_En: I compared the two pages.
    Text_ZhHans: "\u6211\u6765\u56DE\u5BF9\u7167\u7740\u4E24\u9875\u3002"
    Text_Ja: "\u4E8C\u3064\u306E\u30DA\u30FC\u30B8\u3092\u898B\u6BD4\u3079\u305F\u3002"
    Text_Es: "Compar\xE9 ambas p\xE1ginas."
    Text_Pt: "Comparei as duas p\xE1ginas."
    Text_Ru: "\u042F \u0441\u0440\u0430\u0432\u043D\u0438\u043B\u0430 \u0434\u0432\u0435
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B."
  - ID: Chapter_3_Front_33
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC774 \uBCC4\uB4E4\u2026\u2026 \uAC19\uC740 \uBAA8\uC591 \uAC19\uC740\uB370."
    Text_En: These stars... They look the same.
    Text_ZhHans: "\u8FD9\u4E9B\u661F\u661F\u2026\u2026\u5F62\u72B6\u597D\u50CF\u4E00\u6837\u3002"
    Text_Ja: "\u3053\u306E\u661F\u2026\u2026\u540C\u3058\u5F62\u306B\u898B\u3048\u308B\u3002"
    Text_Es: Estas estrellas... Parecen iguales.
    Text_Pt: Estas estrelas... Parecem iguais.
    Text_Ru: "\u042D\u0442\u0438 \u0437\u0432\u0451\u0437\u0434\u044B... \u041F\u043E\u0445\u043E\u0436\u0435,
      \u0440\u0438\u0441\u0443\u043D\u043E\u043A \u043E\u0434\u0438\u043D."
  - ID: Chapter_3_Front_34
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC55E\uCABD \uADF8\uB9BC\uC5D0\uB294 \uC120\uC774 \uC774\uC5B4\uC838
      \uC788\uC5C8\uC9C0\uB9CC,"
    Text_En: The earlier drawing had lines.
    Text_ZhHans: "\u524D\u9762\u7684\u56FE\u6848\u7528\u7EBF\u8FDE\u7740\uFF0C"
    Text_Ja: "\u524D\u306E\u7D75\u306B\u306F\u7DDA\u304C\u5F15\u304B\u308C\u3066\u3044\u305F\u3051\u308C\u3069\u3001"
    Text_Es: "En el dibujo antiguo hab\xEDa l\xEDneas."
    Text_Pt: O desenho antigo tinha linhas.
    Text_Ru: "\u041D\u0430 \u0440\u0430\u043D\u043D\u0435\u043C \u0440\u0438\u0441\u0443\u043D\u043A\u0435
      \u0431\u044B\u043B\u0438 \u043B\u0438\u043D\u0438\u0438,"
  - ID: Chapter_3_Front_35
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uB4A4\uCABD\uC5D0\uB294 \uC810\uB9CC \uCC0D\uD600 \uC788\uC5C8\uB2E4."
    Text_En: The later one had only dots.
    Text_ZhHans: "\u540E\u9762\u7684\u5374\u53EA\u6709\u70B9\u3002"
    Text_Ja: "\u5F8C\u308D\u306B\u306F\u70B9\u3057\u304B\u306A\u304B\u3063\u305F\u3002"
    Text_Es: En el otro, solo puntos.
    Text_Pt: O outro, apenas pontos.
    Text_Ru: "\u0430 \u043D\u0430 \u043F\u043E\u0437\u0434\u043D\u0435\u043C \u2014
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u043E\u0447\u043A\u0438."
  - ID: Chapter_3_Front_36
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC5B4\uB9B4 \uB54C\uB3C4 \uCC98\uC74C\uC5D0\uB294"
    Text_En: When I was little,
    Text_ZhHans: "\u5C0F\u65F6\u5019\u4E5F\u662F\u8FD9\u6837\uFF0C"
    Text_Ja: "\u5B50\u3069\u3082\u306E\u9803\u3082\u3001\u6700\u521D\u306F\u3001"
    Text_Es: "De peque\xF1a, al principio,"
    Text_Pt: "Quando eu era pequena, no in\xEDcio,"
    Text_Ru: "\u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043F\u043E\u043D\u0430\u0447\u0430\u043B\u0443"
  - ID: Chapter_3_Front_37
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uBCC4\uB4E4\uC774 \uC804\uBD80 \uBE44\uC2B7\uD558\uAC8C\uB9CC \uBCF4\uC600\uB2E4."
    Text_En: all the stars looked alike.
    Text_ZhHans: "\u4E00\u5F00\u59CB\uFF0C\u661F\u661F\u770B\u8D77\u6765\u90FD\u5DEE\u4E0D\u591A\u3002"
    Text_Ja: "\u661F\u304C\u5168\u90E8\u540C\u3058\u3088\u3046\u306B\u898B\u3048\u305F\u3002"
    Text_Es: "todas las estrellas me parec\xEDan iguales."
    Text_Pt: todas as estrelas pareciam iguais.
    Text_Ru: "\u0432\u0441\u0435 \u0437\u0432\u0451\u0437\u0434\u044B \u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043C\u043D\u0435 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u043C\u0438."
  - ID: Chapter_3_Front_38
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uAC00 \uD558\uB098\uC529 \uC9DA\uC5B4\uC8FC\uACE0 \uB098\uC11C\uC57C"
    Text_En: Only after Dad pointed them out
    Text_ZhHans: "\u76F4\u5230\u7238\u7238\u4E00\u9897\u9897\u6307\u7ED9\u6211\u770B\uFF0C"
    Text_Ja: "\u304A\u7236\u3055\u3093\u304C\u4E00\u3064\u305A\u3064\u6559\u3048\u3066\u304F\u308C\u3066\u3001"
    Text_Es: "Solo cuando pap\xE1 me las se\xF1alaba"
    Text_Pt: "S\xF3 quando papai apontava uma por uma"
    Text_Ru: "\u041B\u0438\u0448\u044C \u043A\u043E\u0433\u0434\u0430 \u043F\u0430\u043F\u0430
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u0438\u0445 \u043F\u043E
      \u043E\u0434\u043D\u043E\u0439,"
  - ID: Chapter_3_Front_39
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uADF8 \uC0AC\uC774\uC5D0 \uC228\uC5B4 \uC788\uB358 \uBAA8\uC591\uC744
      \uCC3E\uC558\uB2E4."
    Text_En: could I see the shapes between them.
    Text_ZhHans: "\u6211\u624D\u627E\u5230\u85CF\u5728\u5B83\u4EEC\u4E4B\u95F4\u7684\u5F62\u72B6\u3002"
    Text_Ja: "\u3088\u3046\u3084\u304F\u96A0\u308C\u305F\u5F62\u304C\u898B\u3064\u304B\u3063\u305F\u3002"
    Text_Es: "ve\xEDa las formas ocultas entre ellas."
    Text_Pt: eu via as formas escondidas entre elas.
    Text_Ru: "\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430 \u0441\u043A\u0440\u044B\u0442\u044B\u0435
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u0444\u0438\u0433\u0443\u0440\u044B."
  - ID: Chapter_3_Front_40
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC624\uB798\uB41C \uADF8\uB9BC\uC758 \uC120\uC744 \uC0B4\uD3B4\uBD24\uB2E4."
    Text_En: I studied the old drawing's lines.
    Text_ZhHans: "\u6211\u4ED4\u7EC6\u770B\u7740\u65E7\u56FE\u4E0A\u7684\u8FDE\u7EBF\u3002"
    Text_Ja: "\u79C1\u306F\u53E4\u3044\u7D75\u306E\u7DDA\u3092\u305F\u3069\u3063\u305F\u3002"
    Text_Es: "Examin\xE9 las l\xEDneas del dibujo antiguo."
    Text_Pt: Examinei as linhas do desenho antigo.
    Text_Ru: "\u042F \u0438\u0437\u0443\u0447\u0438\u043B\u0430 \u043B\u0438\u043D\u0438\u0438
      \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0440\u0438\u0441\u0443\u043D\u043A\u0430."
  - ID: Chapter_3_Front_41
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uAC19\uC740 \uBAA8\uC591\uC774 \uB098\uC628\uB2E4\uBA74,"
    Text_En: If the shapes matched,
    Text_ZhHans: "\u5982\u679C\u80FD\u8FDE\u51FA\u540C\u6837\u7684\u5F62\u72B6\uFF0C"
    Text_Ja: "\u540C\u3058\u5F62\u306B\u306A\u308C\u3070\u3001"
    Text_Es: "Si aparec\xEDa la misma forma,"
    Text_Pt: Se a forma fosse a mesma,
    Text_Ru: "\u0415\u0441\u043B\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F
      \u0442\u0430 \u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u0430,"
  - ID: Chapter_3_Front_42
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC774 \uD398\uC774\uC9C0\uAC00 \uC5B4\uB290 \uACF3\uC744 \uB73B\uD558\uB294\uC9C0
      \uC54C \uC218 \uC788\uB2E4."
    Text_En: I'd know which place this page meant.
    Text_ZhHans: "\u5C31\u80FD\u77E5\u9053\u8FD9\u4E00\u9875\u6307\u7684\u662F\u54EA\u91CC\u3002"
    Text_Ja: "\u3053\u306E\u30DA\u30FC\u30B8\u304C\u6307\u3059\u5834\u6240\u3082\u5206\u304B\u308B\u3002"
    Text_Es: "sabr\xEDa qu\xE9 lugar indicaba esta p\xE1gina."
    Text_Pt: "eu saberia que lugar esta p\xE1gina indicava."
    Text_Ru: "\u044F \u043F\u043E\u0439\u043C\u0443, \u043A\u0430\u043A\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0443\u043A\u0430\u0437\u0430\u043D\u043E."
  - ID: Chapter_3_Front_43
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uAC00 \uAC00\uB974\uCCD0\uC900 \uB300\uB85C,"
    Text_En: Just as Dad had taught me,
    Text_ZhHans: "\u5C31\u7167\u7238\u7238\u6559\u6211\u7684\u90A3\u6837\uFF0C"
    Text_Ja: "\u304A\u7236\u3055\u3093\u306B\u6559\u308F\u3063\u305F\u3068\u304A\u308A\u3001"
    Text_Es: "Tal como me ense\xF1\xF3 pap\xE1,"
    Text_Pt: Como papai me ensinou,
    Text_Ru: "\u041A\u0430\u043A \u0443\u0447\u0438\u043B \u043C\u0435\u043D\u044F
      \u043F\u0430\u043F\u0430,"
  - ID: Chapter_3_Front_44
    Chapter_Id: 3_Front
    Speaker: Daughter
    Text_Kr: "\uBCC4 \uD558\uB098\uBD80\uD130 \uCC9C\uCC9C\uD788 \uC774\uC5B4\uBCF4\uC790."
    Text_En: I'd start with one star.
    Text_ZhHans: "\u4ECE\u4E00\u9897\u661F\u5F00\u59CB\uFF0C\u6162\u6162\u8FDE\u8D77\u6765\u5427\u3002"
    Text_Ja: "\u661F\u4E00\u3064\u304B\u3089\u3001\u3086\u3063\u304F\u308A\u3064\u306A\u3044\u3067\u307F\u3088\u3046\u3002"
    Text_Es: "empezar\xEDa por una estrella."
    Text_Pt: "eu come\xE7aria por uma estrela."
    Text_Ru: "\u043D\u0430\u0447\u043D\u0443 \u0441 \u043E\u0434\u043D\u043E\u0439
      \u0437\u0432\u0435\u0437\u0434\u044B, \u043D\u0435 \u0441\u043F\u0435\u0448\u0430."
  - ID: Chapter_3_Back_1
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uBC29 \uC548\uC5D0\uB294 \uC778\uAE30\uCC99\uC774 \uC5C6\uC5C8\uB2E4."
    Text_En: The room was empty.
    Text_ZhHans: "\u623F\u95F4\u91CC\u6CA1\u6709\u4EBA\u5728\u3002"
    Text_Ja: "\u90E8\u5C4B\u306B\u4EBA\u306E\u6C17\u914D\u306F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "No hab\xEDa nadie en la habitaci\xF3n."
    Text_Pt: "N\xE3o havia ningu\xE9m no quarto."
    Text_Ru: "\u0412 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043D\u0438\u043A\u043E\u0433\u043E
      \u043D\u0435 \u0431\u044B\u043B\u043E."
  - ID: Chapter_3_Back_2
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uCC45\uC0C1 \uC704\uC5D0 \uB0A1\uC740 \uC218\uCCA9 \uD558\uB098\uAC00
      \uB193\uC5EC \uC788\uC5C8\uB2E4."
    Text_En: An old notebook lay on the desk.
    Text_ZhHans: "\u4E66\u684C\u4E0A\u653E\u7740\u4E00\u672C\u65E7\u7B14\u8BB0\u672C\u3002"
    Text_Ja: "\u673A\u306B\u53E4\u3044\u624B\u5E33\u304C\u4E00\u518A\u7F6E\u3044\u3066\u3042\u3063\u305F\u3002"
    Text_Es: Un viejo cuaderno reposaba en la mesa.
    Text_Pt: Um velho caderno estava sobre a mesa.
    Text_Ru: "\u041D\u0430 \u0441\u0442\u043E\u043B\u0435 \u043B\u0435\u0436\u0430\u043B
      \u0441\u0442\u0430\u0440\u044B\u0439 \u0431\u043B\u043E\u043A\u043D\u043E\u0442."
  - ID: Chapter_3_Back_3
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB538\uACFC \uB2E8\uB458\uC774 \uC0B4\uC558\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
    Text_En: He lived here with his daughter.
    Text_ZhHans: "\u636E\u8BF4\u4ED6\u548C\u5973\u513F\u4E24\u4E2A\u4EBA\u4F4F\u3002"
    Text_Ja: "\u5A18\u3068\u4E8C\u4EBA\u66AE\u3089\u3057\u3060\u3063\u305F\u305D\u3046\u3067\u3059\u3002"
    Text_Es: "Dicen que viv\xEDa solo con su hija."
    Text_Pt: "Dizem que ele morava s\xF3 com a filha."
    Text_Ru: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043E\u043D \u0436\u0438\u043B
      \u0432\u0434\u0432\u043E\u0451\u043C \u0441 \u0434\u043E\u0447\u0435\u0440\u044C\u044E."
  - ID: Chapter_3_Back_4
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB538\uC740 \uC5F0\uB77D\uC774 \uB418\uB098?"
    Text_En: Have we reached her?
    Text_ZhHans: "\u8054\u7CFB\u4E0A\u5973\u513F\u4E86\u5417\uFF1F"
    Text_Ja: "\u5A18\u306B\u306F\u9023\u7D61\u304C\u3064\u3044\u305F\u304B\uFF1F"
    Text_Es: "\xBFHan podido contactar con ella?"
    Text_Pt: Conseguiram falar com ela?
    Text_Ru: "\u0421 \u0434\u043E\u0447\u0435\u0440\u044C\u044E \u0441\u0432\u044F\u0437\u0430\u043B\u0438\u0441\u044C?"
  - ID: Chapter_3_Back_5
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC544\uC9C1 \uC548 \uB429\uB2C8\uB2E4."
    Text_En: Not yet.
    Text_ZhHans: "\u8FD8\u6CA1\u6709\u3002"
    Text_Ja: "\u307E\u3060\u3067\u3059\u3002"
    Text_Es: "A\xFAn no."
    Text_Pt: "Ainda n\xE3o."
    Text_Ru: "\u041F\u043E\u043A\u0430 \u043D\u0435\u0442."
  - ID: Chapter_3_Back_6
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC5B8\uC81C\uBD80\uD130 \uC9D1\uC744 \uBE44\uC6E0\uB294\uC9C0\uB3C4
      \uD655\uC778 \uC911\uC785\uB2C8\uB2E4."
    Text_En: We're checking when she left.
    Text_ZhHans: "\u4E5F\u5728\u786E\u8BA4\u5979\u662F\u4EC0\u4E48\u65F6\u5019\u79BB\u5BB6\u7684\u3002"
    Text_Ja: "\u3044\u3064\u304B\u3089\u7559\u5B88\u306A\u306E\u304B\u3082\u78BA\u8A8D\u4E2D\u3067\u3059\u3002"
    Text_Es: "Tambi\xE9n averiguamos cu\xE1ndo se fue."
    Text_Pt: "Tamb\xE9m estamos apurando quando ela saiu."
    Text_Ru: "\u0412\u044B\u044F\u0441\u043D\u044F\u0435\u043C, \u043A\u043E\u0433\u0434\u0430
      \u043E\u043D\u0430 \u0443\u0448\u043B\u0430 \u0438\u0437 \u0434\u043E\u043C\u0430."
  - ID: Chapter_3_Back_7
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uC7A5\uAC11\uC744 \uB07C\uACE0 \uC218\uCCA9\uC744 \uD3BC\uCCE4\uB2E4."
    Text_En: I put on gloves and opened the book.
    Text_ZhHans: "\u6211\u6234\u4E0A\u624B\u5957\uFF0C\u7FFB\u5F00\u7B14\u8BB0\u672C\u3002"
    Text_Ja: "\u79C1\u306F\u624B\u888B\u3092\u306F\u3081\u3001\u624B\u5E33\u3092\u958B\u3044\u305F\u3002"
    Text_Es: "Me puse los guantes y abr\xED el cuaderno."
    Text_Pt: Coloquei as luvas e abri o caderno.
    Text_Ru: "\u042F \u043D\u0430\u0434\u0435\u043B \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438
      \u0438 \u043E\u0442\u043A\u0440\u044B\u043B \u0431\u043B\u043E\u043A\u043D\u043E\u0442."
  - ID: Chapter_3_Back_8
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC55E\uBD80\uBD84\uC5D0\uB294 \uBCC4\uC744 \uAD00\uCE21\uD55C \uAE30\uB85D\uC774
      \uC788\uC5C8\uB2E4."
    Text_En: The first pages held stargazing notes.
    Text_ZhHans: "\u524D\u9762\u662F\u89C2\u661F\u8BB0\u5F55\u3002"
    Text_Ja: "\u524D\u534A\u306B\u306F\u661F\u306E\u89B3\u6E2C\u8A18\u9332\u304C\u3042\u3063\u305F\u3002"
    Text_Es: "Al principio hab\xEDa notas de observaci\xF3n."
    Text_Pt: "No in\xEDcio, havia notas de observa\xE7\xE3o."
    Text_Ru: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0431\u044B\u043B\u0438
      \u0437\u0430\u043F\u0438\u0441\u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439."
  - ID: Chapter_3_Back_9
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB0A0\uC9DC\uC640 \uB0A0\uC528, \uCC3E\uC544\uBCF8 \uBCC4\uC790\uB9AC."
    Text_En: Dates, weather, constellations.
    Text_ZhHans: "\u65E5\u671F\u3001\u5929\u6C14\uFF0C\u8FD8\u6709\u89C2\u6D4B\u8FC7\u7684\u661F\u5EA7\u3002"
    Text_Ja: "\u65E5\u4ED8\u3068\u5929\u6C17\u3001\u89B3\u6E2C\u3057\u305F\u661F\u5EA7\u3002"
    Text_Es: Fechas, tiempo y constelaciones.
    Text_Pt: "Datas, clima e constela\xE7\xF5es."
    Text_Ru: "\u0414\u0430\u0442\u044B, \u043F\u043E\u0433\u043E\u0434\u0430, \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435
      \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F."
  - ID: Chapter_3_Back_10
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uBCC4\uC744 \uBCF4\uB7EC \uC790\uC8FC \uB2E4\uB154\uB2E4\uB354\uAD70\uC694."
    Text_En: Apparently, he went out often.
    Text_ZhHans: "\u542C\u8BF4\u4ED6\u7ECF\u5E38\u51FA\u53BB\u770B\u661F\u661F\u3002"
    Text_Ja: "\u3088\u304F\u661F\u3092\u898B\u306B\u51FA\u304B\u3051\u3066\u3044\u305F\u305D\u3046\u3067\u3059\u3002"
    Text_Es: "Parece que sal\xEDa a ver estrellas a menudo."
    Text_Pt: "Dizem que ele sa\xEDa muito para ver estrelas."
    Text_Ru: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043E\u043D \u0447\u0430\u0441\u0442\u043E
      \u0435\u0437\u0434\u0438\u043B \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: Chapter_3_Back_11
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uBC24\uC5D0 \uB098\uAC00 \uC0C8\uBCBD\uC5D0 \uB3CC\uC544\uC624\uACE4
      \uD588\uB2F5\uB2C8\uB2E4."
    Text_En: He'd leave at night, return at dawn.
    Text_ZhHans: "\u603B\u662F\u591C\u91CC\u51FA\u95E8\uFF0C\u51CC\u6668\u624D\u56DE\u6765\u3002"
    Text_Ja: "\u591C\u306B\u51FA\u3066\u3001\u660E\u3051\u65B9\u306B\u5E30\u3063\u3066\u304D\u305F\u3068\u304B\u3002"
    Text_Es: "Se iba de noche y volv\xEDa al amanecer."
    Text_Pt: "Sa\xEDa \xE0 noite e voltava de madrugada."
    Text_Ru: "\u0423\u0435\u0437\u0436\u0430\u043B \u043D\u043E\u0447\u044C\u044E,
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0441\u044F \u043F\u043E\u0434
      \u0443\u0442\u0440\u043E."
  - ID: Chapter_3_Back_12
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB4A4\uCABD\uC740 \uAE30\uB85D\uC758 \uD615\uC2DD\uC774 \uB2EC\uB790\uB2E4."
    Text_En: The later entries were different.
    Text_ZhHans: "\u540E\u9762\u7684\u8BB0\u5F55\u683C\u5F0F\u5374\u4E0D\u540C\u3002"
    Text_Ja: "\u5F8C\u534A\u306F\u8A18\u9332\u306E\u5F62\u5F0F\u304C\u9055\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "Las \xFAltimas notas ten\xEDan otro formato."
    Text_Pt: "As \xFAltimas notas tinham outro formato."
    Text_Ru: "\u0411\u043B\u0438\u0436\u0435 \u043A \u043A\u043E\u043D\u0446\u0443
      \u0437\u0430\u043F\u0438\u0441\u0438 \u043C\u0435\u043D\u044F\u043B\u0438\u0441\u044C."
  - ID: Chapter_3_Back_13
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uBCC4\uC790\uB9AC \uC544\uB798\uB85C \uC9C0\uBA85\uACFC \uACBD\uB85C\uAC00
      \uC801\uD600 \uC788\uC5C8\uB2E4."
    Text_En: Places and routes beneath the stars.
    Text_ZhHans: "\u661F\u5EA7\u4E0B\u5199\u7740\u5730\u540D\u548C\u8DEF\u7EBF\u3002"
    Text_Ja: "\u661F\u5EA7\u306E\u4E0B\u306B\u5730\u540D\u3068\u9053\u9806\u304C\u3042\u3063\u305F\u3002"
    Text_Es: "Bajo las estrellas hab\xEDa lugares y rutas."
    Text_Pt: "Lugares e rotas sob as constela\xE7\xF5es."
    Text_Ru: "\u041F\u043E\u0434 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F\u043C\u0438
      \u2014 \u043C\u0435\u0441\u0442\u0430 \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B."
  - ID: Chapter_3_Back_14
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uAC08\uB9BC\uAE38\uC758 \uBC29\uD5A5\uACFC \uAC78\uC5B4\uAC00\uC57C
      \uD560 \uAC70\uB9AC."
    Text_En: Turns at forks. Distances on foot.
    Text_ZhHans: "\u5C94\u8DEF\u7684\u65B9\u5411\uFF0C\u4EE5\u53CA\u6B65\u884C\u7684\u8DDD\u79BB\u3002"
    Text_Ja: "\u5206\u304B\u308C\u9053\u306E\u65B9\u5411\u3001\u6B69\u304F\u8DDD\u96E2\u3002"
    Text_Es: Direcciones en los cruces. Distancias a pie.
    Text_Pt: "Dire\xE7\xF5es nos cruzamentos. Dist\xE2ncias a p\xE9."
    Text_Ru: "\u041F\u043E\u0432\u043E\u0440\u043E\u0442\u044B \u043D\u0430 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0430\u0445.
      \u0420\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u043F\u0435\u0448\u043A\u043E\u043C."
  - ID: Chapter_3_Back_15
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB05D\uC5D0\uB294 \uB73B\uC744 \uC54C \uC218 \uC5C6\uB294 \uD45C\uC2DC\uAC00
      \uC788\uC5C8\uB2E4."
    Text_En: Each ended with an unexplained mark.
    Text_ZhHans: "\u6700\u540E\u8FD8\u6709\u542B\u4E49\u4E0D\u660E\u7684\u6807\u8BB0\u3002"
    Text_Ja: "\u6700\u5F8C\u306B\u306F\u610F\u5473\u4E0D\u660E\u306E\u5370\u304C\u3042\u3063\u305F\u3002"
    Text_Es: Al final, una marca sin significado claro.
    Text_Pt: No fim, uma marca sem significado claro.
    Text_Ru: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u2014 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u0430\u044F
      \u043E\u0442\u043C\u0435\u0442\u043A\u0430."
  - ID: Chapter_3_Back_16
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uCC28\uB7C9 \uB3D9\uC120 \uC790\uB8CC\uB97C \uC606\uC5D0
      \uB193\uC558\uB2E4."
    Text_En: I laid the vehicle records beside it.
    Text_ZhHans: "\u6211\u628A\u8F66\u8F86\u884C\u9A76\u8BB0\u5F55\u653E\u5728\u65C1\u8FB9\u3002"
    Text_Ja: "\u79C1\u306F\u8ECA\u4E21\u306E\u79FB\u52D5\u8A18\u9332\u3092\u6A2A\u306B\u7F6E\u3044\u305F\u3002"
    Text_Es: "Puse al lado el registro del veh\xEDculo."
    Text_Pt: "Pus ao lado o registro do ve\xEDculo."
    Text_Ru: "\u042F \u043F\u043E\u043B\u043E\u0436\u0438\u043B \u0440\u044F\u0434\u043E\u043C
      \u0434\u0430\u043D\u043D\u044B\u0435 \u043E \u043C\u0430\u0448\u0438\u043D\u0435."
  - ID: Chapter_3_Back_17
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uD53C\uD574\uC790\uAC00 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBAA9\uACA9\uB41C
      \uB0A0,"
    Text_En: On the day the victim was last seen,
    Text_ZhHans: "\u53D7\u5BB3\u8005\u6700\u540E\u88AB\u76EE\u51FB\u7684\u90A3\u5929\uFF0C"
    Text_Ja: "\u88AB\u5BB3\u8005\u304C\u6700\u5F8C\u306B\u76EE\u6483\u3055\u308C\u305F\u65E5\u3001"
    Text_Es: "El d\xEDa que vieron por \xFAltima vez a la v\xEDctima,"
    Text_Pt: "No dia em que a v\xEDtima foi vista pela \xFAltima vez,"
    Text_Ru: "\u0412 \u0434\u0435\u043D\u044C, \u043A\u043E\u0433\u0434\u0430 \u0436\u0435\u0440\u0442\u0432\u0443
      \u0432\u0438\u0434\u0435\u043B\u0438 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437,"
  - ID: Chapter_3_Back_18
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uADF8\uC758 \uCC28\uB3C4 \uAC19\uC740 \uAD6C\uAC04\uC744 \uC9C0\uB098\uAC14\uB2E4."
    Text_En: his car had passed the same stretch.
    Text_ZhHans: "\u4ED6\u7684\u8F66\u4E5F\u7ECF\u8FC7\u4E86\u540C\u4E00\u8DEF\u6BB5\u3002"
    Text_Ja: "\u5F7C\u306E\u8ECA\u3082\u540C\u3058\u533A\u9593\u3092\u901A\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "su coche tambi\xE9n pas\xF3 por aquel tramo."
    Text_Pt: o carro dele passou pelo mesmo trecho.
    Text_Ru: "\u0435\u0433\u043E \u043C\u0430\u0448\u0438\u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u0430
      \u043F\u043E \u0442\u043E\u043C\u0443 \u0436\u0435 \u0443\u0447\u0430\u0441\u0442\u043A\u0443."
  - ID: Chapter_3_Back_19
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC774\uD6C4 \uCC28\uAC00 \uD5A5\uD55C \uCABD\uC740 \uC0B0\uC73C\uB85C
      \uB09C \uB3C4\uB85C\uC600\uB2E4."
    Text_En: Then it had headed into the hills.
    Text_ZhHans: "\u4E4B\u540E\uFF0C\u8F66\u5F00\u4E0A\u4E86\u901A\u5F80\u5C71\u91CC\u7684\u9053\u8DEF\u3002"
    Text_Ja: "\u305D\u306E\u5F8C\u3001\u8ECA\u306F\u5C71\u3078\u5411\u304B\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "Luego tom\xF3 la carretera hacia el monte."
    Text_Pt: Depois, seguiu pela estrada da montanha.
    Text_Ru: "\u0417\u0430\u0442\u0435\u043C \u043E\u043D\u0430 \u0441\u0432\u0435\u0440\u043D\u0443\u043B\u0430
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 \u0432 \u0433\u043E\u0440\u044B."
  - ID: Chapter_3_Back_20
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC5EC\uAE30 \uC801\uD78C \uC9C4\uC785\uB85C."
    Text_En: This access road here.
    Text_ZhHans: "\u8FD9\u91CC\u5199\u7684\u5165\u53E3\uFF0C"
    Text_Ja: "\u3053\u3053\u306B\u66F8\u304B\u308C\u305F\u5165\u53E3\u3002"
    Text_Es: "Este acceso que anot\xF3."
    Text_Pt: Esta entrada anotada aqui.
    Text_Ru: "\u0412\u043E\u0442 \u044D\u0442\u043E\u0442 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0439
      \u0432\u044A\u0435\u0437\u0434."
  - ID: Chapter_3_Back_21
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uCC28\uB7C9\uC774 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD655\uC778\uB41C
      \uACF3\uACFC \uAC00\uAE5D\uAD70."
    Text_En: It's near the car's last sighting.
    Text_ZhHans: "\u79BB\u6700\u540E\u62CD\u5230\u8F66\u8F86\u7684\u5730\u65B9\u5F88\u8FD1\u3002"
    Text_Ja: "\u8ECA\u304C\u6700\u5F8C\u306B\u78BA\u8A8D\u3055\u308C\u305F\u5834\u6240\u306B\u8FD1\u3044\u306A\u3002"
    Text_Es: "Est\xE1 cerca de donde vieron el coche."
    Text_Pt: Fica perto de onde o carro foi visto.
    Text_Ru: "\u041D\u0435\u0434\u0430\u043B\u0435\u043A\u043E \u043E\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
      \u043E\u0442\u043C\u0435\u0442\u043A\u0438 \u043C\u0430\u0448\u0438\u043D\u044B."
  - ID: Chapter_3_Back_22
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uADF8 \uB4A4\uB85C\uB294 \uAC78\uC5B4\uC11C \uB4E4\uC5B4\uAC00\uB294
      \uAE38\uC785\uB2C8\uB2E4."
    Text_En: The rest is a walking trail.
    Text_ZhHans: "\u4E4B\u540E\u53EA\u80FD\u6B65\u884C\u8FDB\u53BB\u3002"
    Text_Ja: "\u305D\u306E\u5148\u306F\u5F92\u6B69\u3067\u5165\u308B\u9053\u3067\u3059\u3002"
    Text_Es: "Desde ah\xED se sigue a pie."
    Text_Pt: "Dali em diante, s\xF3 a p\xE9."
    Text_Ru: "\u0414\u0430\u043B\u044C\u0448\u0435 \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0448\u043A\u043E\u043C."
  - ID: Chapter_3_Back_23
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uBC14\uC704\uC640 \uB098\uBB34 \uC704\uCE58\uAE4C\uC9C0 \uC801\uC5B4\uB480\uC2B5\uB2C8\uB2E4."
    Text_En: He even marked the rocks and trees.
    Text_ZhHans: "\u8FDE\u5CA9\u77F3\u548C\u6811\u7684\u4F4D\u7F6E\u90FD\u5199\u4E86\u3002"
    Text_Ja: "\u5CA9\u3084\u6728\u306E\u4F4D\u7F6E\u307E\u3067\u8A18\u3055\u308C\u3066\u3044\u307E\u3059\u3002"
    Text_Es: "Hasta anot\xF3 d\xF3nde est\xE1n las rocas y \xE1rboles."
    Text_Pt: "Ele marcou at\xE9 as rochas e as \xE1rvores."
    Text_Ru: "\u041E\u043D \u043E\u0442\u043C\u0435\u0442\u0438\u043B \u0434\u0430\u0436\u0435
      \u0441\u043A\u0430\u043B\u044B \u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F."
  - ID: Chapter_3_Back_24
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uC811\uD78C \uBAA8\uC11C\uB9AC\uB97C \uC870\uC2EC\uC2A4\uB7FD\uAC8C
      \uD3C8\uB2E4."
    Text_En: I carefully unfolded a page corner.
    Text_ZhHans: "\u6211\u5C0F\u5FC3\u5730\u5C55\u5F00\u6298\u8D77\u7684\u9875\u89D2\u3002"
    Text_Ja: "\u79C1\u306F\u6298\u308C\u305F\u30DA\u30FC\u30B8\u306E\u89D2\u3092\u305D\u3063\u3068\u4F38\u3070\u3057\u305F\u3002"
    Text_Es: "Desdobl\xE9 con cuidado una esquina."
    Text_Pt: "Desdobrei com cuidado o canto da p\xE1gina."
    Text_Ru: "\u042F \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u043B
      \u0437\u0430\u0433\u043D\u0443\u0442\u044B\u0439 \u0443\u0433\u043E\u043B."
  - ID: Chapter_3_Back_25
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC885\uC774 \uC0AC\uC774\uC5D0 \uB9C8\uB978 \uD759\uC774 \uB07C\uC5B4
      \uC788\uC5C8\uB2E4."
    Text_En: Dry dirt lay between the pages.
    Text_ZhHans: "\u7EB8\u9875\u4E4B\u95F4\u5939\u7740\u5E72\u6389\u7684\u6CE5\u571F\u3002"
    Text_Ja: "\u7D19\u306E\u9593\u306B\u4E7E\u3044\u305F\u571F\u304C\u631F\u307E\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "Hab\xEDa tierra seca entre las hojas."
    Text_Pt: Havia terra seca entre as folhas.
    Text_Ru: "\u041C\u0435\u0436\u0434\u0443 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u043C\u0438
      \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0430 \u0441\u0443\u0445\u0430\u044F
      \u0437\u0435\u043C\u043B\u044F."
  - ID: Chapter_3_Back_26
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB9C8\uC9C0\uB9C9 \uC7A5\uC5D0\uB294 \uB2E4\uB978 \uAE00\uC528\uAC00
      \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    Text_En: The last page had different writing.
    Text_ZhHans: "\u6700\u540E\u4E00\u9875\u7559\u7740\u53E6\u4E00\u79CD\u5B57\u8FF9\u3002"
    Text_Ja: "\u6700\u5F8C\u306E\u30DA\u30FC\u30B8\u306B\u306F\u3001\u5225\u306E\u7B46\u8DE1\u304C\u3042\u3063\u305F\u3002"
    Text_Es: "La \xFAltima p\xE1gina ten\xEDa otra letra."
    Text_Pt: "Na \xFAltima p\xE1gina, a letra era diferente."
    Text_Ru: "\u041D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435 \u0431\u044B\u043B \u0434\u0440\u0443\u0433\u043E\u0439
      \u043F\u043E\u0447\u0435\u0440\u043A."
  - ID: Chapter_3_Back_27
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC544\uBE60\uC640 \uBCC4\uC744 \uC787\uB294 \uBC95\uC744 \uBC30\uC6E0\uB358
      \uACF3\uC5D0 \uAC08\uAC8C."
    Text_En: I'll go where you taught me the stars.
    Text_ZhHans: "\u6211\u53BB\u7238\u7238\u6559\u6211\u8FDE\u661F\u661F\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u3068\u661F\u3092\u3064\u306A\u3050\u7DF4\u7FD2\u3092\u3057\u305F\u5834\u6240\u306B\u884C\u304F\u306D\u3002"
    Text_Es: "Ir\xE9 donde me ense\xF1aste a unir estrellas."
    Text_Pt: "Vou onde voc\xEA me ensinou a ligar estrelas."
    Text_Ru: "\u041F\u043E\u0439\u0434\u0443 \u0442\u0443\u0434\u0430, \u0433\u0434\u0435
      \u0442\u044B \u0443\u0447\u0438\u043B \u043C\u0435\u043D\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: Chapter_3_Back_28
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC624\uB298\uC740 \uAC70\uAE30\uC11C \uAE30\uB2E4\uB9B4\uAC8C."
    Text_En: I'll wait there today.
    Text_ZhHans: "\u4ECA\u5929\u6211\u4F1A\u5728\u90A3\u91CC\u7B49\u4F60\u3002"
    Text_Ja: "\u4ECA\u65E5\u306F\u305D\u3053\u3067\u5F85\u3063\u3066\u308B\u3002"
    Text_Es: "Hoy te esperar\xE9 all\xED."
    Text_Pt: "Hoje vou esperar l\xE1."
    Text_Ru: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u0443\u0434\u0443
      \u0436\u0434\u0430\u0442\u044C \u0442\u0430\u043C."
  - ID: Chapter_3_Back_29
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB538\uC774 \uC544\uBC84\uC9C0\uC5D0\uAC8C \uB0A8\uAE34 \uB9D0 \uAC19\uAD70."
    Text_En: Looks like a note from his daughter.
    Text_ZhHans: "\u50CF\u662F\u5973\u513F\u7559\u7ED9\u7236\u4EB2\u7684\u8BDD\u3002"
    Text_Ja: "\u5A18\u304C\u7236\u89AA\u306B\u6B8B\u3057\u305F\u8A00\u8449\u306E\u3088\u3046\u3060\u306A\u3002"
    Text_Es: Parece una nota de la hija para su padre.
    Text_Pt: Parece um recado da filha para o pai.
    Text_Ru: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0434\u043E\u0447\u044C \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u0437\u0430\u043F\u0438\u0441\u043A\u0443 \u043E\u0442\u0446\u0443."
  - ID: Chapter_3_Back_30
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC6B0\uC120 \uAE30\uB85D\uB41C \uC7A5\uC18C\uBD80\uD130 \uD655\uC778\uD55C\uB2E4."
    Text_En: Let's check the listed places first.
    Text_ZhHans: "\u5148\u786E\u8BA4\u8BB0\u5F55\u91CC\u7684\u5730\u70B9\u3002"
    Text_Ja: "\u307E\u305A\u306F\u8A18\u9332\u3055\u308C\u305F\u5834\u6240\u3092\u78BA\u8A8D\u3059\u308B\u3002"
    Text_Es: Primero revisaremos los lugares anotados.
    Text_Pt: Vamos verificar os locais anotados primeiro.
    Text_Ru: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0435 \u043C\u0435\u0441\u0442\u0430."
  - ID: Chapter_3_Back_31
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC218\uCCA9 \uD655\uBCF4\uD558\uACE0, \uAE30\uB85D\uC744 \uCD2C\uC601\uD574\uC11C
      \uACF5\uC720\uD574."
    Text_En: Secure the book. Share photos of it.
    Text_ZhHans: "\u6536\u597D\u7B14\u8BB0\u672C\uFF0C\u62CD\u4E0B\u8BB0\u5F55\u53D1\u7ED9\u5404\u7EC4\u3002"
    Text_Ja: "\u624B\u5E33\u3092\u62BC\u53CE\u3057\u3001\u8A18\u9332\u3092\u64AE\u5F71\u3057\u3066\u5171\u6709\u3057\u308D\u3002"
    Text_Es: Guarden el cuaderno y compartan fotos.
    Text_Pt: Recolham o caderno e compartilhem fotos.
    Text_Ru: "\u0418\u0437\u044B\u043C\u0438\u0442\u0435 \u0431\u043B\u043E\u043A\u043D\u043E\u0442.
      \u0420\u0430\u0437\u043E\u0448\u043B\u0438\u0442\u0435 \u0441\u043D\u0438\u043C\u043A\u0438
      \u0437\u0430\u043F\u0438\u0441\u0435\u0439."
  - ID: Chapter_3_Back_32
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uCC28\uB7C9 \uB3D9\uC120\uACFC \uACB9\uCE58\uB294 \uACF3\uBD80\uD130
      \uC218\uC0C9\uD55C\uB2E4."
    Text_En: Start where the vehicle route matches.
    Text_ZhHans: "\u4ECE\u4E0E\u8F66\u8F86\u8DEF\u7EBF\u91CD\u5408\u7684\u5730\u65B9\u5F00\u59CB\u641C\u3002"
    Text_Ja: "\u8ECA\u306E\u7D4C\u8DEF\u3068\u91CD\u306A\u308B\u5834\u6240\u304B\u3089\u635C\u7D22\u3060\u3002"
    Text_Es: Empiecen donde coincida la ruta del coche.
    Text_Pt: Comecem onde a rota do carro coincide.
    Text_Ru: "\u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0439
      \u0441 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C \u043C\u0430\u0448\u0438\u043D\u044B."
  - ID: Chapter_3_Back_33
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC778\uC6D0 \uC694\uCCAD\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    Text_En: I'll request more personnel.
    Text_ZhHans: "\u6211\u53BB\u7533\u8BF7\u589E\u6D3E\u4EBA\u624B\u3002"
    Text_Ja: "\u5FDC\u63F4\u3092\u8981\u8ACB\u3057\u307E\u3059\u3002"
    Text_Es: "Pedir\xE9 refuerzos."
    Text_Pt: "Vou pedir refor\xE7os."
    Text_Ru: "\u0417\u0430\u043F\u0440\u043E\u0448\u0443 \u043B\u044E\u0434\u0435\u0439."
  - ID: Chapter_3_Back_34
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB538\uC758 \uD589\uBC29\uB3C4 \uACC4\uC18D \uD655\uC778\uD574."
    Text_En: Keep looking for his daughter, too.
    Text_ZhHans: "\u4E5F\u7EE7\u7EED\u67E5\u5973\u513F\u7684\u4E0B\u843D\u3002"
    Text_Ja: "\u5A18\u306E\u884C\u65B9\u3082\u5F15\u304D\u7D9A\u304D\u8ABF\u3079\u308D\u3002"
    Text_Es: Sigan buscando a la hija.
    Text_Pt: Continuem procurando a filha.
    Text_Ru: "\u0414\u043E\u0447\u044C \u0442\u043E\u0436\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435
      \u0438\u0441\u043A\u0430\u0442\u044C."
  - ID: Chapter_3_Back_35
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC544\uBC84\uC9C0\uAC00 \uC5B4\uB514\uB85C \uAC14\uB294\uC9C0 \uC54C
      \uC218\uB3C4 \uC788\uC5B4."
    Text_En: She may know where he went.
    Text_ZhHans: "\u5979\u53EF\u80FD\u77E5\u9053\u7236\u4EB2\u53BB\u4E86\u54EA\u91CC\u3002"
    Text_Ja: "\u7236\u89AA\u306E\u884C\u304D\u5148\u3092\u77E5\u3063\u3066\u3044\u308B\u304B\u3082\u3057\u308C\u3093\u3002"
    Text_Es: "Quiz\xE1 sepa ad\xF3nde fue su padre."
    Text_Pt: Ela pode saber aonde o pai foi.
    Text_Ru: "\u041E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u0437\u043D\u0430\u0442\u044C,
      \u043A\u0443\u0434\u0430 \u0443\u0448\u0451\u043B \u043E\u0442\u0435\u0446."
  - ID: Chapter_3_Back_36
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uC218\uCCA9\uC5D0 \uADF8\uB824\uC9C4 \uBCC4\uB4E4\uC744
      \uB2E4\uC2DC \uBD24\uB2E4."
    Text_En: I looked again at the drawn stars.
    Text_ZhHans: "\u6211\u518D\u6B21\u770B\u5411\u672C\u5B50\u4E0A\u7684\u661F\u661F\u3002"
    Text_Ja: "\u79C1\u306F\u624B\u5E33\u306E\u661F\u3092\u3082\u3046\u4E00\u5EA6\u898B\u305F\u3002"
    Text_Es: "Volv\xED a mirar las estrellas dibujadas."
    Text_Pt: Olhei de novo para as estrelas desenhadas.
    Text_Ru: "\u042F \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: Chapter_3_Back_37
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uADF8\uB9BC \uC544\uB798\uC758 \uAE38\uC740 \uC232 \uAE4A\uC219\uC774
      \uC774\uC5B4\uC84C\uB2E4."
    Text_En: The paths below led deep into the woods.
    Text_ZhHans: "\u56FE\u6848\u4E0B\u7684\u8DEF\u901A\u5F80\u68EE\u6797\u6DF1\u5904\u3002"
    Text_Ja: "\u7D75\u306E\u4E0B\u306E\u9053\u306F\u3001\u68EE\u306E\u5965\u3078\u7D9A\u3044\u3066\u3044\u305F\u3002"
    Text_Es: El camino llevaba al fondo del bosque.
    Text_Pt: Os caminhos levavam ao fundo da floresta.
    Text_Ru: "\u0414\u043E\u0440\u043E\u0433\u0438 \u043F\u043E\u0434 \u043D\u0438\u043C\u0438
      \u0432\u0435\u043B\u0438 \u0432 \u0433\u043B\u0443\u0431\u044C \u043B\u0435\u0441\u0430."
  - ID: Chapter_3_Back_38
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uADF8\uAC00 \uADF8\uACF3\uC5D0\uC11C \uBB34\uC5C7\uC744 \uD588\uB294\uC9C0,"
    Text_En: Whatever he'd done there,
    Text_ZhHans: "\u4ED6\u5728\u90A3\u91CC\u505A\u8FC7\u4EC0\u4E48\uFF0C"
    Text_Ja: "\u5F7C\u304C\u305D\u3053\u3067\u4F55\u3092\u3057\u305F\u306E\u304B\u3001"
    Text_Es: "Fuera lo que fuera lo que hab\xEDa hecho,"
    Text_Pt: O que quer que ele tivesse feito ali,
    Text_Ru: "\u0427\u0442\u043E \u043E\u043D \u0442\u0430\u043C \u0434\u0435\u043B\u0430\u043B,"
  - ID: Chapter_3_Back_39
    Chapter_Id: 3_Back
    Speaker: Police
    Text_Kr: "\uC774\uC81C \uC9C1\uC811 \uD655\uC778\uD560 \uCC28\uB840\uC600\uB2E4."
    Text_En: it was time to see for ourselves.
    Text_ZhHans: "\u73B0\u5728\u8BE5\u4EB2\u81EA\u53BB\u786E\u8BA4\u4E86\u3002"
    Text_Ja: "\u76F4\u63A5\u78BA\u304B\u3081\u308B\u3068\u304D\u304C\u6765\u305F\u3002"
    Text_Es: era hora de comprobarlo.
    Text_Pt: era hora de descobrir.
    Text_Ru: "\u043F\u0440\u0435\u0434\u0441\u0442\u043E\u044F\u043B\u043E \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
  - ID: Chapter_4_Front_1
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC0BD\uB0A0\uC774 \uB3CC\uC5D0 \uBD80\uB52A\uD614\uB2E4."
    Text_En: The shovel struck a stone.
    Text_ZhHans: "\u9539\u5203\u649E\u4E0A\u4E86\u77F3\u5934\u3002"
    Text_Ja: "\u30B7\u30E3\u30D9\u30EB\u306E\u5148\u304C\u77F3\u306B\u5F53\u305F\u3063\u305F\u3002"
    Text_Es: "La pala golpe\xF3 una piedra."
    Text_Pt: "A p\xE1 bateu em uma pedra."
    Text_Ru: "\u041B\u043E\u043F\u0430\u0442\u0430 \u0443\u0434\u0430\u0440\u0438\u043B\u0430\u0441\u044C
      \u043E \u043A\u0430\u043C\u0435\u043D\u044C."
  - ID: Chapter_4_Front_2
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uC190\uC744 \uBA48\uCD94\uACE0 \uD5C8\uB9AC\uB97C \uD3C8\uB2E4."
    Text_En: I stopped and straightened my back.
    Text_ZhHans: "\u6211\u505C\u4E0B\u624B\uFF0C\u76F4\u8D77\u8170\u3002"
    Text_Ja: "\u79C1\u306F\u624B\u3092\u6B62\u3081\u3001\u8170\u3092\u4F38\u3070\u3057\u305F\u3002"
    Text_Es: "Me detuve y enderec\xE9 la espalda."
    Text_Pt: Parei e endireitei as costas.
    Text_Ru: "\u042F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u0438 \u0432\u044B\u043F\u0440\u044F\u043C\u0438\u043B \u0441\u043F\u0438\u043D\u0443."
  - ID: Chapter_4_Front_3
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB098\uBB34 \uC0AC\uC774\uB85C \uBC24\uD558\uB298\uC774 \uBCF4\uC600\uB2E4."
    Text_En: The night sky showed through the trees.
    Text_ZhHans: "\u6811\u6728\u4E4B\u95F4\u9732\u51FA\u591C\u7A7A\u3002"
    Text_Ja: "\u6728\u3005\u306E\u9593\u304B\u3089\u591C\u7A7A\u304C\u898B\u3048\u305F\u3002"
    Text_Es: "El cielo nocturno asomaba entre los \xE1rboles."
    Text_Pt: "O c\xE9u noturno aparecia entre as \xE1rvores."
    Text_Ru: "\u041C\u0435\u0436\u0434\u0443 \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C\u0438
      \u0432\u0438\u0434\u043D\u0435\u043B\u043E\u0441\u044C \u043D\u043E\u0447\u043D\u043E\u0435
      \u043D\u0435\u0431\u043E."
  - ID: Chapter_4_Front_4
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC608\uC804\uC5D0\uB294 \uB9DD\uC6D0\uACBD\uC744 \uBA54\uACE0 \uC624\uB974\uB358
      \uAE38\uC774\uC5C8\uB2E4."
    Text_En: I'd once carried a telescope up here.
    Text_ZhHans: "\u4EE5\u524D\uFF0C\u6211\u66FE\u80CC\u7740\u671B\u8FDC\u955C\u8D70\u4E0A\u8FD9\u6761\u8DEF\u3002"
    Text_Ja: "\u6614\u306F\u671B\u9060\u93E1\u3092\u62C5\u3044\u3067\u4E0A\u3063\u305F\u9053\u3060\u3063\u305F\u3002"
    Text_Es: "Antes sub\xEDa por aqu\xED con el telescopio."
    Text_Pt: "Eu j\xE1 subira ali levando um telesc\xF3pio."
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044F \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0441\u044F
      \u0441\u044E\u0434\u0430 \u0441 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u043E\u043C."
  - ID: Chapter_4_Front_5
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC544\uC774\uC5D0\uAC8C \uC791\uC740\uACF0\uC790\uB9AC\uB97C \uC54C\uB824\uC8FC\uB358
      \uBC24\uC5D0\uB3C4,"
    Text_En: Even as I showed her the Little Bear,
    Text_ZhHans: "\u6559\u5973\u513F\u8BA4\u5C0F\u718A\u5EA7\u7684\u90A3\u4E2A\u665A\u4E0A\uFF0C"
    Text_Ja: "\u5A18\u306B\u3053\u3050\u307E\u5EA7\u3092\u6559\u3048\u305F\u591C\u3082\u3001"
    Text_Es: "La noche que le ense\xF1\xE9 la Osa Menor,"
    Text_Pt: "Na noite em que mostrei a Ursa Menor \xE0 minha filha,"
    Text_Ru: "\u0412 \u0442\u0443 \u043D\u043E\u0447\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0443\u0447\u0438\u043B \u0434\u043E\u0447\u044C \u0438\u0441\u043A\u0430\u0442\u044C
      \u041C\u0430\u043B\u0443\u044E \u041C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u0443,"
  - ID: Chapter_4_Front_6
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uC624\uB298 \uC774\uACF3\uC5D0 \uC62C \uC77C\uC744 \uC0DD\uAC01\uD558\uACE0
      \uC788\uC5C8\uB2E4."
    Text_En: I'd been thinking of coming here tonight.
    Text_ZhHans: "\u6211\u4E5F\u5728\u60F3\u7740\u4ECA\u665A\u8981\u6765\u8FD9\u91CC\u7684\u4E8B\u3002"
    Text_Ja: "\u4ECA\u591C\u3053\u3053\u306B\u6765\u308B\u3053\u3068\u3092\u8003\u3048\u3066\u3044\u305F\u3002"
    Text_Es: "ya pensaba en venir aqu\xED esta noche."
    Text_Pt: "j\xE1 pensava em vir aqui esta noite."
    Text_Ru: "\u044F \u0443\u0436\u0435 \u0434\u0443\u043C\u0430\u043B \u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u043C
      \u043F\u0440\u0438\u0445\u043E\u0434\u0435 \u0441\u044E\u0434\u0430."
  - ID: Chapter_4_Front_7
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC9C0\uAE08 \uB0B4 \uACC1\uC5D0 \uC788\uB294 \uAC83\uC740"
    Text_En: What lay beside me now
    Text_ZhHans: "\u5982\u4ECA\uFF0C\u966A\u5728\u6211\u8EAB\u8FB9\u7684\uFF0C"
    Text_Ja: "\u4ECA\u3001\u305D\u3070\u306B\u3042\u308B\u306E\u306F\u3001"
    Text_Es: Ahora, a mi lado,
    Text_Pt: Agora, o que estava ao meu lado
    Text_Ru: "\u0422\u0435\u043F\u0435\u0440\u044C \u0440\u044F\u0434\u043E\u043C
      \u0441\u043E \u043C\u043D\u043E\u0439"
  - ID: Chapter_4_Front_8
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB9DD\uC6D0\uACBD\uB3C4, \uB538\uC544\uC774\uB3C4 \uC544\uB2C8\uC5C8\uB2E4."
    Text_En: was neither my telescope nor my girl.
    Text_ZhHans: "\u65E2\u4E0D\u662F\u671B\u8FDC\u955C\uFF0C\u4E5F\u4E0D\u662F\u5973\u513F\u3002"
    Text_Ja: "\u671B\u9060\u93E1\u3067\u3082\u3001\u5A18\u3067\u3082\u306A\u304B\u3063\u305F\u3002"
    Text_Es: no estaban ni el telescopio ni mi hija.
    Text_Pt: "n\xE3o era o telesc\xF3pio, nem minha filha."
    Text_Ru: "\u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0438 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0430,
      \u043D\u0438 \u0434\u043E\u0447\u0435\u0440\u0438."
  - ID: Chapter_4_Front_9
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uADF8\uC800 \uC77C\uAC70\uB9AC\uB9CC\uC774 \uC788\uC744 \uBFD0."
    Text_En: Only work.
    Text_ZhHans: "\u53EA\u6709\u5DE5\u4F5C\u800C\u5DF2\u3002"
    Text_Ja: "\u305F\u3060\u3001\u4ED5\u4E8B\u3060\u3051\u3060\u3063\u305F\u3002"
    Text_Es: Solo el trabajo.
    Text_Pt: Era apenas trabalho.
    Text_Ru: "\u0422\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0431\u043E\u0442\u0430."
  - ID: Chapter_4_Front_10
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: ...
    Text_En: ...
    Text_ZhHans: "\u2026\u2026"
    Text_Ja: "\u2026\u2026"
    Text_Es: ...
    Text_Pt: ...
    Text_Ru: ...
  - ID: Chapter_4_Front_11
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uD574\uC57C\uD560 \uC77C\uC744 \uD560 \uBFD0\uC774\uC5C8\uB2E4."
    Text_En: I was just doing what I had to.
    Text_ZhHans: "\u6211\u53EA\u662F\u5728\u505A\u8BE5\u505A\u7684\u4E8B\u3002"
    Text_Ja: "\u3084\u308B\u3079\u304D\u3053\u3068\u3092\u3057\u3066\u3044\u308B\u3060\u3051\u3060\u3063\u305F\u3002"
    Text_Es: "Solo hac\xEDa lo que ten\xEDa que hacer."
    Text_Pt: "Eu s\xF3 fazia o que tinha de fazer."
    Text_Ru: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0435\u043B\u0430\u043B
      \u0442\u043E, \u0447\u0442\u043E \u0434\u043E\u043B\u0436\u0435\u043D."
  - ID: Chapter_4_Front_12
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uB2E4\uC2DC \uC0BD\uC744 \uC7A1\uC558\uB2E4."
    Text_En: I took up the shovel again.
    Text_ZhHans: "\u6211\u91CD\u65B0\u63E1\u4F4F\u94C1\u9539\u3002"
    Text_Ja: "\u79C1\u306F\u518D\u3073\u30B7\u30E3\u30D9\u30EB\u3092\u63E1\u3063\u305F\u3002"
    Text_Es: "Volv\xED a agarrar la pala."
    Text_Pt: "Segurei a p\xE1 outra vez."
    Text_Ru: "\u042F \u0441\u043D\u043E\u0432\u0430 \u0432\u0437\u044F\u043B\u0441\u044F
      \u0437\u0430 \u043B\u043E\u043F\u0430\u0442\u0443."
  - ID: Chapter_4_Front_13
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uD759\uC774 \uB5A8\uC5B4\uC9C8 \uB54C\uB9C8\uB2E4"
    Text_En: With every shovelful,
    Text_ZhHans: "\u6CE5\u571F\u4E00\u6B21\u6B21\u843D\u4E0B\uFF0C"
    Text_Ja: "\u571F\u304C\u843D\u3061\u308B\u305F\u3073\u3001"
    Text_Es: Con cada palada,
    Text_Pt: "A cada por\xE7\xE3o de terra,"
    Text_Ru: "\u0421 \u043A\u0430\u0436\u0434\u043E\u0439 \u043F\u043E\u0440\u0446\u0438\u0435\u0439
      \u0437\u0435\u043C\u043B\u0438"
  - ID: Chapter_4_Front_14
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB208\uC55E\uC758 \uD615\uCCB4\uAC00 \uC870\uAE08\uC529 \uAC00\uB824\uC84C\uB2E4."
    Text_En: the shape before me faded.
    Text_ZhHans: "\u773C\u524D\u7684\u8F6E\u5ED3\u6E10\u6E10\u88AB\u63A9\u76D6\u3002"
    Text_Ja: "\u76EE\u306E\u524D\u306E\u5F62\u304C\u5C11\u3057\u305A\u3064\u96A0\u308C\u3066\u3044\u3063\u305F\u3002"
    Text_Es: la figura iba quedando oculta.
    Text_Pt: a forma diante de mim desaparecia.
    Text_Ru: "\u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F \u043F\u0435\u0440\u0435\u0434\u043E
      \u043C\u043D\u043E\u0439 \u0438\u0441\u0447\u0435\u0437\u0430\u043B\u0438."
  - ID: Chapter_4_Front_15
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB9C8\uC9C0\uB9C9 \uD759\uC744 \uB36E\uACE0 \uB098\uC11C\uB3C4"
    Text_En: Even after the last layer of dirt,
    Text_ZhHans: "\u8986\u4E0A\u6700\u540E\u4E00\u5C42\u571F\u540E\uFF0C"
    Text_Ja: "\u6700\u5F8C\u306E\u571F\u3092\u304B\u3076\u305B\u305F\u5F8C\u3082\u3001"
    Text_Es: Incluso tras cubrirla del todo,
    Text_Pt: "Mesmo ap\xF3s cobrir tudo,"
    Text_Ru: "\u0414\u0430\u0436\u0435 \u0437\u0430\u0441\u044B\u043F\u0430\u0432
      \u0432\u0441\u0451 \u0434\u043E \u043A\u043E\u043D\u0446\u0430,"
  - ID: Chapter_4_Front_16
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uD55C\uB3D9\uC548 \uADF8 \uC790\uB9AC\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
    Text_En: I stood there for a while.
    Text_ZhHans: "\u6211\u4ECD\u5728\u90A3\u91CC\u7AD9\u4E86\u5F88\u4E45\u3002"
    Text_Ja: "\u3057\u3070\u3089\u304F\u305D\u306E\u5834\u306B\u7ACB\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "me qued\xE9 all\xED un buen rato."
    Text_Pt: fiquei parado ali por um tempo.
    Text_Ru: "\u044F \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E \u0441\u0442\u043E\u044F\u043B
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
  - ID: Chapter_4_Front_17
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC0BD\uC744 \uC954 \uC190\uC774 \uC800\uB838\uB2E4."
    Text_En: My shovel hand was numb.
    Text_ZhHans: "\u63E1\u7740\u94C1\u9539\u7684\u624B\u53D1\u9EBB\u3002"
    Text_Ja: "\u30B7\u30E3\u30D9\u30EB\u3092\u63E1\u308B\u624B\u304C\u3057\u3073\u308C\u305F\u3002"
    Text_Es: La mano que sujetaba la pala estaba entumecida.
    Text_Pt: "A m\xE3o que segurava a p\xE1 estava dormente."
    Text_Ru: "\u0420\u0443\u043A\u0430 \u043D\u0430 \u0447\u0435\u0440\u0435\u043D\u043A\u0435
      \u043E\u043D\u0435\u043C\u0435\u043B\u0430."
  - ID: Chapter_4_Front_18
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC218\uCCA9\uC744 \uAEBC\uB0C8\uB2E4."
    Text_En: I took the notebook from my pocket.
    Text_ZhHans: "\u6211\u4ECE\u53E3\u888B\u91CC\u62FF\u51FA\u7B14\u8BB0\u672C\u3002"
    Text_Ja: "\u30DD\u30B1\u30C3\u30C8\u304B\u3089\u624B\u5E33\u3092\u53D6\u308A\u51FA\u3057\u305F\u3002"
    Text_Es: "Saqu\xE9 el cuaderno del bolsillo."
    Text_Pt: Tirei o caderno do bolso.
    Text_Ru: "\u042F \u0434\u043E\u0441\u0442\u0430\u043B \u0431\u043B\u043E\u043A\u043D\u043E\u0442
      \u0438\u0437 \u043A\u0430\u0440\u043C\u0430\u043D\u0430."
  - ID: Chapter_4_Front_19
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uAD00\uCE21 \uC7A5\uC18C\uB97C \uC801\uB358 \uD398\uC774\uC9C0\uB4E4\uC774"
    Text_En: Pages once filled with stargazing spots
    Text_ZhHans: "\u66FE\u7ECF\u8BB0\u7740\u89C2\u661F\u5730\u70B9\u7684\u4E66\u9875\uFF0C"
    Text_Ja: "\u89B3\u6E2C\u5834\u6240\u3092\u66F8\u3044\u3066\u3044\u305F\u30DA\u30FC\u30B8\u304C\u3001"
    Text_Es: "Las p\xE1ginas de lugares para ver estrellas"
    Text_Pt: "As p\xE1ginas dos locais de observa\xE7\xE3o"
    Text_Ru: "\u0421\u0442\u0440\u0430\u043D\u0438\u0446\u044B \u0441 \u043C\u0435\u0441\u0442\u0430\u043C\u0438
      \u0434\u043B\u044F \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439"
  - ID: Chapter_4_Front_20
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC774\uC81C\uB294 \uB2E4\uB978 \uAE30\uB85D\uC73C\uB85C \uCC44\uC6CC\uC9C0\uACE0
      \uC788\uC5C8\uB2E4."
    Text_En: were filling with different records.
    Text_ZhHans: "\u5982\u4ECA\u6B63\u88AB\u53E6\u4E00\u79CD\u8BB0\u5F55\u586B\u6EE1\u3002"
    Text_Ja: "\u4ECA\u306F\u5225\u306E\u8A18\u9332\u3067\u57CB\u307E\u3063\u3066\u3044\u304F\u3002"
    Text_Es: se llenaban ahora de otras notas.
    Text_Pt: agora se enchiam de outros registros.
    Text_Ru: "\u0442\u0435\u043F\u0435\u0440\u044C \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u043B\u0438\u0441\u044C
      \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0437\u0430\u043F\u0438\u0441\u044F\u043C\u0438."
  - ID: Chapter_4_Front_21
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uB0A0\uC9DC \uC606\uC5D0 \uC791\uC740 \uD45C\uC2DC\uB97C
      \uB0A8\uACBC\uB2E4."
    Text_En: I made a small mark beside the date.
    Text_ZhHans: "\u6211\u5728\u65E5\u671F\u65C1\u505A\u4E86\u4E2A\u5C0F\u6807\u8BB0\u3002"
    Text_Ja: "\u65E5\u4ED8\u306E\u6A2A\u306B\u5C0F\u3055\u306A\u5370\u3092\u3064\u3051\u305F\u3002"
    Text_Es: Hice una marca junto a la fecha.
    Text_Pt: "Fiz uma pequena marca junto \xE0 data."
    Text_Ru: "\u042F \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043E\u0442\u043C\u0435\u0442\u043A\u0443
      \u0432\u043E\u0437\u043B\u0435 \u0434\u0430\u0442\u044B."
  - ID: Chapter_4_Front_22
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC774\uACF3\uB3C4 \uAD6C\uBD84\uD574\uB46C\uC57C \uD588\uB2E4."
    Text_En: I had to mark this place, too.
    Text_ZhHans: "\u8FD9\u91CC\u4E5F\u5F97\u533A\u5206\u6E05\u695A\u3002"
    Text_Ja: "\u3053\u3053\u3082\u533A\u5225\u3057\u3066\u304A\u304F\u5FC5\u8981\u304C\u3042\u3063\u305F\u3002"
    Text_Es: "Tambi\xE9n deb\xEDa distinguir este lugar."
    Text_Pt: "Precisava distinguir este lugar tamb\xE9m."
    Text_Ru: "\u041D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u043C\u0435\u0442\u0438\u0442\u044C
      \u0438 \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E."
  - ID: Chapter_4_Front_23
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB2E4\uB978 \uC7A5\uC18C\uC640 \uB4A4\uC11E\uC774\uC9C0 \uC54A\uB3C4\uB85D."
    Text_En: So I wouldn't confuse it with another.
    Text_ZhHans: "\u514D\u5F97\u548C\u5176\u4ED6\u5730\u65B9\u5F04\u6DF7\u3002"
    Text_Ja: "\u307B\u304B\u306E\u5834\u6240\u3068\u6DF7\u540C\u3057\u306A\u3044\u3088\u3046\u306B\u3002"
    Text_Es: "Para no confundirlo con los dem\xE1s."
    Text_Pt: "Para n\xE3o confundir com os outros."
    Text_Ru: "\u0427\u0442\u043E\u0431\u044B \u043D\u0435 \u0441\u043F\u0443\u0442\u0430\u0442\u044C
      \u0441 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438."
  - ID: Chapter_4_Front_24
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uACE0\uAC1C\uB97C \uB4E4\uC790 \uC6A9\uC790\uB9AC\uAC00 \uB208\uC5D0
      \uB4E4\uC5B4\uC654\uB2E4."
    Text_En: I looked up and saw Draco.
    Text_ZhHans: "\u62AC\u8D77\u5934\uFF0C\u5929\u9F99\u5EA7\u6620\u5165\u773C\u5E18\u3002"
    Text_Ja: "\u898B\u4E0A\u3052\u308B\u3068\u3001\u308A\u3085\u3046\u5EA7\u304C\u76EE\u306B\u5165\u3063\u305F\u3002"
    Text_Es: "Alc\xE9 la vista y vi a Draco."
    Text_Pt: "Ergui os olhos e vi a constela\xE7\xE3o de Drag\xE3o."
    Text_Ru: "\u042F \u043F\u043E\u0434\u043D\u044F\u043B \u0433\u043E\u043B\u043E\u0432\u0443
      \u0438 \u0443\u0432\u0438\u0434\u0435\u043B \u0414\u0440\u0430\u043A\u043E\u043D\u0430."
  - ID: Chapter_4_Front_25
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uBCC4\uC744 \uBCF4\uB7EC \uC654\uC744 \uB54C\uB3C4"
    Text_En: The same constellation I'd sought
    Text_ZhHans: "\u4EE5\u524D\u6765\u89C2\u661F\u65F6\uFF0C"
    Text_Ja: "\u661F\u3092\u898B\u306B\u6765\u305F\u3068\u304D\u3082\u3001"
    Text_Es: "La constelaci\xF3n que buscaba desde aqu\xED"
    Text_Pt: Quando vinha observar estrelas,
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0437\u0432\u0451\u0437\u0434\u044B,"
  - ID: Chapter_4_Front_26
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC774 \uC790\uB9AC\uC5D0\uC11C \uCC3E\uC544\uBCF4\uB358 \uBCC4\uC790\uB9AC\uC600\uB2E4."
    Text_En: when I came here for the stars.
    Text_ZhHans: "\u6211\u4E5F\u66FE\u5728\u8FD9\u91CC\u5BFB\u627E\u8FC7\u5B83\u3002"
    Text_Ja: "\u3053\u3053\u304B\u3089\u63A2\u3057\u3066\u3044\u305F\u661F\u5EA7\u3060\u3063\u305F\u3002"
    Text_Es: "cuando ven\xEDa a observar estrellas."
    Text_Pt: "eu tamb\xE9m a procurava dali."
    Text_Ru: "\u044F \u0438\u0441\u043A\u0430\u043B \u0435\u0433\u043E \u0441 \u044D\u0442\u043E\u0433\u043E
      \u0436\u0435 \u043C\u0435\u0441\u0442\u0430."
  - ID: Chapter_4_Front_27
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uBE48\uCE78\uC5D0 \uBCC4\uC758 \uC704\uCE58\uB97C \uC62E\uACBC\uB2E4."
    Text_En: I drew its stars in an empty space.
    Text_ZhHans: "\u6211\u628A\u661F\u661F\u7684\u4F4D\u7F6E\u753B\u5728\u7A7A\u767D\u5904\u3002"
    Text_Ja: "\u79C1\u306F\u4F59\u767D\u306B\u661F\u306E\u4F4D\u7F6E\u3092\u5199\u3057\u305F\u3002"
    Text_Es: "Dibuj\xE9 su posici\xF3n en un espacio vac\xEDo."
    Text_Pt: "Desenhei as estrelas no espa\xE7o vazio."
    Text_Ru: "\u042F \u043F\u0435\u0440\u0435\u043D\u0451\u0441 \u0437\u0432\u0451\u0437\u0434\u044B
      \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u0435 \u043F\u043E\u043B\u0435."
  - ID: Chapter_4_Front_28
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uC5B4\uB460 \uC18D\uC5D0\uC11C\uB294 \uD759 \uBB3B\uC740 \uC810\uB4E4\uC774"
    Text_En: In the dark, the flecks of dirt
    Text_ZhHans: "\u9ED1\u6697\u4E2D\uFF0C\u6CBE\u4E0A\u7684\u6CE5\u70B9"
    Text_Ja: "\u6697\u95C7\u3067\u306F\u3001\u4ED8\u7740\u3057\u305F\u571F\u306E\u7C92\u304C\u3001"
    Text_Es: En la oscuridad, las motas de tierra
    Text_Pt: No escuro, os pontinhos de terra
    Text_Ru: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043A\u0440\u0443\u043F\u0438\u0446\u044B
      \u0437\u0435\u043C\u043B\u0438"
  - ID: Chapter_4_Front_29
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB0B4\uAC00 \uCC0D\uC740 \uBCC4\uACFC \uC11E\uC5EC \uBCF4\uC600\uB2E4."
    Text_En: blended with the stars I'd drawn.
    Text_ZhHans: "\u548C\u6211\u753B\u7684\u661F\u661F\u6DF7\u5728\u4E00\u8D77\u3002"
    Text_Ja: "\u63CF\u3044\u305F\u661F\u3068\u6DF7\u3056\u3063\u3066\u898B\u3048\u305F\u3002"
    Text_Es: se mezclaban con las estrellas dibujadas.
    Text_Pt: "se misturavam \xE0s estrelas desenhadas."
    Text_Ru: "\u0441\u043C\u0435\u0448\u0438\u0432\u0430\u043B\u0438\u0441\u044C
      \u0441 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438
      \u0442\u043E\u0447\u043A\u0430\u043C\u0438."
  - ID: Chapter_4_Front_30
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uBCC4 \uC0AC\uC774\uC5D0 \uC120\uC744 \uADF8\uC5B4\uB450\uBA74"
    Text_En: If I joined the stars with lines,
    Text_ZhHans: "\u53EA\u8981\u5728\u661F\u661F\u4E4B\u95F4\u753B\u4E0A\u7EBF\uFF0C"
    Text_Ja: "\u661F\u306E\u9593\u306B\u7DDA\u3092\u5F15\u3051\u3070\u3001"
    Text_Es: "Si trazaba l\xEDneas entre ellas,"
    Text_Pt: "Se eu tra\xE7asse linhas entre elas,"
    Text_Ru: "\u0415\u0441\u043B\u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434\u044B \u043B\u0438\u043D\u0438\u044F\u043C\u0438,"
  - ID: Chapter_4_Front_31
    Chapter_Id: 4_Front
    Speaker: Father
    Text_Kr: "\uB2E4\uC74C\uC5D0 \uD3BC\uCCE4\uC744 \uB54C\uB3C4 \uC54C\uC544\uBCFC
      \uC218 \uC788\uC744 \uAC83\uC774\uB2E4."
    Text_En: I'd know them when I opened it again.
    Text_ZhHans: "\u4E0B\u6B21\u7FFB\u5F00\u65F6\u5C31\u80FD\u8BA4\u51FA\u6765\u4E86\u3002"
    Text_Ja: "\u6B21\u306B\u958B\u3044\u305F\u3068\u304D\u3082\u5206\u304B\u308B\u306F\u305A\u3060\u3002"
    Text_Es: "las reconocer\xEDa al abrirlo otra vez."
    Text_Pt: "poderia reconhec\xEA-las da pr\xF3xima vez."
    Text_Ru: "\u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437
      \u044F \u0438\u0445 \u0443\u0437\u043D\u0430\u044E."
  - ID: Chapter_4_Back_1
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC218\uCCA9\uC5D0 \uC801\uD78C \uAE38\uC740 \uC5EC\uAE30\uC11C \uB05D\uB0AC\uB2E4."
    Text_En: The notebook's route ended here.
    Text_ZhHans: "\u7B14\u8BB0\u91CC\u7684\u8DEF\u5230\u8FD9\u91CC\u5C31\u7ED3\u675F\u4E86\u3002"
    Text_Ja: "\u624B\u5E33\u306B\u66F8\u304B\u308C\u305F\u9053\u306F\u3001\u3053\u3053\u3067\u7D42\u308F\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "La ruta del cuaderno terminaba aqu\xED."
    Text_Pt: O caminho do caderno terminava aqui.
    Text_Ru: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435
      \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u043B\u0441\u044F \u0437\u0434\u0435\u0441\u044C."
  - ID: Chapter_4_Back_2
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uAC08\uB9BC\uAE38\uB3C4, \uAE30\uC6B8\uC5B4\uC9C4 \uBC14\uC704\uB3C4"
    Text_En: The fork and the leaning rock
    Text_ZhHans: "\u5C94\u8DEF\uFF0C\u8FD8\u6709\u503E\u659C\u7684\u5CA9\u77F3\uFF0C"
    Text_Ja: "\u5206\u304B\u308C\u9053\u3082\u3001\u50BE\u3044\u305F\u5CA9\u3082\u3001"
    Text_Es: El cruce y la roca inclinada
    Text_Pt: "A bifurca\xE7\xE3o e a rocha inclinada"
    Text_Ru: "\u0420\u0430\u0437\u0432\u0438\u043B\u043A\u0430 \u0438 \u043D\u0430\u043A\u043B\u043E\u043D\u043D\u0430\u044F
      \u0441\u043A\u0430\u043B\u0430"
  - ID: Chapter_4_Back_3
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uAC00 \uC801\uC5B4\uB454 \uB300\uB85C\uC600\uB2E4."
    Text_En: were just as Dad had written.
    Text_ZhHans: "\u90FD\u548C\u7238\u7238\u5199\u7684\u4E00\u6837\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u304C\u66F8\u3044\u305F\u3068\u304A\u308A\u3060\u3063\u305F\u3002"
    Text_Es: "eran tal como pap\xE1 los describi\xF3."
    Text_Pt: eram como papai tinha descrito.
    Text_Ru: "\u0431\u044B\u043B\u0438 \u0442\u0430\u043A\u0438\u043C\u0438, \u043A\u0430\u043A
      \u043E\u043F\u0438\u0441\u0430\u043B \u043F\u0430\u043F\u0430."
  - ID: Chapter_4_Back_4
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uB7F0\uB370 \uC544\uBE60\uB294 \uC5C6\uC5C8\uB2E4."
    Text_En: But Dad wasn't here.
    Text_ZhHans: "\u53EF\u7238\u7238\u4E0D\u5728\u3002"
    Text_Ja: "\u3067\u3082\u3001\u304A\u7236\u3055\u3093\u306F\u3044\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Pero \xE9l no estaba."
    Text_Pt: "Mas ele n\xE3o estava ali."
    Text_Ru: "\u041D\u043E \u0435\u0433\u043E \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u0431\u044B\u043B\u043E."
  - ID: Chapter_4_Back_5
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60!"
    Text_En: Dad!
    Text_ZhHans: "\u7238\u7238\uFF01"
    Text_Ja: "\u304A\u7236\u3055\u3093\uFF01"
    Text_Es: "\xA1Pap\xE1!"
    Text_Pt: Papai!
    Text_Ru: "\u041F\u0430\u043F\u0430!"
  - ID: Chapter_4_Back_6
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC7A0\uC2DC \uAE30\uB2E4\uB838\uB2E4\uAC00 \uB2E4\uC2DC \uBD88\uB800\uB2E4."
    Text_En: I waited, then called again.
    Text_ZhHans: "\u7B49\u4E86\u4E00\u4F1A\u513F\uFF0C\u6211\u53C8\u558A\u4E86\u4E00\u58F0\u3002"
    Text_Ja: "\u5C11\u3057\u5F85\u3063\u3066\u3001\u3082\u3046\u4E00\u5EA6\u547C\u3093\u3060\u3002"
    Text_Es: "Esper\xE9 un momento y volv\xED a llamarlo."
    Text_Pt: Esperei um pouco e chamei de novo.
    Text_Ru: "\u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u043B\u0430 \u0438
      \u043F\u043E\u0437\u0432\u0430\u043B\u0430 \u0441\u043D\u043E\u0432\u0430."
  - ID: Chapter_4_Back_7
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB098 \uC654\uC5B4. \uC5B4\uB514 \uC788\uC5B4?"
    Text_En: I'm here. Where are you?
    Text_ZhHans: "\u6211\u6765\u4E86\uFF0C\u4F60\u5728\u54EA\u513F\uFF1F"
    Text_Ja: "\u6765\u305F\u3088\u3002\u3069\u3053\u306B\u3044\u308B\u306E\uFF1F"
    Text_Es: "Ya llegu\xE9. \xBFD\xF3nde est\xE1s?"
    Text_Pt: "Eu cheguei. Onde voc\xEA est\xE1?"
    Text_Ru: "\u042F \u043F\u0440\u0438\u0448\u043B\u0430. \u0422\u044B \u0433\u0434\u0435?"
  - ID: Chapter_4_Back_8
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uBB47\uC78E\uC774 \uD754\uB4E4\uB9AC\uB294 \uC18C\uB9AC\uB9CC
      \uB4E4\uB838\uB2E4."
    Text_En: Only the leaves answered.
    Text_ZhHans: "\u53EA\u6709\u6811\u53F6\u6447\u52A8\u7684\u58F0\u97F3\u3002"
    Text_Ja: "\u8449\u306E\u63FA\u308C\u308B\u97F3\u3057\u304B\u805E\u3053\u3048\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Solo o\xED el susurro de las hojas."
    Text_Pt: "S\xF3 ouvi as folhas se mexendo."
    Text_Ru: "\u0412 \u043E\u0442\u0432\u0435\u0442 \u043B\u0438\u0448\u044C \u0448\u0435\u043B\u0435\u0441\u0442\u0435\u043B\u0438
      \u043B\u0438\u0441\u0442\u044C\u044F."
  - ID: Chapter_4_Back_9
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC218\uCCA9\uACFC \uC8FC\uBCC0\uC744 \uBC88\uAC08\uC544
      \uC0B4\uD3C8\uB2E4."
    Text_En: I checked the notebook and the clearing.
    Text_ZhHans: "\u6211\u6765\u56DE\u770B\u7740\u7B14\u8BB0\u672C\u548C\u5468\u56F4\u3002"
    Text_Ja: "\u79C1\u306F\u624B\u5E33\u3068\u8FBA\u308A\u3092\u898B\u6BD4\u3079\u305F\u3002"
    Text_Es: "Compar\xE9 el cuaderno con lo que me rodeaba."
    Text_Pt: Comparei o caderno com o lugar.
    Text_Ru: "\u042F \u0441\u0432\u0435\u0440\u044F\u043B\u0430 \u0431\u043B\u043E\u043A\u043D\u043E\u0442
      \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u0432\u0438\u0434\u0435\u043B\u0430."
  - ID: Chapter_4_Back_10
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uBC14\uC704 \uC606, \uB098\uBB34\uAC00 \uAC08\uB77C\uC9C4 \uACF3."
    Text_En: Beside the rock. By the split tree.
    Text_ZhHans: "\u5CA9\u77F3\u65C1\uFF0C\u6811\u5E72\u5206\u53C9\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u5CA9\u306E\u305D\u3070\u3001\u6728\u304C\u679D\u5206\u304B\u308C\u3057\u305F\u5834\u6240\u3002"
    Text_Es: "Junto a la roca. El \xE1rbol bifurcado."
    Text_Pt: "Ao lado da rocha. A \xE1rvore bifurcada."
    Text_Ru: "\u0423 \u0441\u043A\u0430\u043B\u044B, \u0432\u043E\u0437\u043B\u0435
      \u0440\u0430\u0437\u0434\u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430."
  - ID: Chapter_4_Back_11
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uBD84\uBA85 \uC774 \uC790\uB9AC\uC600\uB2E4."
    Text_En: This had to be the place.
    Text_ZhHans: "\u5C31\u662F\u8FD9\u91CC\uFF0C\u6CA1\u9519\u3002"
    Text_Ja: "\u9593\u9055\u3044\u306A\u304F\u3001\u3053\u3053\u3060\u3063\u305F\u3002"
    Text_Es: "Ten\xEDa que ser aqu\xED."
    Text_Pt: "Era aqui, sem d\xFAvida."
    Text_Ru: "\u0422\u043E\u0447\u043D\u043E \u0437\u0434\u0435\u0441\u044C."
  - ID: Chapter_4_Back_12
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uADF8 \uC544\uB798\uC758 \uD759\uC774 \uC8FC\uBCC0\uACFC \uB2EC\uB790\uB2E4."
    Text_En: The earth below looked different.
    Text_ZhHans: "\u90A3\u91CC\u7684\u571F\u548C\u5468\u56F4\u4E0D\u4E00\u6837\u3002"
    Text_Ja: "\u305D\u306E\u4E0B\u306E\u571F\u3060\u3051\u3001\u5468\u308A\u3068\u9055\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "La tierra de abajo parec\xEDa distinta."
    Text_Pt: A terra embaixo parecia diferente.
    Text_Ru: "\u0417\u0435\u043C\u043B\u044F \u043F\u043E\u0434 \u043D\u0438\u043C
      \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0430\u0441\u044C \u043E\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439."
  - ID: Chapter_4_Back_13
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC778\uC704\uC801\uC73C\uB85C \uB36E\uC5EC \uC788\uB294 \uB4EF\uD55C "
    Text_En: As if someone had covered it.
    Text_ZhHans: "\u50CF\u662F\u6709\u4EBA\u523B\u610F\u76D6\u4E0A\u53BB\u7684\uFF0C"
    Text_Ja: "\u8AB0\u304B\u304C\u571F\u3092\u304B\u3076\u305B\u305F\u3088\u3046\u306A\u3001"
    Text_Es: Como si alguien la hubiera echado encima.
    Text_Pt: "Como se algu\xE9m a tivesse colocado ali."
    Text_Ru: "\u0411\u0443\u0434\u0442\u043E \u0435\u0451 \u043A\u0442\u043E-\u0442\u043E
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043D\u0430\u0441\u044B\u043F\u0430\u043B."
  - ID: Chapter_4_Back_14
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB9C8\uCE58 \uBB34\uC5B8\uAC00\uAC00 \uBB3B\uD600\uC788\uB294 \uB4EF\uD55C
      \uB290\uB08C\uC774 \uB4E4\uC5C8\uB2E4."
    Text_En: As if something lay buried there.
    Text_ZhHans: "\u4EFF\u4F5B\u4E0B\u9762\u57CB\u7740\u4EC0\u4E48\u3002"
    Text_Ja: "\u4F55\u304B\u304C\u57CB\u307E\u3063\u3066\u3044\u308B\u3088\u3046\u306A\u6C17\u304C\u3057\u305F\u3002"
    Text_Es: Como si hubiera algo enterrado.
    Text_Pt: Como se houvesse algo enterrado.
    Text_Ru: "\u0411\u0443\u0434\u0442\u043E \u043F\u043E\u0434 \u043D\u0435\u0439
      \u0447\u0442\u043E-\u0442\u043E \u043B\u0435\u0436\u0430\u043B\u043E."
  - ID: Chapter_4_Back_15
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC21C\uAC04 \uC18C\uB984\uC774 \uB07C\uCCE4\uB2E4."
    Text_En: A chill ran through me.
    Text_ZhHans: "\u4E00\u77AC\u95F4\uFF0C\u6211\u6D51\u8EAB\u53D1\u51B7\u3002"
    Text_Ja: "\u4E00\u77AC\u3001\u80CC\u7B4B\u304C\u51B7\u305F\u304F\u306A\u3063\u305F\u3002"
    Text_Es: "Me recorri\xF3 un escalofr\xEDo."
    Text_Pt: Um arrepio percorreu meu corpo.
    Text_Ru: "\u041F\u043E \u0441\u043F\u0438\u043D\u0435 \u043F\u0440\u043E\u0431\u0435\u0436\u0430\u043B
      \u0445\u043E\u043B\u043E\u0434."
  - ID: Chapter_4_Back_16
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uBB34\uC5B8\uAC00 \uBB3B\uC5B4\uB454 \uAC78\uAE4C."
    Text_En: Had someone buried something?
    Text_ZhHans: "\u6709\u4EBA\u5728\u8FD9\u91CC\u57CB\u4E86\u4E1C\u897F\u5417\uFF1F"
    Text_Ja: "\u4F55\u304B\u3092\u57CB\u3081\u305F\u306E\u3060\u308D\u3046\u304B\u3002"
    Text_Es: "\xBFHabr\xEDan enterrado algo?"
    Text_Pt: "Ser\xE1 que enterraram alguma coisa?"
    Text_Ru: "\u0417\u0434\u0435\u0441\u044C \u0447\u0442\u043E-\u0442\u043E \u0437\u0430\u043A\u043E\u043F\u0430\u043B\u0438?"
  - ID: Chapter_4_Back_17
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC218\uCCA9\uC5D0\uB294 \uB545\uC18D\uC5D0 \uBB34\uC5C7\uC774 \uC788\uB294\uC9C0"
    Text_En: The notebook said nothing
    Text_ZhHans: "\u7B14\u8BB0\u672C\u6CA1\u6709\u5199\uFF0C"
    Text_Ja: "\u5730\u4E2D\u306B\u4F55\u304C\u3042\u308B\u306E\u304B\u306F\u3001"
    Text_Es: "El cuaderno no dec\xEDa"
    Text_Pt: "O caderno n\xE3o dizia"
    Text_Ru: "\u0427\u0442\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0451\u0439,"
  - ID: Chapter_4_Back_18
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC801\uD600 \uC788\uC9C0 \uC54A\uC558\uB2E4."
    Text_En: about what lay underground.
    Text_ZhHans: "\u5730\u4E0B\u7A76\u7ADF\u6709\u4EC0\u4E48\u3002"
    Text_Ja: "\u624B\u5E33\u306B\u306F\u66F8\u304B\u308C\u3066\u3044\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "qu\xE9 hab\xEDa bajo tierra."
    Text_Pt: o que havia debaixo da terra.
    Text_Ru: "\u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435 \u043D\u0435
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u043E\u0441\u044C."
  - ID: Chapter_4_Back_19
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uD558\uC9C0\uB9CC \uB2E4\uB978 \uD754\uC801\uC740 \uCC3E\uC744 \uC218
      \uC5C6\uC5C8\uB2E4."
    Text_En: But there was no other trace.
    Text_ZhHans: "\u53EF\u6211\u627E\u4E0D\u5230\u5176\u4ED6\u75D5\u8FF9\u3002"
    Text_Ja: "\u3067\u3082\u3001\u307B\u304B\u306B\u624B\u304C\u304B\u308A\u306F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Pero no encontr\xE9 ning\xFAn otro rastro."
    Text_Pt: "Mas n\xE3o encontrei outro sinal."
    Text_Ru: "\u041D\u043E \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u043B\u0435\u0434\u043E\u0432
      \u044F \u043D\u0435 \u043D\u0430\u0448\u043B\u0430."
  - ID: Chapter_4_Back_20
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC00 \uC0BD\uC744 \uAC00\uC838\uC654\uB2E4."
    Text_En: I went home and brought a shovel.
    Text_ZhHans: "\u6211\u56DE\u5BB6\u62FF\u6765\u4E86\u94C1\u9539\u3002"
    Text_Ja: "\u79C1\u306F\u5BB6\u306B\u623B\u308A\u3001\u30B7\u30E3\u30D9\u30EB\u3092\u6301\u3063\u3066\u304D\u305F\u3002"
    Text_Es: "Volv\xED a casa y traje una pala."
    Text_Pt: "Voltei para casa e trouxe uma p\xE1."
    Text_Ru: "\u042F \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C \u0434\u043E\u043C\u043E\u0439
      \u0437\u0430 \u043B\u043E\u043F\u0430\u0442\u043E\u0439."
  - ID: Chapter_4_Back_21
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB2E4\uC2DC \uADF8 \uC55E\uC5D0 \uC130\uC744 \uB54C\uB294"
    Text_En: When I stood there again,
    Text_ZhHans: "\u518D\u6B21\u7AD9\u5728\u90A3\u91CC\u65F6\uFF0C"
    Text_Ja: "\u518D\u3073\u305D\u306E\u524D\u306B\u7ACB\u3063\u305F\u3068\u304D\u3001"
    Text_Es: "Cuando estuve de nuevo all\xED,"
    Text_Pt: Quando parei ali outra vez,
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430 \u0441\u043D\u043E\u0432\u0430 \u0432\u0441\u0442\u0430\u043B\u0430
      \u043D\u0430 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435,"
  - ID: Chapter_4_Back_22
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC190\uC7A1\uC774\uB97C \uC7A1\uC740 \uC190\uC5D0 \uB540\uC774 \uB0AC\uB2E4."
    Text_En: my palms sweated on the handle.
    Text_ZhHans: "\u63E1\u7740\u9539\u67C4\u7684\u624B\u5FC3\u6EE1\u662F\u6C57\u3002"
    Text_Ja: "\u67C4\u3092\u63E1\u308B\u624B\u306B\u306F\u6C57\u304C\u306B\u3058\u3093\u3067\u3044\u305F\u3002"
    Text_Es: me sudaban las manos sobre el mango.
    Text_Pt: "minhas m\xE3os suavam no cabo."
    Text_Ru: "\u043B\u0430\u0434\u043E\u043D\u0438 \u043D\u0430 \u0447\u0435\u0440\u0435\u043D\u043A\u0435
      \u0432\u0441\u043F\u043E\u0442\u0435\u043B\u0438."
  - ID: Chapter_4_Back_23
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uD759\uC744 \uAC77\uC5B4\uB0BC\uC218\uB85D"
    Text_En: The more dirt I cleared,
    Text_ZhHans: "\u6316\u5F00\u7684\u571F\u8D8A\u591A\uFF0C"
    Text_Ja: "\u571F\u3092\u53D6\u308A\u9664\u304F\u307B\u3069\u3001"
    Text_Es: "Cuanta m\xE1s tierra quitaba,"
    Text_Pt: Quanto mais terra eu tirava,
    Text_Ru: "\u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0435\u043C\u043B\u0438
      \u044F \u0443\u0431\u0438\u0440\u0430\u043B\u0430,"
  - ID: Chapter_4_Back_24
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB0B4\uAC00 \uBB34\uC2A8 \uC0DD\uAC01\uC744 \uD558\uB294\uC9C0 \uC54C
      \uAC83 \uAC19\uC558\uB2E4."
    Text_En: the clearer my own fear became.
    Text_ZhHans: "\u6211\u5C31\u8D8A\u6E05\u695A\u81EA\u5DF1\u5728\u5BB3\u6015\u4EC0\u4E48\u3002"
    Text_Ja: "\u81EA\u5206\u304C\u4F55\u3092\u6050\u308C\u3066\u3044\u308B\u306E\u304B\u5206\u304B\u3063\u305F\u3002"
    Text_Es: "m\xE1s claro ve\xEDa lo que tem\xEDa."
    Text_Pt: mais claro ficava o que eu temia.
    Text_Ru: "\u0442\u0435\u043C \u044F\u0441\u043D\u0435\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043B\u0430,
      \u0447\u0435\u0433\u043E \u0431\u043E\u044E\u0441\u044C."
  - ID: Chapter_4_Back_25
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC81C\uBC1C, \uC5EC\uAE30\uC5D0\uB294 \uC5C6\uC5C8\uC73C\uBA74."
    Text_En: Please, don't be here.
    Text_ZhHans: "\u6C42\u6C42\u4F60\uFF0C\u5343\u4E07\u522B\u5728\u8FD9\u91CC\u3002"
    Text_Ja: "\u304A\u9858\u3044\u3001\u3053\u3053\u306B\u306F\u3044\u306A\u3044\u3067\u3002"
    Text_Es: "Por favor, que no est\xE9 aqu\xED."
    Text_Pt: "Por favor, n\xE3o esteja aqui."
    Text_Ru: "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u0437\u0434\u0435\u0441\u044C."
  - ID: Chapter_4_Back_26
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC0BD \uB05D\uC5D0 \uCC9C \uC870\uAC01\uC774 \uAC78\uB838\uB2E4."
    Text_En: The shovel caught a scrap of cloth.
    Text_ZhHans: "\u9539\u5C16\u52FE\u4F4F\u4E86\u4E00\u5757\u5E03\u3002"
    Text_Ja: "\u30B7\u30E3\u30D9\u30EB\u306E\u5148\u306B\u5E03\u304C\u5F15\u3063\u304B\u304B\u3063\u305F\u3002"
    Text_Es: "La pala se enganch\xF3 en una tela."
    Text_Pt: "A ponta da p\xE1 prendeu em um tecido."
    Text_Ru: "\u041B\u043E\u043F\u0430\u0442\u0430 \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0430\u0441\u044C
      \u0437\u0430 \u0442\u043A\u0430\u043D\u044C."
  - ID: Chapter_4_Back_27
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: ...
    Text_En: ...
    Text_ZhHans: "\u2026\u2026"
    Text_Ja: "\u2026\u2026"
    Text_Es: ...
    Text_Pt: ...
    Text_Ru: ...
  - ID: Chapter_4_Back_28
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uD759 \uC0AC\uC774\uB85C \uB4DC\uB7EC\uB09C \uAC83\uC740 \uC0AC\uB78C\uC758
      \uC190\uC774\uC5C8\uB2E4."
    Text_En: A human hand emerged from the dirt.
    Text_ZhHans: "\u6CE5\u571F\u4E2D\u9732\u51FA\u4E86\u4E00\u53EA\u4EBA\u624B\u3002"
    Text_Ja: "\u571F\u306E\u4E2D\u304B\u3089\u3001\u4EBA\u306E\u624B\u304C\u73FE\u308C\u305F\u3002"
    Text_Es: "Entre la tierra apareci\xF3 una mano humana."
    Text_Pt: "Uma m\xE3o humana surgiu entre a terra."
    Text_Ru: "\u0418\u0437 \u0437\u0435\u043C\u043B\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0430\u044F \u0440\u0443\u043A\u0430."
  - ID: Chapter_4_Back_29
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB180\uB780 \uAC00\uC2B4\uC744 \uBD80\uC5EC\uC7A1\uACE0"
    Text_En: My heart pounding,
    Text_ZhHans: "\u6211\u5F3A\u538B\u7740\u72C2\u8DF3\u7684\u5FC3\uFF0C"
    Text_Ja: "\u6FC0\u3057\u304F\u9CF4\u308B\u80F8\u3092\u62BC\u3055\u3048\u3001"
    Text_Es: "Con el coraz\xF3n desbocado,"
    Text_Pt: "Com o cora\xE7\xE3o disparado,"
    Text_Ru: "\u0421 \u0442\u0440\u0443\u0434\u043E\u043C \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F
      \u043F\u0430\u043D\u0438\u043A\u0443,"
  - ID: Chapter_4_Back_30
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB294 \uC544\uB2D0\uAE4C \uD558\uACE0 \uC870\uAE08 \uB354
      \uD30C\uBCF4\uC558\uB2E4."
    Text_En: I dug further, afraid it might be Dad.
    Text_ZhHans: "\u6015\u90A3\u662F\u7238\u7238\uFF0C\u53C8\u5F80\u4E0B\u6316\u4E86\u4E00\u4E9B\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u304B\u3082\u3057\u308C\u306A\u3044\u3068\u3001\u3082\u3046\u5C11\u3057\u6398\u3063\u305F\u3002"
    Text_Es: "cav\xE9 un poco m\xE1s, temiendo que fuera pap\xE1."
    Text_Pt: cavei mais, temendo que fosse papai.
    Text_Ru: "\u044F \u043A\u043E\u043F\u043D\u0443\u043B\u0430 \u0435\u0449\u0451,
      \u0431\u043E\u044F\u0441\u044C, \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u0430\u043F\u0430."
  - ID: Chapter_4_Back_31
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\u2026\u2026\uC544\uBE60\uB294 \uC544\uB2C8\uC5C8\uB2E4."
    Text_En: ...It wasn't Dad.
    Text_ZhHans: "\u2026\u2026\u4E0D\u662F\u7238\u7238\u3002"
    Text_Ja: "\u2026\u2026\u304A\u7236\u3055\u3093\u3067\u306F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "...No era \xE9l."
    Text_Pt: "...N\xE3o era ele."
    Text_Ru: "...\u042D\u0442\u043E \u0431\u044B\u043B \u043D\u0435 \u043E\u043D."
  - ID: Chapter_4_Back_32
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uCC98\uC74C \uBCF4\uB294 \uC0AC\uB78C\uC774\uC5C8\uB2E4."
    Text_En: It was someone I'd never seen.
    Text_ZhHans: "\u662F\u4E2A\u4ECE\u672A\u89C1\u8FC7\u7684\u4EBA\u3002"
    Text_Ja: "\u898B\u305F\u3053\u3068\u306E\u306A\u3044\u4EBA\u3060\u3063\u305F\u3002"
    Text_Es: "Era alguien que nunca hab\xEDa visto."
    Text_Pt: "Era algu\xE9m que eu nunca tinha visto."
    Text_Ru: "\u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430
      \u044D\u0442\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430."
  - ID: Chapter_4_Back_33
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC228\uC774 \uC0C8\uC5B4 \uB098\uC654\uB2E4."
    Text_En: A breath escaped me.
    Text_ZhHans: "\u6211\u957F\u957F\u5730\u5410\u51FA\u4E00\u53E3\u6C14\u3002"
    Text_Ja: "\u606F\u304C\u6F0F\u308C\u305F\u3002"
    Text_Es: "Se me escap\xF3 un suspiro."
    Text_Pt: Soltei o ar.
    Text_Ru: "\u0423 \u043C\u0435\u043D\u044F \u0432\u044B\u0440\u0432\u0430\u043B\u0441\u044F
      \u0432\u0437\u0434\u043E\u0445."
  - ID: Chapter_4_Back_34
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC548\uB3C4\uD55C \uC790\uC2E0\uC774 \uB450\uB824\uC6E0\uB2E4."
    Text_En: My own relief frightened me.
    Text_ZhHans: "\u7ADF\u7136\u611F\u5230\u5E86\u5E78\u7684\u81EA\u5DF1\uFF0C\u8BA9\u6211\u5BB3\u6015\u3002"
    Text_Ja: "\u307B\u3063\u3068\u3057\u305F\u81EA\u5206\u304C\u6016\u304B\u3063\u305F\u3002"
    Text_Es: "Me asust\xF3 sentir alivio."
    Text_Pt: "Meu pr\xF3prio al\xEDvio me assustou."
    Text_Ru: "\u0421\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u0435 \u043D\u0430\u043F\u0443\u0433\u0430\u043B\u043E
      \u043C\u0435\u043D\u044F."
  - ID: Chapter_4_Back_35
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC218\uCCA9\uC744 \uB2E4\uC2DC \uD3BC\uCCE4\uB2E4."
    Text_En: I opened the notebook again.
    Text_ZhHans: "\u6211\u518D\u6B21\u7FFB\u5F00\u7B14\u8BB0\u672C\u3002"
    Text_Ja: "\u79C1\u306F\u518D\u3073\u624B\u5E33\u3092\u958B\u3044\u305F\u3002"
    Text_Es: "Volv\xED a abrir el cuaderno."
    Text_Pt: Abri o caderno de novo.
    Text_Ru: "\u042F \u0441\u043D\u043E\u0432\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430
      \u0431\u043B\u043E\u043A\u043D\u043E\u0442."
  - ID: Chapter_4_Back_36
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uAC19\uC740 \uBC14\uC704, \uAC19\uC740 \uB098\uBB34."
    Text_En: The same rock. The same tree.
    Text_ZhHans: "\u540C\u4E00\u5757\u5CA9\u77F3\uFF0C\u540C\u4E00\u68F5\u6811\u3002"
    Text_Ja: "\u540C\u3058\u5CA9\u3001\u540C\u3058\u6728\u3002"
    Text_Es: "La misma roca. El mismo \xE1rbol."
    Text_Pt: "A mesma rocha. A mesma \xE1rvore."
    Text_Ru: "\u0422\u0430 \u0436\u0435 \u0441\u043A\u0430\u043B\u0430. \u0422\u043E
      \u0436\u0435 \u0434\u0435\u0440\u0435\u0432\u043E."
  - ID: Chapter_4_Back_37
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC798\uBABB \uCC3E\uC544\uC628 \uAC83\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    Text_En: I hadn't come to the wrong place.
    Text_ZhHans: "\u6211\u6CA1\u6709\u627E\u9519\u5730\u65B9\u3002"
    Text_Ja: "\u5834\u6240\u3092\u9593\u9055\u3048\u305F\u308F\u3051\u3067\u306F\u306A\u3044\u3002"
    Text_Es: "No me hab\xEDa equivocado de lugar."
    Text_Pt: "Eu n\xE3o tinha errado o lugar."
    Text_Ru: "\u042F \u043D\u0435 \u043E\u0448\u0438\u0431\u043B\u0430\u0441\u044C
      \u043C\u0435\u0441\u0442\u043E\u043C."
  - ID: Chapter_4_Back_38
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uACBD\uCC30\uC5D0 \uC54C\uB824\uC57C \uD558\uB294\uB370."
    Text_En: I should tell the police.
    Text_ZhHans: "\u5E94\u8BE5\u62A5\u8B66\u624D\u5BF9\u3002"
    Text_Ja: "\u8B66\u5BDF\u306B\u77E5\u3089\u305B\u306A\u304D\u3083\u3002"
    Text_Es: "Ten\xEDa que avisar a la polic\xEDa."
    Text_Pt: "Precisava avisar a pol\xEDcia."
    Text_Ru: "\u041D\u0430\u0434\u043E \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C
      \u0432 \u043F\u043E\u043B\u0438\u0446\u0438\u044E."
  - ID: Chapter_4_Back_39
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC774 \uC218\uCCA9\uC744 \uBCF4\uC5EC\uC8FC\uBA74 \uC544\uBE60\uB294
      \uC5B4\uB5BB\uAC8C \uB420\uAE4C."
    Text_En: But what would this notebook do to Dad?
    Text_ZhHans: "\u53EF\u628A\u8FD9\u672C\u7B14\u8BB0\u4EA4\u51FA\u53BB\uFF0C\u7238\u7238\u4F1A\u600E\u6837\uFF1F"
    Text_Ja: "\u3067\u3082\u3001\u3053\u306E\u624B\u5E33\u3092\u898B\u305B\u305F\u3089\u304A\u7236\u3055\u3093\u306F\uFF1F"
    Text_Es: "Pero \xBFqu\xE9 le pasar\xEDa a pap\xE1 si ense\xF1aba esto?"
    Text_Pt: Mas o que aconteceria com papai se vissem isto?
    Text_Ru: "\u041D\u043E \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0441
      \u043F\u0430\u043F\u043E\u0439, \u0435\u0441\u043B\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u0431\u043B\u043E\u043A\u043D\u043E\u0442?"
  - ID: Chapter_4_Back_40
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC124\uB9C8 \uC544\uBE60\uAC00\u2026\u2026."
    Text_En: Surely Dad hadn't...
    Text_ZhHans: "\u96BE\u9053\u7238\u7238\u2026\u2026"
    Text_Ja: "\u307E\u3055\u304B\u3001\u304A\u7236\u3055\u3093\u304C\u2026\u2026"
    Text_Es: "No pod\xEDa haber sido \xE9l..."
    Text_Pt: "N\xE3o podia ter sido ele..."
    Text_Ru: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043F\u0430\u043F\u0430..."
  - ID: Chapter_4_Back_41
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uBA3C\uC800 \uB9CC\uB098\uC11C \uBB3C\uC5B4\uBD10\uC57C \uD588\uB2E4."
    Text_En: I had to find him and ask first.
    Text_ZhHans: "\u6211\u5F97\u5148\u627E\u5230\u4ED6\uFF0C\u95EE\u4E2A\u6E05\u695A\u3002"
    Text_Ja: "\u5148\u306B\u4F1A\u3063\u3066\u3001\u805E\u304B\u306A\u3051\u308C\u3070\u3002"
    Text_Es: "Primero ten\xEDa que encontrarlo y preguntarle."
    Text_Pt: "Eu tinha que encontr\xE1-lo e perguntar primeiro."
    Text_Ru: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0434\u043E
      \u043D\u0430\u0439\u0442\u0438 \u0435\u0433\u043E \u0438 \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C."
  - ID: Chapter_4_Back_42
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB36E\uC73C\uB824\uB358 \uC218\uCCA9\uC5D0\uC11C \uB2E4\uC74C \uC7A5\uC774
      \uD3BC\uCCD0\uC84C\uB2E4."
    Text_En: As I closed the book, a page fell open.
    Text_ZhHans: "\u6B63\u8981\u5408\u4E0A\u672C\u5B50\uFF0C\u4E0B\u4E00\u9875\u5374\u7FFB\u5F00\u4E86\u3002"
    Text_Ja: "\u9589\u3058\u304B\u3051\u305F\u624B\u5E33\u306E\u6B21\u306E\u30DA\u30FC\u30B8\u304C\u958B\u3044\u305F\u3002"
    Text_Es: "Al cerrar el cuaderno, se abri\xF3 otra p\xE1gina."
    Text_Pt: "Ao fechar o caderno, outra p\xE1gina se abriu."
    Text_Ru: "\u042F \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u043B\u0430 \u0431\u043B\u043E\u043A\u043D\u043E\u0442,
      \u043D\u043E \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C \u043D\u043E\u0432\u0430\u044F
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430."
  - ID: Chapter_4_Back_43
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB2E4\uB978 \uBCC4\uC790\uB9AC\uC640 \uB2E4\uB978 \uC7A5\uC18C."
    Text_En: Another constellation. Another place.
    Text_ZhHans: "\u53E6\u4E00\u4E2A\u661F\u5EA7\uFF0C\u53E6\u4E00\u4E2A\u5730\u65B9\u3002"
    Text_Ja: "\u5225\u306E\u661F\u5EA7\u3068\u3001\u5225\u306E\u5834\u6240\u3002"
    Text_Es: "Otra constelaci\xF3n. Otro lugar."
    Text_Pt: "Outra constela\xE7\xE3o. Outro lugar."
    Text_Ru: "\u0414\u0440\u0443\u0433\u043E\u0435 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u0435.
      \u0414\u0440\u0443\u0433\u043E\u0435 \u043C\u0435\u0441\u0442\u043E."
  - ID: Chapter_4_Back_44
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uACF3\uC5D0\uB3C4 \uAC19\uC740 \uD45C\uC2DC\uAC00 \uC788\uC5C8\uB2E4."
    Text_En: The same mark was there, too.
    Text_ZhHans: "\u90A3\u91CC\u4E5F\u6709\u540C\u6837\u7684\u6807\u8BB0\u3002"
    Text_Ja: "\u305D\u3053\u306B\u3082\u540C\u3058\u5370\u304C\u3042\u3063\u305F\u3002"
    Text_Es: "Tambi\xE9n estaba aquella marca."
    Text_Pt: "A mesma marca estava l\xE1."
    Text_Ru: "\u0418 \u0442\u0430\u043C \u0431\u044B\u043B\u0430 \u0442\u0430\u043A\u0430\u044F
      \u0436\u0435 \u043E\u0442\u043C\u0435\u0442\u043A\u0430."
  - ID: Chapter_4_Back_45
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uB354\uB294 \uC544\uBB34\uAC83\uB3C4 \uD30C\uBCF4\uACE0 \uC2F6\uC9C0
      \uC54A\uC558\uB2E4."
    Text_En: I didn't want to dig up anything else.
    Text_ZhHans: "\u6211\u518D\u4E5F\u4E0D\u60F3\u6316\u5F00\u4EC0\u4E48\u4E86\u3002"
    Text_Ja: "\u3082\u3046\u4F55\u3082\u6398\u308A\u8FD4\u3057\u305F\u304F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "No quer\xEDa desenterrar nada m\xE1s."
    Text_Pt: "Eu n\xE3o queria desenterrar mais nada."
    Text_Ru: "\u042F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430 \u0440\u0430\u0441\u043A\u0430\u043F\u044B\u0432\u0430\u0442\u044C."
  - ID: Chapter_4_Back_46
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uB7F0\uB370 \uC218\uCCA9\uC744 \uB36E\uC73C\uBA74,"
    Text_En: But if I closed the notebook,
    Text_ZhHans: "\u53EF\u4E00\u65E6\u5408\u4E0A\u7B14\u8BB0\u672C\uFF0C"
    Text_Ja: "\u3067\u3082\u3001\u624B\u5E33\u3092\u9589\u3058\u305F\u3089\u3001"
    Text_Es: Pero, si cerraba el cuaderno,
    Text_Pt: Mas, se fechasse o caderno,
    Text_Ru: "\u041D\u043E \u0435\u0441\u043B\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u0431\u043B\u043E\u043A\u043D\u043E\u0442,"
  - ID: Chapter_4_Back_47
    Chapter_Id: 4_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uB97C \uC5B4\uB514\uC11C \uCC3E\uC544\uC57C \uD560\uC9C0
      \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
    Text_En: I wouldn't know where to look for Dad.
    Text_ZhHans: "\u6211\u5C31\u4E0D\u77E5\u9053\u8BE5\u53BB\u54EA\u91CC\u627E\u7238\u7238\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u3092\u3069\u3053\u3067\u63A2\u305B\u3070\u3044\u3044\u304B\u5206\u304B\u3089\u306A\u3044\u3002"
    Text_Es: "no sabr\xEDa d\xF3nde buscar a pap\xE1."
    Text_Pt: "n\xE3o saberia onde procurar papai."
    Text_Ru: "\u0433\u0434\u0435 \u0442\u043E\u0433\u0434\u0430 \u0438\u0441\u043A\u0430\u0442\u044C
      \u043F\u0430\u043F\u0443?"
  - ID: Chapter_5_Front_1
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB9DD\uC6D0\uACBD\uC758 \uCD08\uC810\uC744 \uB9DE\uCDC4\uB2E4."
    Text_En: I focused the telescope.
    Text_ZhHans: "\u6211\u8C03\u597D\u4E86\u671B\u8FDC\u955C\u7684\u7126\u8DDD\u3002"
    Text_Ja: "\u671B\u9060\u93E1\u306E\u30D4\u30F3\u30C8\u3092\u5408\u308F\u305B\u305F\u3002"
    Text_Es: "Enfoqu\xE9 el telescopio."
    Text_Pt: "Ajustei o foco do telesc\xF3pio."
    Text_Ru: "\u042F \u043D\u0430\u0432\u0451\u043B \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F
      \u043D\u0430 \u0440\u0435\u0437\u043A\u043E\u0441\u0442\u044C."
  - ID: Chapter_5_Front_2
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uD750\uB9AC\uB358 \uBE5B\uC774 \uC791\uC740 \uC810\uC73C\uB85C \uBAA8\uC600\uB2E4."
    Text_En: The blurred light became a tiny point.
    Text_ZhHans: "\u6A21\u7CCA\u7684\u5149\u805A\u6210\u4E00\u4E2A\u5C0F\u70B9\u3002"
    Text_Ja: "\u307C\u3084\u3051\u305F\u5149\u304C\u3001\u5C0F\u3055\u306A\u70B9\u306B\u96C6\u307E\u3063\u305F\u3002"
    Text_Es: "La luz borrosa se volvi\xF3 un peque\xF1o punto."
    Text_Pt: A luz borrada virou um pequeno ponto.
    Text_Ru: "\u0420\u0430\u0437\u043C\u044B\u0442\u044B\u0439 \u0441\u0432\u0435\u0442
      \u0441\u043E\u0431\u0440\u0430\u043B\u0441\u044F \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E
      \u0442\u043E\u0447\u043A\u0443."
  - ID: Chapter_5_Front_3
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC608\uC804\uC5D0\uB294 \uC774\uB807\uAC8C \uBC24\uC744 \uBCF4\uB0B4\uB294
      \uAC83\uC774 \uC88B\uC558\uB2E4."
    Text_En: I'd once loved nights like this.
    Text_ZhHans: "\u4EE5\u524D\uFF0C\u6211\u5F88\u559C\u6B22\u8FD9\u6837\u5EA6\u8FC7\u591C\u665A\u3002"
    Text_Ja: "\u6614\u306F\u3001\u3053\u3046\u3057\u3066\u591C\u3092\u904E\u3054\u3059\u306E\u304C\u597D\u304D\u3060\u3063\u305F\u3002"
    Text_Es: "Antes me gustaba pasar as\xED las noches."
    Text_Pt: Antes, eu gostava de passar as noites assim.
    Text_Ru: "\u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u043B\u044E\u0431\u0438\u043B
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0442\u0430\u043A \u043D\u043E\u0447\u0438."
  - ID: Chapter_5_Front_4
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB0AE\uC5D0 \uC77D\uC740 \uCC45\uC744 \uC606\uC5D0 \uD3BC\uCCD0\uB193\uACE0,"
    Text_En: A book I'd read that day beside me,
    Text_ZhHans: "\u628A\u767D\u5929\u8BFB\u8FC7\u7684\u4E66\u644A\u5728\u8EAB\u65C1\uFF0C"
    Text_Ja: "\u663C\u306B\u8AAD\u3093\u3060\u672C\u3092\u305D\u3070\u306B\u5E83\u3052\u3001"
    Text_Es: "Con el libro que hab\xEDa le\xEDdo a mi lado,"
    Text_Pt: Com o livro que lera durante o dia ao lado,
    Text_Ru: "\u0421 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u043E\u0439 \u0440\u044F\u0434\u043E\u043C
      \u043A\u043D\u0438\u0433\u043E\u0439"
  - ID: Chapter_5_Front_5
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uBC30\uC6B4 \uBCC4\uC744 \uD558\uB098\uC529 \uCC3E\uC544\uBCF4\uACE4
      \uD588\uB2E4."
    Text_En: I'd find each star I'd learned about.
    Text_ZhHans: "\u4E00\u9897\u9897\u5BFB\u627E\u521A\u8BA4\u8BC6\u7684\u661F\u661F\u3002"
    Text_Ja: "\u899A\u3048\u305F\u661F\u3092\u4E00\u3064\u305A\u3064\u63A2\u3057\u305F\u3002"
    Text_Es: buscaba las estrellas una por una.
    Text_Pt: buscava cada estrela que tinha aprendido.
    Text_Ru: "\u044F \u0438\u0441\u043A\u0430\u043B \u0437\u0432\u0451\u0437\u0434\u044B,
      \u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0447\u0438\u0442\u0430\u043B
      \u0434\u043D\u0451\u043C."
  - ID: Chapter_5_Front_6
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC5B8\uC820\uAC00\uB294 \uC774\uAC83\uC73C\uB85C \uC0B4\uC544\uAC00\uACE0
      \uC2F6\uC5C8\uB2E4."
    Text_En: I'd hoped to make a living from it.
    Text_ZhHans: "\u6211\u66FE\u5E0C\u671B\u6709\u4E00\u5929\u80FD\u4EE5\u6B64\u4E3A\u751F\u3002"
    Text_Ja: "\u3044\u3064\u304B\u3001\u3053\u308C\u3067\u751F\u304D\u3066\u3044\u304D\u305F\u304B\u3063\u305F\u3002"
    Text_Es: "So\xF1aba con dedicarme a esto alg\xFAn d\xEDa."
    Text_Pt: Sonhava em viver disso um dia.
    Text_Ru: "\u041C\u0435\u0447\u0442\u0430\u043B \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
      \u044D\u0442\u0438\u043C \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C."
  - ID: Chapter_5_Front_7
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uD558\uC9C0\uB9CC \uC138\uC0C1\uC740 \uB0B4 \uB73B\uB300\uB85C \uB418\uC9C0
      \uC54A\uC558\uB2E4."
    Text_En: But life hadn't gone as I'd hoped.
    Text_ZhHans: "\u53EF\u751F\u6D3B\u6CA1\u6709\u5982\u6211\u6240\u613F\u3002"
    Text_Ja: "\u3051\u308C\u3069\u3001\u4EBA\u751F\u306F\u601D\u3044\u3069\u304A\u308A\u306B\u306A\u3089\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Pero la vida no sali\xF3 como esperaba."
    Text_Pt: "Mas a vida n\xE3o saiu como eu queria."
    Text_Ru: "\u041D\u043E \u0436\u0438\u0437\u043D\u044C \u0441\u043B\u043E\u0436\u0438\u043B\u0430\u0441\u044C
      \u043D\u0435 \u0442\u0430\u043A, \u043A\u0430\u043A \u044F \u0445\u043E\u0442\u0435\u043B."
  - ID: Chapter_5_Front_8
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC544\uB0B4\uC758 \uCE58\uB8CC\uBE44\uC640 \uBC00\uB9B0 \uC0DD\uD65C\uBE44."
    Text_En: My wife's treatment. Overdue bills.
    Text_ZhHans: "\u59BB\u5B50\u7684\u6CBB\u7597\u8D39\uFF0C\u8FD8\u6709\u62D6\u6B20\u7684\u751F\u6D3B\u8D39\u3002"
    Text_Ja: "\u59BB\u306E\u6CBB\u7642\u8CBB\u3068\u3001\u6EDE\u3063\u305F\u751F\u6D3B\u8CBB\u3002"
    Text_Es: El tratamiento de mi esposa. Las deudas.
    Text_Pt: O tratamento da minha esposa. As contas atrasadas.
    Text_Ru: "\u041B\u0435\u0447\u0435\u043D\u0438\u0435 \u0436\u0435\u043D\u044B.
      \u041D\u0435\u043E\u043F\u043B\u0430\u0447\u0435\u043D\u043D\u044B\u0435 \u0441\u0447\u0435\u0442\u0430."
  - ID: Chapter_5_Front_9
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC5B4\uB5BB\uAC8C \uD574\uB3C4 \uAC1A\uC744 \uC218\uAC00 \uC5C6\uC5C8\uB2E4."
    Text_En: No matter what I did, I couldn't pay.
    Text_ZhHans: "\u65E0\u8BBA\u600E\u4E48\u52AA\u529B\uFF0C\u90FD\u8FD8\u4E0D\u6E05\u3002"
    Text_Ja: "\u3069\u3046\u3057\u3066\u3082\u8FD4\u3057\u304D\u308C\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Por m\xE1s que intentaba, no pod\xEDa pagarlas."
    Text_Pt: "Por mais que tentasse, n\xE3o conseguia pagar."
    Text_Ru: "\u041A\u0430\u043A \u043D\u0438 \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F,
      \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u0442\u044C\u0441\u044F \u043D\u0435
      \u043C\u043E\u0433."
  - ID: Chapter_5_Front_10
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC624\uB298\uC740 \uC5B4\uB5A4 \uC0AC\uB78C\uB4E4\uC744 \uB9CC\uB098\uAC8C
      \uB418\uC5C8\uB2E4."
    Text_En: Today, I'd met some people.
    Text_ZhHans: "\u4ECA\u5929\uFF0C\u6211\u89C1\u4E86\u51E0\u4E2A\u4EBA\u3002"
    Text_Ja: "\u4ECA\u65E5\u3001\u3042\u308B\u4EBA\u305F\u3061\u306B\u4F1A\u3063\u305F\u3002"
    Text_Es: "Hoy hab\xEDa conocido a unas personas."
    Text_Pt: Hoje, conheci algumas pessoas.
    Text_Ru: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0441\u044F
      \u0441 \u043A\u0430\u043A\u0438\u043C\u0438-\u0442\u043E \u043B\u044E\u0434\u044C\u043C\u0438."
  - ID: Chapter_5_Front_11
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB4E4\uC774 \uB098\uC5D0\uAC8C \uD588\uB358 \uB9D0..."
    Text_En: What they'd said...
    Text_ZhHans: "\u4ED6\u4EEC\u5BF9\u6211\u8BF4\u2026\u2026"
    Text_Ja: "\u5F7C\u3089\u304C\u8A00\u3063\u305F\u8A00\u8449\u2026\u2026"
    Text_Es: Lo que me dijeron...
    Text_Pt: O que elas me disseram...
    Text_Ru: "\u041E\u043D\u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0438..."
  - ID: Chapter_5_Front_12
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC0AC\uB78C\uC774 \uC624\uC9C0 \uC54A\uB294 \uACF3\uC744 \uC798 \uC548\uB2E4\uBA74\uC11C\uC694."
    Text_En: You know places no one visits.
    Text_ZhHans: "\u542C\u8BF4\u4F60\u5F88\u719F\u6089\u6CA1\u4EBA\u53BB\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u4EBA\u306E\u6765\u306A\u3044\u5834\u6240\u3092\u3088\u304F\u3054\u5B58\u3058\u3060\u3068\u304B\u3002"
    Text_Es: Dicen que conoce sitios donde no va nadie.
    Text_Pt: "O senhor conhece lugares onde ningu\xE9m vai."
    Text_Ru: "\u0412\u044B \u0432\u0435\u0434\u044C \u0437\u043D\u0430\u0435\u0442\u0435
      \u043C\u0435\u0441\u0442\u0430, \u043A\u0443\u0434\u0430 \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0445\u043E\u0434\u0438\u0442."
  - ID: Chapter_5_Front_13
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uD2C0\uB9B0 \uB9D0\uC740 \uC544\uB2C8\uC5C8\uB2E4."
    Text_En: They weren't wrong.
    Text_ZhHans: "\u4ED6\u4EEC\u6CA1\u8BF4\u9519\u3002"
    Text_Ja: "\u9593\u9055\u3044\u3067\u306F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: No se equivocaban.
    Text_Pt: "N\xE3o estavam erradas."
    Text_Ru: "\u041E\u043D\u0438 \u043D\u0435 \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C."
  - ID: Chapter_5_Front_14
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uBCC4\uC774 \uC798 \uBCF4\uC774\uB294 \uACF3\uC744 \uCC3E\uB290\uB77C"
    Text_En: To find a clear view of the stars,
    Text_ZhHans: "\u4E3A\u4E86\u5BFB\u627E\u9002\u5408\u89C2\u661F\u7684\u5730\u65B9\uFF0C"
    Text_Ja: "\u661F\u306E\u3088\u304F\u898B\u3048\u308B\u5834\u6240\u3092\u63A2\u3057\u3066\u3001"
    Text_Es: Para encontrar cielos despejados,
    Text_Pt: "Em busca de um bom c\xE9u para observar,"
    Text_Ru: "\u0412 \u043F\u043E\u0438\u0441\u043A\u0430\u0445 \u044F\u0441\u043D\u043E\u0433\u043E
      \u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0433\u043E \u043D\u0435\u0431\u0430"
  - ID: Chapter_5_Front_15
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB0A8\uB4E4\uC774 \uAC00\uC9C0 \uC54A\uB294 \uAE38\uC744 \uB2E4\uB154\uB2E4."
    Text_En: I'd taken paths others never used.
    Text_ZhHans: "\u6211\u8D70\u8FC7\u8BB8\u591A\u522B\u4EBA\u4E0D\u8D70\u7684\u8DEF\u3002"
    Text_Ja: "\u8AB0\u3082\u901A\u3089\u306A\u3044\u9053\u3092\u6B69\u3044\u3066\u304D\u305F\u3002"
    Text_Es: "hab\xEDa recorrido caminos solitarios."
    Text_Pt: eu percorrera caminhos desertos.
    Text_Ru: "\u044F \u0445\u043E\u0434\u0438\u043B \u043F\u0443\u0442\u044F\u043C\u0438,
      \u0433\u0434\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E \u0434\u0440\u0443\u0433\u0438\u0445."
  - ID: Chapter_5_Front_16
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uBD88\uBE5B\uB3C4, \uC0AC\uB78C\uB3C4 \uC5C6\uB294 \uC7A5\uC18C\uB4E4."
    Text_En: Places without lights or people.
    Text_ZhHans: "\u6CA1\u6709\u706F\u5149\uFF0C\u4E5F\u6CA1\u6709\u4EBA\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u660E\u304B\u308A\u3082\u3001\u4EBA\u3082\u3044\u306A\u3044\u5834\u6240\u3002"
    Text_Es: Lugares sin luces ni gente.
    Text_Pt: Lugares sem luzes e sem pessoas.
    Text_Ru: "\u041C\u0435\u0441\u0442\u0430 \u0431\u0435\u0437 \u043E\u0433\u043D\u0435\u0439
      \u0438 \u043B\u044E\u0434\u0435\u0439."
  - ID: Chapter_5_Front_17
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uADF8\uB4E4\uC740 \uADF8\uB7F0 \uACF3\uC774 \uD544\uC694\uD558\uB2E4\uACE0
      \uD588\uB2E4."
    Text_En: They said they needed such places.
    Text_ZhHans: "\u4ED6\u4EEC\u8BF4\uFF0C\u6B63\u9700\u8981\u8FD9\u6837\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u5F7C\u3089\u306F\u3001\u305D\u3046\u3044\u3046\u5834\u6240\u304C\u5FC5\u8981\u3060\u3068\u8A00\u3063\u305F\u3002"
    Text_Es: "Dijeron que necesitaban sitios as\xED."
    Text_Pt: Disseram que precisavam de lugares assim.
    Text_Ru: "\u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A\u0438\u0435
      \u043C\u0435\u0441\u0442\u0430 \u0438\u043C \u0438 \u0431\u044B\u043B\u0438
      \u043D\u0443\u0436\u043D\u044B."
  - ID: Chapter_5_Front_18
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uBB34\uC5C7\uC744 \uAC00\uC838\uB2E4 \uB193\uC73C\uB824\uB294\uC9C0
      \uBB3C\uC5C8\uB2E4."
    Text_En: I asked what they wanted to leave there.
    Text_ZhHans: "\u6211\u95EE\u4ED6\u4EEC\u60F3\u628A\u4EC0\u4E48\u653E\u5728\u90A3\u91CC\u3002"
    Text_Ja: "\u4F55\u3092\u7F6E\u304F\u3064\u3082\u308A\u306A\u306E\u304B\u5C0B\u306D\u305F\u3002"
    Text_Es: "Pregunt\xE9 qu\xE9 quer\xEDan dejar all\xED."
    Text_Pt: "Perguntei o que queriam deixar l\xE1."
    Text_Ru: "\u042F \u0441\u043F\u0440\u043E\u0441\u0438\u043B, \u0447\u0442\u043E
      \u043E\u043D\u0438 \u0445\u043E\u0442\u044F\u0442 \u0442\u0430\u043C \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C."
  - ID: Chapter_5_Front_19
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB300\uB2F5\uC744 \uB4E3\uACE0\uB3C4 \uB098\uB294 \uC790\uB9AC\uB97C
      \uB728\uC9C0 \uC54A\uC558\uB2E4."
    Text_En: Even after the answer, I stayed.
    Text_ZhHans: "\u542C\u5230\u56DE\u7B54\u540E\uFF0C\u6211\u5374\u6CA1\u6709\u79BB\u5F00\u3002"
    Text_Ja: "\u7B54\u3048\u3092\u805E\u3044\u3066\u3082\u3001\u79C1\u306F\u5E2D\u3092\u7ACB\u305F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "O\xED la respuesta, pero no me fui."
    Text_Pt: "Mesmo ap\xF3s ouvir a resposta, n\xE3o fui embora."
    Text_Ru: "\u0423\u0441\u043B\u044B\u0448\u0430\u043B \u043E\u0442\u0432\u0435\u0442,
      \u043D\u043E \u043D\u0435 \u0443\u0448\u0451\u043B."
  - ID: Chapter_5_Front_20
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC8FD\uC740 \uC0AC\uB78C\uC744 \uBB3B\uC5B4\uC8FC\uB294 \uC77C."
    Text_En: Burying the dead.
    Text_ZhHans: "\u66FF\u4EBA\u57CB\u846C\u6B7B\u8005\u3002"
    Text_Ja: "\u6B7B\u3093\u3060\u4EBA\u3092\u57CB\u3081\u308B\u4ED5\u4E8B\u3002"
    Text_Es: Enterrar a los muertos.
    Text_Pt: Enterrar os mortos.
    Text_Ru: "\u0417\u0430\u043A\u0430\u043F\u044B\u0432\u0430\u0442\u044C \u043C\u0451\u0440\u0442\u0432\u044B\u0445."
  - ID: Chapter_5_Front_21
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uADF8 \uB300\uAC00\uB85C \uBC1B\uC744 \uB3C8\uC744 \uC0DD\uAC01\uD558\uACE0
      \uC788\uC5C8\uB2E4."
    Text_En: I was thinking of what they'd pay.
    Text_ZhHans: "\u6211\u60F3\u7684\uFF0C\u662F\u80FD\u62FF\u5230\u591A\u5C11\u94B1\u3002"
    Text_Ja: "\u305D\u306E\u5831\u916C\u306E\u3053\u3068\u3092\u8003\u3048\u3066\u3044\u305F\u3002"
    Text_Es: "Pensaba en el dinero que recibir\xEDa."
    Text_Pt: Eu pensava no dinheiro que receberia.
    Text_Ru: "\u042F \u0434\u0443\u043C\u0430\u043B \u043E \u0434\u0435\u043D\u044C\u0433\u0430\u0445,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u043B\u0443\u0447\u0443."
  - ID: Chapter_5_Front_22
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC774\uBC88 \uCE58\uB8CC\uBE44\uB294 \uB0BC \uC218 \uC788\uC5C8\uB2E4."
    Text_En: I could cover her next treatment.
    Text_ZhHans: "\u8FD9\u6B21\u7684\u6CBB\u7597\u8D39\u6709\u7740\u843D\u4E86\u3002"
    Text_Ja: "\u4ECA\u5EA6\u306E\u6CBB\u7642\u8CBB\u306F\u6255\u3048\u308B\u3002"
    Text_Es: "Podr\xEDa pagar el pr\xF3ximo tratamiento."
    Text_Pt: "Daria para pagar o pr\xF3ximo tratamento."
    Text_Ru: "\u0425\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0435
      \u043B\u0435\u0447\u0435\u043D\u0438\u0435."
  - ID: Chapter_5_Front_23
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uBA70\uCE60\uB9CC\uC774\uB77C\uB3C4 \uB3C8 \uAC71\uC815 \uC5C6\uC774"
    Text_En: For a few days, at least,
    Text_ZhHans: "\u81F3\u5C11\u80FD\u6709\u51E0\u5929\u4E0D\u7528\u62C5\u5FC3\u94B1\uFF0C"
    Text_Ja: "\u6570\u65E5\u3060\u3051\u3067\u3082\u3001\u91D1\u306E\u5FC3\u914D\u3092\u305B\u305A\u306B\u3001"
    Text_Es: "Al menos unos d\xEDas, sin pensar en dinero,"
    Text_Pt: Por alguns dias, sem pensar em dinheiro,
    Text_Ru: "\u0425\u043E\u0442\u044F \u0431\u044B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u0431\u0435\u0437 \u0442\u0440\u0435\u0432\u043E\u0433\u0438
      \u043E \u0434\u0435\u043D\u044C\u0433\u0430\u0445"
  - ID: Chapter_5_Front_24
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC544\uB0B4 \uACC1\uC5D0 \uC549\uC544 \uC788\uC744 \uC218 \uC788\uC5C8\uB2E4."
    Text_En: I could sit with her without worrying.
    Text_ZhHans: "\u5B89\u9759\u5730\u966A\u5728\u59BB\u5B50\u8EAB\u8FB9\u3002"
    Text_Ja: "\u59BB\u306E\u305D\u3070\u306B\u5EA7\u3063\u3066\u3044\u3089\u308C\u308B\u3002"
    Text_Es: "podr\xEDa sentarme junto a mi esposa."
    Text_Pt: eu poderia ficar ao lado da minha esposa.
    Text_Ru: "\u044F \u0441\u043C\u043E\u0433\u0443 \u043F\u043E\u0441\u0438\u0434\u0435\u0442\u044C
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0436\u0435\u043D\u043E\u0439."
  - ID: Chapter_5_Front_25
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uACB0\uAD6D \uD558\uACA0\uB2E4\uACE0 \uB9D0\uD588\uB2E4."
    Text_En: In the end, I said yes.
    Text_ZhHans: "\u6700\u540E\uFF0C\u6211\u7B54\u5E94\u4E86\u3002"
    Text_Ja: "\u7D50\u5C40\u3001\u5F15\u304D\u53D7\u3051\u308B\u3068\u8A00\u3063\u305F\u3002"
    Text_Es: "Al final, acept\xE9."
    Text_Pt: No fim, aceitei.
    Text_Ru: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432
      \u044F \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F."
  - ID: Chapter_5_Front_26
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uADF8 \uB9D0\uC744 \uD55C \uB4A4\uBD80\uD130"
    Text_En: Ever since,
    Text_ZhHans: "\u4ECE\u8BF4\u51FA\u90A3\u53E5\u8BDD\u8D77\uFF0C"
    Text_Ja: "\u305D\u3046\u53E3\u306B\u3057\u3066\u304B\u3089\u3001"
    Text_Es: Desde que lo dije,
    Text_Pt: Desde que disse aquilo,
    Text_Ru: "\u0421 \u0442\u0435\u0445 \u043F\u043E\u0440"
  - ID: Chapter_5_Front_27
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC2DC\uACC4\uB97C \uC790\uAFB8 \uD655\uC778\uD558\uAC8C \uB410\uB2E4."
    Text_En: I'd kept checking the clock.
    Text_ZhHans: "\u6211\u5C31\u4E0D\u65AD\u5730\u770B\u65F6\u95F4\u3002"
    Text_Ja: "\u4F55\u5EA6\u3082\u6642\u8A08\u3092\u898B\u308B\u3088\u3046\u306B\u306A\u3063\u305F\u3002"
    Text_Es: no dejaba de mirar el reloj.
    Text_Pt: "n\xE3o parava de olhar o rel\xF3gio."
    Text_Ru: "\u044F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430 \u0447\u0430\u0441\u044B."
  - ID: Chapter_5_Front_28
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC57D\uC18D\uD55C \uC2DC\uAC04\uAE4C\uC9C0\uB294 \uC870\uAE08 \uB0A8\uC544
      \uC788\uC5C8\uB2E4."
    Text_En: There was still time before we met.
    Text_ZhHans: "\u79BB\u7EA6\u5B9A\u7684\u65F6\u95F4\u8FD8\u65E9\u3002"
    Text_Ja: "\u7D04\u675F\u306E\u6642\u9593\u307E\u3067\u306F\u3001\u307E\u3060\u5C11\u3057\u3042\u3063\u305F\u3002"
    Text_Es: "A\xFAn faltaba un poco para la cita."
    Text_Pt: Ainda faltava um pouco para o encontro.
    Text_Ru: "\u0414\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u043E\u0441\u044C
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
  - ID: Chapter_5_Front_29
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uB2E4\uC2DC \uB9DD\uC6D0\uACBD \uC55E\uC5D0 \uC549\uC558\uB2E4."
    Text_En: I sat at the telescope again.
    Text_ZhHans: "\u6211\u91CD\u65B0\u5750\u5230\u671B\u8FDC\u955C\u524D\u3002"
    Text_Ja: "\u79C1\u306F\u518D\u3073\u671B\u9060\u93E1\u306E\u524D\u306B\u5EA7\u3063\u305F\u3002"
    Text_Es: "Volv\xED a sentarme ante el telescopio."
    Text_Pt: "Sentei diante do telesc\xF3pio outra vez."
    Text_Ru: "\u042F \u0441\u043D\u043E\u0432\u0430 \u0441\u0435\u043B \u0437\u0430
      \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F."
  - ID: Chapter_5_Front_30
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC624\uB298 \uCC3E\uC544\uBCF4\uB824\uB358 \uAC83\uC740 \uD5E4\uB77C\uD074\uB808\uC2A4\uC790\uB9AC\uC600\uB2E4."
    Text_En: Tonight, I'd meant to find Hercules.
    Text_ZhHans: "\u4ECA\u665A\u539F\u672C\u60F3\u627E\u7684\u662F\u6B66\u4ED9\u5EA7\u3002"
    Text_Ja: "\u4ECA\u591C\u63A2\u3059\u3064\u3082\u308A\u3060\u3063\u305F\u306E\u306F\u3001\u30D8\u30EB\u30AF\u30EC\u30B9\u5EA7\u3002"
    Text_Es: "Esa noche iba a buscar a H\xE9rcules."
    Text_Pt: "Naquela noite, eu ia procurar H\xE9rcules."
    Text_Ru: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F
      \u043D\u0430\u0439\u0442\u0438 \u0413\u0435\u0440\u043A\u0443\u043B\u0435\u0441\u0430."
  - ID: Chapter_5_Front_31
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC8FC\uC5B4\uC9C4 \uACFC\uC5C5\uC744 \uD558\uB098\uC529 \uB05D\uB0B4\uB358
      \uC0AC\uB78C."
    Text_En: A man who faced one labor after another.
    Text_ZhHans: "\u90A3\u4E2A\u9010\u4E00\u5B8C\u6210\u8BD5\u70BC\u7684\u4EBA\u3002"
    Text_Ja: "\u4E0E\u3048\u3089\u308C\u305F\u8A66\u7DF4\u3092\u4E00\u3064\u305A\u3064\u7D42\u3048\u305F\u7537\u3002"
    Text_Es: "Un hombre que cumpl\xEDa una tarea tras otra."
    Text_Pt: "Um homem que cumpria uma tarefa ap\xF3s outra."
    Text_Ru: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0433\u043E
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0437\u0430 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435\u043C."
  - ID: Chapter_5_Front_32
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC9C0\uAE08\uC740 \uADF8 \uC774\uC57C\uAE30\uC758 \uB05D\uBCF4\uB2E4"
    Text_En: Now, I couldn't think of his ending.
    Text_ZhHans: "\u6B64\u523B\uFF0C\u6211\u60F3\u4E0D\u8D77\u6545\u4E8B\u7684\u7ED3\u5C40\uFF0C"
    Text_Ja: "\u4ECA\u306F\u3001\u305D\u306E\u7269\u8A9E\u306E\u7D50\u672B\u3088\u308A\u3082\u3001"
    Text_Es: "Ahora no pensaba en c\xF3mo acab\xF3 su historia,"
    Text_Pt: "Eu n\xE3o pensava mais no fim daquela hist\xF3ria,"
    Text_Ru: "\u042F \u0434\u0443\u043C\u0430\u043B \u0443\u0436\u0435 \u043D\u0435
      \u043E \u043A\u043E\u043D\u0446\u0435 \u0435\u0433\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u0438,"
  - ID: Chapter_5_Front_33
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB208\uC55E\uC758 \uC77C\uC744 \uB05D\uB0B8\uB2E4\uB294 \uB9D0\uB9CC
      \uB5A0\uC62C\uB790\uB2E4."
    Text_En: Only of finishing the task before me.
    Text_ZhHans: "\u8111\u6D77\u91CC\u53EA\u6709\u5B8C\u6210\u773C\u524D\u7684\u5DE5\u4F5C\u3002"
    Text_Ja: "\u76EE\u306E\u524D\u306E\u4ED5\u4E8B\u3092\u7D42\u3048\u308B\u3053\u3068\u3070\u304B\u308A\u6D6E\u304B\u3093\u3060\u3002"
    Text_Es: solo en terminar el trabajo pendiente.
    Text_Pt: "s\xF3 em terminar o trabalho \xE0 minha frente."
    Text_Ru: "\u0430 \u043B\u0438\u0448\u044C \u043E \u0442\u043E\u043C, \u043A\u0430\u043A
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u0441\u0432\u043E\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443."
  - ID: Chapter_5_Front_34
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC774\uBC88 \uC77C\uB9CC \uB9C8\uCE58\uBA74."
    Text_En: If I could just finish this job,
    Text_ZhHans: "\u53EA\u8981\u505A\u5B8C\u8FD9\u4E00\u4EF6\u3002"
    Text_Ja: "\u3053\u306E\u4ED5\u4E8B\u3055\u3048\u7D42\u308F\u308C\u3070\u3002"
    Text_Es: Si acababa este encargo,
    Text_Pt: "Se eu acabasse este servi\xE7o,"
    Text_Ru: "\u0412\u043E\u0442 \u0432\u044B\u043F\u043E\u043B\u043D\u044E \u044D\u0442\u043E\u0442
      \u0437\u0430\u043A\u0430\u0437."
  - ID: Chapter_5_Front_35
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uC801\uC5B4\uB3C4 \uB2F9\uC7A5\uC740 \uBC84\uD2F8 \uC218 \uC788\uC744
      \uAC83\uC774\uB2E4."
    Text_En: we could get by for now.
    Text_ZhHans: "\u81F3\u5C11\u6682\u65F6\u8FD8\u80FD\u6491\u4E0B\u53BB\u3002"
    Text_Ja: "\u5C11\u306A\u304F\u3068\u3082\u3001\u4ECA\u306F\u3057\u306E\u3052\u308B\u3060\u308D\u3046\u3002"
    Text_Es: "podr\xEDamos seguir adelante por ahora."
    Text_Pt: "poder\xEDamos aguentar por enquanto."
    Text_Ru: "\u0418 \u0445\u043E\u0442\u044F \u0431\u044B \u043F\u043E\u043A\u0430
      \u043C\u044B \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u0441\u044F."
  - ID: Chapter_5_Front_36
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uAD00\uCE21 \uC218\uCCA9\uC744 \uD3BC\uCCE4\uB2E4."
    Text_En: I opened my stargazing notebook.
    Text_ZhHans: "\u6211\u7FFB\u5F00\u89C2\u6D4B\u7B14\u8BB0\u3002"
    Text_Ja: "\u79C1\u306F\u89B3\u6E2C\u624B\u5E33\u3092\u958B\u3044\u305F\u3002"
    Text_Es: "Abr\xED mi cuaderno de observaci\xF3n."
    Text_Pt: "Abri meu caderno de observa\xE7\xE3o."
    Text_Ru: "\u042F \u043E\u0442\u043A\u0440\u044B\u043B \u0436\u0443\u0440\u043D\u0430\u043B
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439."
  - ID: Chapter_5_Front_37
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uCC3E\uC544\uB454 \uBCC4 \uBA87 \uAC1C\uB9CC \uC810\uC73C\uB85C \uB0A8\uC544
      \uC788\uC5C8\uB2E4."
    Text_En: The stars I'd found were still just dots.
    Text_ZhHans: "\u627E\u5230\u7684\u51E0\u9897\u661F\uFF0C\u8FD8\u53EA\u662F\u4E00\u4E9B\u70B9\u3002"
    Text_Ja: "\u898B\u3064\u3051\u305F\u661F\u304C\u3001\u3044\u304F\u3064\u304B\u70B9\u3067\u6B8B\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "Las estrellas que hall\xE9 segu\xEDan siendo puntos."
    Text_Pt: "As estrelas que achei ainda eram s\xF3 pontos."
    Text_Ru: "\u041D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u0437\u0432\u0451\u0437\u0434\u044B
      \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C \u0442\u043E\u0447\u043A\u0430\u043C\u0438."
  - ID: Chapter_5_Front_38
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB098\uAC00\uAE30 \uC804\uC5D0 \uC774\uAC83\uB9CC\uC740 \uB9C8\uC800
      \uADF8\uB824\uB450\uC790."
    Text_En: I'd finish this drawing before I left.
    Text_ZhHans: "\u51FA\u95E8\u524D\uFF0C\u81F3\u5C11\u628A\u8FD9\u5E45\u56FE\u753B\u5B8C\u5427\u3002"
    Text_Ja: "\u51FA\u304B\u3051\u308B\u524D\u306B\u3001\u3053\u308C\u3060\u3051\u306F\u63CF\u304D\u7D42\u3048\u3088\u3046\u3002"
    Text_Es: "Antes de salir, terminar\xEDa este dibujo."
    Text_Pt: Antes de sair, terminaria este desenho.
    Text_Ru: "\u041F\u0435\u0440\u0435\u0434 \u0443\u0445\u043E\u0434\u043E\u043C
      \u0437\u0430\u043A\u043E\u043D\u0447\u0443 \u0445\u043E\u0442\u044F \u0431\u044B
      \u0440\u0438\u0441\u0443\u043D\u043E\u043A."
  - ID: Chapter_5_Front_39
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uB9DD\uC6D0\uACBD \uC606\uC758 \uADF8\uB9BC\uACFC \uD558\uB298\uC744
      \uBC88\uAC08\uC544 \uBCF4\uBA70,"
    Text_En: Looking from the chart to the sky,
    Text_ZhHans: "\u6211\u5BF9\u7167\u671B\u8FDC\u955C\u65C1\u7684\u56FE\u548C\u5929\u7A7A\uFF0C"
    Text_Ja: "\u305D\u3070\u306B\u7F6E\u3044\u305F\u661F\u56F3\u3068\u7A7A\u3092\u898B\u6BD4\u3079\u3001"
    Text_Es: Alternando entre el mapa y el cielo,
    Text_Pt: "Olhando do mapa para o c\xE9u,"
    Text_Ru: "\u0421\u0432\u0435\u0440\u044F\u044F \u043A\u0430\u0440\u0442\u0443
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u043E\u043C
      \u0438 \u043D\u0435\u0431\u043E,"
  - ID: Chapter_5_Front_40
    Chapter_Id: 5_Front
    Speaker: Father
    Text_Kr: "\uBCC4 \uC0AC\uC774\uB97C \uCC9C\uCC9C\uD788 \uC774\uC5B4\uAC14\uB2E4."
    Text_En: I slowly connected the stars.
    Text_ZhHans: "\u6162\u6162\u8FDE\u8D77\u661F\u661F\u3002"
    Text_Ja: "\u3086\u3063\u304F\u308A\u661F\u3092\u3064\u306A\u3044\u3067\u3044\u3063\u305F\u3002"
    Text_Es: fui uniendo las estrellas despacio.
    Text_Pt: fui ligando as estrelas devagar.
    Text_Ru: "\u044F \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u043B
      \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: Chapter_5_Back_1
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB36E\uAC1C \uC704\uC5D0 \uBA3C\uC9C0\uAC00 \uC549\uC544 \uC788\uC5C8\uB2E4."
    Text_En: Dust lay on the cover.
    Text_ZhHans: "\u9632\u5C18\u7F69\u4E0A\u79EF\u7740\u7070\u3002"
    Text_Ja: "\u30AB\u30D0\u30FC\u306B\u307B\u3053\u308A\u304C\u7A4D\u3082\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "Hab\xEDa polvo sobre la funda."
    Text_Pt: Havia poeira sobre a capa.
    Text_Ru: "\u041D\u0430 \u0447\u0435\u0445\u043B\u0435 \u043B\u0435\u0436\u0430\u043B\u0430
      \u043F\u044B\u043B\u044C."
  - ID: Chapter_5_Back_2
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB9DD\uC6D0\uACBD\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB4E4\uC5EC\uB2E4\uBCF8
      \uB0A0\uC774"
    Text_En: I couldn't remember
    Text_ZhHans: "\u6211\u5DF2\u7ECF\u60F3\u4E0D\u8D77\uFF0C"
    Text_Ja: "\u6700\u5F8C\u306B\u671B\u9060\u93E1\u3092\u306E\u305E\u3044\u305F\u306E\u304C\u3001"
    Text_Es: No recordaba
    Text_Pt: "Eu n\xE3o lembrava"
    Text_Ru: "\u042F \u0443\u0436\u0435 \u043D\u0435 \u043F\u043E\u043C\u043D\u0438\u043B,"
  - ID: Chapter_5_Back_3
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC5B8\uC81C\uC600\uB294\uC9C0 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC558\uB2E4."
    Text_En: the last time I'd used the telescope.
    Text_ZhHans: "\u4E0A\u6B21\u7528\u671B\u8FDC\u955C\u662F\u4EC0\u4E48\u65F6\u5019\u3002"
    Text_Ja: "\u3044\u3064\u3060\u3063\u305F\u304B\u601D\u3044\u51FA\u305B\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "cu\xE1ndo mir\xE9 por el telescopio por \xFAltima vez."
    Text_Pt: "quando usara o telesc\xF3pio pela \xFAltima vez."
    Text_Ru: "\u043A\u043E\u0433\u0434\u0430 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437 \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0432 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F."
  - ID: Chapter_5_Back_4
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uD55C\uB54C\uB294 \uC774 \uC55E\uC5D0 \uC549\uC544"
    Text_En: Once, I'd sit here
    Text_ZhHans: "\u66FE\u7ECF\u5750\u5728\u8FD9\u91CC\u65F6\uFF0C"
    Text_Ja: "\u304B\u3064\u3066\u306F\u3001\u3053\u306E\u524D\u306B\u5EA7\u308A\u3001"
    Text_Es: "Antes me sentaba frente a \xE9l"
    Text_Pt: "J\xE1 houve um tempo em que eu sentava ali"
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044F \u0441\u0438\u0434\u0435\u043B
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C"
  - ID: Chapter_5_Back_5
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uBC24\uC774 \uC9E7\uB2E4\uACE0 \uC0DD\uAC01\uD55C \uC801\uB3C4 \uC788\uC5C8\uB2E4."
    Text_En: and wish the nights were longer.
    Text_ZhHans: "\u6211\u8FD8\u5ACC\u591C\u665A\u592A\u77ED\u3002"
    Text_Ja: "\u591C\u306F\u77ED\u3044\u3068\u601D\u3063\u305F\u3053\u3068\u3082\u3042\u3063\u305F\u3002"
    Text_Es: y pensaba que la noche era muy corta.
    Text_Pt: e achava as noites curtas demais.
    Text_Ru: "\u0438 \u0434\u0443\u043C\u0430\u043B, \u043A\u0430\u043A \u043A\u043E\u0440\u043E\u0442\u043A\u0430
      \u043D\u043E\u0447\u044C."
  - ID: Chapter_5_Back_6
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC544\uB0B4\uAC00 \uBCD1\uC6D0\uC5D0 \uB4E4\uC5B4\uAC04 \uB4A4\uB85C\uB294"
    Text_En: Since my wife went into hospital,
    Text_ZhHans: "\u81EA\u4ECE\u59BB\u5B50\u4F4F\u9662\u540E\uFF0C"
    Text_Ja: "\u59BB\u304C\u5165\u9662\u3057\u3066\u304B\u3089\u306F\u3001"
    Text_Es: Desde que hospitalizaron a mi esposa,
    Text_Pt: Desde que minha esposa foi internada,
    Text_Ru: "\u0421 \u0442\u0435\u0445 \u043F\u043E\u0440 \u043A\u0430\u043A \u0436\u0435\u043D\u0430
      \u043F\u043E\u043F\u0430\u043B\u0430 \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443,"
  - ID: Chapter_5_Back_7
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB9C8\uC74C \uB193\uACE0 \uBCC4\uC744 \uBCF4\uB358 \uB0A0\uC774 \uB4DC\uBB3C\uC5C8\uB2E4."
    Text_En: I'd rarely watched the stars in peace.
    Text_ZhHans: "\u5C31\u5F88\u5C11\u80FD\u5B89\u5FC3\u770B\u661F\u661F\u4E86\u3002"
    Text_Ja: "\u5FC3\u5B89\u3089\u304B\u306B\u661F\u3092\u898B\u308B\u65E5\u306F\u5C11\u306A\u304B\u3063\u305F\u3002"
    Text_Es: pocas veces pude mirar el cielo en paz.
    Text_Pt: raramente olhava as estrelas em paz.
    Text_Ru: "\u0440\u0435\u0434\u043A\u043E \u0443\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044C
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0437\u0432\u0451\u0437\u0434\u044B
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
  - ID: Chapter_5_Back_8
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uADF8\uB54C\uB294 \uB3C8\uB9CC \uC788\uC73C\uBA74 \uB418\uB294 \uC904
      \uC54C\uC558\uB2E4."
    Text_En: Back then, I thought money was enough.
    Text_ZhHans: "\u90A3\u65F6\uFF0C\u6211\u4EE5\u4E3A\u53EA\u8981\u6709\u94B1\u5C31\u591F\u4E86\u3002"
    Text_Ja: "\u3042\u306E\u9803\u306F\u3001\u91D1\u3055\u3048\u3042\u308C\u3070\u3068\u601D\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "Entonces cre\xEDa que bastaba con tener dinero."
    Text_Pt: "Na \xE9poca, achei que bastava ter dinheiro."
    Text_Ru: "\u0422\u043E\u0433\u0434\u0430 \u044F \u0434\u0443\u043C\u0430\u043B:
      \u0431\u044B\u043B\u0438 \u0431\u044B \u0434\u0435\u043D\u044C\u0433\u0438."
  - ID: Chapter_5_Back_9
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uCE58\uB8CC\uB97C \uACC4\uC18D\uD558\uBA74 \uB098\uC544\uC9C8 \uAC70\uB77C\uACE0,"
    Text_En: If she could keep getting treatment,
    Text_ZhHans: "\u53EA\u8981\u7EE7\u7EED\u6CBB\u7597\uFF0C\u5979\u5C31\u4F1A\u597D\u8D77\u6765\u3002"
    Text_Ja: "\u6CBB\u7642\u3092\u7D9A\u3051\u308C\u3070\u3001\u3088\u304F\u306A\u308B\u3002"
    Text_Es: "Si segu\xEDa el tratamiento, mejorar\xEDa."
    Text_Pt: Com mais tratamento, ela melhoraria.
    Text_Ru: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043C \u043B\u0435\u0447\u0435\u043D\u0438\u0435
      \u2014 \u0435\u0439 \u0441\u0442\u0430\u043D\u0435\u0442 \u043B\u0443\u0447\u0448\u0435."
  - ID: Chapter_5_Back_10
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC870\uAE08\uB9CC \uB354 \uBC84\uD2F0\uBA74 \uB41C\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB2E4."
    Text_En: if we could hold on a little longer.
    Text_ZhHans: "\u53EA\u8981\u518D\u6491\u4E00\u4F1A\u513F\u5C31\u597D\u3002"
    Text_Ja: "\u3082\u3046\u5C11\u3057\u8010\u3048\u308C\u3070\u3044\u3044\u306E\u3060\u3068\u3002"
    Text_Es: "Solo ten\xEDamos que aguantar un poco m\xE1s."
    Text_Pt: "S\xF3 precis\xE1vamos aguentar um pouco mais."
    Text_Ru: "\u041D\u0430\u0434\u043E \u043B\u0438\u0448\u044C \u0435\u0449\u0451
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0442\u0435\u0440\u043F\u0435\u0442\u044C."
  - ID: Chapter_5_Back_11
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC544\uB0B4\uAC00 \uC8FD\uC740 \uB4A4\uC5D0\uB3C4 \uBE5A\uC740 \uB0A8\uC558\uB2E4."
    Text_En: After she died, the debts remained.
    Text_ZhHans: "\u59BB\u5B50\u53BB\u4E16\u540E\uFF0C\u503A\u52A1\u8FD8\u5728\u3002"
    Text_Ja: "\u59BB\u304C\u6B7B\u3093\u3067\u3082\u3001\u501F\u91D1\u306F\u6B8B\u3063\u305F\u3002"
    Text_Es: "Mi esposa muri\xF3, pero las deudas quedaron."
    Text_Pt: "Minha esposa morreu, mas as d\xEDvidas ficaram."
    Text_Ru: "\u0416\u0435\u043D\u0430 \u0443\u043C\u0435\u0440\u043B\u0430, \u043D\u043E
      \u0434\u043E\u043B\u0433\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C."
  - ID: Chapter_5_Back_12
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uADF8\uB9AC\uACE0 \uC544\uC774\uAC00 \uB0A8\uC558\uB2E4."
    Text_En: And so did our daughter.
    Text_ZhHans: "\u5973\u513F\u4E5F\u8FD8\u5728\u3002"
    Text_Ja: "\u305D\u3057\u3066\u3001\u5A18\u304C\u6B8B\u3063\u305F\u3002"
    Text_Es: "Y tambi\xE9n mi hija."
    Text_Pt: "E minha filha tamb\xE9m."
    Text_Ru: "\u0418 \u0434\u043E\u0447\u044C \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C."
  - ID: Chapter_5_Back_13
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uD63C\uC790\uC11C\uB3C4 \uBD80\uC871\uD568 \uC5C6\uC774 \uD0A4\uC6CC\uC57C
      \uD588\uB2E4."
    Text_En: I had to give her everything, alone.
    Text_ZhHans: "\u5C31\u7B97\u72EC\u81EA\u629A\u517B\uFF0C\u4E5F\u4E0D\u80FD\u8BA9\u5979\u7F3A\u4EC0\u4E48\u3002"
    Text_Ja: "\u4E00\u4EBA\u3067\u3082\u3001\u4E0D\u81EA\u7531\u306A\u304F\u80B2\u3066\u306A\u3051\u308C\u3070\u3002"
    Text_Es: "Deb\xEDa criarla sin que le faltara nada."
    Text_Pt: "Eu tinha que cri\xE1-la sem deixar faltar nada."
    Text_Ru: "\u042F \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0432\u044B\u0440\u0430\u0441\u0442\u0438\u0442\u044C
      \u0435\u0451 \u0431\u0435\u0437 \u043D\u0443\u0436\u0434\u044B."
  - ID: Chapter_5_Back_14
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC801\uC5B4\uB3C4 \uB098\uB294 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uACE0
      \uB2E4\uB154\uB2E4."
    Text_En: At least, that was what I told myself.
    Text_ZhHans: "\u81F3\u5C11\uFF0C\u6211\u4E00\u76F4\u8FD9\u6837\u544A\u8BC9\u81EA\u5DF1\u3002"
    Text_Ja: "\u5C11\u306A\u304F\u3068\u3082\u3001\u305D\u3046\u81EA\u5206\u306B\u8A00\u3044\u805E\u304B\u305B\u3066\u3044\u305F\u3002"
    Text_Es: "Al menos, eso me repet\xEDa."
    Text_Pt: Ao menos, era o que eu dizia a mim mesmo.
    Text_Ru: "\u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435,
      \u0442\u0430\u043A \u044F \u0441\u0435\u0431\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B."
  - ID: Chapter_5_Back_15
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uBB3B\uC5B4\uC8FC\uB294 \uC77C\uB9CC\uC73C\uB85C\uB294 \uBD80\uC871\uD558\uB2E4\uACE0
      \uB290\uAF08\uC744 \uB54C,"
    Text_En: When burying bodies no longer felt enough,
    Text_ZhHans: "\u5F53\u6211\u89C9\u5F97\u5149\u9760\u57CB\u5C38\u4E0D\u591F\u65F6\uFF0C"
    Text_Ja: "\u57CB\u3081\u308B\u4ED5\u4E8B\u3060\u3051\u3067\u306F\u8DB3\u308A\u306A\u3044\u3068\u601D\u3063\u305F\u9803\u3001"
    Text_Es: "Cuando enterrar cuerpos dej\xF3 de parecer suficiente,"
    Text_Pt: "Quando enterrar corpos j\xE1 n\xE3o parecia suficiente,"
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430 \u0434\u0435\u043D\u0435\u0433 \u0437\u0430
      \u0437\u0430\u0445\u043E\u0440\u043E\u043D\u0435\u043D\u0438\u044F \u0441\u0442\u0430\u043B\u043E
      \u043C\u0430\u043B\u043E,"
  - ID: Chapter_5_Back_16
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uADF8\uB4E4\uC740 \uB2E4\uB978 \uC77C\uC744 \uC81C\uC548\uD588\uB2E4."
    Text_En: they offered me another job.
    Text_ZhHans: "\u4ED6\u4EEC\u63D0\u51FA\u4E86\u53E6\u4E00\u4EFD\u5DE5\u4F5C\u3002"
    Text_Ja: "\u5F7C\u3089\u306F\u5225\u306E\u4ED5\u4E8B\u3092\u6301\u3061\u304B\u3051\u305F\u3002"
    Text_Es: me ofrecieron otro trabajo.
    Text_Pt: eles ofereceram outro trabalho.
    Text_Ru: "\u043E\u043D\u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438
      \u0434\u0440\u0443\u0433\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443."
  - ID: Chapter_5_Back_17
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC774\uBC88\uC5D0\uB294 \uB0B4\uAC00 \uC9C1\uC811 \uC8FD\uC774\uB294
      \uC77C\uC774\uC5C8\uB2E4."
    Text_En: This time, I would do the killing.
    Text_ZhHans: "\u8FD9\u6B21\uFF0C\u8981\u7531\u6211\u4EB2\u624B\u6740\u4EBA\u3002"
    Text_Ja: "\u4ECA\u5EA6\u306F\u3001\u79C1\u304C\u76F4\u63A5\u6BBA\u3059\u4ED5\u4E8B\u3060\u3063\u305F\u3002"
    Text_Es: "Esta vez, yo tendr\xEDa que matar."
    Text_Pt: Desta vez, eu teria que matar.
    Text_Ru: "\u0422\u0435\u043F\u0435\u0440\u044C \u0443\u0431\u0438\u0432\u0430\u0442\u044C
      \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u044F\u043B\u043E \u043C\u043D\u0435."
  - ID: Chapter_5_Back_18
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB354 \uB9CE\uC740 \uB3C8\uC744 \uBC1B\uC744 \uC218 \uC788\uC5C8\uB2E4."
    Text_En: It paid more.
    Text_ZhHans: "\u80FD\u62FF\u5230\u66F4\u591A\u94B1\u3002"
    Text_Ja: "\u3082\u3063\u3068\u91D1\u304C\u3082\u3089\u3048\u308B\u3002"
    Text_Es: "Me pagar\xEDan m\xE1s."
    Text_Pt: Pagariam mais.
    Text_Ru: "\u0417\u0430 \u044D\u0442\u043E \u043F\u043B\u0430\u0442\u0438\u043B\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435."
  - ID: Chapter_5_Back_19
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uD558\uC9C0\uB9CC \uC0AC\uB78C\uC744 \uC8FD\uC774\uB77C\uB2C8 \uB9D0\uB3C4
      \uC548 \uB418\uB294 \uC77C\uC774\uC5C8\uB2E4."
    Text_En: But killing someone was unthinkable.
    Text_ZhHans: "\u53EF\u6740\u4EBA\uFF0C\u5B9E\u5728\u662F\u65E0\u6CD5\u63A5\u53D7\u7684\u4E8B\u3002"
    Text_Ja: "\u3060\u304C\u3001\u4EBA\u3092\u6BBA\u3059\u306A\u3069\u3042\u308A\u3048\u306A\u304B\u3063\u305F\u3002"
    Text_Es: Pero matar a alguien era impensable.
    Text_Pt: "Mas matar algu\xE9m era impens\xE1vel."
    Text_Ru: "\u041D\u043E \u0443\u0431\u0438\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0431\u044B\u043B\u043E \u043D\u0435\u043C\u044B\u0441\u043B\u0438\u043C\u043E."
  - ID: Chapter_5_Back_20
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uAC70\uC808\uD558\uB824\uACE0 \uD558\uB2C8 \uADF8\uB4E4\uC740 \uB418\uB824
      \uD611\uBC15\uD588\uB2E4"
    Text_En: When I tried to refuse, they threatened me.
    Text_ZhHans: "\u6211\u60F3\u62D2\u7EDD\uFF0C\u4ED6\u4EEC\u5374\u53CD\u8FC7\u6765\u5A01\u80C1\u6211\u3002"
    Text_Ja: "\u65AD\u308D\u3046\u3068\u3059\u308B\u3068\u3001\u5F7C\u3089\u306F\u8105\u3057\u3066\u304D\u305F\u3002"
    Text_Es: Al intentar negarme, me amenazaron.
    Text_Pt: "Quando tentei recusar, me amea\xE7aram."
    Text_Ru: "\u042F \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F,
      \u0430 \u043E\u043D\u0438 \u0441\u0442\u0430\u043B\u0438 \u0443\u0433\u0440\u043E\u0436\u0430\u0442\u044C."
  - ID: Chapter_5_Back_21
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB538\uAE4C\uC9C0 \uC783\uACE0 \uC2F6\uB0D0\uACE0..."
    Text_En: Did I want to lose my daughter, too?
    Text_ZhHans: "\u95EE\u6211\u662F\u4E0D\u662F\u8FDE\u5973\u513F\u4E5F\u4E0D\u60F3\u8981\u4E86\u2026\u2026"
    Text_Ja: "\u5A18\u307E\u3067\u5931\u3044\u305F\u3044\u306E\u304B\u3068\u2026\u2026"
    Text_Es: "\xBFTambi\xE9n quer\xEDa perder a mi hija...?"
    Text_Pt: "Eu queria perder minha filha tamb\xE9m...?"
    Text_Ru: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u044F \u0445\u043E\u0447\u0443
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0435\u0449\u0451 \u0438
      \u0434\u043E\u0447\u044C..."
  - ID: Chapter_5_Back_22
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC5B4\uCA54 \uC218 \uC5C6\uC774 \uBC1B\uC544\uB4E4\uC600\uB2E4"
    Text_En: I felt I had no choice but to agree.
    Text_ZhHans: "\u6211\u53EA\u80FD\u7B54\u5E94\u3002"
    Text_Ja: "\u4ED5\u65B9\u306A\u304F\u3001\u5F15\u304D\u53D7\u3051\u305F\u3002"
    Text_Es: "No tuve m\xE1s remedio que aceptar."
    Text_Pt: "N\xE3o tive escolha a n\xE3o ser aceitar."
    Text_Ru: "\u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F."
  - ID: Chapter_5_Back_23
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB538\uC744 \uC704\uD574\uC11C\uB77C\uBA74 \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uB2E4."
    Text_En: For her sake, I had no choice.
    Text_ZhHans: "\u4E3A\u4E86\u5973\u513F\uFF0C\u6211\u522B\u65E0\u9009\u62E9\u3002"
    Text_Ja: "\u5A18\u306E\u305F\u3081\u306A\u3089\u3001\u4ED5\u65B9\u304C\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Por mi hija, no hab\xEDa otra opci\xF3n."
    Text_Pt: "Pela minha filha, n\xE3o havia outra op\xE7\xE3o."
    Text_Ru: "\u0420\u0430\u0434\u0438 \u0434\u043E\u0447\u0435\u0440\u0438 \u0443
      \u043C\u0435\u043D\u044F \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u044B\u0431\u043E\u0440\u0430."
  - ID: Chapter_5_Back_24
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC774\uBC88\uAE4C\uC9C0\uB9CC."
    Text_En: Just this once.
    Text_ZhHans: "\u5C31\u8FD9\u6700\u540E\u4E00\u6B21\u3002"
    Text_Ja: "\u3053\u308C\u3067\u6700\u5F8C\u3060\u3002"
    Text_Es: Solo esta vez.
    Text_Pt: "S\xF3 desta vez."
    Text_Ru: "\u0422\u043E\u043B\u044C\u043A\u043E \u0432 \u044D\u0442\u043E\u0442
      \u0440\u0430\u0437."
  - ID: Chapter_5_Back_25
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC774 \uB9D0\uC744 \uBA87 \uBC88\uC774\uB098 \uB418\uD480\uC774\uD588\uB294\uC9C0"
    Text_En: I'd said it so many times
    Text_ZhHans: "\u8FD9\u53E5\u8BDD\u91CD\u590D\u8FC7\u591A\u5C11\u904D\uFF0C"
    Text_Ja: "\u305D\u306E\u8A00\u8449\u3092\u4F55\u5EA6\u7E70\u308A\u8FD4\u3057\u305F\u304B\u3001"
    Text_Es: "Hab\xEDa repetido esas palabras"
    Text_Pt: Eu tinha repetido essas palavras
    Text_Ru: "\u042F \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B \u044D\u0442\u0438
      \u0441\u043B\u043E\u0432\u0430"
  - ID: Chapter_5_Back_26
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC774\uC81C\uB294 \uC140 \uC218\uB3C4 \uC5C6\uC5C8\uB2E4."
    Text_En: I'd lost count.
    Text_ZhHans: "\u6211\u5DF2\u7ECF\u6570\u4E0D\u6E05\u4E86\u3002"
    Text_Ja: "\u3082\u3046\u6570\u3048\u304D\u308C\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "tantas veces que perd\xED la cuenta."
    Text_Pt: tantas vezes que perdi a conta.
    Text_Ru: "\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437, \u0447\u0442\u043E
      \u0443\u0436\u0435 \u0441\u0431\u0438\u043B\u0441\u044F \u0441\u043E \u0441\u0447\u0451\u0442\u0430."
  - ID: Chapter_5_Back_27
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uAC11\uC790\uAE30 \uC804\uD654\uAC00 \uC6B8\uB838\uB2E4."
    Text_En: Suddenly, the phone rang.
    Text_ZhHans: "\u7535\u8BDD\u7A81\u7136\u54CD\u4E86\u3002"
    Text_Ja: "\u7A81\u7136\u3001\u96FB\u8A71\u304C\u9CF4\u3063\u305F\u3002"
    Text_Es: "De pronto son\xF3 el tel\xE9fono."
    Text_Pt: De repente, o telefone tocou.
    Text_Ru: "\u0412\u0434\u0440\u0443\u0433 \u0437\u0430\u0437\u0432\u043E\u043D\u0438\u043B
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D."
  - ID: Chapter_5_Back_28
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC77C\uC744 \uB9E1\uAE30\uB358 \uC0AC\uB78C\uC774\uC5C8\uB2E4."
    Text_En: It was the man who gave me work.
    Text_ZhHans: "\u662F\u4E00\u76F4\u7ED9\u6211\u6D3E\u6D3B\u7684\u4EBA\u3002"
    Text_Ja: "\u4ED5\u4E8B\u3092\u56DE\u3057\u3066\u304F\u308B\u7537\u3060\u3063\u305F\u3002"
    Text_Es: Era el hombre que me daba trabajo.
    Text_Pt: Era o homem que me dava trabalho.
    Text_Ru: "\u042D\u0442\u043E \u0431\u044B\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0434\u0430\u0432\u0430\u0432\u0448\u0438\u0439 \u043C\u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0443."
  - ID: Chapter_5_Back_29
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC804\uD654 \uB108\uBA38\uC5D0\uC11C \uC624\uB298 \uB9CC\uB098\uC790\uB294
      \uB9D0\uC774 \uB4E4\uB838\uB2E4."
    Text_En: He wanted to meet today.
    Text_ZhHans: "\u4ED6\u8BF4\uFF0C\u4ECA\u5929\u60F3\u89C1\u4E00\u9762\u3002"
    Text_Ja: "\u4ECA\u65E5\u3001\u4F1A\u3044\u305F\u3044\u3068\u8A00\u3046\u3002"
    Text_Es: "Quer\xEDa verme ese d\xEDa."
    Text_Pt: Ele queria me encontrar naquele dia.
    Text_Ru: "\u041E\u043D \u0445\u043E\u0442\u0435\u043B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F."
  - ID: Chapter_5_Back_30
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uBB34\uC2A8 \uC77C\uC774\uB0D0\uACE0 \uBB3C\uC5C8\uB2E4."
    Text_En: I asked what it was about.
    Text_ZhHans: "\u6211\u95EE\u6709\u4EC0\u4E48\u4E8B\u3002"
    Text_Ja: "\u4F55\u306E\u7528\u304B\u3068\u5C0B\u306D\u305F\u3002"
    Text_Es: "Pregunt\xE9 para qu\xE9."
    Text_Pt: Perguntei sobre o que era.
    Text_Ru: "\u042F \u0441\u043F\u0440\u043E\u0441\u0438\u043B, \u0432 \u0447\u0451\u043C
      \u0434\u0435\u043B\u043E."
  - ID: Chapter_5_Back_31
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC624\uB298\uC740 \uC77C\uC744 \uB9E1\uAE30\uB824\uB294 \uAC8C \uC544\uB2C8\uB77C\uACE0
      \uD588\uB2E4."
    Text_En: Not another job, he said.
    Text_ZhHans: "\u4ED6\u8BF4\uFF0C\u4ECA\u5929\u4E0D\u662F\u8981\u7ED9\u6211\u6D3E\u6D3B\u3002"
    Text_Ja: "\u4ECA\u65E5\u306F\u4ED5\u4E8B\u306E\u8A71\u3067\u306F\u306A\u3044\u3068\u8A00\u3063\u305F\u3002"
    Text_Es: Dijo que no era otro encargo.
    Text_Pt: "Disse que n\xE3o era outro servi\xE7o."
    Text_Ru: "\u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435 \u043F\u043E \u0440\u0430\u0431\u043E\u0442\u0435."
  - ID: Chapter_5_Back_32
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB2F9\uBD84\uAC04 \uC5F0\uB77D\uD558\uC9C0 \uBABB\uD560 \uAC83 \uAC19\uC73C\uB2C8"
    Text_En: He'd be out of touch for a while.
    Text_ZhHans: "\u63A5\u4E0B\u6765\u53EF\u80FD\u6709\u4E00\u9635\u5B50\u8054\u7CFB\u4E0D\u4E0A\uFF0C"
    Text_Ja: "\u3057\u3070\u3089\u304F\u9023\u7D61\u304C\u53D6\u308C\u306A\u304F\u306A\u308B\u306E\u3067\u3001"
    Text_Es: "Estar\xEDa un tiempo sin poder contactar,"
    Text_Pt: Ficaria um tempo sem poder falar comigo,
    Text_Ru: "\u041A\u0430\u043A\u043E\u0435-\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D,"
  - ID: Chapter_5_Back_33
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uADF8 \uC804\uC5D0 \uC5BC\uAD74\uC744 \uBCF4\uACE0 \uD560 \uC774\uC57C\uAE30\uAC00
      \uC788\uB2E4\uACE0."
    Text_En: Before that, he wanted to talk in person.
    Text_ZhHans: "\u6240\u4EE5\u60F3\u5728\u90A3\u4E4B\u524D\u5F53\u9762\u8C08\u8C08\u3002"
    Text_Ja: "\u305D\u306E\u524D\u306B\u3001\u4F1A\u3063\u3066\u8A71\u3057\u305F\u3044\u3053\u3068\u304C\u3042\u308B\u3068\u3002"
    Text_Es: "y antes quer\xEDa hablar en persona."
    Text_Pt: e antes queria conversar pessoalmente.
    Text_Ru: "\u0438 \u043F\u0435\u0440\u0435\u0434 \u044D\u0442\u0438\u043C \u0445\u043E\u0447\u0435\u0442
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043B\u0438\u0447\u043D\u043E."
  - ID: Chapter_5_Back_34
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC804\uD654\uB85C \uD558\uBA74 \uC548 \uB418\uB0D0\uACE0 \uBB3C\uC5C8\uC9C0\uB9CC,"
    Text_En: I asked why not over the phone.
    Text_ZhHans: "\u6211\u95EE\uFF0C\u4E0D\u80FD\u5728\u7535\u8BDD\u91CC\u8BF4\u5417\uFF1F"
    Text_Ja: "\u96FB\u8A71\u3067\u306F\u99C4\u76EE\u306A\u306E\u304B\u3068\u805E\u3044\u305F\u304C\u3001"
    Text_Es: "Pregunt\xE9 por qu\xE9 no hacerlo por tel\xE9fono."
    Text_Pt: "Perguntei se n\xE3o podia ser por telefone."
    Text_Ru: "\u042F \u0441\u043F\u0440\u043E\u0441\u0438\u043B, \u043F\u043E\u0447\u0435\u043C\u0443
      \u043D\u0435 \u043F\u043E \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443."
  - ID: Chapter_5_Back_35
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uAE38\uAC8C \uAC78\uB9AC\uC9C0 \uC54A\uB294\uB2E4\uB294 \uB9D0\uB9CC
      \uB3CC\uC544\uC654\uB2E4."
    Text_En: He only said it wouldn't take long.
    Text_ZhHans: "\u4ED6\u53EA\u56DE\u7B54\uFF0C\u4E0D\u4F1A\u803D\u8BEF\u592A\u4E45\u3002"
    Text_Ja: "\u9577\u304F\u306F\u304B\u304B\u3089\u306A\u3044\u3068\u3057\u304B\u7B54\u3048\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Solo dijo que no tardar\xEDa."
    Text_Pt: "S\xF3 respondeu que n\xE3o demoraria."
    Text_Ru: "\u0412 \u043E\u0442\u0432\u0435\u0442 \u043B\u0438\u0448\u044C: \u044D\u0442\u043E
      \u043D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E."
  - ID: Chapter_5_Back_36
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB098\uB294 \uC54C\uACA0\uB2E4\uACE0 \uD588\uB2E4."
    Text_En: I agreed.
    Text_ZhHans: "\u6211\u7B54\u5E94\u4E86\u3002"
    Text_Ja: "\u79C1\u306F\u5206\u304B\u3063\u305F\u3068\u7B54\u3048\u305F\u3002"
    Text_Es: "Acept\xE9."
    Text_Pt: Eu aceitei.
    Text_Ru: "\u042F \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F."
  - ID: Chapter_5_Back_37
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC774\uBC88\uC5D0\uC57C\uB9D0\uB85C \uADF8\uB9CC\uB450\uACA0\uB2E4\uACE0
      \uB9D0\uD574\uC57C \uD588\uB2E4."
    Text_En: This time, I'd tell him I was done.
    Text_ZhHans: "\u8FD9\u6B21\u4E00\u5B9A\u8981\u544A\u8BC9\u4ED6\uFF0C\u6211\u4E0D\u5E72\u4E86\u3002"
    Text_Ja: "\u4ECA\u5EA6\u3053\u305D\u3001\u8F9E\u3081\u308B\u3068\u8A00\u308F\u306A\u3051\u308C\u3070\u3002"
    Text_Es: "Esta vez le dir\xEDa que lo dejaba."
    Text_Pt: Desta vez, diria que estava fora.
    Text_Ru: "\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u0441\u043A\u0430\u0436\u0443,
      \u0447\u0442\u043E \u0443\u0445\u043E\u0436\u0443."
  - ID: Chapter_5_Back_38
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC5B8\uC81C\uAE4C\uC9C0 \uC5B4\uCA54 \uC218 \uC5C6\uB2E4\uB294 \uD551\uACC4\uB85C"
    Text_En: I couldn't keep doing his bidding,
    Text_ZhHans: "\u4E0D\u80FD\u4E00\u76F4\u62FF\u522B\u65E0\u9009\u62E9\u5F53\u501F\u53E3\uFF0C"
    Text_Ja: "\u3044\u3064\u307E\u3067\u3082\u4ED5\u65B9\u304C\u306A\u3044\u3068\u8A00\u3044\u8A33\u3057\u3066\u3001"
    Text_Es: "No pod\xEDa seguir obedeciendo"
    Text_Pt: "N\xE3o podia continuar obedecendo,"
    Text_Ru: "\u041D\u0435\u043B\u044C\u0437\u044F \u0432\u0435\u0447\u043D\u043E
      \u0441\u0441\u044B\u043B\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u0432\u044B\u0431\u043E\u0440\u0430"
  - ID: Chapter_5_Back_39
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC2DC\uD0A4\uB294 \uC77C\uC744 \uACC4\uC18D\uD560 \uC218\uB294 \uC5C6\uC5C8\uB2E4."
    Text_En: claiming I had no choice.
    Text_ZhHans: "\u7EE7\u7EED\u4EFB\u4EBA\u6446\u5E03\u3002"
    Text_Ja: "\u8A00\u308F\u308C\u308B\u307E\u307E\u306B\u50CD\u304F\u308F\u3051\u306B\u306F\u3044\u304B\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "con la excusa de no tener elecci\xF3n."
    Text_Pt: usando a falta de escolha como desculpa.
    Text_Ru: "\u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u0435\u0433\u043E \u043F\u0440\u0438\u043A\u0430\u0437\u044B."
  - ID: Chapter_5_Back_40
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uC81C\uBC1C \uC774 \uAD74\uB808\uB97C \uB05D\uB0BC \uC218 \uC788\uAE30\uB97C."
    Text_En: Please, let this be the end of it.
    Text_ZhHans: "\u4F46\u613F\u8FD9\u6B21\u80FD\u7ED3\u675F\u8FD9\u4E00\u5207\u3002"
    Text_Ja: "\u3069\u3046\u304B\u3001\u3053\u306E\u9023\u9396\u3092\u7D42\u308F\u3089\u305B\u3089\u308C\u307E\u3059\u3088\u3046\u306B\u3002"
    Text_Es: "Ojal\xE1 pudiera poner fin a todo esto."
    Text_Pt: Por favor, que eu consiga acabar com isso.
    Text_Ru: "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u0443\u0441\u0442\u044C
      \u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u0438\u0434\u0451\u0442 \u043A\u043E\u043D\u0435\u0446."
  - ID: Chapter_5_Back_41
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uBC29\uC744 \uB098\uC11C\uB2E4 \uB9DD\uC6D0\uACBD \uC55E\uC5D0\uC11C
      \uBA48\uCDC4\uB2E4."
    Text_En: On my way out, I paused by the telescope.
    Text_ZhHans: "\u79BB\u5F00\u623F\u95F4\u65F6\uFF0C\u6211\u5728\u671B\u8FDC\u955C\u524D\u505C\u4E0B\u3002"
    Text_Ja: "\u90E8\u5C4B\u3092\u51FA\u308B\u9014\u4E2D\u3001\u671B\u9060\u93E1\u306E\u524D\u3067\u6B62\u307E\u3063\u305F\u3002"
    Text_Es: Al salir, me detuve ante el telescopio.
    Text_Pt: "Ao sair, parei diante do telesc\xF3pio."
    Text_Ru: "\u0412\u044B\u0445\u043E\u0434\u044F, \u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u0443 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0430."
  - ID: Chapter_5_Back_42
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uB2E4\uC2DC \uBCC4\uC744 \uBCFC \uC77C\uC774 \uC0DD\uACBC\uC73C\uBA74
      \uC88B\uACA0\uB2E4\uB294 \uC0DD\uAC01\uC744 \uD558\uBA70"
    Text_En: I hoped I'd look at the stars again.
    Text_ZhHans: "\u4F46\u613F\u8FD8\u6709\u673A\u4F1A\u518D\u770B\u661F\u661F\u3002"
    Text_Ja: "\u307E\u305F\u661F\u3092\u898B\u3089\u308C\u308B\u65E5\u304C\u6765\u308C\u3070\u3068\u601D\u3044\u3001"
    Text_Es: "Dese\xE9 volver a mirar las estrellas alg\xFAn d\xEDa."
    Text_Pt: Desejei poder olhar as estrelas outra vez.
    Text_Ru: "\u041F\u043E\u0434\u0443\u043C\u0430\u043B: \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0431\u044B \u0437\u0432\u0451\u0437\u0434\u044B \u0435\u0449\u0451 \u0445\u043E\u0442\u044C
      \u0440\u0430\u0437."
  - ID: Chapter_5_Back_43
    Chapter_Id: 5_Back
    Speaker: Father
    Text_Kr: "\uADF8\uB300\uB85C \uBC29\uC744 \uB098\uC130\uB2E4."
    Text_En: Then I left the room.
    Text_ZhHans: "\u62B1\u7740\u8FD9\u4E2A\u5FF5\u5934\uFF0C\u6211\u8D70\u51FA\u4E86\u623F\u95F4\u3002"
    Text_Ja: "\u305D\u306E\u307E\u307E\u90E8\u5C4B\u3092\u51FA\u305F\u3002"
    Text_Es: "Y sal\xED de la habitaci\xF3n."
    Text_Pt: "E sa\xED do quarto."
    Text_Ru: "\u0418 \u0432\u044B\u0448\u0435\u043B \u0438\u0437 \u043A\u043E\u043C\u043D\u0430\u0442\u044B."
  - ID: Chapter_6_Front_1
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC218\uCCA9\uC5D0 \uD45C\uC2DC\uB41C \uACF3\uC740 \uC804\uBD80 \uD655\uC778\uD588\uB098?"
    Text_En: Checked every place in the notebook?
    Text_ZhHans: "\u7B14\u8BB0\u91CC\u6807\u51FA\u7684\u5730\u65B9\u90FD\u67E5\u8FC7\u4E86\u5417\uFF1F"
    Text_Ja: "\u624B\u5E33\u306E\u5834\u6240\u306F\u3059\u3079\u3066\u78BA\u8A8D\u3057\u305F\u304B\uFF1F"
    Text_Es: "\xBFRevisaron todos los lugares del cuaderno?"
    Text_Pt: Verificaram todos os locais do caderno?
    Text_Ru: "\u0412\u0441\u0435 \u043C\u0435\u0441\u0442\u0430 \u0438\u0437 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438?"
  - ID: Chapter_6_Front_2
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uB124. \uD604\uC7A5\uB9C8\uB2E4 \uAC10\uC2DD\uC744 \uC9C4\uD589\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    Text_En: Yes. Forensics is at each site.
    Text_ZhHans: "\u662F\uFF0C\u5404\u5904\u73B0\u573A\u90FD\u5728\u8FDB\u884C\u9274\u5B9A\u3002"
    Text_Ja: "\u306F\u3044\u3002\u5404\u73FE\u5834\u3067\u9451\u8B58\u304C\u8ABF\u3079\u3066\u3044\u307E\u3059\u3002"
    Text_Es: "S\xED. Los forenses trabajan en cada uno."
    Text_Pt: "Sim. A per\xEDcia est\xE1 em cada um deles."
    Text_Ru: "\u0414\u0430. \u041D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u044B."
  - ID: Chapter_6_Front_3
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uAE30\uB85D\uACFC \uB9DE\uC9C0 \uC54A\uB294 \uBD80\uBD84\uC740?"
    Text_En: Anything that doesn't match?
    Text_ZhHans: "\u6709\u4EC0\u4E48\u548C\u8BB0\u5F55\u4E0D\u7B26\u7684\u5417\uFF1F"
    Text_Ja: "\u8A18\u9332\u3068\u5408\u308F\u306A\u3044\u70B9\u306F\uFF1F"
    Text_Es: "\xBFAlgo que no encaje con las notas?"
    Text_Pt: "Algo que n\xE3o bate com os registros?"
    Text_Ru: "\u0427\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0435
      \u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0441 \u0437\u0430\u043F\u0438\u0441\u044F\u043C\u0438?"
  - ID: Chapter_6_Front_4
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uB9E4\uC7A5\uB41C \uC2DC\uAE30\uB294 \uC11C\uB85C \uB2E4\uB985\uB2C8\uB2E4."
    Text_En: The burials happened at different times.
    Text_ZhHans: "\u57CB\u5C38\u65F6\u95F4\u5404\u4E0D\u76F8\u540C\u3002"
    Text_Ja: "\u57CB\u3081\u3089\u308C\u305F\u6642\u671F\u306F\u3001\u305D\u308C\u305E\u308C\u9055\u3044\u307E\u3059\u3002"
    Text_Es: Los cuerpos se enterraron en fechas distintas.
    Text_Pt: "Os corpos foram enterrados em \xE9pocas diferentes."
    Text_Ru: "\u0417\u0430\u0445\u043E\u0440\u043E\u043D\u0435\u043D\u0438\u044F
      \u0441\u0434\u0435\u043B\u0430\u043D\u044B \u0432 \u0440\u0430\u0437\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F."
  - ID: Chapter_6_Front_5
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uCD5C\uADFC\uC5D0 \uD759\uC744 \uD30C\uB0B8 \uD754\uC801\uB3C4 \uC788\uACE0\uC694."
    Text_En: Some sites were dug up recently, too.
    Text_ZhHans: "\u4E5F\u6709\u6700\u8FD1\u88AB\u6316\u5F00\u7684\u75D5\u8FF9\u3002"
    Text_Ja: "\u6700\u8FD1\u6398\u308A\u8FD4\u3055\u308C\u305F\u8DE1\u3082\u3042\u308A\u307E\u3059\u3002"
    Text_Es: "Tambi\xE9n hay excavaciones recientes."
    Text_Pt: "Tamb\xE9m h\xE1 escava\xE7\xF5es recentes."
    Text_Ru: "\u0415\u0441\u0442\u044C \u0438 \u0441\u043B\u0435\u0434\u044B \u043D\u0435\u0434\u0430\u0432\u043D\u0438\u0445
      \u0440\u0430\u0441\u043A\u043E\u043F\u043E\u043A."
  - ID: Chapter_6_Front_6
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uBB3B\uC740 \uC0AC\uB78C\uC774 \uB2E4\uC2DC \uCC3E\uC544\uC628 \uAC78\uAE4C\uC694?"
    Text_En: Did whoever buried them come back?
    Text_ZhHans: "\u662F\u57CB\u5C38\u7684\u4EBA\u56DE\u6765\u8FC7\u5417\uFF1F"
    Text_Ja: "\u57CB\u3081\u305F\u672C\u4EBA\u304C\u623B\u3063\u305F\u306E\u3067\u3057\u3087\u3046\u304B\uFF1F"
    Text_Es: "\xBFVolvi\xF3 quien los enterr\xF3?"
    Text_Pt: Quem os enterrou voltou depois?
    Text_Ru: "\u0422\u043E\u0442, \u043A\u0442\u043E \u0438\u0445 \u0437\u0430\u043A\u043E\u043F\u0430\u043B,
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F?"
  - ID: Chapter_6_Front_7
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC544\uB2C8\uBA74 \uB2E4\uB978 \uC0AC\uB78C\uC774 \uCC3E\uC544\uC654\uACA0\uC9C0."
    Text_En: Or someone else found them.
    Text_ZhHans: "\u4E5F\u53EF\u80FD\u662F\u522B\u4EBA\u6765\u8FC7\u3002"
    Text_Ja: "\u3042\u308B\u3044\u306F\u3001\u5225\u306E\u8AB0\u304B\u3060\u308D\u3046\u3002"
    Text_Es: "O alguien m\xE1s los encontr\xF3."
    Text_Pt: "Ou outra pessoa esteve l\xE1."
    Text_Ru: "\u0418\u043B\u0438 \u043F\u0440\u0438\u0448\u0451\u043B \u043A\u0442\u043E-\u0442\u043E
      \u0434\u0440\u0443\u0433\u043E\u0439."
  - ID: Chapter_6_Front_8
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uC218\uC0C9\uD55C \uC9C0\uC810\uB4E4\uC744 \uB2E4\uC2DC
      \uC0B4\uD3C8\uB2E4."
    Text_En: I reviewed the search locations.
    Text_ZhHans: "\u6211\u91CD\u65B0\u67E5\u770B\u641C\u67E5\u8FC7\u7684\u5730\u70B9\u3002"
    Text_Ja: "\u79C1\u306F\u635C\u7D22\u3057\u305F\u5730\u70B9\u3092\u898B\u76F4\u3057\u305F\u3002"
    Text_Es: "Revis\xE9 los puntos registrados."
    Text_Pt: Revisei os pontos da busca.
    Text_Ru: "\u042F \u0435\u0449\u0451 \u0440\u0430\u0437 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0442\u043E\u0447\u043A\u0438 \u043F\u043E\u0438\u0441\u043A\u0430."
  - ID: Chapter_6_Front_9
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC7A5\uC18C\uB294 \uCC3E\uC558\uC9C0\uB9CC,"
    Text_En: We'd found the places,
    Text_ZhHans: "\u5730\u65B9\u627E\u5230\u4E86\uFF0C"
    Text_Ja: "\u5834\u6240\u306F\u5206\u304B\u3063\u305F\u3002"
    Text_Es: "Hab\xEDamos encontrado los lugares,"
    Text_Pt: Encontramos os lugares,
    Text_Ru: "\u041C\u0435\u0441\u0442\u0430 \u043C\u044B \u043D\u0430\u0448\u043B\u0438,"
  - ID: Chapter_6_Front_10
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uADF8\uACF3\uC5D0\uC11C \uC788\uC5C8\uB358 \uC77C\uC740 \uC5EC\uC804\uD788
      \uBE48\uCE78\uC774\uC5C8\uB2E4."
    Text_En: but not what had happened there.
    Text_ZhHans: "\u53EF\u90A3\u91CC\u53D1\u751F\u7684\u4E8B\u4ECD\u662F\u4E00\u7247\u7A7A\u767D\u3002"
    Text_Ja: "\u3060\u304C\u3001\u305D\u3053\u3067\u4F55\u304C\u3042\u3063\u305F\u304B\u306F\u7A7A\u767D\u306E\u307E\u307E\u3060\u3002"
    Text_Es: "pero no sab\xEDamos qu\xE9 ocurri\xF3 en ellos."
    Text_Pt: "mas n\xE3o sab\xEDamos o que tinha ocorrido ali."
    Text_Ru: "\u043D\u043E \u0441\u043B\u0443\u0447\u0438\u0432\u0448\u0435\u0435\u0441\u044F
      \u0442\u0430\u043C \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u043E\u0441\u044C
      \u0437\u0430\u0433\u0430\u0434\u043A\u043E\u0439."
  - ID: Chapter_6_Front_11
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uB538\uC5D0\uAC8C \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uBD10\uC57C\uACA0\uC5B4."
    Text_En: We need to speak to his daughter.
    Text_ZhHans: "\u5F97\u627E\u5973\u513F\u8C08\u8C08\u3002"
    Text_Ja: "\u5A18\u304B\u3089\u8A71\u3092\u805E\u304F\u5FC5\u8981\u304C\u3042\u308B\u306A\u3002"
    Text_Es: Tenemos que hablar con la hija.
    Text_Pt: Precisamos conversar com a filha.
    Text_Ru: "\u041D\u0430\u0434\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0434\u043E\u0447\u0435\u0440\u044C\u044E."
  - ID: Chapter_6_Front_12
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC544\uBC84\uC9C0\uAC00 \uC9D1\uC744 \uBE44\uC6B4 \uC2DC\uAE30\uB098"
    Text_En: She may know when he went away,
    Text_ZhHans: "\u5979\u6216\u8BB8\u77E5\u9053\u7236\u4EB2\u79BB\u5BB6\u7684\u65F6\u95F4\uFF0C"
    Text_Ja: "\u7236\u89AA\u304C\u5BB6\u3092\u7A7A\u3051\u305F\u6642\u671F\u3084\u3001"
    Text_Es: "Quiz\xE1 sepa cu\xE1ndo se ausent\xF3 su padre"
    Text_Pt: Ela pode saber quando o pai saiu
    Text_Ru: "\u041C\u043E\u0436\u0435\u0442, \u043E\u043D\u0430 \u0437\u043D\u0430\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u0442\u0435\u0446 \u0443\u0435\u0437\u0436\u0430\u043B,"
  - ID: Chapter_6_Front_13
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC218\uCCA9\uC5D0 \uB300\uD574 \uC544\uB294 \uAC8C \uC788\uC744\uC9C0\uB3C4
      \uBAA8\uB974\uB2C8\uAE4C."
    Text_En: or something about this notebook.
    Text_ZhHans: "\u4E5F\u53EF\u80FD\u4E86\u89E3\u8FD9\u672C\u7B14\u8BB0\u3002"
    Text_Ja: "\u624B\u5E33\u306B\u3064\u3044\u3066\u4F55\u304B\u77E5\u3063\u3066\u3044\u308B\u304B\u3082\u3057\u308C\u3093\u3002"
    Text_Es: o conozca algo de este cuaderno.
    Text_Pt: ou conhecer algo sobre o caderno.
    Text_Ru: "\u0438\u043B\u0438 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043E\u0431 \u044D\u0442\u043E\u043C \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435."
  - ID: Chapter_6_Front_14
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC9D1\uC5D0\uB294 \uC544\uC9C1 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uB2F5\uB2C8\uB2E4."
    Text_En: She still hasn't returned home.
    Text_ZhHans: "\u542C\u8BF4\u5979\u8FD8\u6CA1\u56DE\u5BB6\u3002"
    Text_Ja: "\u307E\u3060\u5BB6\u306B\u306F\u623B\u3063\u3066\u3044\u306A\u3044\u305D\u3046\u3067\u3059\u3002"
    Text_Es: "Todav\xEDa no ha vuelto a casa."
    Text_Pt: "Ela ainda n\xE3o voltou para casa."
    Text_Ru: "\u0414\u043E\u043C\u043E\u0439 \u043E\u043D\u0430 \u0435\u0449\u0451
      \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0430\u0441\u044C."
  - ID: Chapter_6_Front_15
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC218\uCCA9\uC5D0 \uB0A8\uAE34 \uB9D0\uC744 \uB2E4\uC2DC \uD655\uC778\uD574
      \uBCF4\uC558\uB2E4."
    Text_En: I read her note again.
    Text_ZhHans: "\u6211\u518D\u6B21\u786E\u8BA4\u4E86\u672C\u5B50\u4E0A\u7684\u7559\u8A00\u3002"
    Text_Ja: "\u624B\u5E33\u306B\u6B8B\u3055\u308C\u305F\u8A00\u8449\u3092\u8AAD\u307F\u8FD4\u3057\u305F\u3002"
    Text_Es: "Volv\xED a leer la nota que dej\xF3."
    Text_Pt: Li o bilhete outra vez.
    Text_Ru: "\u042F \u0441\u043D\u043E\u0432\u0430 \u043F\u0440\u043E\u0447\u0451\u043B
      \u0435\u0451 \u0437\u0430\u043F\u0438\u0441\u043A\u0443."
  - ID: Chapter_6_Front_16
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC544\uBE60\uC640 \uBCC4\uC744 \uC787\uB294 \uBC95\uC744 \uBC30\uC6E0\uB358
      \uACF3\uC5D0 \uAC08\uAC8C."
    Text_En: I'll go where you taught me the stars.
    Text_ZhHans: "\u6211\u53BB\u7238\u7238\u6559\u6211\u8FDE\u661F\u661F\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u3068\u661F\u3092\u3064\u306A\u3050\u7DF4\u7FD2\u3092\u3057\u305F\u5834\u6240\u306B\u884C\u304F\u306D\u3002"
    Text_Es: "Ir\xE9 donde me ense\xF1aste a unir estrellas."
    Text_Pt: "Vou onde voc\xEA me ensinou a ligar estrelas."
    Text_Ru: "\u041F\u043E\u0439\u0434\u0443 \u0442\u0443\u0434\u0430, \u0433\u0434\u0435
      \u0442\u044B \u0443\u0447\u0438\u043B \u043C\u0435\u043D\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: Chapter_6_Front_17
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC624\uB298\uC740 \uAC70\uAE30\uC11C \uAE30\uB2E4\uB9B4\uAC8C."
    Text_En: I'll wait there today.
    Text_ZhHans: "\u4ECA\u5929\u6211\u4F1A\u5728\u90A3\u91CC\u7B49\u4F60\u3002"
    Text_Ja: "\u4ECA\u65E5\u306F\u305D\u3053\u3067\u5F85\u3063\u3066\u308B\u3002"
    Text_Es: "Hoy te esperar\xE9 all\xED."
    Text_Pt: "Hoje vou esperar l\xE1."
    Text_Ru: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u0443\u0434\u0443
      \u0436\u0434\u0430\u0442\u044C \u0442\u0430\u043C."
  - ID: Chapter_6_Front_18
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC55E\uCABD \uAD00\uCE21 \uAE30\uB85D\uC5D0\uB3C4 \uC7A5\uC18C\uAC00
      \uC5EC\uB7EC \uAD70\uB370\uC785\uB2C8\uB2E4."
    Text_En: The early entries list several places.
    Text_ZhHans: "\u524D\u9762\u7684\u89C2\u6D4B\u8BB0\u5F55\u4E5F\u5199\u4E86\u597D\u51E0\u4E2A\u5730\u65B9\u3002"
    Text_Ja: "\u524D\u306E\u89B3\u6E2C\u8A18\u9332\u306B\u3082\u3001\u5834\u6240\u304C\u3044\u304F\u3064\u3082\u3042\u308A\u307E\u3059\u3002"
    Text_Es: Las notas antiguas mencionan varios sitios.
    Text_Pt: "As primeiras notas citam v\xE1rios lugares."
    Text_Ru: "\u0412 \u0441\u0442\u0430\u0440\u044B\u0445 \u0437\u0430\u043F\u0438\u0441\u044F\u0445
      \u0442\u043E\u0436\u0435 \u043C\u043D\u043E\u0433\u043E \u043C\u0435\u0441\u0442."
  - ID: Chapter_6_Front_19
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC774 \uAE00\uB9CC\uC73C\uB85C\uB294 \uC5B4\uB290 \uACF3\uC778\uC9C0\u2026\u2026."
    Text_En: This note alone doesn't tell us which...
    Text_ZhHans: "\u5149\u51ED\u8FD9\u53E5\u8BDD\uFF0C\u6050\u6015\u2026\u2026"
    Text_Ja: "\u3053\u306E\u6587\u3060\u3051\u3067\u306F\u3001\u3069\u3053\u306A\u306E\u304B\u2026\u2026"
    Text_Es: "Solo con esto no sabemos cu\xE1l..."
    Text_Pt: "S\xF3 com este bilhete, n\xE3o d\xE1 para saber..."
    Text_Ru: "\u041F\u043E \u043E\u0434\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u043A\u0435
      \u043D\u0435 \u043F\u043E\u043D\u044F\u0442\u044C..."
  - ID: Chapter_6_Front_20
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uB9C8\uC9C0\uB9C9 \uBB38\uC7A5\uC5D0\uC11C \uB208\uC744
      \uBA48\uCDC4\uB2E4."
    Text_En: My eyes stopped on the last sentence.
    Text_ZhHans: "\u6211\u7684\u76EE\u5149\u505C\u5728\u6700\u540E\u4E00\u53E5\u3002"
    Text_Ja: "\u79C1\u306F\u6700\u5F8C\u306E\u4E00\u6587\u3067\u76EE\u3092\u6B62\u3081\u305F\u3002"
    Text_Es: "Me detuve en la \xFAltima frase."
    Text_Pt: "Parei na \xFAltima frase."
    Text_Ru: "\u041C\u043E\u0439 \u0432\u0437\u0433\u043B\u044F\u0434 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0441\u0442\u0440\u043E\u043A\u0435."
  - ID: Chapter_6_Front_21
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uAE30\uB2E4\uB9B4\uAC8C."
    Text_En: I'll wait.
    Text_ZhHans: "\u6211\u4F1A\u7B49\u4F60\u3002"
    Text_Ja: "\u5F85\u3063\u3066\u308B\u3002"
    Text_Es: "Te esperar\xE9."
    Text_Pt: Vou esperar.
    Text_Ru: "\u0411\u0443\u0434\u0443 \u0436\u0434\u0430\u0442\u044C."
  - ID: Chapter_6_Front_22
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC544\uBC84\uC9C0\uB97C \uCC3E\uC73C\uB7EC \uAC04\uB2E4\uB294 \uB9D0\uC774
      \uC544\uB2C8\uC5C8\uB2E4."
    Text_En: She hadn't said she'd go looking for him.
    Text_ZhHans: "\u5979\u8BF4\u7684\u4E0D\u662F\u53BB\u5BFB\u627E\u7236\u4EB2\u3002"
    Text_Ja: "\u7236\u89AA\u3092\u63A2\u3057\u306B\u884C\u304F\u3068\u306F\u66F8\u3044\u3066\u3044\u306A\u3044\u3002"
    Text_Es: "No dec\xEDa que fuera a buscarlo."
    Text_Pt: "Ela n\xE3o disse que ia procurar o pai."
    Text_Ru: "\u041E\u043D\u0430 \u043D\u0435 \u043F\u0438\u0441\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0438\u0434\u0451\u0442 \u0438\u0441\u043A\u0430\u0442\u044C
      \u043E\u0442\u0446\u0430."
  - ID: Chapter_6_Front_23
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uD760..."
    Text_En: Hmm...
    Text_ZhHans: "\u55EF\u2026\u2026"
    Text_Ja: "\u3075\u3080\u2026\u2026"
    Text_Es: Mmm...
    Text_Pt: Hum...
    Text_Ru: "\u0425\u043C..."
  - ID: Chapter_6_Front_24
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uB354\uB294 \uAE30\uB85D\uC744 \uB530\uB77C\uAC08 \uC0DD\uAC01\uC774
      \uC5C6\uC5C8\uB358 \uAC78\uAE4C\uC694."
    Text_En: Had she given up following the records?
    Text_ZhHans: "\u5979\u662F\u4E0D\u662F\u4E0D\u6253\u7B97\u518D\u8DDF\u7740\u8BB0\u5F55\u627E\u4E86\uFF1F"
    Text_Ja: "\u3082\u3046\u8A18\u9332\u3092\u305F\u3069\u308B\u6C17\u306F\u306A\u304B\u3063\u305F\u306E\u3067\u3057\u3087\u3046\u304B\u3002"
    Text_Es: "\xBFHab\xEDa decidido dejar de seguir las notas?"
    Text_Pt: "Ser\xE1 que desistiu de seguir os registros?"
    Text_Ru: "\u041C\u043E\u0436\u0435\u0442, \u043E\u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430 \u0438\u0434\u0442\u0438
      \u043F\u043E \u0437\u0430\u043F\u0438\u0441\u044F\u043C?"
  - ID: Chapter_6_Front_25
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uADF8\uB7AC\uC744 \uC218\uB3C4 \uC788\uC9C0."
    Text_En: Maybe.
    Text_ZhHans: "\u4E5F\u6709\u53EF\u80FD\u3002"
    Text_Ja: "\u305D\u3046\u304B\u3082\u3057\u308C\u3093\u3002"
    Text_Es: Puede ser.
    Text_Pt: Pode ser.
    Text_Ru: "\u0412\u043F\u043E\u043B\u043D\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E."
  - ID: Chapter_6_Front_26
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uCC3E\uC544\uB2E4\uB140\uB3C4 \uB9CC\uB098\uC9C0 \uBABB\uD588\uB2E4\uBA74,"
    Text_En: If she'd searched and found nothing,
    Text_ZhHans: "\u5982\u679C\u600E\u4E48\u627E\u90FD\u627E\u4E0D\u5230\uFF0C"
    Text_Ja: "\u63A2\u3057\u56DE\u3063\u3066\u3082\u4F1A\u3048\u306A\u304B\u3063\u305F\u306A\u3089\u3001"
    Text_Es: "Si no lo encontr\xF3 por m\xE1s que buscara,"
    Text_Pt: "Se procurou e n\xE3o o encontrou,"
    Text_Ru: "\u0415\u0441\u043B\u0438 \u0438\u0441\u043A\u0430\u043B\u0430, \u043D\u043E
      \u0442\u0430\u043A \u0438 \u043D\u0435 \u043D\u0430\u0448\u043B\u0430,"
  - ID: Chapter_6_Front_27
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC544\uBC84\uC9C0\uAC00 \uC790\uC2E0\uC744 \uCC3E\uC544\uC624\uAE38
      \uBC14\uB790\uC744\uC9C0\uB3C4."
    Text_En: perhaps she hoped he'd find her.
    Text_ZhHans: "\u4E5F\u8BB8\u5979\u5E0C\u671B\u7236\u4EB2\u80FD\u6765\u627E\u5979\u3002"
    Text_Ja: "\u4ECA\u5EA6\u306F\u7236\u89AA\u306B\u6765\u3066\u307B\u3057\u304B\u3063\u305F\u306E\u304B\u3082\u306A\u3002"
    Text_Es: "quiz\xE1 esperaba que \xE9l fuera a buscarla."
    Text_Pt: "talvez quisesse que ele viesse busc\xE1-la."
    Text_Ru: "\u0442\u043E, \u043C\u043E\u0436\u0435\u0442, \u043D\u0430\u0434\u0435\u044F\u043B\u0430\u0441\u044C,
      \u0447\u0442\u043E \u043E\u043D \u0441\u0430\u043C \u043F\u0440\u0438\u0434\u0451\u0442."
  - ID: Chapter_6_Front_28
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uB458\uC774 \uC790\uC8FC \uAC14\uB358 \uACF3\uBD80\uD130 \uD655\uC778\uD560\uAE4C\uC694?"
    Text_En: Shall we check their usual spots?
    Text_ZhHans: "\u5148\u67E5\u4ED6\u4EEC\u5E38\u53BB\u7684\u5730\u65B9\u5417\uFF1F"
    Text_Ja: "\u4E8C\u4EBA\u304C\u3088\u304F\u884C\u3063\u305F\u5834\u6240\u304B\u3089\u8ABF\u3079\u307E\u3059\u304B\uFF1F"
    Text_Es: "\xBFRevisamos los sitios que frecuentaban?"
    Text_Pt: Verificamos os lugares que frequentavam?
    Text_Ru: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u043C\u0435\u0441\u0442\u0430,
      \u0433\u0434\u0435 \u043E\u043D\u0438 \u0447\u0430\u0441\u0442\u043E \u0431\u044B\u0432\u0430\u043B\u0438?"
  - ID: Chapter_6_Front_29
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uADF8\uB798. \uAE38\uC744 \uC801\uC5B4\uB450\uC9C0 \uC54A\uC544\uB3C4
      \uCC3E\uC544\uAC08 \uC218 \uC788\uACE0,"
    Text_En: Yes. Somewhere she'd need no directions.
    Text_ZhHans: "\u5BF9\uFF0C\u4E0D\u7528\u8BB0\u8DEF\u7EBF\u4E5F\u80FD\u627E\u5230\uFF0C"
    Text_Ja: "\u3042\u3042\u3002\u9053\u9806\u304C\u306A\u304F\u3066\u3082\u884C\u3051\u308B\u5834\u6240\u3067\u3001"
    Text_Es: "S\xED. Donde ella pudiera ir sin indicaciones."
    Text_Pt: Sim. Um lugar que ela conhecesse de cor.
    Text_Ru: "\u0414\u0430. \u041A\u0443\u0434\u0430 \u043E\u043D\u0430 \u0434\u043E\u0439\u0434\u0451\u0442
      \u0438 \u0431\u0435\u0437 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0439."
  - ID: Chapter_6_Front_30
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC544\uBC84\uC9C0\uB3C4 \uC5B4\uB514\uC778\uC9C0 \uC54C\uC544\uB4E4\uC744
      \uB9CC\uD55C \uACF3."
    Text_En: Somewhere he'd know from those words.
    Text_ZhHans: "\u800C\u4E14\u7236\u4EB2\u4E00\u770B\u5C31\u77E5\u9053\u7684\u5730\u65B9\u3002"
    Text_Ja: "\u7236\u89AA\u3082\u3059\u3050\u306B\u5206\u304B\u308B\u5834\u6240\u3060\u3002"
    Text_Es: "Y \xE9l entendiera ad\xF3nde se refer\xEDa."
    Text_Pt: "E que o pai entendesse s\xF3 com aquelas palavras."
    Text_Ru: "\u0418 \u043A\u0443\u0434\u0430 \u043E\u0442\u0435\u0446 \u043F\u043E\u0439\u043C\u0451\u0442
      \u043F\u0440\u0438\u0439\u0442\u0438."
  - ID: Chapter_6_Front_31
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uC624\uB798\uB41C \uAD00\uCE21 \uAE30\uB85D\uC744 \uD3BC\uCCE4\uB2E4."
    Text_En: I opened the old stargazing entries.
    Text_ZhHans: "\u6211\u7FFB\u5F00\u65E9\u671F\u7684\u89C2\u6D4B\u8BB0\u5F55\u3002"
    Text_Ja: "\u79C1\u306F\u53E4\u3044\u89B3\u6E2C\u8A18\u9332\u3092\u958B\u3044\u305F\u3002"
    Text_Es: "Abr\xED las antiguas notas de observaci\xF3n."
    Text_Pt: "Abri as antigas notas de observa\xE7\xE3o."
    Text_Ru: "\u042F \u043E\u0442\u043A\u0440\u044B\u043B \u0441\u0442\u0430\u0440\u044B\u0435
      \u0437\u0430\u043F\u0438\u0441\u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439."
  - ID: Chapter_6_Front_32
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uBCC4 \uADF8\uB9BC \uC544\uB798\uB85C \uC9E7\uC740 \uBA54\uBAA8\uB4E4\uC774
      \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    Text_En: Short notes lay beneath the stars.
    Text_ZhHans: "\u661F\u661F\u4E0B\u9762\u7559\u7740\u51E0\u53E5\u7B80\u77ED\u7684\u5907\u6CE8\u3002"
    Text_Ja: "\u661F\u306E\u7D75\u306E\u4E0B\u306B\u3001\u77ED\u3044\u30E1\u30E2\u304C\u3042\u3063\u305F\u3002"
    Text_Es: "Hab\xEDa frases breves bajo las estrellas."
    Text_Pt: Havia pequenos recados sob as estrelas.
    Text_Ru: "\u041F\u043E\u0434 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438
      \u0431\u044B\u043B\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0437\u0430\u043C\u0435\u0442\u043A\u0438."
  - ID: Chapter_6_Front_33
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC544\uC774\uC640 \uD568\uAED8 \uC654\uB2E4."
    Text_En: Came here with my daughter.
    Text_ZhHans: "\u548C\u5973\u513F\u4E00\u8D77\u6765\u7684\u3002"
    Text_Ja: "\u5A18\u3068\u4E00\u7DD2\u306B\u6765\u305F\u3002"
    Text_Es: Vine con mi hija.
    Text_Pt: Vim com minha filha.
    Text_Ru: "\u041F\u0440\u0438\u0448\u0451\u043B \u0441\u044E\u0434\u0430 \u0441
      \u0434\u043E\u0447\u0435\u0440\u044C\u044E."
  - ID: Chapter_6_Front_34
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uCC98\uC74C\uC73C\uB85C \uBCC4\uC744 \uC9DA\uC5B4\uC8FC\uC5C8\uB2E4."
    Text_En: Showed her the stars for the first time.
    Text_ZhHans: "\u7B2C\u4E00\u6B21\u6307\u7ED9\u5979\u770B\u661F\u661F\u3002"
    Text_Ja: "\u521D\u3081\u3066\u661F\u3092\u6307\u3057\u3066\u6559\u3048\u305F\u3002"
    Text_Es: "Le ense\xF1\xE9 las estrellas por primera vez."
    Text_Pt: Mostrei as estrelas a ela pela primeira vez.
    Text_Ru: "\u0412\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0435\u0439 \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: Chapter_6_Front_35
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uB098\uB294 \uADF8 \uBB38\uC7A5 \uC606\uC758 \uBCC4\uB4E4\uC744 \uBC14\uB77C\uBD24\uB2E4."
    Text_En: I looked at the stars beside those words.
    Text_ZhHans: "\u6211\u770B\u5411\u90A3\u53E5\u8BDD\u65C1\u8FB9\u7684\u661F\u661F\u3002"
    Text_Ja: "\u79C1\u306F\u305D\u306E\u8A00\u8449\u306E\u6A2A\u306E\u661F\u3092\u898B\u305F\u3002"
    Text_Es: "Mir\xE9 las estrellas junto a esas palabras."
    Text_Pt: Olhei as estrelas ao lado dessas palavras.
    Text_Ru: "\u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430
      \u0437\u0432\u0451\u0437\u0434\u044B \u0440\u044F\u0434\u043E\u043C \u0441
      \u044D\u0442\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438."
  - ID: Chapter_6_Front_36
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC774 \uC544\uC774\uC5D0\uAC8C\uB294 \uC5B4\uB5A4 \uAE30\uC5B5\uC73C\uB85C
      \uB0A8\uC558\uC744\uAE4C."
    Text_En: What did she remember of that day?
    Text_ZhHans: "\u5BF9\u5979\u6765\u8BF4\uFF0C\u90A3\u662F\u600E\u6837\u7684\u56DE\u5FC6\u5462\uFF1F"
    Text_Ja: "\u3053\u306E\u5B50\u306B\u306F\u3001\u3069\u3093\u306A\u601D\u3044\u51FA\u306A\u306E\u3060\u308D\u3046\u3002"
    Text_Es: "\xBFQu\xE9 recuerdo guardar\xEDa ella de aquel d\xEDa?"
    Text_Pt: "Que lembran\xE7a ela teria daquele dia?"
    Text_Ru: "\u041A\u0430\u043A \u043E\u043D\u0430 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0430
      \u0442\u043E\u0442 \u0434\u0435\u043D\u044C?"
  - ID: Chapter_6_Front_37
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uC544\uBE60\uB97C \uCC3E\uACE0 \uC2F6\uC5B4 \uD558\uB294 \uB538\uC774\uB77C..."
    Text_En: A daughter hoping to find her father...
    Text_ZhHans: "\u4E00\u4E2A\u60F3\u627E\u5230\u7238\u7238\u7684\u5973\u513F\u2026\u2026"
    Text_Ja: "\u7236\u89AA\u306B\u4F1A\u3044\u305F\u3044\u5A18\u3001\u304B\u2026\u2026"
    Text_Es: Una hija que quiere encontrar a su padre...
    Text_Pt: Uma filha querendo encontrar o pai...
    Text_Ru: "\u0414\u043E\u0447\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0445\u043E\u0447\u0435\u0442 \u043D\u0430\u0439\u0442\u0438 \u043E\u0442\u0446\u0430..."
  - ID: Chapter_6_Front_38
    Chapter_Id: 6_Front
    Speaker: Police
    Text_Kr: "\uAC08 \uACF3\uC740 \uBED4\uD558\uAD70."
    Text_En: I think I know where she'd go.
    Text_ZhHans: "\u6211\u60F3\uFF0C\u6211\u77E5\u9053\u5979\u4F1A\u53BB\u54EA\u513F\u4E86\u3002"
    Text_Ja: "\u884C\u304D\u5148\u306F\u6C7A\u307E\u3063\u305F\u306A\u3002"
    Text_Es: "Creo que s\xE9 ad\xF3nde ir\xEDa."
    Text_Pt: Acho que sei aonde ela iria.
    Text_Ru: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u0437\u043D\u0430\u044E,
      \u043A\u0443\u0434\u0430 \u043E\u043D\u0430 \u043F\u043E\u0448\u043B\u0430."
  - ID: Chapter_6_Back_1
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uBCA4\uCE58\uC5D0 \uB2FF\uC740 \uC190\uC774 \uCC28\uAC00\uC6E0\uB2E4."
    Text_En: The bench felt cold beneath my hand.
    Text_ZhHans: "\u957F\u6905\u51B0\u51C9\uFF0C\u5BD2\u610F\u900F\u8FDB\u638C\u5FC3\u3002"
    Text_Ja: "\u30D9\u30F3\u30C1\u306B\u89E6\u308C\u305F\u624B\u304C\u51B7\u305F\u304B\u3063\u305F\u3002"
    Text_Es: "El banco estaba fr\xEDo bajo mi mano."
    Text_Pt: "O banco estava frio sob minha m\xE3o."
    Text_Ru: "\u0421\u043A\u0430\u043C\u0435\u0439\u043A\u0430 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u0430
      \u043B\u0430\u0434\u043E\u043D\u044C."
  - ID: Chapter_6_Back_2
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC190\uC744 \uAC70\uB450\uC5B4 \uC18C\uB9E4 \uC548\uC73C\uB85C
      \uB123\uC5C8\uB2E4."
    Text_En: I tucked my hand into my sleeve.
    Text_ZhHans: "\u6211\u6536\u56DE\u624B\uFF0C\u7F29\u8FDB\u8896\u5B50\u91CC\u3002"
    Text_Ja: "\u624B\u3092\u5F15\u3063\u8FBC\u3081\u3001\u8896\u306E\u4E2D\u306B\u5165\u308C\u305F\u3002"
    Text_Es: "La retir\xE9 y la met\xED en la manga."
    Text_Pt: "Recolhi a m\xE3o para dentro da manga."
    Text_Ru: "\u042F \u0443\u0431\u0440\u0430\u043B\u0430 \u0440\u0443\u043A\u0443
      \u0432 \u0440\u0443\u043A\u0430\u0432."
  - ID: Chapter_6_Back_3
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uAE38 \uCABD\uC5D0\uC11C \uC18C\uB9AC\uAC00 \uB0A0 \uB54C\uB9C8\uB2E4"
    Text_En: Whenever I heard a sound from the path,
    Text_ZhHans: "\u6BCF\u5F53\u8DEF\u4E0A\u4F20\u6765\u58F0\u97F3\uFF0C"
    Text_Ja: "\u9053\u306E\u65B9\u304B\u3089\u97F3\u304C\u3059\u308B\u305F\u3073\u3001"
    Text_Es: "Cada vez que o\xEDa algo en el camino,"
    Text_Pt: Sempre que ouvia um som no caminho,
    Text_Ru: "\u0421\u0442\u043E\u0438\u043B\u043E \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0437\u0432\u0443\u043A \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B
      \u0434\u043E\u0440\u043E\u0436\u043A\u0438,"
  - ID: Chapter_6_Back_4
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4."
    Text_En: I turned.
    Text_ZhHans: "\u6211\u90FD\u4F1A\u56DE\u5934\u3002"
    Text_Ja: "\u79C1\u306F\u632F\u308A\u8FD4\u3063\u305F\u3002"
    Text_Es: "volv\xEDa la cabeza."
    Text_Pt: "eu virava a cabe\xE7a."
    Text_Ru: "\u044F \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043B\u0430\u0441\u044C."
  - ID: Chapter_6_Back_5
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC9C0\uB098\uAC00\uB294 \uC0AC\uB78C\uC740 \uC788\uC5B4\uB3C4"
    Text_En: People passed,
    Text_ZhHans: "\u867D\u7136\u6709\u4EBA\u7ECF\u8FC7\uFF0C"
    Text_Ja: "\u901A\u308A\u904E\u304E\u308B\u4EBA\u306F\u3044\u3066\u3082\u3001"
    Text_Es: Pasaba gente,
    Text_Pt: As pessoas passavam,
    Text_Ru: "\u041B\u044E\u0434\u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438
      \u043C\u0438\u043C\u043E,"
  - ID: Chapter_6_Back_6
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC774\uCABD\uC73C\uB85C \uC624\uB294 \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uB2E4."
    Text_En: but no one came toward me.
    Text_ZhHans: "\u5374\u6CA1\u6709\u4EBA\u671D\u8FD9\u8FB9\u8D70\u6765\u3002"
    Text_Ja: "\u3053\u3061\u3089\u3078\u6765\u308B\u4EBA\u306F\u3044\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "pero nadie ven\xEDa hacia m\xED."
    Text_Pt: "mas ningu\xE9m vinha at\xE9 mim."
    Text_Ru: "\u043D\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0448\u0451\u043B
      \u043A\u043E \u043C\u043D\u0435."
  - ID: Chapter_6_Back_7
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uAC00 \uC624\uBA74 \uBB34\uC2A8 \uB9D0\uBD80\uD130 \uD574\uC57C
      \uD560\uAE4C."
    Text_En: What would I say when Dad arrived?
    Text_ZhHans: "\u7238\u7238\u6765\u4E86\uFF0C\u6211\u8BE5\u5148\u8BF4\u4EC0\u4E48\uFF1F"
    Text_Ja: "\u304A\u7236\u3055\u3093\u304C\u6765\u305F\u3089\u3001\u4F55\u304B\u3089\u8A71\u305D\u3046\u3002"
    Text_Es: "\xBFQu\xE9 le dir\xEDa a pap\xE1 cuando llegara?"
    Text_Pt: O que eu diria quando papai chegasse?
    Text_Ru: "\u0427\u0442\u043E \u044F \u0441\u043A\u0430\u0436\u0443, \u043A\u043E\u0433\u0434\u0430
      \u043F\u0430\u043F\u0430 \u043F\u0440\u0438\u0434\u0451\u0442?"
  - ID: Chapter_6_Back_8
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC5B4\uB514 \uC788\uC5C8\uB0D0\uACE0."
    Text_En: Where were you?
    Text_ZhHans: "\u4F60\u53BB\u54EA\u513F\u4E86\uFF1F"
    Text_Ja: "\u3069\u3053\u306B\u3044\u305F\u306E\u3002"
    Text_Es: "\xBFD\xF3nde estabas?"
    Text_Pt: "Onde voc\xEA estava?"
    Text_Ru: "\u0413\u0434\u0435 \u0442\u044B \u0431\u044B\u043B?"
  - ID: Chapter_6_Back_9
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC65C \uC5F0\uB77D\uC744 \uD558\uC9C0 \uC54A\uC558\uB0D0\uACE0."
    Text_En: Why didn't you call?
    Text_ZhHans: "\u4E3A\u4EC0\u4E48\u4E0D\u8054\u7CFB\u6211\uFF1F"
    Text_Ja: "\u3069\u3046\u3057\u3066\u9023\u7D61\u3057\u306A\u304B\u3063\u305F\u306E\u3002"
    Text_Es: "\xBFPor qu\xE9 no llamaste?"
    Text_Pt: "Por que n\xE3o ligou?"
    Text_Ru: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u0435 \u0437\u0432\u043E\u043D\u0438\u043B?"
  - ID: Chapter_6_Back_10
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uB2E4\uC74C\uC5D0\uB294\u2026\u2026."
    Text_En: And after that...
    Text_ZhHans: "\u7136\u540E\u5462\u2026\u2026"
    Text_Ja: "\u305D\u306E\u6B21\u306F\u2026\u2026"
    Text_Es: "Y despu\xE9s..."
    Text_Pt: E depois...
    Text_Ru: "\u0410 \u043F\u043E\u0442\u043E\u043C..."
  - ID: Chapter_6_Back_11
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uC190\uD1B1 \uB05D\uC5D0 \uB0A8\uC740 \uD759\uC744 \uBB38\uC9C8\uB800\uB2E4."
    Text_En: I rubbed the dirt beneath my nails.
    Text_ZhHans: "\u6211\u6413\u7740\u6307\u7532\u8FB9\u6B8B\u7559\u7684\u6CE5\u571F\u3002"
    Text_Ja: "\u722A\u5148\u306B\u6B8B\u3063\u305F\u571F\u3092\u3053\u3059\u3063\u305F\u3002"
    Text_Es: "Me frot\xE9 la tierra bajo las u\xF1as."
    Text_Pt: Esfreguei a terra sob as unhas.
    Text_Ru: "\u042F \u043F\u043E\u0442\u0451\u0440\u043B\u0430 \u0437\u0435\u043C\u043B\u044E
      \u043F\u043E\u0434 \u043D\u043E\u0433\u0442\u044F\u043C\u0438."
  - ID: Chapter_6_Back_12
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uBB3C\uC5B4\uBCF4\uACE0 \uC2F6\uC740 \uB9D0\uC740 \uB9CE\uC558\uC9C0\uB9CC,"
    Text_En: There was so much I wanted to ask.
    Text_ZhHans: "\u60F3\u95EE\u7684\u8BDD\u5F88\u591A\uFF0C"
    Text_Ja: "\u805E\u304D\u305F\u3044\u3053\u3068\u306F\u305F\u304F\u3055\u3093\u3042\u3063\u305F\u3002"
    Text_Es: "Ten\xEDa tantas preguntas,"
    Text_Pt: Tinha tantas perguntas,
    Text_Ru: "\u041C\u043D\u0435 \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E
      \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C."
  - ID: Chapter_6_Back_13
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC5B4\uB5A4 \uB300\uB2F5\uC744 \uB4E3\uAC8C \uB420\uC9C0\uB294 \uB450\uB824\uC6E0\uB2E4."
    Text_En: But I was afraid of the answers.
    Text_ZhHans: "\u5374\u53C8\u5BB3\u6015\u542C\u5230\u7B54\u6848\u3002"
    Text_Ja: "\u3051\u308C\u3069\u3001\u7B54\u3048\u3092\u805E\u304F\u306E\u304C\u6016\u304B\u3063\u305F\u3002"
    Text_Es: pero me asustaban las respuestas.
    Text_Pt: mas temia as respostas.
    Text_Ru: "\u041D\u043E \u044F \u0431\u043E\u044F\u043B\u0430\u0441\u044C \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u043E\u0442\u0432\u0435\u0442\u044B."
  - ID: Chapter_6_Back_14
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uB0B4\uAC00 \uC798\uBABB \uC0DD\uAC01\uD55C \uAC70\uB77C\uACE0 \uB9D0\uD574\uC92C\uC73C\uBA74
      \uD588\uB2E4."
    Text_En: I wanted him to say I'd been wrong.
    Text_ZhHans: "\u6211\u5E0C\u671B\u4ED6\u544A\u8BC9\u6211\uFF0C\u662F\u6211\u60F3\u9519\u4E86\u3002"
    Text_Ja: "\u79C1\u306E\u52D8\u9055\u3044\u3060\u3068\u8A00\u3063\u3066\u307B\u3057\u304B\u3063\u305F\u3002"
    Text_Es: "Quer\xEDa que me dijera que estaba equivocada."
    Text_Pt: Queria que ele dissesse que eu estava errada.
    Text_Ru: "\u0425\u043E\u0442\u0435\u043B\u0430, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D \u0441\u043A\u0430\u0437\u0430\u043B: \u044F \u0432\u0441\u0451
      \u043F\u043E\u043D\u044F\u043B\u0430 \u043D\u0435 \u0442\u0430\u043A."
  - ID: Chapter_6_Back_15
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uB7F0\uB370 \uADF8 \uB9D0\uC744 \uB4E3\uACE0 \uC2F6\uC5B4\uC11C"
    Text_En: But did wanting to hear that
    Text_ZhHans: "\u53EF\u6211\u4F1A\u4E0D\u4F1A\u53EA\u662F\u60F3\u542C\u5230\u8FD9\u53E5\u8BDD\uFF0C"
    Text_Ja: "\u3067\u3082\u3001\u305D\u306E\u8A00\u8449\u304C\u805E\u304D\u305F\u304F\u3066\u3001"
    Text_Es: "Pero, por querer o\xEDr eso,"
    Text_Pt: "Mas ser\xE1 que, por querer ouvir isso,"
    Text_Ru: "\u041D\u043E \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E
      \u043B\u0438 \u044F \u0433\u043B\u0430\u0437\u0430 \u043D\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435"
  - ID: Chapter_6_Back_16
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uB2E4\uB978 \uAC83\uB4E4\uC740 \uBABB \uBCF8 \uCC99\uD558\uB294 \uAC74
      \uC544\uB2D0\uAE4C."
    Text_En: mean I was ignoring everything else?
    Text_ZhHans: "\u624D\u5BF9\u5176\u4ED6\u4E8B\u60C5\u89C6\u800C\u4E0D\u89C1\uFF1F"
    Text_Ja: "\u307B\u304B\u306E\u3053\u3068\u3092\u898B\u306A\u3044\u3075\u308A\u3057\u3066\u3044\u308B\u306E\u3067\u306F\u3002"
    Text_Es: "\xBFestaba ignorando todo lo dem\xE1s?"
    Text_Pt: "eu fingia n\xE3o ver todo o resto?"
    Text_Ru: "\u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u043E\u043C\u0443,
      \u0447\u0442\u043E \u0445\u043E\u0447\u0443 \u044D\u0442\u043E \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C?"
  - ID: Chapter_6_Back_17
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
    Text_En: I looked up.
    Text_ZhHans: "\u6211\u62AC\u8D77\u5934\u3002"
    Text_Ja: "\u79C1\u306F\u9854\u3092\u4E0A\u3052\u305F\u3002"
    Text_Es: "Levant\xE9 la cabeza."
    Text_Pt: "Ergui a cabe\xE7a."
    Text_Ru: "\u042F \u043F\u043E\u0434\u043D\u044F\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u0443."
  - ID: Chapter_6_Back_18
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60\uAC00 \uC9DA\uC5B4\uC8FC\uB358 \uBCC4\uB4E4\uC774 \uBCF4\uC600\uB2E4."
    Text_En: There were the stars he'd shown me.
    Text_ZhHans: "\u7238\u7238\u66FE\u6307\u7ED9\u6211\u770B\u7684\u661F\u661F\u5C31\u5728\u773C\u524D\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u304C\u6559\u3048\u3066\u304F\u308C\u305F\u661F\u304C\u898B\u3048\u305F\u3002"
    Text_Es: "Vi las estrellas que me hab\xEDa ense\xF1ado."
    Text_Pt: Vi as estrelas que ele tinha me mostrado.
    Text_Ru: "\u0423\u0432\u0438\u0434\u0435\u043B\u0430 \u0437\u0432\u0451\u0437\u0434\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B
      \u043F\u0430\u043F\u0430."
  - ID: Chapter_6_Back_19
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC774\uC81C\uB294 \uD63C\uC790\uC11C\uB3C4 \uCC3E\uC744 \uC218 \uC788\uC5C8\uB2E4."
    Text_En: I could find them on my own now.
    Text_ZhHans: "\u5982\u4ECA\uFF0C\u6211\u81EA\u5DF1\u4E5F\u80FD\u627E\u5230\u4E86\u3002"
    Text_Ja: "\u3082\u3046\u3001\u4E00\u4EBA\u3067\u3082\u898B\u3064\u3051\u3089\u308C\u308B\u3002"
    Text_Es: "Ahora pod\xEDa encontrarlas sola."
    Text_Pt: "Agora conseguia ach\xE1-las sozinha."
    Text_Ru: "\u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430
      \u0438\u0445 \u0441\u0430\u043C\u0430."
  - ID: Chapter_6_Back_20
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uCC3E\uC558\uB2E4\uACE0 \uB9D0\uD560 \uC0AC\uB78C\uB9CC \uC606\uC5D0
      \uC5C6\uC5C8\uB2E4."
    Text_En: Only he wasn't here for me to tell.
    Text_ZhHans: "\u53EA\u662F\u8EAB\u8FB9\u6CA1\u4EBA\u80FD\u542C\u6211\u8BF4\u627E\u5230\u4E86\u3002"
    Text_Ja: "\u898B\u3064\u3051\u305F\u3068\u4F1D\u3048\u308B\u76F8\u624B\u3060\u3051\u304C\u3001\u96A3\u306B\u3044\u306A\u3044\u3002"
    Text_Es: "Solo faltaba \xE9l para poder cont\xE1rselo."
    Text_Pt: "S\xF3 faltava ele ao meu lado para eu contar."
    Text_Ru: "\u0422\u043E\u043B\u044C\u043A\u043E \u0440\u044F\u0434\u043E\u043C
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0442\u043E\u0433\u043E, \u043A\u043E\u043C\u0443
      \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043E\u0431 \u044D\u0442\u043E\u043C."
  - ID: Chapter_6_Back_21
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uD558\uC9C0\uB9CC \uC544\uBE60\uAC00 \uB3CC\uC544\uC62C \uB54C\uAE4C\uC9C0"
    Text_En: But I couldn't stay silent
    Text_ZhHans: "\u53EF\u6211\u4E0D\u80FD\u4E00\u76F4\u7B49\u5230\u7238\u7238\u56DE\u6765\uFF0C"
    Text_Ja: "\u3067\u3082\u3001\u304A\u7236\u3055\u3093\u304C\u5E30\u308B\u307E\u3067\u3001"
    Text_Es: "Pero no pod\xEDa guardar silencio"
    Text_Pt: "Mas n\xE3o podia ficar calada"
    Text_Ru: "\u041D\u043E \u044F \u043D\u0435 \u043C\u043E\u0433\u043B\u0430 \u043C\u043E\u043B\u0447\u0430\u0442\u044C"
  - ID: Chapter_6_Back_22
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBB34\uC5D0\uAC8C\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC744 \uC218\uB294
      \uC5C6\uC5C8\uB2E4."
    Text_En: until he came home.
    Text_ZhHans: "\u90FD\u4E0D\u628A\u4E8B\u60C5\u544A\u8BC9\u522B\u4EBA\u3002"
    Text_Ja: "\u8AB0\u306B\u3082\u8A71\u3055\u305A\u306B\u306F\u3044\u3089\u308C\u306A\u304B\u3063\u305F\u3002"
    Text_Es: hasta que volviera.
    Text_Pt: "at\xE9 ele voltar."
    Text_Ru: "\u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0435\u0433\u043E
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F."
  - ID: Chapter_6_Back_23
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uD759 \uC0AC\uC774\uB85C \uB4DC\uB7EC\uB0AC\uB358 \uC190\uC774 \uB5A0\uC62C\uB790\uB2E4."
    Text_En: I remembered the hand in the dirt.
    Text_ZhHans: "\u6211\u60F3\u8D77\u6CE5\u571F\u4E2D\u9732\u51FA\u7684\u90A3\u53EA\u624B\u3002"
    Text_Ja: "\u571F\u306E\u4E2D\u304B\u3089\u73FE\u308C\u305F\u624B\u3092\u601D\u3044\u51FA\u3057\u305F\u3002"
    Text_Es: "Record\xE9 la mano que sali\xF3 de la tierra."
    Text_Pt: "Lembrei da m\xE3o que surgiu da terra."
    Text_Ru: "\u042F \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B\u0430 \u0440\u0443\u043A\u0443,
      \u043F\u043E\u043A\u0430\u0437\u0430\u0432\u0448\u0443\u044E\u0441\u044F \u0438\u0437
      \u0437\u0435\u043C\u043B\u0438."
  - ID: Chapter_6_Back_24
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uADF8 \uC0AC\uB78C\uC744 \uAE30\uB2E4\uB9AC\uB294 \uC0AC\uB78C\uB3C4
      \uC788\uC744 \uAC83\uC774\uB2E4."
    Text_En: Someone must be waiting for them, too.
    Text_ZhHans: "\u4E00\u5B9A\u4E5F\u6709\u4EBA\u5728\u7B49\u90A3\u4E2A\u4EBA\u3002"
    Text_Ja: "\u3042\u306E\u4EBA\u3092\u5F85\u3063\u3066\u3044\u308B\u4EBA\u3082\u3044\u308B\u306F\u305A\u3060\u3002"
    Text_Es: "Alguien tambi\xE9n estar\xEDa esperando a esa persona."
    Text_Pt: "Algu\xE9m tamb\xE9m devia esperar aquela pessoa."
    Text_Ru: "\u041D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u044D\u0442\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0442\u043E\u0436\u0435 \u043A\u0442\u043E-\u0442\u043E
      \u0436\u0434\u0451\u0442."
  - ID: Chapter_6_Back_25
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uADF8 \uC0AC\uB78C\uB4E4\uC744 \uC704\uD574\uC11C\uB77C\uB3C4 \uB354
      \uC774\uC0C1 \uCE68\uBB35\uD574\uC11C\uB294 \uC548\uB41C\uB2E4 "
    Text_En: For their sake, I had to speak.
    Text_ZhHans: "\u4E3A\u4E86\u4ED6\u4EEC\uFF0C\u6211\u4E5F\u4E0D\u80FD\u518D\u6C89\u9ED8\u3002"
    Text_Ja: "\u305D\u306E\u4EBA\u305F\u3061\u306E\u305F\u3081\u306B\u3082\u3001\u9ED9\u3063\u3066\u306F\u3044\u3089\u308C\u306A\u3044\u3002"
    Text_Es: "Por ellos, ten\xEDa que hablar."
    Text_Pt: Por essas pessoas, eu precisava falar.
    Text_Ru: "\u0425\u043E\u0442\u044F \u0431\u044B \u0440\u0430\u0434\u0438 \u043D\u0438\u0445
      \u043D\u0435\u043B\u044C\u0437\u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u043E\u043B\u0447\u0430\u0442\u044C."
  - ID: Chapter_6_Back_26
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC9D1\uC5D0 \uB3CC\uC544\uAC00\uBA74 \uACBD\uCC30\uC5D0 \uC2E0\uACE0\uD558\uC790."
    Text_En: I'd call the police when I got home.
    Text_ZhHans: "\u56DE\u5BB6\u540E\u5C31\u62A5\u8B66\u5427\u3002"
    Text_Ja: "\u5BB6\u306B\u5E30\u3063\u305F\u3089\u3001\u8B66\u5BDF\u306B\u77E5\u3089\u305B\u3088\u3046\u3002"
    Text_Es: "Llamar\xEDa a la polic\xEDa al volver a casa."
    Text_Pt: "Ao chegar em casa, ligaria para a pol\xEDcia."
    Text_Ru: "\u0412\u0435\u0440\u043D\u0443\u0441\u044C \u0434\u043E\u043C\u043E\u0439
      \u0438 \u043F\u043E\u0437\u0432\u043E\u043D\u044E \u0432 \u043F\u043E\u043B\u0438\u0446\u0438\u044E."
  - ID: Chapter_6_Back_27
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC218\uCCA9\uC744 \uB530\uB77C \uC5B4\uB514\uC5D0 \uAC14\uB294\uC9C0,"
    Text_En: Where the notebook had led me.
    Text_ZhHans: "\u6211\u8DDF\u7740\u7B14\u8BB0\u53BB\u4E86\u54EA\u91CC\uFF0C"
    Text_Ja: "\u624B\u5E33\u3092\u305F\u3069\u3063\u3066\u3001\u3069\u3053\u3078\u884C\u3063\u305F\u306E\u304B\u3002"
    Text_Es: "Ad\xF3nde me hab\xEDa llevado el cuaderno."
    Text_Pt: Aonde fui seguindo o caderno.
    Text_Ru: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0443, \u043A\u0443\u0434\u0430
      \u043F\u0440\u0438\u0432\u0435\u043B\u0438 \u043C\u0435\u043D\u044F \u0437\u0430\u043F\u0438\u0441\u0438."
  - ID: Chapter_6_Back_28
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uADF8\uACF3\uC5D0\uC11C \uBB34\uC5C7\uC744 \uBD24\uB294\uC9C0."
    Text_En: What I'd seen there.
    Text_ZhHans: "\u53C8\u5728\u90A3\u91CC\u770B\u5230\u4E86\u4EC0\u4E48\u3002"
    Text_Ja: "\u305D\u3053\u3067\u3001\u4F55\u3092\u898B\u305F\u306E\u304B\u3002"
    Text_Es: "Qu\xE9 hab\xEDa visto all\xED."
    Text_Pt: "O que encontrei l\xE1."
    Text_Ru: "\u0418 \u0447\u0442\u043E \u044F \u0442\u0430\u043C \u0443\u0432\u0438\u0434\u0435\u043B\u0430."
  - ID: Chapter_6_Back_29
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uB0B4\uAC00 \uC544\uB294 \uAC83\uBD80\uD130 \uB9D0\uD558\uBA74 \uB41C\uB2E4."
    Text_En: I'd start with what I knew.
    Text_ZhHans: "\u5148\u8BF4\u51FA\u81EA\u5DF1\u77E5\u9053\u7684\u5C31\u597D\u3002"
    Text_Ja: "\u81EA\u5206\u306E\u77E5\u3063\u3066\u3044\u308B\u3053\u3068\u304B\u3089\u8A71\u305B\u3070\u3044\u3044\u3002"
    Text_Es: "Bastaba con contar lo que sab\xEDa."
    Text_Pt: "Bastava come\xE7ar pelo que eu sabia."
    Text_Ru: "\u041D\u0430\u0447\u043D\u0443 \u0441 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E
      \u0437\u043D\u0430\u044E."
  - ID: Chapter_6_Back_30
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC544\uBE60."
    Text_En: Dad.
    Text_ZhHans: "\u7238\u7238\u3002"
    Text_Ja: "\u304A\u7236\u3055\u3093\u3002"
    Text_Es: "Pap\xE1."
    Text_Pt: Papai.
    Text_Ru: "\u041F\u0430\u043F\u0430."
  - ID: Chapter_6_Back_31
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uC624\uB298\uC740 \uB098 \uBA3C\uC800 \uAC08\uAC8C."
    Text_En: I'm going on ahead today.
    Text_ZhHans: "\u4ECA\u5929\u6211\u5148\u8D70\u4E86\u3002"
    Text_Ja: "\u4ECA\u65E5\u306F\u3001\u79C1\u304C\u5148\u306B\u884C\u304F\u306D\u3002"
    Text_Es: Hoy me voy yo primero.
    Text_Pt: Hoje eu vou na frente.
    Text_Ru: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0443\u0439\u0434\u0443
      \u043F\u0435\u0440\u0432\u043E\u0439."
  - ID: Chapter_6_Back_32
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uB098\uB294 \uBCA4\uCE58\uC5D0\uC11C \uC77C\uC5B4\uB098"
    Text_En: I rose from the bench.
    Text_ZhHans: "\u6211\u4ECE\u957F\u6905\u4E0A\u7AD9\u8D77\u6765\uFF0C"
    Text_Ja: "\u79C1\u306F\u30D9\u30F3\u30C1\u304B\u3089\u7ACB\u3061\u4E0A\u304C\u3063\u305F\u3002"
    Text_Es: "Me levant\xE9 del banco."
    Text_Pt: Levantei do banco.
    Text_Ru: "\u042F \u0432\u0441\u0442\u0430\u043B\u0430 \u0441\u043E \u0441\u043A\u0430\u043C\u0435\u0439\u043A\u0438."
  - ID: Chapter_6_Back_33
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uBC1C\uBC11\uC744 \uBCF4\uBA70 \uCC9C\uCC9C\uD788 \uAC78\uC5C8\uC9C0\uB9CC"
    Text_En: Eyes lowered, I walked slowly.
    Text_ZhHans: "\u4F4E\u7740\u5934\uFF0C\u6162\u6162\u5F80\u524D\u8D70\u3002"
    Text_Ja: "\u8DB3\u5143\u3092\u898B\u306A\u304C\u3089\u3001\u3086\u3063\u304F\u308A\u6B69\u3044\u305F\u3051\u308C\u3069\u3001"
    Text_Es: "Camin\xE9 despacio, mirando al suelo."
    Text_Pt: "Caminhei devagar, olhando para o ch\xE3o."
    Text_Ru: "\u0428\u043B\u0430 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u0433\u043B\u044F\u0434\u044F \u043F\u043E\u0434 \u043D\u043E\u0433\u0438,"
  - ID: Chapter_6_Back_34
    Chapter_Id: 6_Back
    Speaker: Daughter
    Text_Kr: "\uB4A4\uC5D0\uC11C \uB098\uB97C \uBD80\uB974\uB294 \uC18C\uB9AC\uB294
      \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    Text_En: No voice called me back.
    Text_ZhHans: "\u8EAB\u540E\u59CB\u7EC8\u6CA1\u6709\u4EBA\u53EB\u4F4F\u6211\u3002"
    Text_Ja: "\u5F8C\u308D\u304B\u3089\u547C\u3073\u6B62\u3081\u308B\u58F0\u306F\u3057\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "Nadie me llam\xF3 desde atr\xE1s."
    Text_Pt: Nenhuma voz me chamou de volta.
    Text_Ru: "\u043D\u043E \u0441\u0437\u0430\u0434\u0438 \u043C\u0435\u043D\u044F
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043E\u043A\u043B\u0438\u043A\u043D\u0443\u043B."
  - ID: Intro_1
    Chapter_Id: Intro
    Speaker: Father
    Text_Kr: "\uB208\uC55E\uC5D0\uB294 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uB2E4."
    Text_En: There was nothing before me.
    Text_ZhHans: "\u773C\u524D\u4EC0\u4E48\u4E5F\u6CA1\u6709\u3002"
    Text_Ja: "\u76EE\u306E\u524D\u306B\u306F\u4F55\u3082\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "No hab\xEDa nada ante mis ojos."
    Text_Pt: "N\xE3o havia nada diante de mim."
    Text_Ru: "\u041F\u0435\u0440\u0435\u0434\u043E \u043C\u043D\u043E\u0439 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0431\u044B\u043B\u043E."
  - ID: Intro_2
    Chapter_Id: Intro
    Speaker: Father
    Text_Kr: "\uC5B4\uB514\uC5D0\uC11C \uC654\uB294\uC9C0,"
    Text_En: I couldn't remember where I'd been,
    Text_ZhHans: "\u6211\u4E0D\u8BB0\u5F97\u81EA\u5DF1\u4ECE\u54EA\u91CC\u6765\uFF0C"
    Text_Ja: "\u3069\u3053\u304B\u3089\u6765\u305F\u306E\u304B\u3001"
    Text_Es: "No recordaba de d\xF3nde ven\xEDa"
    Text_Pt: "N\xE3o lembrava de onde tinha vindo"
    Text_Ru: "\u041D\u0435 \u043F\u043E\u043C\u043D\u044E, \u043E\u0442\u043A\u0443\u0434\u0430
      \u044F \u0437\u0434\u0435\u0441\u044C."
  - ID: Intro_3
    Chapter_Id: Intro
    Speaker: Father
    Text_Kr: "\uC5B4\uB514\uB85C \uAC00\uB824\uB358 \uAC74\uC9C0\uB3C4 \uAE30\uC5B5\uB098\uC9C0
      \uC54A\uC558\uB2E4."
    Text_En: or where I'd meant to go.
    Text_ZhHans: "\u4E5F\u4E0D\u8BB0\u5F97\u539F\u672C\u8981\u53BB\u54EA\u91CC\u3002"
    Text_Ja: "\u3069\u3053\u3078\u5411\u304B\u3046\u3064\u3082\u308A\u3060\u3063\u305F\u306E\u304B\u3082\u601D\u3044\u51FA\u305B\u306A\u3044\u3002"
    Text_Es: "ni ad\xF3nde me dirig\xEDa."
    Text_Pt: nem para onde pretendia ir.
    Text_Ru: "\u0418 \u043A\u0443\u0434\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
      \u0438\u0434\u0442\u0438 \u2014 \u0442\u043E\u0436\u0435."
  - ID: Intro_4
    Chapter_Id: Intro
    Speaker: Father
    Text_Kr: "\uBB34\uC5B8\uAC00 \uC78A\uACE0 \uC788\uB2E4\uB294 \uC0DD\uAC01\uB9CC
      \uB4E4\uC5C8\uB2E4."
    Text_En: Only that I'd forgotten something.
    Text_ZhHans: "\u53EA\u89C9\u5F97\u81EA\u5DF1\u5FD8\u8BB0\u4E86\u4EC0\u4E48\u3002"
    Text_Ja: "\u4F55\u304B\u3092\u5FD8\u308C\u3066\u3044\u308B\u6C17\u304C\u3057\u305F\u3002"
    Text_Es: "Solo sent\xEDa que hab\xEDa olvidado algo."
    Text_Pt: "S\xF3 sentia que tinha esquecido algo."
    Text_Ru: "\u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u043E,
      \u0447\u0442\u043E \u0437\u0430\u0431\u044B\u0442\u043E \u0447\u0442\u043E-\u0442\u043E
      \u0432\u0430\u0436\u043D\u043E\u0435."
  - ID: Intro_5
    Chapter_Id: Intro
    Speaker: Father
    Text_Kr: "\uADF8\uB0E5 \uC9C0\uB098\uCCD0\uC11C\uB294 \uC548 \uB418\uB294 \uAC83\uC744."
    Text_En: Something I couldn't leave behind.
    Text_ZhHans: "\u5FD8\u8BB0\u4E86\u4E0D\u80FD\u5C31\u8FD9\u6837\u9519\u8FC7\u7684\u4E8B\u3002"
    Text_Ja: "\u305D\u306E\u307E\u307E\u901A\u308A\u904E\u304E\u3066\u306F\u3044\u3051\u306A\u3044\u4F55\u304B\u3092\u3002"
    Text_Es: "Algo que no pod\xEDa dejar atr\xE1s."
    Text_Pt: "Algo que n\xE3o podia deixar para tr\xE1s."
    Text_Ru: "\u0422\u043E, \u043C\u0438\u043C\u043E \u0447\u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F
      \u043F\u0440\u043E\u0439\u0442\u0438."
  - ID: Intro_6
    Chapter_Id: Intro
    Speaker: Father
    Text_Kr: "\uC5B4\uB460 \uC18D\uC5D0\uC11C \uC791\uC740 \uBE5B\uC774 \uAE5C\uBE61\uC600\uB2E4."
    Text_En: A small light flickered in the dark.
    Text_ZhHans: "\u9ED1\u6697\u4E2D\uFF0C\u4E00\u70B9\u5FAE\u5149\u95EA\u70C1\u3002"
    Text_Ja: "\u6697\u95C7\u306E\u4E2D\u3001\u5C0F\u3055\u306A\u5149\u304C\u307E\u305F\u305F\u3044\u305F\u3002"
    Text_Es: "Una peque\xF1a luz brill\xF3 en la oscuridad."
    Text_Pt: Uma pequena luz piscou no escuro.
    Text_Ru: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u0437\u0430\u043C\u0435\u0440\u0446\u0430\u043B
      \u043E\u0433\u043E\u043D\u0451\u043A."
  - ID: Intro_7
    Chapter_Id: Intro
    Speaker: Father
    Text_Kr: "\uB0AF\uC120 \uBE5B\uC778\uB370\uB3C4"
    Text_En: Though it was unfamiliar,
    Text_ZhHans: "\u660E\u660E\u662F\u964C\u751F\u7684\u5149\uFF0C"
    Text_Ja: "\u898B\u77E5\u3089\u306C\u5149\u306A\u306E\u306B\u3001"
    Text_Es: Aunque me resultaba desconocida,
    Text_Pt: "Mesmo sem reconhec\xEA-la,"
    Text_Ru: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u0441\u0432\u0435\u0442,"
  - ID: Intro_8
    Chapter_Id: Intro
    Speaker: Father
    Text_Kr: "\uC774\uC0C1\uD558\uAC8C \uB208\uC744 \uB5C4 \uC218 \uC5C6\uC5C8\uB2E4."
    Text_En: I couldn't look away.
    Text_ZhHans: "\u5374\u83AB\u540D\u8BA9\u6211\u79FB\u4E0D\u5F00\u76EE\u5149\u3002"
    Text_Ja: "\u306A\u305C\u304B\u76EE\u3092\u96E2\u305B\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "no pod\xEDa apartar la mirada."
    Text_Pt: "eu n\xE3o conseguia desviar o olhar."
    Text_Ru: "\u043D\u043E \u043E\u0442\u0432\u0435\u0441\u0442\u0438 \u0432\u0437\u0433\u043B\u044F\u0434
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u043E\u0441\u044C."
  - ID: Intro_9
    Chapter_Id: Intro
    Speaker: Father
    Text_Kr: "\uC870\uAE08 \uB354 \uAC00\uAE4C\uC774\uC11C \uBCF4\uACE0 \uC2F6\uC5C8\uB2E4."
    Text_En: I wanted to see it up close.
    Text_ZhHans: "\u6211\u60F3\u9760\u8FD1\u4E9B\u770B\u770B\u3002"
    Text_Ja: "\u3082\u3046\u5C11\u3057\u8FD1\u304F\u3067\u898B\u305F\u304B\u3063\u305F\u3002"
    Text_Es: "Quer\xEDa verla m\xE1s de cerca."
    Text_Pt: "Queria v\xEA-la mais de perto."
    Text_Ru: "\u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0435\u0433\u043E \u043F\u043E\u0431\u043B\u0438\u0436\u0435."
  - ID: AfterChapter_1_1
    Chapter_Id: AfterChapter_1
    Speaker: Father
    Text_Kr: "\uC7A5\uBA74\uC740 \uC0AC\uB77C\uC84C\uC9C0\uB9CC"
    Text_En: The scene faded,
    Text_ZhHans: "\u753B\u9762\u6D88\u5931\u4E86\uFF0C"
    Text_Ja: "\u5149\u666F\u306F\u6D88\u3048\u305F\u304C\u3001"
    Text_Es: "La escena desapareci\xF3,"
    Text_Pt: A cena desapareceu,
    Text_Ru: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0438\u0441\u0447\u0435\u0437\u043B\u0430,"
  - ID: AfterChapter_1_2
    Chapter_Id: AfterChapter_1
    Speaker: Father
    Text_Kr: "\uBAA9\uC18C\uB9AC\uB294 \uD55C\uB3D9\uC548 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    Text_En: but the voices lingered.
    Text_ZhHans: "\u58F0\u97F3\u5374\u4E45\u4E45\u6CA1\u6709\u6563\u53BB\u3002"
    Text_Ja: "\u58F0\u306F\u3057\u3070\u3089\u304F\u6B8B\u3063\u3066\u3044\u305F\u3002"
    Text_Es: pero las voces permanecieron.
    Text_Pt: mas as vozes ficaram por um tempo.
    Text_Ru: "\u043D\u043E \u0433\u043E\u043B\u043E\u0441\u0430 \u0435\u0449\u0451
      \u0434\u043E\u043B\u0433\u043E \u0437\u0432\u0443\u0447\u0430\u043B\u0438."
  - ID: AfterChapter_1_3
    Chapter_Id: AfterChapter_1
    Speaker: Father
    Text_Kr: "\uAE30\uB2E4\uB9AC\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4\uB294 \uAC83."
    Text_En: Someone was waiting.
    Text_ZhHans: "\u6709\u4EBA\u5728\u7B49\u5F85\u3002"
    Text_Ja: "\u5F85\u3063\u3066\u3044\u308B\u4EBA\u304C\u3044\u308B\u3002"
    Text_Es: "Hab\xEDa alguien esperando."
    Text_Pt: "Havia algu\xE9m esperando."
    Text_Ru: "\u041A\u0442\u043E-\u0442\u043E \u0436\u0434\u0451\u0442."
  - ID: AfterChapter_1_4
    Chapter_Id: AfterChapter_1
    Speaker: Father
    Text_Kr: "\uADF8 \uC0AC\uC2E4\uC774 \uC65C \uC774\uB807\uAC8C \uB9C8\uC74C\uC5D0
      \uAC78\uB9AC\uB294\uC9C0"
    Text_En: Why did that trouble me so much?
    Text_ZhHans: "\u4E3A\u4EC0\u4E48\u8FD9\u4EF6\u4E8B\u8BA9\u6211\u5982\u6B64\u5728\u610F\uFF0C"
    Text_Ja: "\u305D\u306E\u3053\u3068\u304C\u3001\u306A\u305C\u3053\u3093\u306A\u306B\u6C17\u306B\u306A\u308B\u306E\u304B\u3001"
    Text_Es: "\xBFPor qu\xE9 me inquietaba tanto?"
    Text_Pt: Por que aquilo me incomodava tanto?
    Text_Ru: "\u041F\u043E\u0447\u0435\u043C\u0443 \u044D\u0442\u043E \u0442\u0430\u043A
      \u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442?"
  - ID: AfterChapter_1_5
    Chapter_Id: AfterChapter_1
    Speaker: Father
    Text_Kr: "\uC54C \uC218 \uC5C6\uC5C8\uB2E4."
    Text_En: I couldn't say.
    Text_ZhHans: "\u6211\u4E5F\u8BF4\u4E0D\u6E05\u3002"
    Text_Ja: "\u5206\u304B\u3089\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "No lo sab\xEDa."
    Text_Pt: "Eu n\xE3o sabia."
    Text_Ru: "\u041D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E."
  - ID: AfterChapter_1_6
    Chapter_Id: AfterChapter_1
    Speaker: Father
    Text_Kr: "\uACE0\uAC1C\uB97C \uB4E4\uC790 \uB2E4\uB978 \uBE5B\uC774 \uBCF4\uC600\uB2E4."
    Text_En: I looked up and saw another light.
    Text_ZhHans: "\u62AC\u8D77\u5934\uFF0C\u53C8\u770B\u89C1\u4E86\u53E6\u4E00\u675F\u5149\u3002"
    Text_Ja: "\u9854\u3092\u4E0A\u3052\u308B\u3068\u3001\u5225\u306E\u5149\u304C\u898B\u3048\u305F\u3002"
    Text_Es: "Alc\xE9 la vista y vi otra luz."
    Text_Pt: Ergui os olhos e vi outra luz.
    Text_Ru: "\u0412\u0432\u0435\u0440\u0445\u0443 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u0434\u0440\u0443\u0433\u043E\u0439 \u043E\u0433\u043E\u043D\u0451\u043A."
  - ID: AfterChapter_1_7
    Chapter_Id: AfterChapter_1
    Speaker: Father
    Text_Kr: "\uC544\uC9C1 \uBCF4\uC9C0 \uBABB\uD55C \uC774\uC57C\uAE30\uAC00 \uB0A8\uC544
      \uC788\uC5C8\uB2E4."
    Text_En: There was more I hadn't seen.
    Text_ZhHans: "\u8FD8\u6709\u6211\u5C1A\u672A\u770B\u8FC7\u7684\u6545\u4E8B\u3002"
    Text_Ja: "\u307E\u3060\u898B\u3066\u3044\u306A\u3044\u7269\u8A9E\u304C\u6B8B\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "A\xFAn quedaban historias por descubrir."
    Text_Pt: "Ainda havia hist\xF3rias que eu n\xE3o tinha visto."
    Text_Ru: "\u041E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0435\u0449\u0451
      \u043D\u0435\u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0435
      \u0438\u0441\u0442\u043E\u0440\u0438\u0438."
  - ID: AfterChapter_2_1
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uCC28 \uC548\uC5D0 \uC788\uB358 \uC0AC\uB78C\uB4E4\uC774 \uB2EC\uB77C\uC84C\uB2E4."
    Text_En: The people in the car had changed.
    Text_ZhHans: "\u8F66\u91CC\u7684\u4EBA\u53D8\u4E86\u3002"
    Text_Ja: "\u8ECA\u306E\u4E2D\u306B\u3044\u308B\u4EBA\u305F\u3061\u304C\u5909\u308F\u3063\u305F\u3002"
    Text_Es: "Las personas del coche hab\xEDan cambiado."
    Text_Pt: As pessoas dentro do carro mudaram.
    Text_Ru: "\u041B\u044E\u0434\u0438 \u0432 \u043C\u0430\u0448\u0438\u043D\u0435
      \u0441\u043C\u0435\u043D\u0438\u043B\u0438\u0441\u044C."
  - ID: AfterChapter_2_2
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uC870\uAE08 \uC804\uAE4C\uC9C0 \uB4E4\uB9AC\uB358 \uB300\uD654 \uB300\uC2E0"
    Text_En: The earlier conversation was gone.
    Text_ZhHans: "\u521A\u624D\u7684\u4EA4\u8C08\u4E0D\u89C1\u4E86\uFF0C"
    Text_Ja: "\u3055\u3063\u304D\u307E\u3067\u306E\u4F1A\u8A71\u306B\u4EE3\u308F\u3063\u3066\u3001"
    Text_Es: "En lugar de aquella conversaci\xF3n,"
    Text_Pt: No lugar da conversa de antes,
    Text_Ru: "\u0412\u043C\u0435\u0441\u0442\u043E \u043F\u0440\u0435\u0436\u043D\u0435\u0433\u043E
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430"
  - ID: AfterChapter_2_3
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uB204\uAD70\uAC00\uB97C \uCC3E\uB294 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    Text_En: Now they were searching for someone.
    Text_ZhHans: "\u53D6\u800C\u4EE3\u4E4B\u7684\u662F\u5BFB\u627E\u67D0\u4EBA\u7684\u58F0\u97F3\u3002"
    Text_Ja: "\u8AB0\u304B\u3092\u63A2\u3059\u58F0\u304C\u805E\u3053\u3048\u305F\u3002"
    Text_Es: "o\xEDa voces que buscaban a alguien."
    Text_Pt: "ouvi vozes procurando algu\xE9m."
    Text_Ru: "\u0437\u0432\u0443\u0447\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0441\u0430
      \u0442\u0435\u0445, \u043A\u0442\u043E \u043A\u043E\u0433\u043E-\u0442\u043E
      \u0438\u0441\u043A\u0430\u043B."
  - ID: AfterChapter_2_4
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uC774 \uC7A5\uBA74\uB4E4\uC740"
    Text_En: These scenes...
    Text_ZhHans: "\u8FD9\u4E9B\u753B\u9762\uFF0C"
    Text_Ja: "\u3053\u306E\u5149\u666F\u306F\u3001"
    Text_Es: Estas escenas...
    Text_Pt: Estas cenas...
    Text_Ru: "\u042D\u0442\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u044B..."
  - ID: AfterChapter_2_5
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uC77C\uC5B4\uB09C \uC21C\uC11C\uB300\uB85C \uBCF4\uC774\uB294 \uAC8C
      \uC544\uB2CC \uAC83 \uAC19\uC558\uB2E4."
    Text_En: They didn't seem to be in order.
    Text_ZhHans: "\u4F3C\u4E4E\u5E76\u4E0D\u662F\u6309\u53D1\u751F\u7684\u987A\u5E8F\u51FA\u73B0\u7684\u3002"
    Text_Ja: "\u8D77\u304D\u305F\u9806\u306B\u898B\u3048\u3066\u3044\u308B\u308F\u3051\u3067\u306F\u306A\u3044\u3089\u3057\u3044\u3002"
    Text_Es: "No parec\xEDan seguir el orden de los hechos."
    Text_Pt: "N\xE3o pareciam seguir a ordem dos fatos."
    Text_Ru: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D\u0438 \u0438\u0434\u0443\u0442
      \u043D\u0435 \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443."
  - ID: AfterChapter_2_6
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uADF8 \uC0AC\uC774\uC5D0 \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0"
    Text_En: What had happened between them?
    Text_ZhHans: "\u5728\u5B83\u4EEC\u4E4B\u95F4\u53D1\u751F\u4E86\u4EC0\u4E48\uFF0C"
    Text_Ja: "\u305D\u306E\u9593\u306B\u4F55\u304C\u3042\u3063\u305F\u306E\u304B\u3001"
    Text_Es: "\xBFQu\xE9 hab\xEDa ocurrido entre ellas?"
    Text_Pt: O que aconteceu entre elas?
    Text_Ru: "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438,"
  - ID: AfterChapter_2_7
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uC544\uC9C1 \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
    Text_En: I still didn't know.
    Text_ZhHans: "\u6211\u8FD8\u4E0D\u77E5\u9053\u3002"
    Text_Ja: "\u307E\u3060\u5206\u304B\u3089\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "A\xFAn no lo sab\xEDa."
    Text_Pt: "Eu ainda n\xE3o sabia."
    Text_Ru: "\u043F\u043E\u043A\u0430 \u043D\u0435\u044F\u0441\u043D\u043E."
  - ID: AfterChapter_2_8
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uB0A8\uC740 \uBE5B\uB3C4 \uC0B4\uD3B4\uBD10\uC57C\uACA0\uB2E4."
    Text_En: I'd have to follow the other lights.
    Text_ZhHans: "\u5F97\u7EE7\u7EED\u770B\u770B\u5269\u4E0B\u7684\u5149\u3002"
    Text_Ja: "\u6B8B\u308A\u306E\u5149\u3082\u898B\u3066\u307F\u3088\u3046\u3002"
    Text_Es: "Tendr\xEDa que mirar las otras luces."
    Text_Pt: Precisava olhar as outras luzes.
    Text_Ru: "\u041D\u0443\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0438 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043E\u0433\u043D\u0438."
  - ID: AfterChapter_2_9
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uBAA8\uB450 \uBCF4\uACE0 \uB098\uBA74"
    Text_En: Once I'd seen them all,
    Text_ZhHans: "\u7B49\u5168\u90E8\u770B\u8FC7\u4EE5\u540E\uFF0C"
    Text_Ja: "\u3059\u3079\u3066\u3092\u898B\u308C\u3070\u3001"
    Text_Es: Cuando las hubiera visto todas,
    Text_Pt: Depois de ver todas,
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430 \u043F\u0435\u0440\u0435\u0434 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u043F\u0440\u043E\u0439\u0434\u0443\u0442 \u0432\u0441\u0435,"
  - ID: AfterChapter_2_10
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uBB34\uC5C7\uC774 \uBA3C\uC800\uC600\uB294\uC9C0"
    Text_En: I could work out what came first
    Text_ZhHans: "\u4E5F\u8BB8\u5C31\u80FD\u5206\u6E05\u5148\u540E\uFF0C"
    Text_Ja: "\u4F55\u304C\u5148\u3060\u3063\u305F\u306E\u304B\u3001"
    Text_Es: "podr\xEDa descubrir qu\xE9 ocurri\xF3 primero"
    Text_Pt: poderia descobrir o que veio primeiro
    Text_Ru: "\u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u043E\u043D\u044F\u0442\u043D\u043E,
      \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u0440\u0430\u043D\u044C\u0448\u0435."
  - ID: AfterChapter_2_11
    Chapter_Id: AfterChapter_2
    Speaker: Father
    Text_Kr: "\uD558\uB098\uC529 \uC774\uC5B4\uBCFC \uC218 \uC788\uC744 \uAC83\uC774\uB2E4."
    Text_En: and connect them, one by one.
    Text_ZhHans: "\u628A\u5B83\u4EEC\u4E00\u4E00\u8FDE\u8D77\u6765\u3002"
    Text_Ja: "\u4E00\u3064\u305A\u3064\u3064\u306A\u3052\u3089\u308C\u308B\u306F\u305A\u3060\u3002"
    Text_Es: y unirlas una por una.
    Text_Pt: "e ligar uma \xE0 outra."
    Text_Ru: "\u0422\u043E\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442
      \u0441\u0432\u044F\u0437\u0430\u0442\u044C \u0438\u0445 \u0432\u043E\u0435\u0434\u0438\u043D\u043E."
  - ID: AfterChapter_6_1
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uB9C8\uC9C0\uB9C9 \uC7A5\uBA74\uC774 \uC0AC\uB77C\uC84C\uB2E4."
    Text_En: The last scene faded.
    Text_ZhHans: "\u6700\u540E\u7684\u753B\u9762\u6D88\u5931\u4E86\u3002"
    Text_Ja: "\u6700\u5F8C\u306E\u5149\u666F\u304C\u6D88\u3048\u305F\u3002"
    Text_Es: "La \xFAltima escena desapareci\xF3."
    Text_Pt: "A \xFAltima cena desapareceu."
    Text_Ru: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u0430
      \u0438\u0441\u0447\u0435\u0437\u043B\u0430."
  - ID: AfterChapter_6_2
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uD769\uC5B4\uC838 \uC788\uB358 \uBE5B\uB4E4\uC774 \uB208\uC55E\uC5D0
      \uB0A8\uC558\uB2E4."
    Text_En: Scattered lights remained before me.
    Text_ZhHans: "\u6563\u843D\u7684\u5149\u7559\u5728\u773C\u524D\u3002"
    Text_Ja: "\u6563\u3089\u3070\u3063\u305F\u5149\u304C\u3001\u76EE\u306E\u524D\u306B\u6B8B\u3063\u305F\u3002"
    Text_Es: "Quedaron luces dispersas ante m\xED."
    Text_Pt: Luzes espalhadas ficaram diante de mim.
    Text_Ru: "\u041F\u0435\u0440\u0435\u0434\u043E \u043C\u043D\u043E\u0439 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0440\u043E\u0441\u0441\u044B\u043F\u0438 \u043E\u0433\u043D\u0435\u0439."
  - ID: AfterChapter_6_3
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uB204\uAD70\uAC00\uB294 \uAE30\uB2E4\uB838\uACE0,"
    Text_En: Someone had waited.
    Text_ZhHans: "\u6709\u4EBA\u7B49\u5F85\uFF0C"
    Text_Ja: "\u8AB0\u304B\u306F\u5F85\u3061\u3001"
    Text_Es: "Alguien hab\xEDa esperado."
    Text_Pt: "Algu\xE9m esperou."
    Text_Ru: "\u041A\u0442\u043E-\u0442\u043E \u0436\u0434\u0430\u043B."
  - ID: AfterChapter_6_4
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uB204\uAD70\uAC00\uB294 \uCC3E\uC544 \uB098\uC130\uB2E4."
    Text_En: Someone had gone searching.
    Text_ZhHans: "\u6709\u4EBA\u5BFB\u627E\u3002"
    Text_Ja: "\u8AB0\u304B\u306F\u63A2\u3057\u306B\u51FA\u305F\u3002"
    Text_Es: "Alguien hab\xEDa salido a buscar."
    Text_Pt: "Algu\xE9m saiu \xE0 procura."
    Text_Ru: "\u041A\u0442\u043E-\u0442\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0438\u0441\u043A\u0438."
  - ID: AfterChapter_6_5
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uADF8\uB4E4\uC774 \uC9C0\uB098\uC628 \uC2DC\uAC04\uC740"
    Text_En: The lives they'd led
    Text_ZhHans: "\u4ED6\u4EEC\u8D70\u8FC7\u7684\u65F6\u95F4\uFF0C"
    Text_Ja: "\u5F7C\u3089\u304C\u305F\u3069\u3063\u305F\u6642\u9593\u306F\u3001"
    Text_Es: "Sus vidas no hab\xEDan transcurrido"
    Text_Pt: O tempo que viveram
    Text_Ru: "\u041F\u0440\u043E\u0436\u0438\u0442\u043E\u0435 \u0438\u043C\u0438
      \u0432\u0440\u0435\u043C\u044F"
  - ID: AfterChapter_6_6
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uB0B4\uAC00 \uBCF8 \uC21C\uC11C\uC640 \uAC19\uC9C0 \uC54A\uC558\uB2E4."
    Text_En: hadn't unfolded in the order I'd seen.
    Text_ZhHans: "\u548C\u6211\u770B\u5230\u7684\u987A\u5E8F\u5E76\u4E0D\u76F8\u540C\u3002"
    Text_Ja: "\u79C1\u304C\u898B\u305F\u9806\u756A\u3068\u306F\u9055\u3063\u3066\u3044\u305F\u3002"
    Text_Es: "en el orden en que las hab\xEDa visto."
    Text_Pt: "n\xE3o seguia a ordem em que eu o vi."
    Text_Ru: "\u0448\u043B\u043E \u043D\u0435 \u0432 \u0442\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435,
      \u0432 \u043A\u0430\u043A\u043E\u043C \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u043B\u0438
      \u043A\u0430\u0440\u0442\u0438\u043D\u044B."
  - ID: AfterChapter_6_7
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uC5B4\uB514\uC5D0\uC11C \uC2DC\uC791\uB41C \uC77C\uC774\uC5C8\uC744\uAE4C."
    Text_En: Where had it all begun?
    Text_ZhHans: "\u8FD9\u4E00\u5207\u662F\u4ECE\u54EA\u91CC\u5F00\u59CB\u7684\uFF1F"
    Text_Ja: "\u3069\u3053\u304B\u3089\u59CB\u307E\u3063\u305F\u3053\u3068\u306A\u306E\u3060\u308D\u3046\u3002"
    Text_Es: "\xBFD\xF3nde hab\xEDa empezado todo?"
    Text_Pt: "Onde tudo tinha come\xE7ado?"
    Text_Ru: "\u0421 \u0447\u0435\u0433\u043E \u0436\u0435 \u0432\u0441\u0451 \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C?"
  - ID: AfterChapter_6_8
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uD558\uB098\uC529 \uC774\uC5B4\uBD10\uC57C \uD588\uB2E4."
    Text_En: I had to connect the pieces.
    Text_ZhHans: "\u6211\u5F97\u628A\u5B83\u4EEC\u4E00\u4E00\u8FDE\u8D77\u6765\u3002"
    Text_Ja: "\u4E00\u3064\u305A\u3064\u3001\u3064\u306A\u3050\u5FC5\u8981\u304C\u3042\u3063\u305F\u3002"
    Text_Es: "Deb\xEDa unir cada pieza."
    Text_Pt: Precisava juntar cada parte.
    Text_Ru: "\u041D\u0443\u0436\u043D\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C
      \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u043E\u0434\u043D\u043E \u0437\u0430
      \u0434\u0440\u0443\u0433\u0438\u043C."
  - ID: AfterChapter_6_9
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uBCC4\uACFC \uBCC4 \uC0AC\uC774\uC5D0 \uC120\uC744 \uAE0B\uB4EF\uC774,"
    Text_En: Like drawing lines between stars.
    Text_ZhHans: "\u5C31\u50CF\u5728\u661F\u4E0E\u661F\u4E4B\u95F4\u753B\u7EBF\uFF0C"
    Text_Ja: "\u661F\u3068\u661F\u306E\u9593\u306B\u7DDA\u3092\u5F15\u304F\u3088\u3046\u306B\u3001"
    Text_Es: "Como trazar l\xEDneas entre estrellas."
    Text_Pt: "Como tra\xE7ar linhas entre estrelas."
    Text_Ru: "\u0421\u043B\u043E\u0432\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u043B\u0438\u043D\u0438\u0438 \u043C\u0435\u0436\u0434\u0443 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438."
  - ID: AfterChapter_6_10
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uBA3C\uC800 \uC788\uC5C8\uB358 \uC77C\uC5D0\uC11C"
    Text_En: From what happened first
    Text_ZhHans: "\u4ECE\u5148\u53D1\u751F\u7684\u4E8B\uFF0C"
    Text_Ja: "\u5148\u306B\u8D77\u304D\u305F\u3053\u3068\u304B\u3089\u3001"
    Text_Es: "Desde lo que ocurri\xF3 primero"
    Text_Pt: Do que aconteceu primeiro
    Text_Ru: "\u041E\u0442 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u0440\u0430\u043D\u044C\u0448\u0435,"
  - ID: AfterChapter_6_11
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uADF8\uB2E4\uC74C \uC77C\uB85C."
    Text_En: to what came next.
    Text_ZhHans: "\u8FDE\u5411\u63A5\u4E0B\u6765\u53D1\u751F\u7684\u4E8B\u3002"
    Text_Ja: "\u305D\u306E\u6B21\u306E\u51FA\u6765\u4E8B\u3078\u3002"
    Text_Es: "hasta lo que vino despu\xE9s."
    Text_Pt: para o que veio depois.
    Text_Ru: "\u043A \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u0431\u044B\u043B\u043E
      \u043F\u043E\u0442\u043E\u043C."
  - ID: AfterChapter_6_12
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uBAA8\uB4E0 \uC77C\uC744 \uB9DE\uCDB0\uBCF8\uB2E4\uBA74"
    Text_En: If I put it all together,
    Text_ZhHans: "\u5982\u679C\u80FD\u62FC\u51FA\u4E8B\u60C5\u7684\u5168\u8C8C\uFF0C"
    Text_Ja: "\u3059\u3079\u3066\u3092\u3064\u306A\u304E\u5408\u308F\u305B\u308C\u3070\u3001"
    Text_Es: Si lograba encajarlo todo,
    Text_Pt: Se conseguisse encaixar tudo,
    Text_Ru: "\u0415\u0441\u043B\u0438 \u0432\u0441\u0451 \u0432\u0441\u0442\u0430\u043D\u0435\u0442
      \u043D\u0430 \u0441\u0432\u043E\u0438 \u043C\u0435\u0441\u0442\u0430,"
  - ID: AfterChapter_6_13
    Chapter_Id: AfterChapter_6
    Speaker: Father
    Text_Kr: "\uB0B4 \uAE30\uC5B5\uB3C4 \uB3CC\uC544\uC62C \uAC83\uCC98\uB7FC \uB290\uAEF4\uC84C\uB2E4."
    Text_En: perhaps my memories would return.
    Text_ZhHans: "\u4E5F\u8BB8\u6211\u7684\u8BB0\u5FC6\u4E5F\u4F1A\u56DE\u6765\u3002"
    Text_Ja: "\u79C1\u306E\u8A18\u61B6\u3082\u623B\u308B\u6C17\u304C\u3057\u305F\u3002"
    Text_Es: "quiz\xE1 recuperar\xEDa mis recuerdos."
    Text_Pt: "talvez minhas mem\xF3rias voltassem."
    Text_Ru: "\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F
      \u0438 \u043C\u043E\u044F \u043F\u0430\u043C\u044F\u0442\u044C."
  - ID: AfterChapter_All_1
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC544\uC774\uC5D0\uAC8C \uBCC4\uC744 \uC54C\uB824\uC8FC\uB358 \uB0A0\uC774
      \uB5A0\uC62C\uB790\uB2E4."
    Text_En: I remembered showing her the stars.
    Text_ZhHans: "\u6211\u60F3\u8D77\u4E86\u6559\u5973\u513F\u8BA4\u661F\u661F\u7684\u90A3\u5929\u3002"
    Text_Ja: "\u5A18\u306B\u661F\u3092\u6559\u3048\u305F\u65E5\u3092\u601D\u3044\u51FA\u3057\u305F\u3002"
    Text_Es: "Record\xE9 el d\xEDa que le ense\xF1\xE9 las estrellas."
    Text_Pt: Lembrei do dia em que lhe mostrei as estrelas.
    Text_Ru: "\u042F \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B, \u043A\u0430\u043A
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u0434\u043E\u0447\u0435\u0440\u0438
      \u0437\u0432\u0451\u0437\u0434\u044B."
  - ID: AfterChapter_All_2
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB0B4\uAC00 \uAC00\uB9AC\uD0A8 \uACF3\uC744 \uCC3E\uACE0\uB3C4"
    Text_En: Even when she found the one I meant,
    Text_ZhHans: "\u5373\u4F7F\u627E\u5230\u4E86\u6211\u6307\u7684\u5730\u65B9\uFF0C"
    Text_Ja: "\u79C1\u306E\u6307\u3059\u5834\u6240\u3092\u898B\u3064\u3051\u3066\u3082\u3001"
    Text_Es: "Incluso al encontrar la que se\xF1alaba,"
    Text_Pt: Mesmo achando a que eu apontava,
    Text_Ru: "\u0414\u0430\u0436\u0435 \u043D\u0430\u0439\u0434\u044F \u0442\u0443,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u043B,"
  - ID: AfterChapter_All_3
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB9DE\uAC8C \uCC3E\uC558\uB294\uC9C0 \uBA87 \uBC88\uC774\uB098 \uBB3C\uC5B4\uBCF4\uACE4
      \uD588\uB2E4."
    Text_En: she'd ask again if she was right.
    Text_ZhHans: "\u5979\u8FD8\u662F\u4F1A\u53CD\u590D\u95EE\u6211\u627E\u5F97\u5BF9\u4E0D\u5BF9\u3002"
    Text_Ja: "\u5408\u3063\u3066\u3044\u308B\u304B\u4F55\u5EA6\u3082\u78BA\u304B\u3081\u3066\u304D\u305F\u3002"
    Text_Es: me preguntaba varias veces si era esa.
    Text_Pt: "ela perguntava v\xE1rias vezes se era aquela."
    Text_Ru: "\u043E\u043D\u0430 \u0432\u0441\u0451 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0430,
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043B\u0438 \u043D\u0430\u0448\u043B\u0430."
  - ID: AfterChapter_All_4
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uD55C\uB54C\uB294 \uBCC4\uC744 \uBC14\uB77C\uBCF4\uB294 \uC77C\uC744
      \uD558\uBA70"
    Text_En: Once, I'd dreamed of a life
    Text_ZhHans: "\u66FE\u7ECF\uFF0C\u6211\u4E5F\u60F3\u9760\u89C2\u661F"
    Text_Ja: "\u304B\u3064\u3066\u306F\u3001\u661F\u3092\u773A\u3081\u308B\u4ED5\u4E8B\u3067\u3001"
    Text_Es: "Una vez so\xF1\xE9 con ganarme la vida"
    Text_Pt: Um dia, sonhei em ganhar a vida
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044F \u043C\u0435\u0447\u0442\u0430\u043B
      \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C \u043D\u0430
      \u0436\u0438\u0437\u043D\u044C,"
  - ID: AfterChapter_All_5
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC0B4\uC544\uAC00\uACE0 \uC2F6\uC5C8\uB2E4."
    Text_En: spent studying the stars.
    Text_ZhHans: "\u5EA6\u8FC7\u81EA\u5DF1\u7684\u4E00\u751F\u3002"
    Text_Ja: "\u751F\u304D\u3066\u3044\u304D\u305F\u304B\u3063\u305F\u3002"
    Text_Es: observando las estrellas.
    Text_Pt: observando as estrelas.
    Text_Ru: "\u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044F \u0437\u0430 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438."
  - ID: AfterChapter_All_6
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB05D\uB0B4 \uC774\uB8E8\uC9C0 \uBABB\uD55C \uAFC8\uC774\uC5C8\uB2E4."
    Text_En: A dream I'd never fulfilled.
    Text_ZhHans: "\u90A3\u4E2A\u68A6\uFF0C\u7EC8\u7A76\u6CA1\u6709\u5B9E\u73B0\u3002"
    Text_Ja: "\u6700\u5F8C\u307E\u3067\u304B\u306A\u308F\u306A\u304B\u3063\u305F\u5922\u3060\u3002"
    Text_Es: "Un sue\xF1o que nunca cumpl\xED."
    Text_Pt: Um sonho que nunca realizei.
    Text_Ru: "\u042D\u0442\u0430 \u043C\u0435\u0447\u0442\u0430 \u0442\u0430\u043A
      \u0438 \u043D\u0435 \u0441\u0431\u044B\u043B\u0430\u0441\u044C."
  - ID: AfterChapter_All_7
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uADF8\uB798\uB3C4 \uC544\uC774\uAC00 \uC606\uC5D0 \uC549\uC544"
    Text_En: Yet with her sitting beside me,
    Text_ZhHans: "\u53EF\u5F53\u5973\u513F\u5750\u5728\u8EAB\u65C1\uFF0C"
    Text_Ja: "\u305D\u308C\u3067\u3082\u3001\u5A18\u304C\u96A3\u306B\u5EA7\u308A\u3001"
    Text_Es: Pero, cuando mi hija se sentaba a mi lado
    Text_Pt: Mas, nas noites em que ela sentava ao meu lado
    Text_Ru: "\u041D\u043E \u043A\u043E\u0433\u0434\u0430 \u0434\u043E\u0447\u044C
      \u0441\u0438\u0434\u0435\u043B\u0430 \u0440\u044F\u0434\u043E\u043C"
  - ID: AfterChapter_All_8
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB2E4\uC74C \uBCC4\uC744 \uBB3C\uC5B4\uC624\uB358 \uBC24\uC5D0\uB294"
    Text_En: asking about the next star,
    Text_ZhHans: "\u95EE\u6211\u4E0B\u4E00\u9897\u661F\u5728\u54EA\u91CC\u65F6\uFF0C"
    Text_Ja: "\u6B21\u306E\u661F\u3092\u5C0B\u306D\u3066\u304F\u308B\u591C\u306F\u3001"
    Text_Es: y preguntaba por la siguiente estrella,
    Text_Pt: "e perguntava pela pr\xF3xima estrela,"
    Text_Ru: "\u0438 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0430
      \u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0437\u0432\u0435\u0437\u0434\u0435,"
  - ID: AfterChapter_All_9
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB0B4\uAC00 \uC544\uBB34\uAC83\uB3C4 \uC783\uC9C0 \uC54A\uC740 \uAC83
      \uAC19\uC558\uB2E4."
    Text_En: it felt as though I'd lost nothing.
    Text_ZhHans: "\u6211\u53C8\u89C9\u5F97\u81EA\u5DF1\u4EC0\u4E48\u90FD\u6CA1\u6709\u5931\u53BB\u3002"
    Text_Ja: "\u4F55\u3082\u5931\u3063\u3066\u3044\u306A\u3044\u6C17\u304C\u3057\u305F\u3002"
    Text_Es: "sent\xEDa que no hab\xEDa perdido nada."
    Text_Pt: "parecia que eu n\xE3o tinha perdido nada."
    Text_Ru: "\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u044F \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B."
  - ID: AfterChapter_All_10
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uADF8\uB7F0\uB370\uB3C4 \uB098\uB294"
    Text_En: Even so,
    Text_ZhHans: "\u5373\u4FBF\u5982\u6B64\uFF0C"
    Text_Ja: "\u306A\u306E\u306B\u3001\u79C1\u306F\u3001"
    Text_Es: "Aun as\xED,"
    Text_Pt: Mesmo assim,
    Text_Ru: "\u0418 \u0432\u0441\u0451 \u0436\u0435"
  - ID: AfterChapter_All_11
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uD574\uC8FC\uC9C0 \uBABB\uD55C \uAC83\uB4E4\uB9CC \uC138\uC5C8\uB2E4."
    Text_En: I counted only what I couldn't give.
    Text_ZhHans: "\u6211\u5374\u53EA\u6570\u7740\u6CA1\u80FD\u7ED9\u5979\u7684\u4E1C\u897F\u3002"
    Text_Ja: "\u3057\u3066\u3084\u308C\u306A\u304B\u3063\u305F\u3053\u3068\u3070\u304B\u308A\u6570\u3048\u305F\u3002"
    Text_Es: "solo contaba lo que no pod\xEDa darle."
    Text_Pt: "eu s\xF3 contava o que n\xE3o pude dar."
    Text_Ru: "\u044F \u0441\u0447\u0438\u0442\u0430\u043B \u043B\u0438\u0448\u044C
      \u0442\u043E, \u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u043C\u043E\u0433
      \u0435\u0439 \u0434\u0430\u0442\u044C."
  - ID: AfterChapter_All_12
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB3C8\uC774 \uB354 \uC788\uC5C8\uB2E4\uBA74."
    Text_En: If only I'd had more money.
    Text_ZhHans: "\u8981\u662F\u6709\u66F4\u591A\u7684\u94B1\u3002"
    Text_Ja: "\u3082\u3063\u3068\u91D1\u304C\u3042\u308C\u3070\u3002"
    Text_Es: "Si hubiera tenido m\xE1s dinero."
    Text_Pt: Se eu tivesse mais dinheiro.
    Text_Ru: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0431\u044B\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u0434\u0435\u043D\u0435\u0433."
  - ID: AfterChapter_All_13
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC544\uB0B4\uB97C \uC0B4\uB9B4 \uC218 \uC788\uC5C8\uB2E4\uBA74."
    Text_En: If only I'd saved my wife.
    Text_ZhHans: "\u8981\u662F\u80FD\u6551\u56DE\u59BB\u5B50\u3002"
    Text_Ja: "\u59BB\u3092\u6551\u3048\u3066\u3044\u308C\u3070\u3002"
    Text_Es: Si hubiera podido salvar a mi esposa.
    Text_Pt: Se pudesse ter salvado minha esposa.
    Text_Ru: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0441\u043F\u0430\u0441\u0442\u0438 \u0436\u0435\u043D\u0443."
  - ID: AfterChapter_All_14
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC544\uC774\uC5D0\uAC8C \uB0A8\uB4E4\uCC98\uB7FC \uD574\uC904 \uC218
      \uC788\uC5C8\uB2E4\uBA74."
    Text_En: If only I'd given her what others had.
    Text_ZhHans: "\u8981\u662F\u80FD\u8BA9\u5973\u513F\u8FC7\u5F97\u548C\u522B\u4EBA\u4E00\u6837\u3002"
    Text_Ja: "\u5A18\u306B\u3001\u307B\u304B\u306E\u5B50\u3068\u540C\u3058\u3088\u3046\u306B\u3057\u3066\u3084\u308C\u305F\u3089\u3002"
    Text_Es: "Si le hubiera dado lo que ten\xEDan otros ni\xF1os."
    Text_Pt: "Se pudesse dar \xE0 minha filha o que os outros tinham."
    Text_Ru: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0434\u043E\u0447\u044C \u0436\u0438\u043B\u0430
      \u043D\u0435 \u0445\u0443\u0436\u0435 \u0434\u0440\u0443\u0433\u0438\u0445
      \u0434\u0435\u0442\u0435\u0439."
  - ID: AfterChapter_All_15
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC774\uB8E8\uC9C0 \uBABB\uD55C \uAC83\uB4E4\uC744 \uD551\uACC4\uB85C"
    Text_En: I used those failures as excuses
    Text_ZhHans: "\u6211\u628A\u8FD9\u4E9B\u672A\u80FD\u5B9E\u73B0\u7684\u613F\u671B\u5F53\u4F5C\u501F\u53E3\uFF0C"
    Text_Ja: "\u304B\u306A\u308F\u306A\u304B\u3063\u305F\u3053\u3068\u3092\u8A00\u3044\u8A33\u306B\u3001"
    Text_Es: "Us\xE9 esos sue\xF1os frustrados como excusa"
    Text_Pt: Usei esses sonhos frustrados como desculpa
    Text_Ru: "\u041D\u0435\u0441\u0431\u044B\u0432\u0448\u0438\u0435\u0441\u044F
      \u043C\u0435\u0447\u0442\u044B \u0441\u0442\u0430\u043B\u0438 \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u043D\u0438\u0435\u043C"
  - ID: AfterChapter_All_16
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uD574\uC11C\uB294 \uC548 \uB420 \uC77C\uB4E4\uC744 \uD588\uB2E4."
    Text_En: to do things I never should have.
    Text_ZhHans: "\u505A\u4E86\u4E0D\u8BE5\u505A\u7684\u4E8B\u3002"
    Text_Ja: "\u3057\u3066\u306F\u3044\u3051\u306A\u3044\u3053\u3068\u3092\u3057\u305F\u3002"
    Text_Es: "para hacer lo que nunca deb\xED."
    Text_Pt: para fazer o que nunca deveria.
    Text_Ru: "\u0442\u043E\u043C\u0443, \u0447\u0435\u0433\u043E \u044F \u043D\u0435
      \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0434\u0435\u043B\u0430\u0442\u044C."
  - ID: AfterChapter_All_17
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC544\uC774\uB97C \uC704\uD574\uC11C\uB77C\uACE0 \uB9D0\uD558\uBA74\uC11C."
    Text_En: All in her name.
    Text_ZhHans: "\u5634\u4E0A\u5374\u8BF4\uFF0C\u90FD\u662F\u4E3A\u4E86\u5973\u513F\u3002"
    Text_Ja: "\u5A18\u306E\u305F\u3081\u3060\u3068\u8A00\u3044\u306A\u304C\u3089\u3002"
    Text_Es: Diciendo que era por ella.
    Text_Pt: Dizendo que era por ela.
    Text_Ru: "\u0410 \u044F \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E
      \u0432\u0441\u0451 \u0440\u0430\u0434\u0438 \u0434\u043E\u0447\u0435\u0440\u0438."
  - ID: AfterChapter_All_18
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC544\uC774\uB294 \uB0B4\uAC00 \uAC00\uB9AC\uD0A4\uB358 \uBCC4\uC744
      \uAE30\uC5B5\uD588\uB2E4."
    Text_En: She remembered the stars I'd shown her.
    Text_ZhHans: "\u5979\u8BB0\u5F97\u6211\u6307\u7ED9\u5979\u770B\u7684\u661F\u661F\u3002"
    Text_Ja: "\u5A18\u306F\u3001\u79C1\u304C\u6559\u3048\u305F\u661F\u3092\u899A\u3048\u3066\u3044\u305F\u3002"
    Text_Es: "Ella recordaba las estrellas que le ense\xF1\xE9."
    Text_Pt: Ela lembrou das estrelas que mostrei.
    Text_Ru: "\u041E\u043D\u0430 \u043F\u043E\u043C\u043D\u0438\u043B\u0430 \u0437\u0432\u0451\u0437\u0434\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u044F \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B."
  - ID: AfterChapter_All_19
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB0B4\uAC00 \uB0A8\uAE34 \uAE30\uB85D\uC744 \uC77D\uACE0"
    Text_En: She followed the records I'd left,
    Text_ZhHans: "\u5979\u8BFB\u7740\u6211\u7559\u4E0B\u7684\u8BB0\u5F55\uFF0C"
    Text_Ja: "\u79C1\u306E\u6B8B\u3057\u305F\u8A18\u9332\u3092\u8AAD\u307F\u3001"
    Text_Es: "Ley\xF3 las notas que dej\xE9"
    Text_Pt: Leu os registros que deixei
    Text_Ru: "\u041F\u0440\u043E\u0447\u043B\u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
      \u043C\u043D\u043E\u044E \u0437\u0430\u043F\u0438\u0441\u0438"
  - ID: AfterChapter_All_20
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB05D\uB0B4 \uC228\uAE30\uACE0 \uC2F6\uC5C8\uB358 \uC77C\uAE4C\uC9C0
      \uCC3E\uC544\uB0C8\uB2E4."
    Text_En: even to the things I'd tried to hide.
    Text_ZhHans: "\u6700\u7EC8\u627E\u5230\u4E86\u6211\u6700\u60F3\u9690\u7792\u7684\u4E8B\u3002"
    Text_Ja: "\u96A0\u3057\u901A\u3057\u305F\u304B\u3063\u305F\u3053\u3068\u307E\u3067\u898B\u3064\u3051\u305F\u3002"
    Text_Es: "y descubri\xF3 hasta lo que quise ocultar."
    Text_Pt: "e encontrou at\xE9 o que eu quis esconder."
    Text_Ru: "\u0438 \u043D\u0430\u0448\u043B\u0430 \u0434\u0430\u0436\u0435 \u0442\u043E,
      \u0447\u0442\u043E \u044F \u0445\u043E\u0442\u0435\u043B \u0441\u043A\u0440\u044B\u0442\u044C."
  - ID: AfterChapter_All_21
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uADF8 \uB05D\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB358 \uAC74"
    Text_En: What waited at the end
    Text_ZhHans: "\u800C\u5728\u5C3D\u5934\u7B49\u7740\u5979\u7684\uFF0C"
    Text_Ja: "\u305D\u306E\u5148\u3067\u5F85\u3063\u3066\u3044\u305F\u306E\u306F\u3001"
    Text_Es: Al final de aquel camino,
    Text_Pt: No fim daquele caminho,
    Text_Ru: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u0435\u0451 \u043F\u0443\u0442\u0438
      \u0436\u0434\u0430\u043B"
  - ID: AfterChapter_All_22
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB0B4\uAC00 \uB418\uACE0 \uC2F6\uC5C8\uB358 \uC544\uBC84\uC9C0\uAC00
      \uC544\uB2C8\uC5C8\uB2E4."
    Text_En: wasn't the father I'd wanted to be.
    Text_ZhHans: "\u4E0D\u662F\u6211\u66FE\u60F3\u6210\u4E3A\u7684\u90A3\u79CD\u7236\u4EB2\u3002"
    Text_Ja: "\u79C1\u304C\u306A\u308A\u305F\u304B\u3063\u305F\u7236\u89AA\u3067\u306F\u306A\u304B\u3063\u305F\u3002"
    Text_Es: "no estaba el padre que yo quer\xEDa ser."
    Text_Pt: "n\xE3o estava o pai que eu queria ser."
    Text_Ru: "\u043D\u0435 \u0442\u043E\u0442 \u043E\u0442\u0435\u0446, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u044F \u043C\u0435\u0447\u0442\u0430\u043B \u0441\u0442\u0430\u0442\u044C."
  - ID: AfterChapter_All_23
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC624\uB298\uC740 \uB098 \uBA3C\uC800 \uAC08\uAC8C."
    Text_En: I'm going on ahead today.
    Text_ZhHans: "\u4ECA\u5929\u6211\u5148\u8D70\u4E86\u3002"
    Text_Ja: "\u4ECA\u65E5\u306F\u3001\u79C1\u304C\u5148\u306B\u884C\u304F\u306D\u3002"
    Text_Es: Hoy me voy yo primero.
    Text_Pt: Hoje eu vou na frente.
    Text_Ru: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0443\u0439\u0434\u0443
      \u043F\u0435\u0440\u0432\u043E\u0439."
  - ID: AfterChapter_All_24
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uADF8 \uB9D0\uC5D0 \uB300\uB2F5\uD558\uACE0 \uC2F6\uC5C8\uB2E4."
    Text_En: I wanted to answer her.
    Text_ZhHans: "\u6211\u60F3\u56DE\u7B54\u5979\u3002"
    Text_Ja: "\u305D\u306E\u8A00\u8449\u306B\u7B54\u3048\u305F\u304B\u3063\u305F\u3002"
    Text_Es: Quise responderle.
    Text_Pt: Eu queria responder.
    Text_Ru: "\u041C\u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
      \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u0435\u0439."
  - ID: AfterChapter_All_25
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uD558\uC9C0\uB9CC \uBB34\uC2A8 \uB9D0\uC744 \uD560 \uC218 \uC788\uC5C8\uC744\uAE4C."
    Text_En: But what could I have said?
    Text_ZhHans: "\u53EF\u6211\u53C8\u80FD\u8BF4\u4EC0\u4E48\u5462\uFF1F"
    Text_Ja: "\u3067\u3082\u3001\u4F55\u304C\u8A00\u3048\u305F\u3060\u308D\u3046\u3002"
    Text_Es: "Pero \xBFqu\xE9 pod\xEDa decir?"
    Text_Pt: Mas o que poderia dizer?
    Text_Ru: "\u041D\u043E \u0447\u0442\u043E \u044F \u043C\u043E\u0433 \u0441\u043A\u0430\u0437\u0430\u0442\u044C?"
  - ID: AfterChapter_All_26
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB098\uB97C \uAE30\uB2E4\uB824\uB2EC\uB77C\uACE0 \uD560 \uC218\uB3C4,"
    Text_En: I couldn't ask her to wait,
    Text_ZhHans: "\u6211\u4E0D\u80FD\u6C42\u5979\u7EE7\u7EED\u7B49\u6211\uFF0C"
    Text_Ja: "\u5F85\u3063\u3066\u3044\u3066\u304F\u308C\u3068\u3082\u3001"
    Text_Es: "No pod\xEDa pedirle que me esperara,"
    Text_Pt: "N\xE3o podia pedir que me esperasse,"
    Text_Ru: "\u041D\u0435 \u043C\u043E\u0433 \u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u0435\u0451 \u0436\u0434\u0430\u0442\u044C."
  - ID: AfterChapter_All_27
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC608\uC804\uCC98\uB7FC \uBC14\uB77C\uBD10\uB2EC\uB77C\uACE0 \uD560
      \uC218\uB3C4 \uC5C6\uC5C8\uB2E4."
    Text_En: or to see me as she once had.
    Text_ZhHans: "\u4E5F\u4E0D\u80FD\u6C42\u5979\u50CF\u4ECE\u524D\u90A3\u6837\u770B\u7740\u6211\u3002"
    Text_Ja: "\u6614\u306E\u3088\u3046\u306B\u898B\u3066\u304F\u308C\u3068\u3082\u8A00\u3048\u306A\u304B\u3063\u305F\u3002"
    Text_Es: ni que me mirara como antes.
    Text_Pt: nem que me olhasse como antes.
    Text_Ru: "\u041D\u0435 \u043C\u043E\u0433 \u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u043C\u0435\u043D\u044F
      \u043A\u0430\u043A \u043F\u0440\u0435\u0436\u0434\u0435."
  - ID: AfterChapter_All_28
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uAFC8\uC744 \uC774\uB8E8\uC9C0 \uBABB\uD588\uC5B4\uB3C4"
    Text_En: Even if my dream never came true,
    Text_ZhHans: "\u5373\u4F7F\u6CA1\u80FD\u5B9E\u73B0\u68A6\u60F3\uFF0C"
    Text_Ja: "\u5922\u304C\u304B\u306A\u308F\u306A\u304F\u3066\u3082\u3001"
    Text_Es: "Aunque no cumpliera mi sue\xF1o,"
    Text_Pt: Mesmo sem realizar meu sonho,
    Text_Ru: "\u041F\u0443\u0441\u0442\u044C \u043C\u0435\u0447\u0442\u0430 \u0438
      \u043D\u0435 \u0441\u0431\u044B\u043B\u0430\u0441\u044C,"
  - ID: AfterChapter_All_29
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uC544\uC774 \uACC1\uC5D0\uB294 \uB0A8\uC744 \uC218 \uC788\uC5C8\uB294\uB370."
    Text_En: I could have stayed beside her.
    Text_ZhHans: "\u6211\u672C\u53EF\u4EE5\u7559\u5728\u5979\u8EAB\u8FB9\u3002"
    Text_Ja: "\u5A18\u306E\u305D\u3070\u306B\u306F\u3044\u3089\u308C\u305F\u306E\u306B\u3002"
    Text_Es: "podr\xEDa haberme quedado a su lado."
    Text_Pt: eu poderia ter ficado ao lado dela.
    Text_Ru: "\u044F \u0432\u0435\u0434\u044C \u043C\u043E\u0433 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0434\u043E\u0447\u0435\u0440\u044C\u044E."
  - ID: AfterChapter_All_30
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uB2E4\uC74C \uBCC4\uC774 \uC5B4\uB514\uB0D0\uACE0 \uBB3C\uC73C\uBA74"
    Text_En: When she asked for the next star,
    Text_ZhHans: "\u5F53\u5979\u95EE\u8D77\u4E0B\u4E00\u9897\u661F\u5728\u54EA\u91CC\uFF0C"
    Text_Ja: "\u6B21\u306E\u661F\u306F\u3069\u3053\u304B\u3068\u805E\u304B\u308C\u305F\u3089\u3001"
    Text_Es: Cuando preguntara por la siguiente estrella,
    Text_Pt: "Quando perguntasse pela pr\xF3xima estrela,"
    Text_Ru: "\u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u0431\u044B \u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0437\u0432\u0435\u0437\u0434\u0435,"
  - ID: AfterChapter_All_31
    Chapter_Id: AfterChapter_All
    Speaker: Father
    Text_Kr: "\uD568\uAED8 \uCC3E\uC544\uC904 \uC218\uB294 \uC788\uC5C8\uB294\uB370."
    Text_En: I could have helped her find it.
    Text_ZhHans: "\u6211\u672C\u53EF\u4EE5\u966A\u5979\u4E00\u8D77\u5BFB\u627E\u3002"
    Text_Ja: "\u4E00\u7DD2\u306B\u63A2\u3057\u3066\u3084\u308C\u305F\u306E\u306B\u3002"
    Text_Es: "podr\xEDa haberla ayudado a encontrarla."
    Text_Pt: "eu poderia ajud\xE1-la a encontrar."
    Text_Ru: "\u044F \u0432\u0435\u0434\u044C \u043C\u043E\u0433 \u043F\u043E\u043C\u043E\u0447\u044C
      \u0435\u0451 \u043D\u0430\u0439\u0442\u0438."
  - ID: Ending_1
    Chapter_Id: Ending
    Speaker: Police
    Text_Kr: ...
    Text_En: ...
    Text_ZhHans: "\u2026\u2026"
    Text_Ja: "\u2026\u2026"
    Text_Es: ...
    Text_Pt: ...
    Text_Ru: ...
  - ID: Ending_2
    Chapter_Id: Ending
    Speaker: Police
    Text_Kr: "\uCE58\uC9C0\uC9C1..."
    Text_En: Krrsh...
    Text_ZhHans: "\u6ECB\u2026\u2026"
    Text_Ja: "\u30B6\u30B6\u30C3\u2026\u2026"
    Text_Es: Crrr...
    Text_Pt: Chhh...
    Text_Ru: "\u0428-\u0448..."
  - ID: Ending_3
    Chapter_Id: Ending
    Speaker: Police
    Text_Kr: "\uC5EC\uAE30\uB294 \uC218\uC0C9 3\uD300."
    Text_En: Search Team Three here.
    Text_ZhHans: "\u8FD9\u91CC\u662F\u641C\u67E5\u4E09\u7EC4\u3002"
    Text_Ja: "\u3053\u3061\u3089\u635C\u7D22\u4E09\u73ED\u3002"
    Text_Es: "Aqu\xED, equipo de b\xFAsqueda tres."
    Text_Pt: "Aqui \xE9 a equipe de busca tr\xEAs."
    Text_Ru: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0440\u0435\u0442\u044C\u044F
      \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430."
  - ID: Ending_4
    Chapter_Id: Ending
    Speaker: Police
    Text_Kr: "\uB9D0\uC500\uD558\uC2ED\uC2DC\uC624."
    Text_En: Go ahead.
    Text_ZhHans: "\u8BF7\u8BB2\u3002"
    Text_Ja: "\u3069\u3046\u305E\u3002"
    Text_Es: Adelante.
    Text_Pt: Prossiga.
    Text_Ru: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442\u0435."
  - ID: Ending_5
    Chapter_Id: Ending
    Speaker: Police
    Text_Kr: "\uADF8\uAC8C..."
    Text_En: Well...
    Text_ZhHans: "\u90A3\u4E2A\u2026\u2026"
    Text_Ja: "\u305D\u308C\u304C\u2026\u2026"
    Text_Es: Es que...
    Text_Pt: "\xC9 que..."
    Text_Ru: "\u0414\u0435\u043B\u043E \u0432 \u0442\u043E\u043C..."
  - ID: Ending_6
    Chapter_Id: Ending
    Speaker: Police
    Text_Kr: "\uC800\uD76C\uAC00 \uCAD3\uB358 \uC6A9\uC758\uC790\uAC00"
    Text_En: The suspect we were looking for...
    Text_ZhHans: "\u6211\u4EEC\u4E00\u76F4\u5728\u8FFD\u67E5\u7684\u5ACC\u7591\u4EBA\uFF0C"
    Text_Ja: "\u8FFD\u3063\u3066\u3044\u305F\u5BB9\u7591\u8005\u304C\u3001"
    Text_Es: "El sospechoso al que busc\xE1bamos..."
    Text_Pt: "O suspeito que procur\xE1vamos..."
    Text_Ru: "\u041F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u044B\u0439,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043C\u044B \u0438\u0441\u043A\u0430\u043B\u0438,"
  - ID: Ending_7
    Chapter_Id: Ending
    Speaker: Police
    Text_Kr: "\uC0B4\uD574\uB41C \uCC44\uB85C \uBC1C\uACAC\uB410\uC2B5\uB2C8\uB2E4."
    Text_En: We've found him murdered.
    Text_ZhHans: "\u88AB\u53D1\u73B0\u906D\u4EBA\u6740\u5BB3\u4E86\u3002"
    Text_Ja: "\u6BBA\u5BB3\u3055\u308C\u305F\u72B6\u614B\u3067\u898B\u3064\u304B\u308A\u307E\u3057\u305F\u3002"
    Text_Es: Lo hemos encontrado asesinado.
    Text_Pt: Foi encontrado assassinado.
    Text_Ru: "\u043D\u0430\u0439\u0434\u0435\u043D \u0443\u0431\u0438\u0442\u044B\u043C."
  - ID: Ending_8
    Chapter_Id: Ending
    Speaker: Police
    Text_Kr: "\u2026\u2026"
    Text_En: ...
    Text_ZhHans: "\u2026\u2026"
    Text_Ja: "\u2026\u2026"
    Text_Es: ...
    Text_Pt: ...
    Text_Ru: ...
  - ID: Ending_9
    Chapter_Id: Ending
    Speaker: Police
    Text_Kr: "\uC820\uC7A5."
    Text_En: Damn it.
    Text_ZhHans: "\u8BE5\u6B7B\u3002"
    Text_Ja: "\u304F\u305D\u3063\u3002"
    Text_Es: Maldita sea.
    Text_Pt: Droga.
    Text_Ru: "\u0427\u0451\u0440\u0442."
